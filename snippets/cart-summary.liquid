{% doc %}
  Renders the cart total summary and checkout/continue-shopping actions.

  @param {object} cart - The Shopify cart context.
  @param {string} [form_id] - Optional cart form ID for the checkout control.
  @param {string} [continue_url] - Optional destination for continuing shopping.

  @example
  {% render 'cart-summary', cart: cart, form_id: 'CartForm' %}
{% enddoc %}

{% liquid
  assign cart_continue_url = continue_url | default: routes.root_url
%}

<aside class="cart-summary" data-cart-summary aria-label="{{ 'cart.summary' | t | escape }}">
  <dl class="cart-summary__totals">
    <div class="cart-summary__row">
      <dt>{{ 'cart.subtotal' | t }}</dt>
      <dd>{{ cart.total_price | money }}</dd>
    </div>
  </dl>

  <div class="cart-summary__actions">
    <a class="btn btn--secondary" href="{{ cart_continue_url }}">{{ 'cart.continue_shopping' | t }}</a>
    {% if cart.item_count > 0 %}
      <button class="btn btn--primary btn--fill" type="submit" name="checkout"{% if form_id != blank %} form="{{ form_id | escape }}"{% endif %}>
        {{ 'cart.checkout' | t }}
      </button>
    {% endif %}
  </div>
</aside>

{% stylesheet %}
  .cart-summary { display: grid; gap: 1.25rem; }
  .cart-summary__totals { margin: 0; }
  .cart-summary__row { align-items: baseline; display: flex; gap: 1rem; justify-content: space-between; }
  .cart-summary__row dd { margin: 0; }
  .cart-summary__actions { display: grid; gap: 0.75rem; }
  .cart-summary__actions .btn { width: 100%; }
{% endstylesheet %}
