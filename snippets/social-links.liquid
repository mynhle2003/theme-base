{% doc %}
  Renders configured social media links.

  @example
  {% render 'social-links' %}
{% enddoc %}

{% assign social_platforms = 'facebook,instagram,x,youtube,tiktok,pinterest' | split: ',' %}

<nav class="social-links" aria-label="{{ 'general.social.links' | t }}">
  {% for platform in social_platforms %}
    {% assign setting_id = 'social_' | append: platform | append: '_url' %}
    {% assign social_url = settings[setting_id] %}
    {% if social_url != blank %}
      <a class="social-links__link" href="{{ social_url | escape }}" target="_blank" rel="noopener noreferrer">
        <span class="social-links__icon" aria-hidden="true">{{ platform | slice: 0, 1 | upcase }}</span>
        <span class="social-links__label{% unless settings.social_media_show_labels %} visually-hidden{% endunless %}">{{ platform | capitalize }}</span>
      </a>
    {% endif %}
  {% endfor %}
</nav>

{% stylesheet %}
  .social-links { align-items: center; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .social-links:empty { display: none; }
  .social-links__link { align-items: center; color: var(--color-foreground); display: inline-flex; gap: 0.35rem; text-decoration: none; }
  .social-links__link:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .social-links__link:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .social-links__icon { align-items: center; border: 1px solid currentColor; border-radius: 50%; display: inline-flex; font-size: 0.7em; height: 1.75rem; justify-content: center; width: 1.75rem; }
  .visually-hidden { clip: rect(0 0 0 0); clip-path: inset(50%); height: 1px; overflow: hidden; position: absolute; white-space: nowrap; width: 1px; }
{% endstylesheet %}
