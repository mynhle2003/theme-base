{% doc %}
  Renders a reusable Shopify menu with active states and accessible disclosures.

  @param {linklist} [menu] - A Shopify menu resource selected by the parent surface.
  @param {object} [links] - Link objects for nested recursive rendering.
  @param {string} id_prefix - Unique ID prefix for this navigation instance.
  @param {string} [class] - Optional class for the navigation element.
  @param {string} [presentation] - Optional presentation mode; use footer for a simple, non-disclosure list.
  @param {string} [label] - Optional accessible navigation label.
  @param {number} [depth] - Current menu depth for recursive rendering.
  @param {number} [max_depth] - Maximum menu depth, capped at three levels.
  @param {boolean} [nested] - Whether to render only the nested list markup.
  @param {string} [list_id] - Optional ID for the nested list controlled by a disclosure.
  @param {boolean} [expanded] - Whether the nested list starts expanded.

  @example
  {% render 'navigation', menu: section.settings.menu, id_prefix: section.id %}
{% enddoc %}

{% liquid
  assign navigation_links = links
  if menu != blank
    assign navigation_links = menu.links
  endif
  assign navigation_depth = depth | default: 1
  assign navigation_max_depth = max_depth | default: 3
  if navigation_max_depth > 3
    assign navigation_max_depth = 3
  endif
  assign navigation_prefix = id_prefix | default: 'navigation'
  assign navigation_presentation = presentation | default: 'standard'
  assign navigation_label = 'navigation.label' | t
  if label != blank
    assign navigation_label = label
  endif
  assign navigation_classes = 'navigation'
  if class != blank
    assign navigation_classes = navigation_classes | append: ' ' | append: class
  endif
%}

{% unless nested %}
  <nav class="{{ navigation_classes | escape }}" aria-label="{{ navigation_label | escape }}" data-navigation>
{% endunless %}

{% if navigation_links != blank %}
  <ul class="navigation__list{% if nested %} navigation__list--nested{% endif %}"{% if nested %}{% if list_id != blank %} id="{{ list_id | escape }}" data-navigation-list{% unless expanded %} hidden{% endunless %}{% endif %}{% endif %}>
    {% for link in navigation_links %}
      <li class="navigation__item{% if link.active or link.child_active %} navigation__item--active{% endif %}">
        {% if navigation_presentation == 'footer' %}
          <a class="navigation__link{% if link.active %} navigation__link--active{% endif %}" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>
            {{ link.title | escape }}
          </a>
          {% if link.links != blank and navigation_depth < navigation_max_depth %}
            {% assign navigation_next_depth = navigation_depth | plus: 1 %}
            {% render 'navigation', links: link.links, id_prefix: navigation_prefix, depth: navigation_next_depth, max_depth: navigation_max_depth, nested: true, presentation: 'footer' %}
          {% endif %}
        {% elsif link.links != blank %}
          {% if navigation_depth < navigation_max_depth %}
            {% assign disclosure_id = navigation_prefix | append: '-' | append: navigation_depth | append: '-' | append: forloop.index %}
            {% assign navigation_next_depth = navigation_depth | plus: 1 %}
            <div class="navigation__item-row">
              <a class="navigation__link{% if link.active %} navigation__link--active{% endif %}" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>
                {{ link.title | escape }}
              </a>
              <button
                class="navigation__toggle"
                type="button"
                aria-controls="{{ disclosure_id | escape }}"
                aria-expanded="{% if link.child_active %}true{% else %}false{% endif %}"
                aria-haspopup="true"
                aria-label="{% if link.child_active %}{{ 'navigation.collapse' | t: name: link.title | escape }}{% else %}{{ 'navigation.expand' | t: name: link.title | escape }}{% endif %}"
                data-navigation-toggle
                data-label-expanded="{{ 'navigation.collapse' | t: name: link.title | escape }}"
                data-label-collapsed="{{ 'navigation.expand' | t: name: link.title | escape }}"
              >
                <span aria-hidden="true">+</span>
              </button>
            </div>
            {% render 'navigation', links: link.links, id_prefix: disclosure_id, depth: navigation_next_depth, max_depth: navigation_max_depth, nested: true, list_id: disclosure_id, expanded: link.child_active %}
          {% else %}
            <a class="navigation__link{% if link.active %} navigation__link--active{% endif %}" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>
              {{ link.title | escape }}
            </a>
          {% endif %}
        {% else %}
          <a class="navigation__link{% if link.active %} navigation__link--active{% endif %}" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>
            {{ link.title | escape }}
          </a>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% elsif nested == blank %}
  <p class="navigation__empty">{{ 'navigation.empty' | t }}</p>
{% endif %}

{% unless nested %}
  </nav>
{% endunless %}

{% stylesheet %}
  .navigation__list {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .navigation__list--nested {
    display: grid;
    gap: 0.5rem;
    margin-block-start: 0.5rem;
    padding-inline-start: 1rem;
  }

  .navigation__item { min-width: 0; }

  .navigation__item-row {
    align-items: center;
    display: flex;
    gap: 0.5rem;
  }

  .navigation__link {
    color: inherit;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .navigation__link:hover,
  .navigation__link--active { text-decoration: underline; text-underline-offset: 0.2em; }

  .navigation__toggle {
    align-items: center;
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    justify-content: center;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding: 0.5rem;
  }

  .navigation__toggle[aria-expanded='true'] span { transform: rotate(45deg); }
  .navigation__toggle:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .navigation__empty { margin: 0; }
{% endstylesheet %}

{% javascript %}
  (() => {
    if (window.themeNavigationManager) return;

    const manager = {
      roots: new Map(),
      initialized: false,

      init(root) {
        const navigationRoots = [];
        if (root.matches?.('[data-navigation]')) navigationRoots.push(root);
        if (root.querySelectorAll) navigationRoots.push(...root.querySelectorAll('[data-navigation]'));
        navigationRoots.forEach((navigationRoot) => this.register(navigationRoot));
      },

      register(root) {
        if (this.roots.has(root)) return;
        const onClick = (event) => this.handleClick(root, event);
        const onKeydown = (event) => this.handleKeydown(root, event);
        root.addEventListener('click', onClick);
        root.addEventListener('keydown', onKeydown);
        this.roots.set(root, { onClick, onKeydown });
      },

      destroy(root) {
        const navigationRoots = [];
        if (root.matches?.('[data-navigation]')) navigationRoots.push(root);
        if (root.querySelectorAll) navigationRoots.push(...root.querySelectorAll('[data-navigation]'));
        navigationRoots.forEach((navigationRoot) => {
          const controller = this.roots.get(navigationRoot);
          if (!controller) return;
          navigationRoot.removeEventListener('click', controller.onClick);
          navigationRoot.removeEventListener('keydown', controller.onKeydown);
          this.roots.delete(navigationRoot);
        });
      },

      handleClick(root, event) {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const toggle = target.closest('[data-navigation-toggle]');
        if (!toggle || !root.contains(toggle)) return;
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        if (!expanded) {
          root.querySelectorAll('[data-navigation-toggle][aria-expanded="true"]').forEach((openToggle) => {
            if (openToggle === toggle) return;
            const openList = document.getElementById(openToggle.getAttribute('aria-controls'));
            if (openList?.contains(toggle)) return;
            this.setExpanded(openToggle, false);
          });
        }
        this.setExpanded(toggle, !expanded);
      },

      setExpanded(toggle, expanded) {
        const controlledList = document.getElementById(toggle.getAttribute('aria-controls'));
        if (!controlledList) return;
        toggle.setAttribute('aria-expanded', String(expanded));
        toggle.setAttribute('aria-label', expanded ? toggle.dataset.labelExpanded : toggle.dataset.labelCollapsed);
        controlledList.hidden = !expanded;
        if (!expanded) this.closeDescendants(controlledList);
      },

      closeDescendants(list) {
        list.querySelectorAll('[data-navigation-toggle][aria-expanded="true"]').forEach((toggle) => {
          this.setExpanded(toggle, false);
        });
      },

      close(root) {
        if (!root) return;
        this.closeDescendants(root);
      },

      handleKeydown(root, event) {
        if (event.key !== 'Escape') return;
        const target = event.target;
        if (!(target instanceof Element)) return;
        let toggle = target.closest('[data-navigation-toggle][aria-expanded="true"]');
        if (!toggle) {
          const list = target.closest('[data-navigation-list]');
          if (!list || !root.contains(list)) return;
          toggle = [...root.querySelectorAll('[data-navigation-toggle]')].find((item) => item.getAttribute('aria-controls') === list.id);
        }
        if (!toggle || toggle.getAttribute('aria-expanded') !== 'true') return;
        event.preventDefault();
        event.stopPropagation();
        this.setExpanded(toggle, false);
        toggle.focus({ preventScroll: true });
      },

      handleDocumentClick(event) {
        const target = event.target;
        if (!(target instanceof Element)) return;
        this.roots.forEach((_entry, root) => {
          if (!root.contains(target)) this.close(root);
        });
      },

      setup() {
        if (this.initialized) return;
        this.initialized = true;
        document.addEventListener('shopify:section:load', (event) => this.init(event.target));
        document.addEventListener('shopify:section:unload', (event) => this.destroy(event.target));
        document.addEventListener('click', (event) => this.handleDocumentClick(event));
        this.init(document);
      },
    };

    window.themeNavigationManager = manager;
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => manager.setup(), { once: true });
    } else {
      manager.setup();
    }
  })();
{% endjavascript %}
