{% doc %}
  Product information scoped to one video-review overlay. Reuses the theme
  variant picker, price primitive and buy-button controller.
  @param {product} product
  @param {string} scope - Unique section/block/product scope
{% enddoc %}
{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign selected_image = current_variant.featured_image | default: product.featured_image
  assign form_id = scope | append: '-form'
  assign add_label = 'products.add_to_cart' | t
  assign sold_label = 'products.sold_out' | t
  assign unavailable_label = 'products.unavailable' | t
  assign details_label = 'video_reviews.view_details' | t
  assign button_label = add_label
  assign unavailable = false
  unless current_variant.available
    assign unavailable = true
    assign button_label = sold_label
  endunless
%}
<div class="video-review__popup-content">
  <div class="video-review__product-options scrollbar scrollbar--vertical">
    <div class="video-review__product-summary">
      <a class="video-review__product-image" href="{{ product.url | escape }}" tabindex="-1" aria-hidden="true">
        {% if selected_image != blank %}
          {{ selected_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '80, 160, 240', sizes: '80px', alt: '' }}
        {% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
      </a>
      <div class="video-review__product-heading">
        {% render 'product-card-title', product: product, heading_tag: 'h3' %}
        <div data-product-price-container data-section-id="{{ scope }}">
          {% assign price_item = current_variant | default: product %}
          {% render 'product-card-price', item: price_item %}
          {% for variant in product.variants %}
            <template data-variant-price-template="{{ variant.id }}">{% render 'product-card-price', item: variant %}</template>
          {% endfor %}
        </div>
      </div>
    </div>
    {% unless product.has_only_default_variant %}
      {% render 'variant-picker', product: product, current_variant: current_variant, section_id: scope, form_id: form_id, type_override: 'button', sync_external_variants: false, update_url_on_change: false, ignore_url_variant: true %}
    {% endunless %}
  </div>
  {% for variant in product.variants %}
    {% assign variant_image = variant.featured_image | default: product.featured_image %}
    <template data-review-variant-image="{{ variant.id }}">
      <a class="video-review__product-image" href="{{ variant.url | default: product.url | escape }}" tabindex="-1" aria-hidden="true">
        {% if variant_image != blank %}
          {{ variant_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '80, 160, 240', sizes: '80px', alt: '' }}
        {% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
      </a>
    </template>
  {% endfor %}
  <div class="video-review__product-actions">
    {% if product.requires_selling_plan %}
      {% assign purchase_label = 'products.choose_options' | t %}
      {% render 'theme-button', label: purchase_label, url: product.url, variant: 'primary' %}
    {% else %}
      <product-buy-buttons data-product-buy-buttons data-section-id="{{ scope }}" data-current-variant-id="{{ current_variant.id }}" data-variant-available="{{ current_variant.available }}" data-add-to-cart-label="{{ add_label | escape }}" data-sold-out-label="{{ sold_label | escape }}" data-unavailable-label="{{ unavailable_label | escape }}">
        <form id="{{ form_id }}" action="{{ routes.cart_add_url }}" method="post" data-product-form data-add-to-cart-label="{{ add_label | escape }}" data-add-to-cart-show-price="false">
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>
          <input type="hidden" name="quantity" data-quantity-input value="{{ current_variant.quantity_rule.min | default: 1 }}">
          {% render 'theme-button', type: 'submit', label: button_label, disabled: unavailable, variant: 'primary', class: 'product-form__submit product-card__action', attributes: 'data-add-to-cart-button', loading_dots: true %}
        </form>
      </product-buy-buttons>
    {% endif %}
    {% capture details_content %}{{ details_label | escape }}<span class="video-review__asset-icon video-review__asset-icon--small" style="--video-review-icon: url('{{ 'video-review-details-arrow.svg' | asset_url }}');" aria-hidden="true"></span>{% endcapture %}
    <a href="{{ product.url | escape }}" class="video-review__details">{{ details_content }}</a>
  </div>
</div>
