{% doc %}
  Renders a registered icon or a defensively checked custom SVG, optionally as a link.

  The caller owns the accessible name. A link is only rendered when a label is
  provided; decorative output is hidden from assistive technology.

  @param {string} [icon] - Registered Heroicons key or a supported legacy alias
  @param {string} [svg_id] - Unique instance suffix for artwork definition IDs
  @param {string} [source] - Icon source: library or custom
  @param {string} [custom_icon] - Custom SVG markup from the Theme Editor
  @param {boolean} [bare] - Render only the SVG, without the shared wrapper
  @param {string} [url] - Optional link destination
  @param {string} [label] - Accessible name for a linked icon
  @param {boolean} [open_in_new_tab] - Whether the link opens in a new tab
  @param {number} [width] - Icon width in pixels
  @param {number} [padding] - Icon padding in pixels
  @param {string} [class] - Additional wrapper classes

  @example
  {% render 'icon', icon: 'arrow', width: 24 %}
{% enddoc %}

{% liquid
  assign icon_source = source | default: 'library'
  unless icon_source == 'library' or icon_source == 'custom'
    assign icon_source = 'library'
  endunless

  assign icon_name = icon | default: 'arrow-right'
  assign registered_icons = 'pencil-square|lock-closed|arrow|arrow-left|arrow-right|paper-airplane|send_malandra|bars-3|bars|grip-vertical|compare|menu|chevron|chevron-down|chevron-left|chevron-right|x-mark|close|eye|magnifying-glass|search|shopping-bag|bag|cart|shopping-cart|cube|user|users|account|truck|shipping|tag|discount|trash|remove|document-text|note|receipt-percent|coupon|share|play|pause|plus|minus|check|check-circle|x-circle|comparison-yes|comparison-no|information-circle|circle|square|triangle|diamond|star|four-stars|five-stars|calendar|calendar-days|clock|comment|chat-bubble|chat-bubble-left-right|shield-check|vertical-rule|funnel|sliders|arrow_right|long_arrow_right|chevron_right|arrow_up_right|circle_arrow|circle_chevron|long_arrow_up|double_chevron|arrow_outline|square_chevron|announcement-social-facebook|announcement-social-instagram|announcement-social-pinterest' | split: '|'
  unless registered_icons contains icon_name
    assign icon_name = 'arrow-right'
  endunless

  assign icon_width = width | default: 24 | plus: 0
  if icon_width < 8 or icon_width > 100
    assign icon_width = 24
  endif

  assign icon_padding = padding | default: 0 | plus: 0
  if icon_padding < 0 or icon_padding > 100
    assign icon_padding = 0
  endif

  assign custom_icon_markup = custom_icon | default: '' | strip
  assign custom_icon_valid = false
  if custom_icon_markup != blank
    assign custom_icon_lower = custom_icon_markup | downcase
    if custom_icon_lower contains '<svg' and custom_icon_lower contains '</svg>'
      assign custom_icon_valid = true
      if custom_icon_lower contains '<script' or custom_icon_lower contains '<foreignobject' or custom_icon_lower contains '<iframe' or custom_icon_lower contains '<object' or custom_icon_lower contains '<embed' or custom_icon_lower contains '<form' or custom_icon_lower contains '<input' or custom_icon_lower contains '<button' or custom_icon_lower contains '<a' or custom_icon_lower contains '<img' or custom_icon_lower contains '<video' or custom_icon_lower contains '<audio' or custom_icon_lower contains 'javascript:' or custom_icon_lower contains 'data:' or custom_icon_lower contains 'onload=' or custom_icon_lower contains 'onclick=' or custom_icon_lower contains 'onerror=' or custom_icon_lower contains 'onmouseover=' or custom_icon_lower contains '{{' or custom_icon_lower contains '{%'
        assign custom_icon_valid = false
      endif
    endif
  endif

  if icon_source == 'custom' and custom_icon_valid == false
    assign icon_source = 'library'
  endif

  assign icon_body = blank
  if icon_source == 'custom'
    if custom_icon_valid
      assign icon_body = custom_icon_markup
    endif
  else
    capture icon_body
      case icon_name
        when 'arrow', 'arrow-right', 'arrow_right'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)" /></svg>'
        when 'long_arrow_right'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"><path d="M2 12h20m-6-6 6 6-6 6" /></svg>'
        when 'arrow_up_right'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"><path d="M6 18 18 6M6 6h12v12" /></svg>'
        when 'circle_arrow'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"><circle cx="12" cy="12" r="9" /><path d="M8 12h8m-4-4 4 4-4 4" /></svg>'
        when 'circle_chevron'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"><circle cx="12" cy="12" r="9" /><path d="m10 8 4 4-4 4" /></svg>'
        when 'long_arrow_up'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"><path d="M12 22V2m-6 6 6-6 6 6" /></svg>'
        when 'double_chevron'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"><path d="m5 5 7 7-7 7m7-14 7 7-7 7" /></svg>'
        when 'arrow_outline'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"><path d="M3 8h9V3l9 9-9 9v-5H3Z" /></svg>'
        when 'square_chevron'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"><rect x="3" y="3" width="18" height="18" rx="1" /><path d="m10 8 4 4-4 4" /></svg>'
        when 'arrow-left'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="m10.5 4.5-7.5 7.5m0 0 7.5 7.5M3 12h18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)" /></svg>'
        when 'send_malandra'
          echo '<svg width="18" height="18" viewBox="0 -1.2219 18 18" fill="none" focusable="false" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><path d="M17.8952 0.0622624C17.8163 -0.00140993 17.709 -0.0175318 17.6149 0.0198495L14.0293 1.44484C9.48945 3.24893 4.79506 5.11449 0.177488 6.94777C0.0710128 6.99008 0.000785489 7.09273 5.97206e-06 7.20728C-0.000738112 7.3219 0.0681074 7.42547 0.17398 7.46916C1.5302 8.02853 2.88673 8.58709 4.24327 9.14569L4.84516 9.39354L7.38572 15.3847C7.43018 15.4895 7.53272 15.5562 7.64451 15.5562C7.65522 15.5562 7.66595 15.5555 7.67676 15.5543C7.75758 15.545 7.82767 15.5014 7.87288 15.4383C7.87522 15.4353 7.87787 15.4327 7.88014 15.4296L10.6049 11.7655C12.2246 12.4326 13.8443 13.0999 15.4644 13.7664C15.4988 13.7805 15.5351 13.7875 15.5714 13.7875C15.6189 13.7875 15.6663 13.7755 15.7088 13.7517C15.7838 13.7097 15.8355 13.6358 15.8491 13.551L16.1406 11.7412C16.7433 7.99905 17.3665 4.12953 17.9961 0.327156C18.0128 0.227166 17.9742 0.125935 17.8952 0.0622624ZM1.03099 7.21412C5.43993 5.46346 9.90859 3.68765 14.237 1.96754L16.666 1.00225C14.9785 2.1148 12.7774 3.61459 10.6397 5.07115C8.52438 6.51252 6.52336 7.87596 5.02867 8.86074L4.45746 8.62554C3.31526 8.15524 2.17305 7.68491 1.03099 7.21412ZM10.9565 5.53603C12.5998 4.41625 14.2807 3.27097 15.7353 2.29675L8.25505 10.3872C8.21827 10.427 8.19379 10.4766 8.18447 10.53L7.53113 14.2867L5.4095 9.28345C6.89983 8.30016 8.87286 6.95574 10.9565 5.53603ZM8.12434 14.1586L8.67851 10.9723C9.14172 11.1631 9.60504 11.3537 10.0683 11.5445L8.12434 14.1586ZM15.5853 11.6518L15.3502 13.1111C13.214 12.2322 11.0781 11.3524 8.94223 10.4725L17.2313 1.50727C16.673 4.89863 16.1211 8.3256 15.5853 11.6518Z" fill="#181818"/></svg>'
        when 'paper-airplane'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="m3 4.5 18 7.5-18 7.5L7.5 12 3 4.5Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"/><path d="M7.5 12H21" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"/></svg>'
        when 'calendar'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="M6.75 3v2.25M17.25 3v2.25M3.75 9h16.5M5.25 5.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25A2.25 2.25 0 0 1 18.75 21H5.25A2.25 2.25 0 0 1 3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)" /></svg>'
        when 'calendar-days'
          echo '<svg viewBox="0 0 24 24" fill="none" focusable="false" aria-hidden="true"><path d="M6.75 3v2.25M17.25 3v2.25M3.75 9h16.5M5.25 5.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25A2.25 2.25 0 0 1 18.75 21H5.25A2.25 2.25 0 0 1 3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)"/><path d="M8 12h.01M12 12h.01M16 12h.01M8 16h.01M12 16h.01M16 16h.01" stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-stroke-width)"/></svg>'
        when 'clock'
