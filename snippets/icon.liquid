        when 'announcement-social-pinterest'
          echo '<svg aria-hidden="true" focusable="false" preserveAspectRatio="none" overflow="visible" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><g><path d="M8 1.60799C9.69931 1.61683 11.3271 2.29285 12.5328 3.49039C13.5234 4.49372 14.1592 5.79308 14.3436 7.19089C14.528 8.5887 14.2509 10.0085 13.5544 11.2344C12.9945 12.2114 12.1853 13.0222 11.2094 13.584C10.2335 14.1458 9.12601 14.4384 8 14.432C7.38455 14.4359 6.77161 14.3533 6.1792 14.1864C6.5016 13.664 6.7168 13.1944 6.832 12.8032L7.2856 11.0432C7.3928 11.2592 7.6 11.4432 7.9 11.6048C8.2072 11.7584 8.5144 11.8424 8.852 11.8424C9.5208 11.8424 10.1203 11.6504 10.6504 11.2664C11.1948 10.8618 11.6197 10.3175 11.88 9.69119C12.176 8.97919 12.3232 8.21279 12.3096 7.44079C12.3096 6.44159 11.9256 5.58879 11.1656 4.85919C10.7758 4.49191 10.317 4.20564 9.81576 4.01696C9.31452 3.82827 8.78083 3.74093 8.2456 3.75999C7.5312 3.75999 6.8624 3.88319 6.2632 4.12879C5.51955 4.41116 4.87651 4.90801 4.41562 5.55633C3.95473 6.20466 3.69675 6.97525 3.6744 7.77039C3.6744 8.34639 3.7816 8.85439 4.0048 9.29199C4.22 9.72239 4.5424 10.0296 4.9808 10.2136C5.0576 10.2448 5.1264 10.2448 5.1808 10.2136C5.2336 10.1912 5.272 10.1368 5.2952 10.06L5.4336 9.53759C5.472 9.42239 5.4496 9.30719 5.3496 9.19199C5.05012 8.84527 4.89343 8.39779 4.9112 7.93999C4.90443 7.52465 4.98279 7.11232 5.14144 6.72842C5.3001 6.34452 5.53569 5.99717 5.83369 5.70778C6.1317 5.4184 6.48581 5.1931 6.8742 5.04578C7.26259 4.89846 7.67704 4.83223 8.092 4.85119C8.9296 4.85119 9.5824 5.08159 10.044 5.53519C10.512 5.99599 10.7504 6.58719 10.7504 7.31759C10.7562 7.89331 10.6706 8.46631 10.4968 9.01519C10.3614 9.48119 10.1165 9.90802 9.7824 10.26C9.4752 10.5672 9.1136 10.7208 8.7064 10.7208C8.376 10.7208 8.1072 10.6056 7.892 10.36C7.6848 10.1144 7.616 9.82239 7.692 9.49199C7.80933 9.08132 7.92987 8.67145 8.0536 8.26239L8.192 7.70159C8.2376 7.50159 8.2608 7.34079 8.2608 7.20239C8.2608 6.92559 8.184 6.69519 8.0456 6.51839C7.892 6.34239 7.6848 6.24959 7.408 6.24959C7.0624 6.24959 6.7704 6.40319 6.54 6.72559C6.3096 7.04079 6.1864 7.43999 6.1864 7.92479C6.1904 8.22399 6.2368 8.52159 6.3248 8.80799L6.3712 8.92319C5.9104 10.9056 5.6408 12.0736 5.5416 12.4112C5.4488 12.8336 5.4184 13.3336 5.4416 13.9016C4.3024 13.397 3.33352 12.5736 2.65187 11.5307C1.97021 10.4878 1.6049 9.26991 1.6 8.02399C1.6 6.25759 2.2224 4.73599 3.4744 3.49119C4.05966 2.88373 4.76316 2.40261 5.5415 2.07749C6.31985 1.75236 7.15655 1.59013 8 1.60079V1.60799Z" fill="white" fill-opacity="0.6"/></g></svg>'
      endcase
    endcapture
    assign icon_body = icon_body | strip
    if icon_name == 'elara-logo-symbol'
      assign artwork_id = svg_id | default: icon_name | handleize
      assign gradient_id = 'elara-gradient-' | append: artwork_id
      assign clip_id = 'elara-clip-' | append: artwork_id
      assign icon_body = icon_body | replace: 'paint0_linear_0_21', gradient_id | replace: 'clip0_0_21', clip_id
    endif
  endif

  if bare and class != blank and icon_body != blank
    assign bare_svg_start = '<svg class="' | append: class | append: '"'
    assign icon_body = icon_body | replace_first: '<svg', bare_svg_start
  endif

  assign icon_wrapper = 'span'
  if url != blank and label != blank
    assign icon_wrapper = 'a'
  endif
  assign icon_class = 'icon icon-renderer'
  if class != blank
    assign icon_class = icon_class | append: ' ' | append: class
  endif

  assign icon_style = blank
%}

{% if width != blank or padding != blank %}
  {% capture icon_style %}
    --icon-width: {{ icon_width }}px;
    --icon-padding: {{ icon_padding }}px;
  {% endcapture %}
  {% assign icon_style = icon_style | strip %}
{% endif %}

{% if icon_body != blank and bare and url == blank %}
  {{ icon_body }}
{% elsif icon_body != blank %}
  <{{ icon_wrapper }}
    class="{{ icon_class | strip }}"
    {% if icon_style != blank %}style="{{ icon_style }}"{% endif %}
    {% if icon_wrapper == 'a' %}
      href="{{ url | escape }}"
      aria-label="{{ label | escape }}"
      {% if open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
    {% else %}
      aria-hidden="true"
    {% endif %}
  >{{ icon_body }}</{{ icon_wrapper }}>
{% endif %}

{% stylesheet %}
  .icon-renderer {
    box-sizing: content-box;
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: var(--icon-width, var(--icon-size-medium, 20px));
    height: auto;
    max-width: 100%;
    padding: var(--icon-padding, 0px);
    color: inherit;
    line-height: 0;
    overflow: hidden;
  }

  .icon-renderer > svg {
    display: block;
    width: 100%;
    height: auto;
    max-width: none;
  }

  .icon-renderer:is(a) {
    color: inherit;
    text-decoration: none;
  }
{% endstylesheet %}
