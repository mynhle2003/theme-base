{% doc %}
  Renders a quantity control for a product form without owning the form.
  Quantity rules are read from the selected variant and refreshed when a
  parent variant picker dispatches a variant change.

  @param {variant} variant - The selected product variant.
  @param {boolean} [show_label] - Whether to render the localized label.
  @param {boolean} [show_stepper] - Whether to render increment/decrement buttons.

  @example
  {% render 'quantity-selector', variant: product.selected_or_first_available_variant %}
{% enddoc %}

{% liquid
  assign quantity_rule = variant.quantity_rule
  assign quantity_min = quantity_rule.min | default: 1
  assign quantity_max = quantity_rule.max
  assign quantity_step = quantity_rule.increment | default: 1
  assign quantity_disabled = true
  if variant.available
    assign quantity_disabled = false
  endif
%}

<quantity-selector
  class="quantity-selector"
  data-quantity-selector
  data-available="{{ variant.available }}"
  style="--quantity-control-gap: 0.5rem;"
>
  {% if show_label %}
    <label class="quantity-selector__label" for="Quantity-{{ variant.id }}">
      {{ 'products.product.quantity' | t }}
    </label>
  {% endif %}

  <div class="quantity-selector__control">
    {% if show_stepper %}
      <button
        class="quantity-selector__button"
        type="button"
        data-quantity-decrease
        aria-label="{{ 'products.product.quantity_decrease' | t }}"
        {% if quantity_disabled %}disabled{% endif %}
      >
        <span aria-hidden="true">−</span>
      </button>
    {% endif %}

    <input
      class="quantity-selector__input form__control"
      data-quantity-input
      id="Quantity-{{ variant.id }}"
      type="number"
      name="quantity"
      value="{{ quantity_min }}"
      min="{{ quantity_min }}"
      step="{{ quantity_step }}"
      {% if quantity_max != blank %}max="{{ quantity_max }}"{% endif %}
      inputmode="numeric"
      {% if quantity_disabled %}disabled{% endif %}
      aria-label="{{ 'products.product.quantity' | t }}"
    >

    {% if show_stepper %}
      <button
        class="quantity-selector__button"
        type="button"
        data-quantity-increase
        aria-label="{{ 'products.product.quantity_increase' | t }}"
        {% if quantity_disabled %}disabled{% endif %}
      >
        <span aria-hidden="true">+</span>
      </button>
    {% endif %}
  </div>
</quantity-selector>

{% stylesheet %}
  .quantity-selector {
    display: grid;
    gap: var(--quantity-control-gap, 0.5rem);
    max-width: 100%;
  }

  .quantity-selector__label {
    color: var(--color-text);
    font-size: var(--font-body-sm);
  }

  .quantity-selector__control {
    align-items: center;
    display: inline-flex;
    max-width: 100%;
    width: fit-content;
  }

  .quantity-selector__button {
    align-items: center;
    background: var(--input-background-color);
    border: var(--input-border-width) solid var(--input-border-color);
    color: var(--color-text);
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    justify-content: center;
    min-height: var(--input-height);
    min-width: var(--input-height);
    padding: 0.5rem;
  }

  .quantity-selector__button:first-child { border-radius: var(--input-radius) 0 0 var(--input-radius); }
  .quantity-selector__button:last-child { border-radius: 0 var(--input-radius) var(--input-radius) 0; }
  .quantity-selector__button:focus-visible { outline: 2px solid var(--input-focus-color); outline-offset: 2px; z-index: 1; }
  .quantity-selector__button:disabled { cursor: not-allowed; opacity: 0.5; }

  .quantity-selector__input {
    border-radius: 0;
    min-width: 4.5rem;
    text-align: center;
    width: 5rem;
  }

  .quantity-selector__input:focus-visible { position: relative; z-index: 1; }

  @media screen and (max-width: 749px) {
    .quantity-selector__button { min-height: var(--input-height-mobile); min-width: var(--input-height-mobile); }
  }
{% endstylesheet %}

{% javascript %}
  class QuantitySelector extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized === 'true') return;

      this.dataset.initialized = 'true';
      this.input = this.querySelector('[data-quantity-input]') || this.querySelector('input[name="quantity"]');
      this.decreaseButton = this.querySelector('[data-quantity-decrease]');
      this.increaseButton = this.querySelector('[data-quantity-increase]');
      this.form = this.closest('form');

      this.decreaseButton?.addEventListener('click', () => this.changeBy(-1));
      this.increaseButton?.addEventListener('click', () => this.changeBy(1));
      this.input?.addEventListener('change', () => this.normalize());
      this.form?.addEventListener('variant:change', (event) => this.updateVariant(event.detail.variant));
      this.updateButtons();
    }

    get min() {
      return Number(this.input?.min || 1);
    }

    get max() {
      return this.input?.max ? Number(this.input.max) : null;
    }

    get step() {
      return Number(this.input?.step || 1);
    }

    setValue(value, emitEvents = true) {
      if (!this.input) return;

      const steppedValue = this.min + Math.round((value - this.min) / this.step) * this.step;
      const nextValue = Math.max(this.min, this.max === null ? steppedValue : Math.min(this.max, steppedValue));
      this.input.value = String(nextValue);
      if (emitEvents) {
        this.input.dispatchEvent(new Event('input', { bubbles: true }));
        this.input.dispatchEvent(new Event('change', { bubbles: true }));
      }
      this.updateButtons();
    }

    changeBy(direction) {
      const currentValue = Number(this.input?.value || this.min);
      this.setValue(currentValue + direction * this.step);
    }

    normalize() {
      const currentValue = Number(this.input?.value || this.min);
      this.setValue(Number.isFinite(currentValue) ? currentValue : this.min, false);
    }

    updateButtons() {
      const currentValue = Number(this.input?.value || this.min);
      if (this.decreaseButton) this.decreaseButton.disabled = this.input?.disabled || currentValue <= this.min;
      if (this.increaseButton) this.increaseButton.disabled = this.input?.disabled || (this.max !== null && currentValue >= this.max);
    }

    updateVariant(variant) {
      if (!this.input) return;

      if (!variant) {
        this.input.disabled = true;
        this.dataset.available = 'false';
        this.updateButtons();
        return;
      }

      const quantityRule = variant.quantity_rule || {};
      this.input.min = String(quantityRule.min || 1);
      this.input.step = String(quantityRule.increment || 1);
      if (quantityRule.max) {
        this.input.max = String(quantityRule.max);
      } else {
        this.input.removeAttribute('max');
      }

      this.input.disabled = !variant.available;
      this.dataset.available = String(Boolean(variant.available));
      this.normalize();
      this.updateButtons();
    }
  }

  if (!customElements.get('quantity-selector')) customElements.define('quantity-selector', QuantitySelector);
{% endjavascript %}
