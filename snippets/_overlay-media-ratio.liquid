{% doc %}
  Normalizes an overlay media ratio setting and returns a compact
  `setting|ratio` pair for the caller to split.

  @param {string} [setting] - Ratio preset: auto, square, portrait,
    landscape, wide, or custom
  @param {string} [fallback] - Preset used when the setting is invalid
  @param {number} [custom_width] - Custom ratio width
  @param {number} [custom_height] - Custom ratio height
  @param {string} [fallback_ratio] - Ratio value used for invalid custom input
{% enddoc %}

{% liquid
  assign overlay_ratio_setting = setting | default: fallback | default: 'auto'
  if overlay_ratio_setting == 'original'
    assign overlay_ratio_setting = 'auto'
  endif
  assign overlay_ratio_fallback = fallback | default: 'auto'
  unless overlay_ratio_setting == 'auto' or overlay_ratio_setting == 'square' or overlay_ratio_setting == 'portrait' or overlay_ratio_setting == 'landscape' or overlay_ratio_setting == 'wide' or overlay_ratio_setting == 'custom' or overlay_ratio_setting == 'ratio_1_1' or overlay_ratio_setting == 'ratio_4_5' or overlay_ratio_setting == 'ratio_5_4' or overlay_ratio_setting == 'ratio_6_7' or overlay_ratio_setting == 'ratio_7_6' or overlay_ratio_setting == 'ratio_5_7' or overlay_ratio_setting == 'ratio_7_5' or overlay_ratio_setting == 'ratio_2_3' or overlay_ratio_setting == 'ratio_3_2' or overlay_ratio_setting == 'ratio_4_3' or overlay_ratio_setting == 'ratio_3_4' or overlay_ratio_setting == 'ratio_2_1' or overlay_ratio_setting == 'ratio_1_2' or overlay_ratio_setting == 'ratio_16_9' or overlay_ratio_setting == 'ratio_9_16' or overlay_ratio_setting == 'ratio_12_5' or overlay_ratio_setting == 'ratio_5_12' or overlay_ratio_setting == 'ratio_48_17' or overlay_ratio_setting == 'ratio_17_48' or overlay_ratio_setting == 'ratio_5_8' or overlay_ratio_setting == 'ratio_8_5'
    assign overlay_ratio_setting = overlay_ratio_fallback
  endunless

  assign overlay_ratio = fallback_ratio | default: 'auto'
  case overlay_ratio_setting
    when 'ratio_1_1'
      assign overlay_ratio = '1 / 1'
    when 'ratio_4_5'
      assign overlay_ratio = '4 / 5'
    when 'ratio_5_4'
      assign overlay_ratio = '5 / 4'
    when 'ratio_6_7'
      assign overlay_ratio = '6 / 7'
    when 'ratio_7_6'
      assign overlay_ratio = '7 / 6'
    when 'ratio_5_7'
      assign overlay_ratio = '5 / 7'
    when 'ratio_7_5'
      assign overlay_ratio = '7 / 5'
    when 'ratio_2_3'
      assign overlay_ratio = '2 / 3'
    when 'ratio_3_2'
      assign overlay_ratio = '3 / 2'
    when 'ratio_4_3'
      assign overlay_ratio = '4 / 3'
    when 'ratio_3_4'
      assign overlay_ratio = '3 / 4'
    when 'ratio_2_1'
      assign overlay_ratio = '2 / 1'
    when 'ratio_1_2'
      assign overlay_ratio = '1 / 2'
    when 'ratio_16_9'
      assign overlay_ratio = '16 / 9'
    when 'ratio_9_16'
      assign overlay_ratio = '9 / 16'
    when 'ratio_12_5'
      assign overlay_ratio = '12 / 5'
    when 'ratio_5_12'
      assign overlay_ratio = '5 / 12'
    when 'ratio_48_17'
      assign overlay_ratio = '48 / 17'
    when 'ratio_17_48'
      assign overlay_ratio = '17 / 48'
    when 'ratio_5_8'
      assign overlay_ratio = '5 / 8'
    when 'ratio_8_5'
      assign overlay_ratio = '8 / 5'
    when 'auto'
      assign overlay_ratio = 'auto'
    when 'square'
      assign overlay_ratio = '1'
    when 'portrait'
      assign overlay_ratio = '0.8'
    when 'landscape'
      assign overlay_ratio = '1.3333'
    when 'wide'
      assign overlay_ratio = '1.7778'
    when 'custom'
      assign overlay_ratio_width = custom_width | default: 1 | plus: 0
      assign overlay_ratio_height = custom_height | default: 1 | plus: 0
      if overlay_ratio_width < 1 or overlay_ratio_width > 100
        assign overlay_ratio_width = 1
      endif
      if overlay_ratio_height < 1 or overlay_ratio_height > 100
        assign overlay_ratio_height = 1
      endif
      assign overlay_ratio = overlay_ratio_width | times: 1.0 | divided_by: overlay_ratio_height
      if overlay_ratio < 0.25 or overlay_ratio > 3
        assign overlay_ratio = fallback_ratio | default: '1'
      endif
  endcase

  echo overlay_ratio_setting
  echo '|'
  echo overlay_ratio
%}
