{% doc %}
  Emits each font-face once when typography roles share a font or button weight.
  @param {object} [body_font] - Primary font
  @param {object} [heading_font] - Heading font
  @param {object} [accent_font] - Accent font
  @param {object} [button_font] - Resolved button font variant
  @param {object} [badge_font] - Resolved badge font variant
  @param {object} [product_card_title_font] - Resolved card title font variant
{% enddoc %}
{%- capture font_faces -%}
  {%- if button_font != blank -%}{{- button_font | font_face: font_display: 'swap' -}}<!-- font-face -->{%- endif -%}
  {%- if badge_font != blank -%}{{- badge_font | font_face: font_display: 'swap' -}}<!-- font-face -->{%- endif -%}
  {%- if product_card_title_font != blank -%}{{- product_card_title_font | font_face: font_display: 'swap' -}}<!-- font-face -->{%- endif -%}
  {%- # Loads font variants with display: swap. -%}
  {%- if body_font != blank -%}
    {{- body_font | font_face: font_display: 'swap' -}}<!-- font-face -->
    {{- body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' -}}<!-- font-face -->
    {{- body_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' -}}<!-- font-face -->
    {{- body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' -}}<!-- font-face -->
  {%- endif -%}
  {%- if heading_font != blank -%}
    {{- heading_font | font_face: font_display: 'swap' -}}<!-- font-face -->
    {{- heading_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' -}}<!-- font-face -->
  {%- endif -%}
  {%- if accent_font != blank -%}
    {{- accent_font | font_face: font_display: 'swap' -}}<!-- font-face -->
    {{- accent_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' -}}<!-- font-face -->
  {%- endif -%}

{%- endcapture -%}
{%- assign unique_font_faces = font_faces | split: '<!-- font-face -->' | uniq -%}
{%- for face in unique_font_faces -%}
  {%- if face contains 'Kaisei Decol' and face contains 'font-weight: 400' and face contains 'font-style: normal' -%}
    {%- assign ranged_face = face | replace: '}', 'unicode-range: U+0250-02FF,U+0370-1DFF,U+2070-209F,U+20D0-20FF,U+2150-218F,U+2300-FEFE,U+FF00-FFFC,U+20000-2FFFF;}' -%}
    {{- ranged_face -}}
  {%- else -%}
    {{- face -}}
  {%- endif -%}
{%- endfor -%}

{% comment %}Exact Latin subset of the selected Kaisei Decol regular font.
  Later, range-specific faces win for Latin; Shopify's full face remains the
  fallback for Japanese and other characters. See the bundled OFL license.{% endcomment %}
{% if heading_font.family contains 'Kaisei Decol' or body_font.family contains 'Kaisei Decol' or accent_font.family contains 'Kaisei Decol' %}
  @font-face {
    font-family: 'Kaisei Decol';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ 'kaisei-decol-latin-400.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0000-024F, U+0300-036F, U+1E00-1EFF, U+2000-206F, U+20A0-20CF, U+2100-214F, U+2190-22FF, U+FEFF, U+FFFD;
  }
{% endif %}
