{% doc %}
  Emits each font-face once when typography roles share a font.
  @param {object} [body_font] - Primary font
  @param {object} [heading_font] - Heading font
  @param {object} [accent_font] - Accent font
  @param {object} [button_font] - Resolved button font variant
  @param {object} [badge_font] - Resolved badge font variant
{% enddoc %}
{%- capture font_faces -%}
  {%- # Loads font variants with display: swap. -%}
  {%- if body_font != blank -%}
    {{- body_font | font_face: font_display: 'swap' -}}<!-- font-face -->
    {{- body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' -}}<!-- font-face -->
    {{- body_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' -}}<!-- font-face -->
    {{- body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' -}}<!-- font-face -->
  {%- endif -%}
  {%- if heading_font != blank -%}
    {{- heading_font | font_face: font_display: 'swap' -}}<!-- font-face -->
    {{- heading_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' -}}<!-- font-face -->
  {%- endif -%}
  {%- if accent_font != blank -%}
    {{- accent_font | font_face: font_display: 'swap' -}}<!-- font-face -->
    {{- accent_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' -}}<!-- font-face -->
  {%- endif -%}

  {%- if button_font != blank -%}
    {{- button_font | font_face: font_display: 'swap' -}}<!-- font-face -->
  {%- endif -%}
  {%- if badge_font != blank -%}
    {{- badge_font | font_face: font_display: 'swap' -}}<!-- font-face -->
  {%- endif -%}
{%- endcapture -%}
{{- font_faces | split: '<!-- font-face -->' | uniq | join: '' -}}
