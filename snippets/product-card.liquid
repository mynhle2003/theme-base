{% doc %}
  Renders a reusable product card for collection, search and recommendation surfaces.

  @param {product} product - The product to render.
  @param {string} [class] - Optional class for the card wrapper.
  @param {boolean} [show_quick_add] - Whether to render the progressive-enhancement add form.

  @example
  {% render 'product-card', product: product %}
{% enddoc %}

{% liquid
  assign card_class = 'product-card product-card--' | append: settings.product_card_style | append: ' color-' | append: settings.product_card_color_scheme | append: ' ' | append: class
  assign image_width = 800
  assign image_height = 800
  assign image_ratio = 'auto'
  assign title_font_family = 'var(--font-heading-family)'
  assign card_shadow = 'none'
  assign card_swatch_height_ratio = 1
  assign product_card_swatch_limit = settings.product_card_swatch_limit | default: 3

  if settings.product_card_title_font == 'body'
    assign title_font_family = 'var(--font-body-family)'
  endif

  case settings.product_card_shadow
    when 'subtle'
      assign card_shadow = '0 2px 8px rgb(0 0 0 / 0.08)'
    when 'medium'
      assign card_shadow = '0 8px 24px rgb(0 0 0 / 0.12)'
    when 'strong'
      assign card_shadow = '0 12px 36px rgb(0 0 0 / 0.18)'
  endcase

  case settings.product_card_image_ratio
    when 'square'
      assign image_height = 800
      assign image_ratio = '1 / 1'
    when 'portrait'
      assign image_height = 1000
      assign image_ratio = '4 / 5'
    when 'landscape'
      assign image_height = 600
      assign image_ratio = '4 / 3'
  endcase

  case settings.product_card_swatch_height_ratio
    when '3:2'
      assign card_swatch_height_ratio = 0.6667
    when '2:1'
      assign card_swatch_height_ratio = 0.5
    when '3:1'
      assign card_swatch_height_ratio = 0.3333
  endcase
%}

<article
  class="{{ card_class | strip }}{% unless settings.product_card_quick_add_mobile %} product-card--quick-add-hidden-mobile{% endunless %}"
  style="--pcard-border-thickness: {{ settings.product_card_border_thickness | default: 0 }}px; --pcard-shadow: {{ card_shadow }}; --pcard-content-spacing: {{ settings.product_card_content_spacing_desktop | default: 20 }}px; --pcard-content-spacing-mobile: {{ settings.product_card_content_spacing_mobile | default: 16 }}px; --pcard-content-gap: {{ settings.product_card_content_gap_desktop | default: 14 }}px; --pcard-content-gap-mobile: {{ settings.product_card_content_gap_mobile | default: 12 }}px; --pcard-info-gap: {{ settings.product_card_info_gap_desktop | default: 4 }}px; --pcard-info-gap-mobile: {{ settings.product_card_info_gap_mobile | default: 4 }}px; --pcard-title-font-family: {{ title_font_family }}; --pcard-title-size: {{ settings.product_card_title_size | default: 20 }}px; --pcard-title-size-mobile: {{ settings.product_card_title_size_mobile | default: 18 }}px; --pcard-title-line-limit: {{ settings.product_card_title_line_limit | default: 'none' }}; --pcard-image-ratio: {{ image_ratio }}; --pcard-alignment: {{ settings.product_card_alignment | default: 'left' }}; --pcard-swatch-width: {{ settings.product_card_swatch_width | default: 30 }}px; --pcard-swatch-width-mobile: {{ settings.product_card_swatch_width_mobile | default: 30 }}px; --pcard-swatch-height-ratio: {{ card_swatch_height_ratio }}; --pcard-swatch-item-gap: {{ settings.product_card_swatch_item_gap | default: 8 }}px;"
>
  <a class="product-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {% if product.featured_image %}
      {% if settings.product_card_image_ratio == 'original' %}
        {{ product.featured_image | image_url: width: image_width | image_tag: class: 'product-card__image product-card__image--primary', loading: 'lazy' }}
      {% else %}
        {{ product.featured_image | image_url: width: image_width, height: image_height, crop: 'center' | image_tag: class: 'product-card__image product-card__image--primary', loading: 'lazy' }}
      {% endif %}
      {% if settings.product_card_show_second_image and product.images[1] %}
        {% if settings.product_card_image_ratio == 'original' %}
          {{ product.images[1] | image_url: width: image_width | image_tag: class: 'product-card__image product-card__image--secondary', loading: 'lazy' }}
        {% else %}
          {{ product.images[1] | image_url: width: image_width, height: image_height, crop: 'center' | image_tag: class: 'product-card__image product-card__image--secondary', loading: 'lazy' }}
        {% endif %}
      {% endif %}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'product-card__image product-card__image--placeholder' }}
    {% endif %}

    {% render 'product-badge', product: product, show_sale_badge: settings.product_card_show_sale_badge, show_sold_out_badge: settings.product_card_show_sold_out_badge %}
  </a>

  <div class="product-card__content">
    <div class="product-card__details">
      {% if settings.product_card_show_vendor and product.vendor != blank %}
        <p class="product-card__vendor body-xs">{{ product.vendor | escape }}</p>
      {% endif %}

      {% if settings.product_card_show_product_type and product.type != blank %}
        <p class="product-card__type body-xs">{{ product.type | escape }}</p>
      {% endif %}

      <h3 class="product-card__title">
        <a href="{{ product.url }}">{{ product.title | escape }}</a>
      </h3>

      {% render 'price', item: product, show_from: true %}

      {% if settings.product_card_show_swatches and settings.swatch_enabled %}
        {% assign swatch_option_name = settings.swatch_option_name | downcase | strip %}
        {% for option in product.options_with_values %}
          {% assign current_option_name = option.name | downcase | strip %}
          {% if current_option_name == swatch_option_name %}
            {% assign option_index = option.position | minus: 1 %}
            <div class="product-card__swatches product-card__swatches--{{ settings.product_card_swatch_position | default: 'top' }}" aria-label="{{ option.name | escape }}">
              {% for value in option.values limit: product_card_swatch_limit %}
                {% assign value_label = value.label | default: value %}
                {% assign swatch_variant = blank %}
                {% for variant in product.variants %}
                  {% if variant.options[option_index] == value_label and variant.available %}
                    {% assign swatch_variant = variant %}
                    {% break %}
                  {% endif %}
                {% endfor %}
                {% if swatch_variant == blank %}
                  {% for variant in product.variants %}
                    {% if variant.options[option_index] == value_label %}
                      {% assign swatch_variant = variant %}
                      {% break %}
                    {% endif %}
                  {% endfor %}
                {% endif %}
                <a href="{{ product.url }}?variant={{ swatch_variant.id }}" aria-label="{{ value_label | escape }}">
                  {% render 'swatch', label: value_label, swatch: value.swatch, variant_image: swatch_variant.featured_image, swatch_type: settings.product_card_swatch_type, selected_style: settings.product_card_swatch_selected_style, width: settings.product_card_swatch_width, width_mobile: settings.product_card_swatch_width_mobile, height_ratio: card_swatch_height_ratio %}
                </a>
              {% endfor %}
            </div>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>

    {% if show_quick_add and settings.product_card_enable_quick_add %}
      {% if product.available %}
        {% assign quick_add_class = 'product-card__quick-add color-' | append: settings.product_card_quick_add_color_scheme %}
        {% form 'product', product, class: quick_add_class %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button class="product-card__quick-add-button{% if settings.product_card_quick_add_button_style == 'icon' %} product-card__quick-add-button--icon{% endif %}{% if settings.product_card_quick_add_full_width %} product-card__quick-add-button--full-width{% endif %}" type="submit"{% if settings.product_card_quick_add_button_style == 'icon' %} aria-label="{{ 'products.product.add_to_cart' | t }}"{% endif %}>
            {% if settings.product_card_quick_add_button_style == 'icon' %}
              <span aria-hidden="true">+</span>
            {% else %}
              {{ 'products.product.add_to_cart' | t }}
            {% endif %}
          </button>
        {% endform %}
      {% endif %}
    {% endif %}
  </div>
</article>

{% stylesheet %}
  .product-card {
    align-items: stretch;
    display: flex;
    flex-direction: column;
    gap: var(--pcard-content-spacing);
    min-width: 0;
    text-align: var(--pcard-alignment);
  }

  .product-card__media {
    background: var(--color-background);
    color: inherit;
    display: block;
    overflow: hidden;
    position: relative;
    border-radius: var(--media-radius);
    text-decoration: none;
  }

  .product-card__image {
    aspect-ratio: var(--pcard-image-ratio, 1 / 1);
    height: auto;
    object-fit: cover;
    transition: opacity var(--motion-duration-fast) var(--motion-ease);
    width: 100%;
  }

  .product-card__image--secondary {
    inset: 0;
    opacity: 0;
    position: absolute;
  }

  .product-card__media:hover .product-card__image--secondary,
  .product-card__media:focus-visible .product-card__image--secondary {
    opacity: 1;
  }

  .product-card__media:hover .product-card__image--primary,
  .product-card__media:focus-visible .product-card__image--primary {
    opacity: 0;
  }

  .product-card__content,
  .product-card__details {
    display: flex;
    flex-direction: column;
    gap: var(--pcard-content-gap);
  }

  .product-card__details { gap: var(--pcard-info-gap); }

  .product-card__vendor,
  .product-card__type {
    color: var(--color-text);
    margin: 0;
  }

  .product-card__title {
    display: -webkit-box;
    font-family: var(--pcard-title-font-family);
    font-size: var(--pcard-title-size);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--pcard-title-line-limit);
    margin: 0;
    overflow: hidden;
  }

  .product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .product-card__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--pcard-swatch-item-gap);
  }

  .product-card__swatches--top { order: -1; }
  .product-card__swatches--bottom { order: 1; }

  .product-card__swatches a {
    border-radius: var(--swatch-radius);
    display: inline-flex;
  }

  .variant-option__button-label--swatch {
    background: transparent;
    border: 0;
    min-height: auto;
    padding: 0.25rem;
  }

  .product-card__quick-add-button {
    background: var(--color-primary-button);
    border: 1px solid var(--color-primary-button-border);
    border-radius: var(--button-radius);
    color: var(--color-primary-button-label);
    cursor: pointer;
    font: inherit;
    min-height: var(--button-height);
    padding: 0.625rem 0.875rem;
    width: auto;
  }

  .product-card__quick-add-button--full-width { width: 100%; }
  .product-card__quick-add-button--icon { aspect-ratio: 1; padding: 0.5rem; width: var(--button-height); }

  .product-card__quick-add-button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .product-card--card { background: var(--color-background); border: var(--pcard-border-thickness) solid var(--color-border); border-radius: var(--card-radius); box-shadow: var(--pcard-shadow); padding: var(--pcard-content-spacing); }

  @media screen and (max-width: 749px) {
    .product-card { --pcard-content-spacing: var(--pcard-content-spacing-mobile); --pcard-content-gap: var(--pcard-content-gap-mobile); --pcard-info-gap: var(--pcard-info-gap-mobile); }
    .product-card__title { font-size: var(--pcard-title-size-mobile); }
    .product-card--quick-add-hidden-mobile .product-card__quick-add { display: none; }
  }
{% endstylesheet %}
