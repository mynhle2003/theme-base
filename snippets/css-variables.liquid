{% liquid
  assign default_color_scheme = settings.default_color_scheme
  assign active_background = '#FFFFFF'
  assign active_foreground = '#1C1B1A'
  assign body_font = settings.font_body_family
  assign heading_font = settings.font_heading_family | default: body_font
  assign accent_font = settings.font_accent_family | default: body_font

  if default_color_scheme != blank
    assign active_background = default_color_scheme.settings.background
    assign active_foreground = default_color_scheme.settings.text
  endif
%}

{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ heading_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ accent_font | font_face: font_display: 'swap' }}

  :root {
    --font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    --font-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --font-accent-family: {{ accent_font.family }}, {{ accent_font.fallback_families }};
    --font-body-style: {{ body_font.style }};
    --font-body-weight: {{ body_font.weight }};
    --font-heading-weight: {{ heading_font.weight }};
    --font-heading-xs: {{ settings.heading_h6_size | default: 20 }}px;
    --font-heading-sm: {{ settings.heading_h5_size | default: 24 }}px;
    --font-heading-md: {{ settings.heading_h4_size | default: 32 }}px;
    --font-heading-lg: {{ settings.heading_h3_size | default: 40 }}px;
    --font-heading-xl: {{ settings.heading_h2_size | default: 56 }}px;
    --font-heading-display: {{ settings.heading_h1_size | default: 72 }}px;
    --font-heading-xs-mobile: {{ settings.heading_h6_size_mobile | default: 18 }}px;
    --font-heading-sm-mobile: {{ settings.heading_h5_size_mobile | default: 20 }}px;
    --font-heading-md-mobile: {{ settings.heading_h4_size_mobile | default: 24 }}px;
    --font-heading-lg-mobile: {{ settings.heading_h3_size_mobile | default: 28 }}px;
    --font-heading-xl-mobile: {{ settings.heading_h2_size_mobile | default: 36 }}px;
    --font-heading-display-mobile: {{ settings.heading_h1_size_mobile | default: 44 }}px;
    --font-body-md: {{ settings.body_base_size | default: 18 }}px;
    --font-body-md-mobile: {{ settings.body_base_size_mobile | default: settings.body_base_size | default: 14 }}px;
    --font-body-xs: calc(var(--font-body-md) * 5 / 7);
    --font-body-sm: calc(var(--font-body-md) * 6 / 7);
    --font-body-lg: calc(var(--font-body-md) * 8 / 7);
    --font-body-xl: calc(var(--font-body-md) * 9 / 7);
    --font-body-xxl: calc(var(--font-body-md) * 10 / 7);
    --font-heading-h1-line-height: {% case settings.heading_h1_line_height %}{% when 'normal' %}1.3{% when 'relaxed' %}1.5{% else %}1.1{% endcase %};
    --font-heading-h2-line-height: {% case settings.heading_h2_line_height %}{% when 'normal' %}1.3{% when 'relaxed' %}1.5{% else %}1.1{% endcase %};
    --font-heading-h3-line-height: {% case settings.heading_h3_line_height %}{% when 'normal' %}1.3{% when 'relaxed' %}1.5{% else %}1.1{% endcase %};
    --font-heading-h4-line-height: {% case settings.heading_h4_line_height %}{% when 'normal' %}1.3{% when 'relaxed' %}1.5{% else %}1.1{% endcase %};
    --font-heading-h5-line-height: {% case settings.heading_h5_line_height %}{% when 'normal' %}1.3{% when 'relaxed' %}1.5{% else %}1.1{% endcase %};
    --font-heading-h6-line-height: {% case settings.heading_h6_line_height %}{% when 'normal' %}1.3{% when 'relaxed' %}1.5{% else %}1.1{% endcase %};
    --font-heading-letter-spacing: {% case settings.heading_letter_spacing %}{% when 'tight' %}-0.02em{% when 'relaxed' %}0.02em{% else %}0{% endcase %};
    --font-body-line-height: {% case settings.body_line_height %}{% when 'normal' %}1.5{% when 'loose' %}1.8{% else %}1.65{% endcase %};
    --font-body-letter-spacing: {% case settings.body_letter_spacing %}{% when 'tight' %}-0.01em{% when 'relaxed' %}0.02em{% else %}0{% endcase %};
    --font-eyebrow-size: {{ settings.eyebrow_font_size | default: 14 }}px;
    --font-eyebrow-line-height: {% case settings.eyebrow_line_height %}{% when 'normal' %}1.3{% when 'relaxed' %}1.5{% else %}1.1{% endcase %};
    --font-eyebrow-letter-spacing: {% case settings.eyebrow_letter_spacing %}{% when 'relaxed' %}0.02em{% when 'loose' %}0.06em{% when 'extra_loose' %}0.12em{% else %}0{% endcase %};
    --font-eyebrow-text-transform: {% if settings.eyebrow_text_case == 'uppercase' %}uppercase{% else %}none{% endif %};
    --font-heading-h1-text-transform: {% case settings.heading_h1_text_case %}{% when 'uppercase' %}uppercase{% when 'capitalize' %}capitalize{% else %}none{% endcase %};
    --font-heading-h2-text-transform: {% case settings.heading_h2_text_case %}{% when 'uppercase' %}uppercase{% when 'capitalize' %}capitalize{% else %}none{% endcase %};
    --font-heading-h3-text-transform: {% case settings.heading_h3_text_case %}{% when 'uppercase' %}uppercase{% when 'capitalize' %}capitalize{% else %}none{% endcase %};
    --font-heading-h4-text-transform: {% case settings.heading_h4_text_case %}{% when 'uppercase' %}uppercase{% when 'capitalize' %}capitalize{% else %}none{% endcase %};
    --font-heading-h5-text-transform: {% case settings.heading_h5_text_case %}{% when 'uppercase' %}uppercase{% when 'capitalize' %}capitalize{% else %}none{% endcase %};
    --font-heading-h6-text-transform: {% case settings.heading_h6_text_case %}{% when 'uppercase' %}uppercase{% when 'capitalize' %}capitalize{% else %}none{% endcase %};
    --font-heading-line-height: var(--font-heading-h3-line-height);
    --font-heading-text-transform: var(--font-heading-h3-text-transform);
    --font-body-text-transform: {% case settings.body_text_case %}{% when 'uppercase' %}uppercase{% when 'capitalize' %}capitalize{% else %}none{% endcase %};
    --page-width: {{ settings.page_width | default: 1600 }}px;
    --page-margin-min: {{ settings.page_margin_min | default: 16 }}px;
    --page-margin-mobile: {{ settings.page_margin_mobile | default: 16 }}px;
    --page-margin-tablet: {{ settings.page_margin_tablet | default: 30 }}px;
    --page-margin-desktop: {{ settings.page_margin_desktop | default: 48 }}px;
    --page-margin: max(var(--page-margin-min), var(--page-margin-mobile));
    --color-background: {{ active_background }};
    --gradient-background: {{ default_color_scheme.settings.background_gradient | default: active_background }};
    --color-foreground: {{ active_foreground }};
    --color-heading: {{ default_color_scheme.settings.heading | default: active_foreground }};
    --color-heading-highlight: {{ default_color_scheme.settings.heading_highlight | default: active_foreground }};
    --color-text: {{ default_color_scheme.settings.text | default: active_foreground }};
    --color-accent: {{ default_color_scheme.settings.accent | default: active_foreground }};
    --color-border: {{ default_color_scheme.settings.border | default: '#E5E5E5' }};
    --color-primary-button: {{ default_color_scheme.settings.primary_button | default: active_foreground }};
    --color-primary-button-label: {{ default_color_scheme.settings.primary_button_label | default: active_background }};
    --color-primary-button-border: {{ default_color_scheme.settings.primary_button_border | default: active_foreground }};
    --color-secondary-button: {{ default_color_scheme.settings.secondary_button | default: active_background }};
    --color-secondary-button-label: {{ default_color_scheme.settings.secondary_button_label | default: active_foreground }};
    --color-secondary-button-border: {{ default_color_scheme.settings.secondary_button_border | default: active_foreground }};
    --color-primary-button-hover-border: {{ default_color_scheme.settings.primary_button_hover_border | default: default_color_scheme.settings.primary_button_border | default: active_foreground }};
    --color-primary-button-hover-background: {{ default_color_scheme.settings.primary_button_hover_background | default: 'transparent' }};
    --color-primary-button-hover-label: {{ default_color_scheme.settings.primary_button_hover_label | default: default_color_scheme.settings.primary_button_label | default: active_background }};
    --color-secondary-button-hover-border: {{ default_color_scheme.settings.secondary_button_hover_border | default: default_color_scheme.settings.secondary_button_border | default: active_foreground }};
    --color-secondary-button-hover-background: {{ default_color_scheme.settings.secondary_button_hover_background | default: 'transparent' }};
    --color-secondary-button-hover-label: {{ default_color_scheme.settings.secondary_button_hover_label | default: default_color_scheme.settings.secondary_button_label | default: active_foreground }};
    --color-tertiary-button-label: {{ default_color_scheme.settings.tertiary_button_label | default: active_foreground }};
    --color-shadow: {{ default_color_scheme.settings.shadow | default: active_foreground }};
    --button-radius: {% case settings.button_radius_style %}{% when 'rounded' %}8px{% when 'pill' %}999px{% else %}0px{% endcase %};
    --button-height: {{ settings.button_height_desktop | default: 48 }}px;
    --button-height-mobile: {{ settings.button_height_mobile | default: 44 }}px;
    --button-padding-inline-desktop: {{ settings.button_padding_inline_desktop | default: 28 }}px;
    --button-padding-inline-mobile: {{ settings.button_padding_inline_mobile | default: 24 }}px;
    --button-padding-inline: var(--button-padding-inline-desktop);
    --button-disabled-opacity: {{ settings.button_disabled_opacity | default: 60 | divided_by: 100.0 }};
    --button-font-size: {{ settings.button_font_size | default: 12 }}px;
    --button-letter-spacing: {% case settings.button_letter_spacing %}{% when 'relaxed' %}0.02em{% when 'loose' %}0.06em{% when 'extra_loose' %}0.12em{% else %}0{% endcase %};
    --button-primary-font-family: {% if settings.button_primary_font == 'heading' %}var(--font-heading-family){% else %}var(--font-body-family){% endif %};
    --button-secondary-font-family: {% if settings.button_secondary_font == 'heading' %}var(--font-heading-family){% else %}var(--font-body-family){% endif %};
    --button-tertiary-font-family: {% if settings.button_tertiary_font == 'heading' %}var(--font-heading-family){% else %}var(--font-body-family){% endif %};
    --button-primary-text-transform: {% if settings.button_primary_text_case == 'uppercase' %}uppercase{% else %}none{% endif %};
    --button-secondary-text-transform: {% if settings.button_secondary_text_case == 'uppercase' %}uppercase{% else %}none{% endif %};
    --button-tertiary-text-transform: {% if settings.button_tertiary_text_case == 'uppercase' %}uppercase{% else %}none{% endif %};
    --button-primary-border-width: {{ settings.button_primary_border_width | default: 1 }}px;
    --button-secondary-border-width: {{ settings.button_secondary_border_width | default: 1 }}px;
    --button-tertiary-underline-offset: {{ settings.button_tertiary_underline_offset | default: 3 }}px;
    --button-tertiary-text-decoration: {% if settings.button_tertiary_show_underline %}underline{% else %}none{% endif %};
    --input-height: {{ settings.input_height | default: 48 }}px;
    --input-height-mobile: {{ settings.input_height_mobile | default: 44 }}px;
    --input-border-width: {{ settings.input_border_width | default: 1 }}px;
    --input-radius: {{ settings.input_border_radius | default: 8 }}px;
    --input-background-color: {% if settings.input_style == 'outline' %}transparent{% else %}{{ settings.input_background_color | default: '#FFFFFF' }}{% endif %};
    --input-border-color: var(--color-border);
    --input-focus-color: var(--color-heading);
    --input-error-color: #B42318;
    --input-success-color: #1F7A4D;
    --form-label-font-family: {% case settings.form_label_font %}{% when 'heading' %}var(--font-heading-family){% when 'accent' %}var(--font-accent-family){% else %}var(--font-body-family){% endcase %};
    --form-input-font-family: {% case settings.form_input_font %}{% when 'heading' %}var(--font-heading-family){% when 'accent' %}var(--font-accent-family){% else %}var(--font-body-family){% endcase %};
    --form-helper-text-font-family: {% case settings.form_helper_text_font %}{% when 'heading' %}var(--font-heading-family){% when 'accent' %}var(--font-accent-family){% else %}var(--font-body-family){% endcase %};
    --form-error-text-font-family: {% case settings.form_error_text_font %}{% when 'heading' %}var(--font-heading-family){% when 'accent' %}var(--font-accent-family){% else %}var(--font-body-family){% endcase %};
    --variant-height: {{ settings.variant_height | default: 44 }}px;
    --variant-height-mobile: {{ settings.variant_height_mobile | default: 44 }}px;
    --variant-radius: var(--input-radius);
    --variant-group-gap: {{ settings.variant_group_gap | default: 20 }}px;
    --variant-label-spacing: {{ settings.variant_label_spacing | default: 12 }}px;
    --variant-item-gap: {{ settings.variant_gap | default: 8 }}px;
    --swatch-width: {{ settings.swatch_width | default: 40 }}px;
    --swatch-width-mobile: {{ settings.swatch_width_mobile | default: 40 }}px;
    --swatch-height-ratio: {% if settings.swatch_height_ratio_preset == '3:2' %}0.6667{% elsif settings.swatch_height_ratio_preset == '2:1' %}0.5{% elsif settings.swatch_height_ratio_preset == '3:1' %}0.3333{% else %}1{% endif %};
    --swatch-radius: var(--input-radius);
    --badge-font-size: 12px;
    --badge-radius: {% if settings.badge_radius_style == 'rounded' %}8px{% elsif settings.badge_radius_style == 'pill' %}999px{% else %}0px{% endif %};
    --badge-padding-block: 4px;
    --badge-padding-inline: 6px;
    --badge-letter-spacing: 0;
    --badge-sale-price: {{ settings.badge_sale_price | default: default_color_scheme.settings.sale_price | default: '#D82727' }};
    --badge-sale-background: {{ settings.badge_sale_background | default: '#D82727' }};
    --badge-sale-color: {{ settings.badge_sale_color | default: '#FFFFFF' }};
    --badge-sold-out-background: {{ settings.badge_sold_out_background | default: '#ADADAD' }};
    --badge-sold-out-color: {{ settings.badge_sold_out_color | default: '#181818' }};
    --badge-collection-background: var(--color-heading);
    --badge-collection-color: var(--color-background);
    --badge-custom-background: {{ settings.badge_custom_background | default: '#5E6504' }};
    --badge-custom-color: {{ settings.badge_custom_color | default: '#FFFFFF' }};
    --sale-price-color: var(--badge-sale-price);
    --icon-size: {{ settings.global_icon_size | default: 32 }}px;
    --icon-stroke-width: {{ settings.global_icon_stroke_width | default: 1.5 }}px;
    --overlay-color: {{ settings.overlay_color | default: '#000000' }};
    --overlay-opacity: {{ settings.overlay_opacity | default: 45 | divided_by: 100.0 }};
    --overlay-blur: {{ settings.overlay_blur | default: 0 }}px;
    --z-index-header: 20;
    --z-index-dropdown: 30;
    --z-index-overlay: 40;
    --z-index-modal: 50;
    --z-index-toast: 60;
    --motion-duration-fast: 120ms;
    --motion-duration: {% case settings.motion_duration %}{% when 'fast' %}120ms{% when 'slow' %}360ms{% else %}220ms{% endcase %};
    --motion-ease: cubic-bezier(0.2, 0.65, 0.3, 1);
    --card-radius: {{ settings.card_corner_radius | default: 8 }}px;
    --media-radius: {{ settings.media_corner_radius | default: 8 }}px;
  }

  @media screen and (max-width: 767.98px) {
    :root {
      --font-heading-xs: var(--font-heading-xs-mobile);
      --font-heading-sm: var(--font-heading-sm-mobile);
      --font-heading-md: var(--font-heading-md-mobile);
      --font-heading-lg: var(--font-heading-lg-mobile);
      --font-heading-xl: var(--font-heading-xl-mobile);
      --font-heading-display: var(--font-heading-display-mobile);
      --font-body-md: var(--font-body-md-mobile);
    }
  }

  {% for scheme in settings.color_schemes %}
    .color-{{ scheme.id }} {
      --color-background: {{ scheme.settings.background }};
      --gradient-background: {{ scheme.settings.background_gradient | default: scheme.settings.background }};
      --color-heading: {{ scheme.settings.heading }};
      --color-heading-highlight: {{ scheme.settings.heading_highlight | default: scheme.settings.heading }};
      --color-text: {{ scheme.settings.text }};
      --color-accent: {{ scheme.settings.accent | default: scheme.settings.text }};
      --color-foreground: {{ scheme.settings.text }};
      --color-border: {{ scheme.settings.border }};
      --color-primary-button: {{ scheme.settings.primary_button }};
      --color-primary-button-label: {{ scheme.settings.primary_button_label }};
      --color-primary-button-border: {{ scheme.settings.primary_button_border }};
      --color-secondary-button: {{ scheme.settings.secondary_button }};
      --color-secondary-button-label: {{ scheme.settings.secondary_button_label }};
      --color-secondary-button-border: {{ scheme.settings.secondary_button_border }};
      --color-primary-button-hover-border: {{ scheme.settings.primary_button_hover_border | default: scheme.settings.primary_button_border }};
      --color-primary-button-hover-background: {{ scheme.settings.primary_button_hover_background | default: 'transparent' }};
      --color-primary-button-hover-label: {{ scheme.settings.primary_button_hover_label | default: scheme.settings.primary_button_label }};
      --color-secondary-button-hover-border: {{ scheme.settings.secondary_button_hover_border | default: scheme.settings.secondary_button_border }};
      --color-secondary-button-hover-background: {{ scheme.settings.secondary_button_hover_background | default: 'transparent' }};
      --color-secondary-button-hover-label: {{ scheme.settings.secondary_button_hover_label | default: scheme.settings.secondary_button_label }};
      --color-tertiary-button-label: {{ scheme.settings.tertiary_button_label | default: scheme.settings.text }};
      --sale-price-color: {{ scheme.settings.sale_price | default: scheme.settings.text }};
      --color-shadow: {{ scheme.settings.shadow }};
    }
  {% endfor %}

  @media screen and (min-width: 750px) and (max-width: 989.98px) {
    :root {
      --page-margin: max(var(--page-margin-min), var(--page-margin-tablet));
    }
  }

  @media screen and (min-width: 990px) {
    :root {
      --page-margin: max(var(--page-margin-min), var(--page-margin-desktop));
    }
  }
{% endstyle %}
