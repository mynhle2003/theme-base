    --placeholder-background-color: color-mix(in srgb, var(--background-color) 92%, var(--body-color));
    --placeholder-fill-color: color-mix(in srgb, var(--body-color) 30%, transparent);

    --line-height-tighter: 1.1;
    --line-height-tight: 1.2;
    --line-height-normal: 1.3;
    --line-height-relaxed: 1.4;
    --line-height-loose: 1.5;
    --line-height-extra-loose: 1.6;
    --letter-spacing-extra-tight: -2px;
    --letter-spacing-super-tight: -1.5px;
    --letter-spacing-ultra-tight: -1.2px;
    --letter-spacing-tighter: -0.6px;
    --letter-spacing-tight: -0.2px;
    --letter-spacing-normal: 0em;
    --letter-spacing-relaxed: 0.1px;
    --letter-spacing-loose: 0.4px;
    --letter-spacing-extra-loose: 0.8px;
    --letter-spacing-ultra-loose: 1.2px;
    --letter-spacing-mega-loose: 2px;

    --font-body-xs: {{ body_xs_size }}px;
    --font-body-sm: {{ body_sm_size }}px;
    --font-body-size: {{ body_size }}px;
    --font-body-md: var(--font-body-size);
    --font-body-lg: {{ body_lg_size }}px;
    --font-body-xl: {{ body_xl_size }}px;
    --font-body-xxl: {{ body_xxl_size }}px;
    --font-body-line-height: {{ body_leading }};
    --font-body-letter-spacing: var(--letter-spacing-relaxed);
    --font-body-text-transform: none;
    --font-heading-xs: {{ heading_6_size_desktop }}px;
    --font-heading-sm: {{ heading_5_size_desktop }}px;
    --font-heading-md: {% render 'fluid-type-size', start: heading_4_size_mobile, end: heading_4_size_desktop, from: 375, to: 1150 %};
    --font-heading-lg: {% render 'fluid-type-size', start: heading_3_size_mobile, end: heading_3_size_desktop, from: 375, to: 1150 %};
    --font-heading-xl: {% render 'fluid-type-size', start: heading_2_size_mobile, end: heading_2_size_desktop, from: 375, to: 1150 %};
    --font-heading-display: {% render 'fluid-type-size', start: heading_1_size_mobile, end: heading_1_size_desktop, from: 375, to: 1150 %};
    --font-heading-xs-line-height: {{ heading_6_line_height }};
    --font-heading-sm-line-height: {{ heading_5_line_height }};
    --font-heading-md-line-height: {{ heading_4_line_height }};
    --font-heading-lg-line-height: {{ heading_3_line_height }};
    --font-heading-xl-line-height: {{ heading_2_line_height }};
    --font-heading-display-line-height: {{ heading_1_line_height }};
    --font-heading-xs-text-transform: {{ heading_6_text_case }};
    --font-heading-sm-text-transform: {{ heading_5_text_case }};
    --font-heading-md-text-transform: {{ heading_4_text_case }};
    --font-heading-lg-text-transform: {{ heading_3_text_case }};
    --font-heading-xl-text-transform: {{ heading_2_text_case }};
    --font-heading-display-text-transform: {{ heading_1_text_case }};
    --font-heading-custom: var(--font-heading-md);
    --font-heading-custom-line-height: var(--font-heading-md-line-height);
    --font-heading-custom-text-transform: var(--font-heading-md-text-transform);
    --font-heading-display-letter-spacing: {{ heading_1_letter_spacing }};
    --font-heading-xl-letter-spacing: {{ heading_2_letter_spacing }};
    --font-heading-lg-letter-spacing: {{ heading_3_letter_spacing }};
    --font-heading-md-letter-spacing: {{ heading_4_letter_spacing }};
    --font-heading-sm-letter-spacing: {{ heading_5_letter_spacing }};
    --font-heading-xs-letter-spacing: {{ heading_6_letter_spacing }};
    --font-heading-custom-letter-spacing: var(--font-heading-md-letter-spacing);
    --font-heading-letter-spacing: {{ heading_letter_spacing }};
    --font-eyebrow-family: var(--font-{{ settings.type_eyebrow_font | default: 'accent' }}-family);
