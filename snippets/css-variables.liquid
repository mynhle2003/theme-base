{% liquid
  assign primary_font = settings.type_primary_font
  assign body_font = primary_font
  assign button_font_weight = settings.button_font_weight | default: 'inherit'
  assign button_font_weight_allowed_values = '300|400|500|600|700|800|900' | split: '|'
  unless button_font_weight_allowed_values contains button_font_weight
    assign button_font_weight = 'inherit'
  endunless
  assign heading_font = settings.type_heading_font | default: body_font
  assign accent_font = settings.type_accent_font | default: body_font

  assign default_scheme_id = settings.default_color_scheme
  if settings.default_color_scheme.id != blank
    assign default_scheme_id = settings.default_color_scheme.id
  endif
  if default_scheme_id == blank
    assign default_scheme_id = 'scheme-1'
  endif

  assign default_background = settings.background_color | default: '#FFFFFF'
  assign default_heading = settings.foreground_color | default: '#111111'
  assign default_heading_highlight = '#A67C52'
  assign default_body = settings.foreground_color | default: '#404040'
  assign default_accent = settings.color_accent | default: '#111111'
  assign default_border = settings.color_border | default: '#D8D8D8'
  assign default_shadow = default_body
  assign default_sale_price = '#D82727'
  assign default_primary_background = default_accent
  assign default_primary_text = default_background
  assign default_primary_border = default_accent
  assign default_primary_hover_background = '#000000'
  assign default_primary_hover_text = '#FFFFFF'
  assign default_primary_hover_border = '#000000'
  assign default_secondary_background = '#ECECEC'
  assign default_secondary_text = default_accent
  assign default_secondary_border = '#ECECEC'
  assign default_secondary_hover_background = '#D8D8D8'
  assign default_secondary_hover_text = default_accent
  assign default_secondary_hover_border = '#D8D8D8'
  assign default_tertiary_text = default_accent
  assign default_tertiary_border = 'transparent'
  assign default_tertiary_hover_background = 'transparent'
  assign default_tertiary_hover_text = default_accent
  assign default_tertiary_hover_border = 'transparent'

  for scheme in settings.color_schemes
    if scheme.id == default_scheme_id
      assign default_background = scheme.settings.background | default: default_background
      assign default_heading = scheme.settings.heading | default: default_heading
      assign default_heading_highlight = scheme.settings.heading_highlight | default: default_heading_highlight
      assign default_body = scheme.settings.text | default: default_body
      assign default_accent = scheme.settings.accent | default: default_accent
      assign default_border = scheme.settings.border | default: default_border
      assign default_shadow = scheme.settings.shadow | default: default_shadow
      assign default_sale_price = scheme.settings.sale_price | default: default_sale_price
      assign default_primary_background = scheme.settings.button_primary_background | default: default_primary_background
      assign default_primary_text = scheme.settings.button_primary_text | default: default_primary_text
      assign default_primary_border = scheme.settings.button_primary_border | default: default_primary_border
      assign default_primary_hover_background = scheme.settings.button_primary_hover_background | default: default_primary_hover_background
      assign default_primary_hover_text = scheme.settings.button_primary_hover_text | default: default_primary_hover_text
      assign default_primary_hover_border = scheme.settings.button_primary_hover_border | default: default_primary_hover_border
      assign default_secondary_background = scheme.settings.button_secondary_background | default: default_secondary_background
      assign default_secondary_text = scheme.settings.button_secondary_text | default: default_secondary_text
      assign default_secondary_border = scheme.settings.button_secondary_border | default: default_secondary_border
      assign default_secondary_hover_background = scheme.settings.button_secondary_hover_background | default: default_secondary_hover_background
      assign default_secondary_hover_text = scheme.settings.button_secondary_hover_text | default: default_secondary_hover_text
      assign default_secondary_hover_border = scheme.settings.button_secondary_hover_border | default: default_secondary_hover_border
      assign default_tertiary_text = scheme.settings.button_tertiary_text | default: default_tertiary_text
      assign default_tertiary_hover_text = scheme.settings.button_tertiary_hover_text | default: default_tertiary_hover_text
    endif
  endfor

  assign default_body_rgb = default_body | color_to_rgb | remove: 'rgba(' | remove: 'rgb(' | remove: ')' | split: ',' | slice: 0, 3 | join: ' ' | strip

  assign overlay_scheme_id = settings.overlay_color_scheme | default: default_scheme_id
  if settings.overlay_color_scheme.id != blank
    assign overlay_scheme_id = settings.overlay_color_scheme.id
  endif
  assign overlay_background = default_background
  assign overlay_text_color = default_body
  assign overlay_border_color = default_border
  assign overlay_shadow_color = default_shadow
  assign overlay_color = overlay_shadow_color
  for scheme in settings.color_schemes
    if scheme.id == overlay_scheme_id
      assign overlay_background = scheme.settings.background | default: overlay_background
      assign overlay_text_color = scheme.settings.text | default: overlay_text_color
      assign overlay_border_color = scheme.settings.border | default: overlay_border_color
      assign overlay_shadow_color = scheme.settings.shadow | default: overlay_shadow_color
      assign overlay_color = overlay_shadow_color
    endif
  endfor

  assign logo_width = settings.logo_width
  if logo_width == blank
    assign logo_width = 180
  endif
  assign logo_width_mobile = settings.logo_width_mobile
  if logo_width_mobile == blank
    assign logo_width_mobile = 140
  endif
  assign page_width = settings.max_page_width | default: 1600
  assign page_width = page_width | remove: 'px' | append: 'px'
  assign page_margin_desktop = settings.layout_desktop_margin
  if page_margin_desktop == blank
    assign page_margin_desktop = 48
  endif
  assign page_margin_tablet = settings.layout_tablet_margin
  if page_margin_tablet == blank
    assign page_margin_tablet = 30
  endif
  assign mobile_margin = settings.layout_mobile_margin
  if mobile_margin == blank
    assign mobile_margin = 16
  endif
  assign section_gap = 48
  assign grid_gap = 24
  assign body_size = settings.type_body_size | default: 16
  assign body_xs_size = 12
  assign body_sm_size = 14
  assign body_lg_size = 18
  assign body_xl_size = 20
  assign body_xxl_size = 24
  assign body_leading = '1.5'
  capture body_leading
    render 'css-token-value', setting: settings.type_body_leading, values: 'normal=1.5|relaxed=1.6|loose=1.75', fallback: body_leading
  endcapture
  assign body_leading = body_leading | strip

  assign heading_weight = heading_font.weight | default: '400'
  assign heading_letter_spacing = '0px'
  capture heading_letter_spacing
    render 'css-token-value', setting: settings.type_letter_spacing, values: 'tight=-0.2px|relaxed=0.2px', fallback: heading_letter_spacing
  endcapture
  assign heading_letter_spacing = heading_letter_spacing | strip

  assign heading_1_letter_spacing = heading_letter_spacing
  assign heading_2_letter_spacing = heading_letter_spacing
  assign heading_3_letter_spacing = heading_letter_spacing
  assign heading_4_letter_spacing = heading_letter_spacing
  assign heading_5_letter_spacing = heading_letter_spacing
  assign heading_6_letter_spacing = heading_letter_spacing

  assign heading_1_size_desktop = settings.type_heading_1_size_desktop | default: 64
  assign heading_1_size_tablet = settings.type_heading_1_size_tablet | default: 52
  assign heading_1_size_mobile = settings.type_heading_1_size_mobile | default: 40
  assign heading_2_size_desktop = settings.type_heading_2_size_desktop | default: 40
  assign heading_2_size_tablet = settings.type_heading_2_size_tablet | default: 34
  assign heading_2_size_mobile = settings.type_heading_2_size_mobile | default: 30
  assign heading_3_size_desktop = settings.type_heading_3_size_desktop | default: 32
  assign heading_3_size_tablet = settings.type_heading_3_size_tablet | default: 22
  assign heading_3_size_mobile = settings.type_heading_3_size_mobile | default: 20
  assign heading_4_size_desktop = settings.type_heading_4_size_desktop | default: 24
  assign heading_4_size_mobile = settings.type_heading_4_size_mobile | default: 18
  assign heading_5_size_desktop = settings.type_heading_5_size_desktop | default: 18
  assign heading_5_size_tablet = settings.type_heading_5_size_tablet | default: 15
  assign heading_5_size_mobile = settings.type_heading_5_size_mobile | default: 15
  assign heading_6_size_desktop = settings.type_heading_6_size_desktop | default: 16
  assign heading_6_size_mobile = settings.type_heading_6_size_mobile | default: 14

  assign heading_1_line_height = '1.2'
  capture heading_1_line_height
    render 'css-token-value', setting: settings.type_heading_1_line_height, values: 'tight=1.1|normal=1.2|relaxed=1.3', fallback: heading_1_line_height
  endcapture
  assign heading_1_line_height = heading_1_line_height | strip
  assign heading_2_line_height = '1.2'
  capture heading_2_line_height
    render 'css-token-value', setting: settings.type_heading_2_line_height, values: 'tight=1.1|normal=1.2|relaxed=1.3', fallback: heading_2_line_height
  endcapture
  assign heading_2_line_height = heading_2_line_height | strip
  assign heading_2_line_height_tablet = heading_2_line_height
  assign heading_3_line_height = '1.3'
  capture heading_3_line_height
    render 'css-token-value', setting: settings.type_heading_3_line_height, values: 'tight=1.2|normal=1.3|relaxed=1.4', fallback: heading_3_line_height
  endcapture
  assign heading_3_line_height = heading_3_line_height | strip
  assign heading_4_line_height = '1.4'
  capture heading_4_line_height
    render 'css-token-value', setting: settings.type_heading_4_line_height, values: 'tight=1.3|normal=1.4|relaxed=1.5', fallback: heading_4_line_height
  endcapture
  assign heading_4_line_height = heading_4_line_height | strip
  assign heading_5_line_height = '1.5'
  capture heading_5_line_height
    render 'css-token-value', setting: settings.type_heading_5_line_height, values: 'tight=1.4|normal=1.5|relaxed=1.6', fallback: heading_5_line_height
  endcapture
  assign heading_5_line_height = heading_5_line_height | strip
  assign heading_6_line_height = '1.5'
  capture heading_6_line_height
    render 'css-token-value', setting: settings.type_heading_6_line_height, values: 'tight=1.4|normal=1.5|relaxed=1.6', fallback: heading_6_line_height
  endcapture
  assign heading_6_line_height = heading_6_line_height | strip

  assign heading_1_text_case = 'none'
  if settings.type_heading_1_case == 'uppercase'
    assign heading_1_text_case = 'uppercase'
  elsif settings.type_heading_1_case == 'capitalize'
    assign heading_1_text_case = 'capitalize'
  endif
  assign heading_2_text_case = 'none'
  if settings.type_heading_2_case == 'uppercase'
    assign heading_2_text_case = 'uppercase'
  elsif settings.type_heading_2_case == 'capitalize'
    assign heading_2_text_case = 'capitalize'
  endif
  assign heading_3_text_case = 'none'
  if settings.type_heading_3_case == 'uppercase'
    assign heading_3_text_case = 'uppercase'
  elsif settings.type_heading_3_case == 'capitalize'
    assign heading_3_text_case = 'capitalize'
  endif
  assign heading_4_text_case = 'none'
  if settings.type_heading_4_case == 'uppercase'
    assign heading_4_text_case = 'uppercase'
  elsif settings.type_heading_4_case == 'capitalize'
    assign heading_4_text_case = 'capitalize'
  endif
  assign heading_5_text_case = 'none'
  if settings.type_heading_5_case == 'uppercase'
    assign heading_5_text_case = 'uppercase'
  elsif settings.type_heading_5_case == 'capitalize'
    assign heading_5_text_case = 'capitalize'
  endif
  assign heading_6_text_case = 'none'
  if settings.type_heading_6_case == 'uppercase'
    assign heading_6_text_case = 'uppercase'
  elsif settings.type_heading_6_case == 'capitalize'
    assign heading_6_text_case = 'capitalize'
  endif

  assign eyebrow_size = settings.type_eyebrow_size | default: 12
  assign eyebrow_line_height = '1.5'
  capture eyebrow_line_height
    render 'css-token-value', setting: settings.type_eyebrow_line_height, values: 'tight=1.3|normal=1.5|relaxed=1.6', fallback: eyebrow_line_height
  endcapture
  assign eyebrow_line_height = eyebrow_line_height | strip
  assign eyebrow_letter_spacing = '0em'
  capture eyebrow_letter_spacing
    render 'css-token-value', setting: settings.type_eyebrow_letter_spacing, values: 'relaxed=0.02em|loose=0.08em|extra_loose=0.2em', fallback: eyebrow_letter_spacing
  endcapture
  assign eyebrow_letter_spacing = eyebrow_letter_spacing | strip
  assign eyebrow_text_case = 'none'
  if settings.type_eyebrow_case == 'uppercase'
    assign eyebrow_text_case = 'uppercase'
  endif

  assign motion_image_zoom = 1.04
  assign product_card_image_zoom = 1.06
  if settings.motion_image_zoom == false
    assign motion_image_zoom = 1
    assign product_card_image_zoom = 1
  endif
  assign motion_block_animations = 1
  if settings.motion_block_animations == false
    assign motion_block_animations = 0
  endif
  assign motion_block_animation = 'none'
  if motion_block_animations == 1
    assign motion_block_animation = 'motion-block-enter var(--motion-duration-standard) var(--motion-ease-standard) both'
  endif

  assign radius_badges_subheadings = 'var(--radius-square)'
  capture radius_badges_subheadings
    render 'css-token-value', setting: settings.radius_badges_subheadings, values: 'slightly_rounded=var(--radius-slight)|rounded=var(--radius-rounded)|pill=var(--radius-pill)', fallback: radius_badges_subheadings
  endcapture
  assign radius_badges_subheadings = radius_badges_subheadings | strip

  assign radius_variant_pickers = 'var(--radius-square)'
  capture radius_variant_pickers
    render 'css-token-value', setting: settings.radius_variant_pickers, values: 'slightly_rounded=var(--radius-slight)|rounded=var(--radius-rounded)|pill=var(--radius-pill)', fallback: radius_variant_pickers
  endcapture
  assign radius_variant_pickers = radius_variant_pickers | strip

  assign radius_swatches = 'var(--radius-square)'
  capture radius_swatches
    render 'css-token-value', setting: settings.radius_swatches, values: 'slightly_rounded=var(--radius-slight)|rounded=var(--radius-rounded)|pill=var(--radius-pill)', fallback: radius_swatches
  endcapture
  assign radius_swatches = radius_swatches | strip

  assign radius_navigation = 'var(--radius-square)'
  capture radius_navigation
    render 'css-token-value', setting: settings.radius_navigation, values: 'slightly_rounded=var(--radius-slight)|rounded=var(--radius-rounded)|pill=var(--radius-pill)', fallback: radius_navigation
  endcapture
  assign radius_navigation = radius_navigation | strip

  assign radius_tags = 'var(--radius-square)'
  capture radius_tags
    render 'css-token-value', setting: settings.radius_tags, values: 'slightly_rounded=var(--radius-slight)|rounded=var(--radius-rounded)|pill=var(--radius-pill)', fallback: radius_tags
  endcapture
  assign radius_tags = radius_tags | strip

  assign media_container_radius = 'var(--radius-square)'
  capture media_container_radius
    render 'css-token-value', setting: settings.radius_media_containers, values: 'slightly_rounded=var(--radius-slight)|rounded=var(--radius-rounded)|extra_rounded=var(--radius-extra)', fallback: media_container_radius
  endcapture
  assign media_container_radius = media_container_radius | strip

  assign drawer_radius = 'var(--radius-square)'
  capture drawer_radius
    render 'css-token-value', setting: settings.radius_drawers, values: 'slightly_rounded=var(--radius-slight)|rounded=var(--radius-rounded)|extra_rounded=var(--radius-extra)', fallback: drawer_radius
  endcapture
  assign drawer_radius = drawer_radius | strip

  assign overlay_close_radius = 'var(--radius-square)'
  assign settings_radius_drawers_allowed_values = 'slightly_rounded|rounded|extra_rounded' | split: '|'
  if settings_radius_drawers_allowed_values contains settings.radius_drawers
    assign overlay_close_radius = 'var(--radius-pill)'
  endif

  assign bottom_sheet_radius = 'var(--radius-square)'
  capture bottom_sheet_radius
    render 'css-token-value', setting: settings.radius_bottom_sheets, values: 'slightly_rounded=var(--radius-slight)|rounded=var(--radius-rounded)|extra_rounded=var(--radius-extra)', fallback: bottom_sheet_radius
  endcapture
  assign bottom_sheet_radius = bottom_sheet_radius | strip

  assign overlay_radius = drawer_radius
  assign border_width = settings.shape_border_width
  if border_width == blank
    assign border_width = 1
  endif
  assign icon_thickness = settings.icon_thickness
  if icon_thickness == blank
    assign icon_thickness = 100
  endif
  assign icon_thickness_scale = icon_thickness | divided_by: 100.0
  assign icon_stroke_width = icon_thickness_scale | times: 1.25

  assign button_radius = 'var(--radius-square)'
  capture button_radius
    render 'css-token-value', setting: settings.button_radius_style, values: 'slightly_rounded=var(--radius-slight)|rounded=var(--radius-rounded)|pill=var(--radius-pill)', fallback: button_radius
  endcapture
  assign button_radius = button_radius | strip

  assign icon_button_radius = 'var(--radius-square)'
  assign settings_button_radius_style_allowed_values = 'slightly_rounded|rounded|pill' | split: '|'
  if settings_button_radius_style_allowed_values contains settings.button_radius_style
    assign icon_button_radius = 'var(--radius-pill)'
  endif

  assign button_height_desktop = settings.button_height_desktop | default: 45
  assign button_height_mobile = settings.button_height_mobile | default: 45
  assign button_padding_inline_desktop = settings.button_padding_inline_desktop | default: 30
  assign button_padding_inline_mobile = settings.button_padding_inline_mobile | default: 16
  assign button_disabled_opacity = settings.button_disabled_opacity | default: 60 | divided_by: 100.0
  assign button_font_size = '13px'
  case settings.button_font_size
    when '10px', '12px', '13px', '14px', '15px', '16px'
      assign button_font_size = settings.button_font_size
  endcase
  assign button_font_size_mobile = '15px'
  case settings.button_font_size_mobile
    when '12px', '13px', '14px', '15px', '16px'
      assign button_font_size_mobile = settings.button_font_size_mobile
  endcase
  assign button_letter_spacing = '0em'
  capture button_letter_spacing
    render 'css-token-value', setting: settings.button_letter_spacing, values: 'relaxed=0.02em|loose=0.08em|reference=1.2px|extra_loose=0.14em', fallback: button_letter_spacing
  endcapture
  assign button_letter_spacing = button_letter_spacing | strip

  assign button_primary_font_family = 'var(--font-body-family)'
  if settings.button_primary_font == 'heading'
    assign button_primary_font_family = 'var(--font-heading-family)'
  endif
  assign button_secondary_font_family = 'var(--font-body-family)'
  if settings.button_secondary_font == 'heading'
    assign button_secondary_font_family = 'var(--font-heading-family)'
  endif
  assign button_tertiary_font_family = 'var(--font-body-family)'
  if settings.button_tertiary_font == 'heading'
    assign button_tertiary_font_family = 'var(--font-heading-family)'
  endif

  assign button_primary_text_case = 'uppercase'
  if settings.button_primary_text_case == 'original'
    assign button_primary_text_case = 'none'
  endif
  assign button_secondary_text_case = 'uppercase'
  if settings.button_secondary_text_case == 'original'
    assign button_secondary_text_case = 'none'
  endif
  assign button_tertiary_text_case = 'uppercase'
  if settings.button_tertiary_text_case == 'original'
    assign button_tertiary_text_case = 'none'
  endif

  assign button_primary_border_width = settings.button_primary_border_width | default: 1
  assign button_secondary_border_width = settings.button_secondary_border_width | default: 1
  assign button_tertiary_underline = 'underline'
  assign button_tertiary_underline_display = 'block'
  assign button_tertiary_underline_space = 0
  if settings.button_tertiary_show_underline == false
    assign button_tertiary_underline = 'none'
    assign button_tertiary_underline_display = 'none'
  else
    assign button_tertiary_underline_space = settings.button_tertiary_underline_offset | default: 3 | plus: 1
  endif
  assign button_tertiary_underline_offset = settings.button_tertiary_underline_offset | default: 3
  assign button_default_variant = 'primary'

  assign input_height_desktop = settings.input_height_desktop
  if input_height_desktop == blank
    assign input_height_desktop = 48
    case settings.input_height
      when 'compact'
        assign input_height_desktop = 40
      when 'large'
        assign input_height_desktop = 56
    endcase
  endif
  assign input_height_mobile = settings.input_height_mobile | default: 44
  assign input_border_width = settings.input_border_width
  if input_border_width == blank
    assign input_border_width = 1
  endif
  assign input_radius = 'var(--radius-rounded)'
  capture input_radius
    render 'css-token-value', setting: settings.input_radius_style, values: 'square=var(--radius-square)|slightly_rounded=var(--radius-slight)|pill=var(--radius-pill)', fallback: input_radius
  endcapture
  assign input_radius = input_radius | strip

  assign form_label_font_size = 'var(--font-body-md)'
  capture form_label_font_size
    render 'css-token-value', setting: settings.form_label_typography, values: 'xs=var(--font-body-xs)|sm=var(--font-body-sm)|body-sm=var(--font-body-sm)|md=var(--font-body-md)|body-md=var(--font-body-md)|lg=var(--font-body-lg)|body-lg=var(--font-body-lg)|xl=var(--font-body-xl)|xxl=var(--font-body-xxl)', fallback: form_label_font_size
  endcapture
  assign form_label_font_size = form_label_font_size | strip
  assign form_input_font_size = 'var(--font-body-md)'
  capture form_input_font_size
    render 'css-token-value', setting: settings.form_input_typography, values: 'xs=var(--font-body-xs)|sm=var(--font-body-sm)|body-sm=var(--font-body-sm)|md=var(--font-body-md)|body-md=var(--font-body-md)|lg=var(--font-body-lg)|body-lg=var(--font-body-lg)|xl=var(--font-body-xl)|xxl=var(--font-body-xxl)', fallback: form_input_font_size
  endcapture
  assign form_input_font_size = form_input_font_size | strip
  assign form_helper_font_size = 'var(--font-body-md)'
  capture form_helper_font_size
    render 'css-token-value', setting: settings.form_helper_typography, values: 'xs=var(--font-body-xs)|sm=var(--font-body-sm)|body-sm=var(--font-body-sm)|md=var(--font-body-md)|body-md=var(--font-body-md)|lg=var(--font-body-lg)|body-lg=var(--font-body-lg)|xl=var(--font-body-xl)|xxl=var(--font-body-xxl)', fallback: form_helper_font_size
  endcapture
  assign form_helper_font_size = form_helper_font_size | strip
  assign form_error_font_size = 'var(--font-body-md)'
  capture form_error_font_size
    render 'css-token-value', setting: settings.form_error_typography, values: 'xs=var(--font-body-xs)|sm=var(--font-body-sm)|body-sm=var(--font-body-sm)|md=var(--font-body-md)|body-md=var(--font-body-md)|lg=var(--font-body-lg)|body-lg=var(--font-body-lg)|xl=var(--font-body-xl)|xxl=var(--font-body-xxl)', fallback: form_error_font_size
  endcapture
  assign form_error_font_size = form_error_font_size | strip

  assign product_card_style = 'standard'
  if settings.product_card_style == 'card'
    assign product_card_style = 'card'
  endif
  assign product_card_border_width = 0
  assign product_card_shadow = 'none'
  if product_card_style == 'card'
    assign product_card_border_width = settings.product_card_border_width | default: 0
    if product_card_border_width < 0 or product_card_border_width > 3
      assign product_card_border_width = 0
    endif
    case settings.product_card_shadow
      when 'soft'
        assign product_card_shadow = '0 0.75rem 1.5rem color-mix(in srgb, var(--shadow-color) 14%, transparent)'
      when 'strong'
        assign product_card_shadow = '0 1rem 2rem color-mix(in srgb, var(--shadow-color) 22%, transparent)'
    endcase
  endif
  assign product_card_title_font_family = 'var(--font-heading-family)'
  if settings.product_card_title_font == 'body'
    assign product_card_title_font_family = 'var(--font-body-family)'
  endif
  assign product_card_title_size_desktop = settings.product_card_title_size_desktop | default: 20
  assign product_card_title_size_mobile = settings.product_card_title_size_mobile | default: 18
  assign product_card_ratio = settings.product_card_ratio | default: 'natural'
  assign product_card_image_ratio = 'auto'
  capture product_card_image_ratio
    render 'image-ratio-value', setting: product_card_ratio, fallback_ratio: 'auto', custom_width: settings.product_card_ratio_custom_width, custom_height: settings.product_card_ratio_custom_height
  endcapture
  assign product_card_image_ratio = product_card_image_ratio | strip
  assign product_card_alignment = 'left'
  capture product_card_alignment
    render 'css-token-value', setting: settings.product_card_alignment, values: 'center=center|right=right', fallback: product_card_alignment
  endcapture
  assign product_card_alignment = product_card_alignment | strip
  assign product_card_content_alignment = 'flex-start'
  capture product_card_content_alignment
    render 'css-token-value', setting: product_card_alignment, values: 'center=center|right=flex-end', fallback: product_card_content_alignment
  endcapture
  assign product_card_content_alignment = product_card_content_alignment | strip
  assign product_card_title_line_limit = 'none'
  case settings.product_card_title_line_limit
    when '1', '2', '3'
      assign product_card_title_line_limit = settings.product_card_title_line_limit
  endcase

  assign product_card_content_spacing_desktop = settings.product_card_content_spacing_desktop
  if product_card_content_spacing_desktop == blank
    assign product_card_content_spacing_desktop = 20
    case settings.product_card_gap
      when 'compact'
        assign product_card_content_spacing_desktop = 12
      when 'standard'
        assign product_card_content_spacing_desktop = 16
      when 'roomy'
        assign product_card_content_spacing_desktop = 24
    endcase
  endif
  assign product_card_content_gap_desktop = settings.product_card_content_gap_desktop | default: 14
  assign product_card_info_gap_desktop = settings.product_card_info_gap_desktop | default: 4
  assign product_card_content_spacing_mobile = settings.product_card_content_spacing_mobile | default: 16
  assign product_card_content_gap_mobile = settings.product_card_content_gap_mobile | default: 12
  assign product_card_info_gap_mobile = settings.product_card_info_gap_mobile | default: 4

  assign product_card_quick_add_enabled = 1
  if settings.product_card_quick_add_enabled == false
    assign product_card_quick_add_enabled = 0
  endif
  assign product_card_quick_add_mobile = 1
  if settings.product_card_quick_add_mobile == false
    assign product_card_quick_add_mobile = 0
  endif
  assign product_card_quick_add_style = 'text'
  if settings.product_card_quick_add_style == 'icon'
    assign product_card_quick_add_style = 'icon'
  endif
  assign product_card_quick_add_full_width = 1
  if settings.product_card_quick_add_full_width == false
    assign product_card_quick_add_full_width = 0
  endif
  assign product_card_quick_view_enabled = 1
  if settings.product_card_quick_view_enabled == false
    assign product_card_quick_view_enabled = 0
  endif
  assign product_card_quick_view_mobile = 0
  if settings.product_card_quick_view_mobile
    assign product_card_quick_view_mobile = 1
  endif

  assign product_card_secondary = 1
  if settings.product_card_secondary == false
    assign product_card_secondary = 0
  endif
  assign product_card_show_sale_badge = 1
  if settings.product_card_show_sale_badge == false
    assign product_card_show_sale_badge = 0
  endif
  assign product_card_show_sold_out_badge = 1
  if settings.product_card_show_sold_out_badge == false
    assign product_card_show_sold_out_badge = 0
  endif
  assign product_card_vendor = 0
  if settings.product_card_vendor
    assign product_card_vendor = 1
  endif
  assign product_card_type = 0
  if settings.product_card_type
    assign product_card_type = 1
  endif

  assign product_card_swatches_enabled = 1
  if settings.product_card_swatches_enabled == false
    assign product_card_swatches_enabled = 0
  endif
  assign product_card_swatch_position = 'bottom'
  if settings.product_card_swatch_position == 'top'
    assign product_card_swatch_position = 'top'
  elsif settings.product_card_swatch_position == 'inline'
    assign product_card_swatch_position = 'inline'
  endif
  assign product_card_swatch_type = 'color'
  if settings.product_card_swatch_type == 'variant_image'
    assign product_card_swatch_type = 'variant_image'
  endif
  assign product_card_swatch_limit = settings.product_card_swatch_limit | default: 4 | plus: 0
  assign product_card_swatch_gap = settings.product_card_swatch_gap | default: 8
  assign product_card_swatch_width_desktop = settings.product_card_swatch_width_desktop | default: 30
  assign product_card_swatch_width_mobile = settings.product_card_swatch_width_mobile | default: 30
  assign product_card_swatch_ratio = '3 / 1'
  capture product_card_swatch_ratio
    render 'css-token-value', setting: settings.product_card_swatch_ratio, values: '1_1=1 / 1|3_2=3 / 2|2_1=2 / 1|3_1=3 / 1', fallback: product_card_swatch_ratio
  endcapture
  assign product_card_swatch_ratio = product_card_swatch_ratio | strip
  assign product_card_swatch_selected_style = 'border'
  if settings.product_card_swatch_selected_style == 'underline'
    assign product_card_swatch_selected_style = 'underline'
  endif

  assign variant_height_desktop = settings.variant_picker_height_desktop
  if variant_height_desktop == nil
    assign variant_height_desktop = 44
  endif
  assign variant_height_mobile = settings.variant_picker_height_mobile
  if variant_height_mobile == nil
    assign variant_height_mobile = 44
  endif
  assign variant_group_gap = settings.variant_picker_group_gap
  if variant_group_gap == nil
    assign variant_group_gap = 20
  endif
  assign variant_label_spacing = settings.variant_picker_label_spacing
  if variant_label_spacing == nil
    assign variant_label_spacing = 12
  endif
  assign variant_item_gap = settings.variant_picker_item_gap
  if variant_item_gap == nil
    assign variant_item_gap = 8
  endif
  assign variant_radius = radius_variant_pickers
  assign variant_border_width = 'var(--input-border-width)'

  assign swatch_style = 'color'
  assign settings_swatch_style_allowed_values = 'variant_image|button|dropdown' | split: '|'
  if settings_swatch_style_allowed_values contains settings.swatch_style
    assign swatch_style = settings.swatch_style
  endif
  assign swatch_width_desktop = settings.swatch_width_desktop | default: 40
  assign swatch_width_mobile = settings.swatch_width_mobile | default: 40
  assign swatch_height_ratio = '3 / 1'
  capture swatch_height_ratio
    render 'css-token-value', setting: settings.swatch_height_ratio, values: '1_1=1 / 1|3_2=3 / 2|2_1=2 / 1', fallback: swatch_height_ratio
  endcapture
  assign swatch_height_ratio = swatch_height_ratio | strip
  if swatch_style == 'variant_image'
    assign swatch_height_ratio = '1 / 1'
  endif
  assign swatch_selected_style = 'underline'
  if settings.swatch_selected_style == 'border'
    assign swatch_selected_style = 'border'
  endif
  assign swatch_radius = radius_swatches

  assign badge_radius = radius_badges_subheadings
  assign badge_sale_price = settings.badge_sale_price_color | default: 'var(--sale-price-color)'
  assign badge_sale_background = settings.badge_sale_background_color | default: 'var(--sale-price-color)'
  assign badge_sale_color = settings.badge_sale_text_color | default: 'var(--button-primary-text)'
  assign badge_sold_out_background = settings.badge_sold_out_background_color | default: 'var(--border-color)'
  assign badge_sold_out_color = settings.badge_sold_out_text_color | default: 'var(--body-color)'

  assign overlay_title_size = 'var(--font-heading-md)'
  case settings.overlay_title_size
    when 'display', 'heading_1'
      assign overlay_title_size = 'var(--font-heading-display)'
    when 'xl', 'heading_2'
      assign overlay_title_size = 'var(--font-heading-xl)'
    when 'lg', 'heading_3'
      assign overlay_title_size = 'var(--font-heading-lg)'
    when 'md', 'heading_4'
      assign overlay_title_size = 'var(--font-heading-md)'
    when 'sm', 'heading_5'
      assign overlay_title_size = 'var(--font-heading-sm)'
    when 'xs', 'heading_6'
      assign overlay_title_size = 'var(--font-heading-xs)'
    when 'custom'
      assign overlay_title_size = settings.overlay_custom_title_size | default: 24 | append: 'px'
  endcase

  assign overlay_backdrop_blur = settings.overlay_backdrop_blur
  if overlay_backdrop_blur == blank
    assign overlay_backdrop_blur = 20
  endif
  assign overlay_popover_border_width = settings.overlay_popover_border_width
  if overlay_popover_border_width == blank
    assign overlay_popover_border_width = 0
  endif
  assign overlay_popover_shadow = 'none'
  capture overlay_popover_shadow
    render 'css-token-value', setting: settings.overlay_popover_shadow, values: 'small=0 0.25rem 0.75rem color-mix(in srgb, var(--overlay-shadow-color) 12%, transparent)|medium=0 0.5rem 1.25rem color-mix(in srgb, var(--overlay-shadow-color) 18%, transparent)|large=0 1rem 2rem color-mix(in srgb, var(--overlay-shadow-color) 24%, transparent)', fallback: overlay_popover_shadow
  endcapture
  assign overlay_popover_shadow = overlay_popover_shadow | strip
  assign overlay_drawer_padding_desktop = '0px'
  if settings.overlay_drawer_padding_desktop
    assign overlay_drawer_padding_desktop = '1.5rem'
  endif
  assign overlay_drawer_padding_mobile = '0px'
  if settings.overlay_drawer_padding_mobile
    assign overlay_drawer_padding_mobile = '1.5rem'
  endif
  assign overlay_drawer_content_padding_desktop = '1.5rem'
  assign overlay_drawer_content_padding_mobile = '1rem'

  assign overlay_opacity = settings.overlay_opacity
  if overlay_opacity == blank
    assign overlay_opacity = 40
  endif
  assign overlay_opacity_value = overlay_opacity | divided_by: 100.0
  # Backdrop opacity owns alpha; color_to_rgb can return rgba for saved alpha colors.
  assign overlay_backdrop_color = overlay_color | color_modify: 'alpha', overlay_opacity_value
  assign overlay_z_base = settings.overlay_z_base
  if overlay_z_base == blank
    assign overlay_z_base = 10
  endif
  assign overlay_z_drawer = settings.overlay_z_drawer
  if overlay_z_drawer == blank
    assign overlay_z_drawer = 200
  endif
  assign overlay_z_modal = settings.overlay_z_modal
  if overlay_z_modal == blank
    assign overlay_z_modal = 1000
  endif
%}

{% style %}
  {% render 'font-faces', body_font: body_font, heading_font: heading_font, accent_font: accent_font, button_font_weight: button_font_weight %}

  :root {
    --header-height: 0px;
    --header-sticky-height: 0px;
    --font-body-family: {% if body_font != blank %}{{ body_font.family }}, {{ body_font.fallback_families }}{% else %}system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif{% endif %};
    --font-body-style: {% if body_font != blank %}{{ body_font.style }}{% else %}normal{% endif %};
    --font-body-weight: {% if body_font != blank %}{{ body_font.weight }}{% else %}400{% endif %};
    --font-heading-family: {% if heading_font != blank %}{{ heading_font.family }}, {{ heading_font.fallback_families }}{% else %}var(--font-body-family){% endif %};
    --font-heading-style: {% if heading_font != blank %}{{ heading_font.style }}{% else %}normal{% endif %};
    --font-heading-weight: {{ heading_weight }};
    --font-accent-family: {% if accent_font != blank %}{{ accent_font.family }}, {{ accent_font.fallback_families }}{% else %}var(--font-body-family){% endif %};
    --font-accent-style: {% if accent_font != blank %}{{ accent_font.style }}{% else %}normal{% endif %};
    --font-accent-weight: {% if accent_font != blank %}{{ accent_font.weight }}{% else %}400{% endif %};
    --font-primary--family: var(--font-body-family);
    --font-primary--style: var(--font-body-style);
    --font-primary--weight: var(--font-body-weight);
    --font-heading--family: var(--font-heading-family);
    --font-heading--style: var(--font-heading-style);
    --font-heading--weight: var(--font-heading-weight);

    --logo-width: {{ logo_width }}px;
    --logo-width-mobile: {{ logo_width_mobile }}px;
    --page-width: {{ page_width }};
    --page-margin-desktop: {{ page_margin_desktop }}px;
    --page-margin-tablet: {{ page_margin_tablet }}px;
    --page-margin-mobile: {{ mobile_margin }}px;
    --layout-section-gap: {{ section_gap }}px;
    --layout-grid-gap: {{ grid_gap }}px;

    --background-color: {{ default_background }};
    --heading-color: {{ default_heading }};
    --heading-highlight-color: {{ default_heading_highlight }};
    --body-color: {{ default_body }};
    --color-foreground-rgb: {{ default_body_rgb }};
    --accent-color: {{ default_accent }};
    --border-color: {{ default_border }};
    --shadow-color: {{ default_shadow }};
    --sale-price-color: {{ default_sale_price }};
    --color-background: var(--background-color);
    --color-foreground: var(--body-color);
    --color-foreground-rgb: {{ default_body_rgb }};
    --color-accent: var(--accent-color);
    --color-border: var(--border-color);
    --color-surface: color-mix(in srgb, var(--background-color) 94%, var(--body-color));
    --placeholder-background-color: color-mix(in srgb, var(--background-color) 92%, var(--body-color));
    --placeholder-fill-color: color-mix(in srgb, var(--body-color) 30%, transparent);

    --font-body-xs: {{ body_xs_size }}px;
    --font-body-sm: {{ body_sm_size }}px;
    --font-body-md: {{ body_size }}px;
    --font-body-lg: {{ body_lg_size }}px;
    --font-body-xl: {{ body_xl_size }}px;
    --font-body-xxl: {{ body_xxl_size }}px;
    --font-body-line-height: {{ body_leading }};
    --font-body-letter-spacing: 0em;
    --font-body-text-transform: none;
    --font-heading-xs: {{ heading_6_size_desktop }}px;
    --font-heading-sm: {{ heading_5_size_desktop }}px;
    --font-heading-md: {{ heading_4_size_desktop }}px;
    --font-heading-lg: {{ heading_3_size_desktop }}px;
    --font-heading-xl: {{ heading_2_size_desktop }}px;
    --font-heading-display: {{ heading_1_size_desktop }}px;
    --font-heading-xs-line-height: {{ heading_6_line_height }};
    --font-heading-sm-line-height: {{ heading_5_line_height }};
    --font-heading-md-line-height: {{ heading_4_line_height }};
    --font-heading-lg-line-height: {{ heading_3_line_height }};
    --font-heading-xl-line-height: {{ heading_2_line_height }};
    --font-heading-display-line-height: {{ heading_1_line_height }};
    --font-heading-xs-text-transform: {{ heading_6_text_case }};
    --font-heading-sm-text-transform: {{ heading_5_text_case }};
    --font-heading-md-text-transform: {{ heading_4_text_case }};
    --font-heading-lg-text-transform: {{ heading_3_text_case }};
    --font-heading-xl-text-transform: {{ heading_2_text_case }};
    --font-heading-display-text-transform: {{ heading_1_text_case }};
    --font-heading-custom: var(--font-heading-md);
    --font-heading-custom-line-height: var(--font-heading-md-line-height);
    --font-heading-custom-text-transform: var(--font-heading-md-text-transform);
    --font-heading-display-letter-spacing: {{ heading_1_letter_spacing }};
    --font-heading-xl-letter-spacing: {{ heading_2_letter_spacing }};
    --font-heading-lg-letter-spacing: {{ heading_3_letter_spacing }};
    --font-heading-md-letter-spacing: {{ heading_4_letter_spacing }};
    --font-heading-sm-letter-spacing: {{ heading_5_letter_spacing }};
    --font-heading-xs-letter-spacing: {{ heading_6_letter_spacing }};
    --font-heading-custom-letter-spacing: var(--font-heading-md-letter-spacing);
    --font-heading-letter-spacing: {{ heading_letter_spacing }};
    --font-eyebrow-size: {{ eyebrow_size }}px;
    --font-eyebrow-line-height: {{ eyebrow_line_height }};
