    --motion-block-animation: {{ motion_block_animation }};

    --radius-square: 0px;
    --radius-slight: 4px;
    --radius-rounded: 8px;
    --radius-pill: 1000px;
    --radius-extra: 16px;
    --shape-border-width: {{ border_width }}px;

    --icon-size-small: 1.6rem;
    --icon-size-medium: 2rem;
    --icon-size-large: 2.4rem;
    --icon-thickness: {{ icon_thickness_scale }};
    --icon-stroke-width: {{ icon_stroke_width }};

    --button-style: {{ button_default_variant }};
