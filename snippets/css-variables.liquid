{% liquid
  # Resolve optional colors before the style tag so editor preview preserves blank values.
  assign button_primary_background_override = settings.button_primary_background_color
  assign button_primary_text_override = settings.button_primary_text_color
  assign button_secondary_background_override = settings.button_secondary_background_color
  assign button_secondary_text_override = settings.button_secondary_text_color
  assign primary_font = settings.type_primary_font
  assign body_font = primary_font
  assign button_font_weight = settings.button_font_weight | default: 'inherit'
  unless button_font_weight == '300' or button_font_weight == '400' or button_font_weight == '500' or button_font_weight == '600' or button_font_weight == '700' or button_font_weight == '800' or button_font_weight == '900'
    assign button_font_weight = 'inherit'
  endunless
  assign heading_font = settings.type_heading_font
  assign accent_font = settings.type_accent_font
  if heading_font == blank
    assign heading_font = body_font
  endif
  if accent_font == blank
    assign accent_font = body_font
  endif

  assign default_scheme_id = settings.default_color_scheme
  if settings.default_color_scheme.id != blank
    assign default_scheme_id = settings.default_color_scheme.id
  endif
  if default_scheme_id == blank
    assign default_scheme_id = 'scheme-1'
  endif

  assign default_background = settings.background_color | default: '#FFFFFF'
  assign default_heading = settings.foreground_color | default: '#111111'
  assign default_heading_highlight = '#A67C52'
  assign default_body = settings.foreground_color | default: '#404040'
  assign default_accent = settings.color_accent | default: '#111111'
  assign default_border = settings.color_border | default: '#D8D8D8'
  assign default_shadow = default_body
  assign default_sale_price = '#D82727'
  assign default_primary_background = default_accent
  assign default_primary_text = default_background
  assign default_primary_border = default_accent
  assign default_primary_hover_background = '#000000'
  assign default_primary_hover_text = '#FFFFFF'
  assign default_primary_hover_border = '#000000'
  assign default_secondary_background = '#ECECEC'
  assign default_secondary_text = default_accent
  assign default_secondary_border = '#ECECEC'
  assign default_secondary_hover_background = '#D8D8D8'
  assign default_secondary_hover_text = default_accent
  assign default_secondary_hover_border = '#D8D8D8'
  assign default_tertiary_text = default_accent
  assign default_tertiary_border = 'transparent'
  assign default_tertiary_hover_background = 'transparent'
  assign default_tertiary_hover_text = default_accent
  assign default_tertiary_hover_border = 'transparent'

  for scheme in settings.color_schemes
    if scheme.id == default_scheme_id
      assign default_background = scheme.settings.background | default: default_background
      assign default_heading = scheme.settings.heading | default: default_heading
      assign default_heading_highlight = scheme.settings.heading_highlight | default: default_heading_highlight
      assign default_body = scheme.settings.text | default: default_body
      assign default_accent = scheme.settings.accent | default: default_accent
      assign default_border = scheme.settings.border | default: default_border
      assign default_shadow = scheme.settings.shadow | default: default_shadow
      assign default_sale_price = scheme.settings.sale_price | default: default_sale_price
      assign default_primary_background = scheme.settings.button_primary_background | default: default_primary_background
      assign default_primary_text = scheme.settings.button_primary_text | default: default_primary_text
      assign default_primary_border = scheme.settings.button_primary_border | default: default_primary_border
      assign default_primary_hover_background = scheme.settings.button_primary_hover_background | default: default_primary_hover_background
      assign default_primary_hover_text = scheme.settings.button_primary_hover_text | default: default_primary_hover_text
      assign default_primary_hover_border = scheme.settings.button_primary_hover_border | default: default_primary_hover_border
      assign default_secondary_background = scheme.settings.button_secondary_background | default: default_secondary_background
      assign default_secondary_text = scheme.settings.button_secondary_text | default: default_secondary_text
      assign default_secondary_border = scheme.settings.button_secondary_border | default: default_secondary_border
      assign default_secondary_hover_background = scheme.settings.button_secondary_hover_background | default: default_secondary_hover_background
      assign default_secondary_hover_text = scheme.settings.button_secondary_hover_text | default: default_secondary_hover_text
      assign default_secondary_hover_border = scheme.settings.button_secondary_hover_border | default: default_secondary_hover_border
      assign default_tertiary_text = scheme.settings.button_tertiary_text | default: default_tertiary_text
      assign default_tertiary_hover_text = scheme.settings.button_tertiary_hover_text | default: default_tertiary_hover_text
      break
    endif
  endfor

  assign default_body_rgb = default_body | color_to_rgb | remove: 'rgba(' | remove: 'rgb(' | remove: ')' | split: ',' | slice: 0, 3 | join: ' ' | strip

  assign overlay_scheme_id = settings.overlay_color_scheme | default: default_scheme_id
  if settings.overlay_color_scheme.id != blank
    assign overlay_scheme_id = settings.overlay_color_scheme.id
  endif
  assign overlay_background = default_background
  assign overlay_text_color = default_body
  assign overlay_border_color = default_border
  assign overlay_shadow_color = default_shadow
  assign overlay_color = overlay_shadow_color
  for scheme in settings.color_schemes
    if scheme.id == overlay_scheme_id
      assign overlay_background = scheme.settings.background | default: overlay_background
      assign overlay_text_color = scheme.settings.text | default: overlay_text_color
      assign overlay_border_color = scheme.settings.border | default: overlay_border_color
      assign overlay_shadow_color = scheme.settings.shadow | default: overlay_shadow_color
      assign overlay_color = overlay_shadow_color
      break
    endif
  endfor

  assign logo_width = settings.logo_width
  if logo_width == blank
    assign logo_width = 180
  endif
  assign logo_width_mobile = settings.logo_width_mobile
  if logo_width_mobile == blank
    assign logo_width_mobile = 140
  endif
  assign page_width = settings.max_page_width | default: 1600
  assign page_width = page_width | remove: 'px' | append: 'px'
  assign page_margin_desktop = settings.layout_desktop_margin
  if page_margin_desktop == blank
    assign page_margin_desktop = 48
  endif
  assign page_margin_tablet = settings.layout_tablet_margin
  if page_margin_tablet == blank
    assign page_margin_tablet = 30
  endif
  assign mobile_margin = settings.layout_mobile_margin
  if mobile_margin == blank
    assign mobile_margin = 16
  endif
  assign section_gap = 48
  assign grid_gap = 24
  assign button_default_variant = 'primary'
  assign overlay_title_size = 'var(--font-heading-md)'
  case settings.overlay_title_size
    when 'display', 'heading_1'
      assign overlay_title_size = 'var(--font-heading-display)'
    when 'xl', 'heading_2'
      assign overlay_title_size = 'var(--font-heading-xl)'
    when 'lg', 'heading_3'
      assign overlay_title_size = 'var(--font-heading-lg)'
    when 'md', 'heading_4'
      assign overlay_title_size = 'var(--font-heading-md)'
    when 'sm', 'heading_5'
      assign overlay_title_size = 'var(--font-heading-sm)'
    when 'xs', 'heading_6'
      assign overlay_title_size = 'var(--font-heading-xs)'
    when 'custom'
      assign overlay_title_size = settings.overlay_custom_title_size | default: 24 | append: 'px'
  endcase

  assign overlay_backdrop_blur = settings.overlay_backdrop_blur
  if overlay_backdrop_blur == blank
    assign overlay_backdrop_blur = 20
  endif
  assign overlay_popover_border_width = settings.overlay_popover_border_width
  if overlay_popover_border_width == blank
    assign overlay_popover_border_width = 0
  endif
  assign overlay_popover_shadow = 'none'
  case settings.overlay_popover_shadow
    when 'small'
      assign overlay_popover_shadow = '0 0.25rem 0.75rem color-mix(in srgb, var(--overlay-shadow-color) 12%, transparent)'
    when 'medium'
      assign overlay_popover_shadow = '0 0.5rem 1.25rem color-mix(in srgb, var(--overlay-shadow-color) 18%, transparent)'
    when 'large'
      assign overlay_popover_shadow = '0 1rem 2rem color-mix(in srgb, var(--overlay-shadow-color) 24%, transparent)'
  endcase
  assign overlay_drawer_padding_desktop = '0px'
  assign overlay_drawer_edge_radius_desktop = '0px'
  if settings.overlay_drawer_padding_desktop
    assign overlay_drawer_padding_desktop = '1.5rem'
    assign overlay_drawer_edge_radius_desktop = drawer_radius
  endif
  assign overlay_drawer_padding_mobile = '0px'
  if settings.overlay_drawer_padding_mobile
    assign overlay_drawer_padding_mobile = '1.5rem'
  endif
  assign overlay_drawer_content_padding_desktop = '1.5rem'
  assign overlay_drawer_content_padding_mobile = '1rem'

  assign overlay_opacity = settings.overlay_opacity
  if overlay_opacity == blank
    assign overlay_opacity = 40
  endif
  assign overlay_opacity_value = overlay_opacity | divided_by: 100.0
  # Backdrop opacity owns alpha; color_to_rgb can return rgba for saved alpha colors.
  assign overlay_backdrop_color = overlay_color | color_modify: 'alpha', overlay_opacity_value
  assign overlay_z_base = settings.overlay_z_base
  if overlay_z_base == blank
    assign overlay_z_base = 10
  endif
  assign overlay_z_drawer = settings.overlay_z_drawer
  if overlay_z_drawer == blank
    assign overlay_z_drawer = 200
  endif
  assign overlay_z_modal = settings.overlay_z_modal
  if overlay_z_modal == blank
    assign overlay_z_modal = 1000
  endif
%}

{% style %}
  {% render 'font-faces', body_font: body_font, heading_font: heading_font, accent_font: accent_font, button_font_weight: button_font_weight %}

  :root {
    --header-height: 0px;
    --header-sticky-height: 0px;
    --font-body-family: {% if body_font != blank %}{{ body_font.family }}, {{ body_font.fallback_families }}{% else %}system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif{% endif %};
    --font-body-style: {% if body_font != blank %}{{ body_font.style }}{% else %}normal{% endif %};
    --font-body-weight: {% if body_font != blank %}{{ body_font.weight }}{% else %}400{% endif %};
    --font-heading-family: {% if heading_font != blank %}{{ heading_font.family }}, {{ heading_font.fallback_families }}{% else %}var(--font-body-family){% endif %};
    --font-heading-style: {% if heading_font != blank %}{{ heading_font.style }}{% else %}normal{% endif %};
    --font-accent-family: {% if accent_font != blank %}{{ accent_font.family }}, {{ accent_font.fallback_families }}{% else %}var(--font-body-family){% endif %};
    --font-accent-style: {% if accent_font != blank %}{{ accent_font.style }}{% else %}normal{% endif %};
    --font-accent-weight: {% if accent_font != blank %}{{ accent_font.weight }}{% else %}400{% endif %};
    --font-primary--family: var(--font-body-family);
    --font-primary--style: var(--font-body-style);
    --font-primary--weight: var(--font-body-weight);
    --font-heading--family: var(--font-heading-family);
    --font-heading--style: var(--font-heading-style);
    --font-heading--weight: var(--font-heading-weight);

    --logo-width: {{ logo_width }}px;
    --logo-width-mobile: {{ logo_width_mobile }}px;
    --page-width: {{ page_width }};
    --page-margin-desktop: {{ page_margin_desktop }}px;
    --page-margin-tablet: {{ page_margin_tablet }}px;
    --page-margin-mobile: {{ mobile_margin }}px;
    --layout-section-gap: {{ section_gap }}px;
    --layout-grid-gap: {{ grid_gap }}px;

    --background-color: {{ default_background }};
    --heading-color: {{ default_heading }};
    --heading-highlight-color: {{ default_heading_highlight }};
    --body-color: {{ default_body }};
    --color-foreground-rgb: {{ default_body_rgb }};
    --accent-color: {{ default_accent }};
    --border-color: {{ default_border }};
    --shadow-color: {{ default_shadow }};
    --sale-price-color: {{ default_sale_price }};
    --color-background: var(--background-color);
    --color-foreground: var(--body-color);
    --color-foreground-rgb: {{ default_body_rgb }};
    --color-accent: var(--accent-color);
    --color-border: var(--border-color);
    --color-surface: color-mix(in srgb, var(--background-color) 94%, var(--body-color));
    --placeholder-background-color: color-mix(in srgb, var(--background-color) 92%, var(--body-color));
    --placeholder-fill-color: color-mix(in srgb, var(--body-color) 30%, transparent);

    --font-body-letter-spacing: 0em;
    --font-body-text-transform: none;
    --font-heading-custom: var(--font-heading-md);
    --font-heading-custom-line-height: var(--font-heading-md-line-height);
    --font-heading-custom-text-transform: var(--font-heading-md-text-transform);
    --font-heading-custom-letter-spacing: var(--font-heading-md-letter-spacing);
    --font-eyebrow-weight: 500;
    --type-body-size: var(--font-body-md);
    --type-body-leading: var(--font-body-line-height);
    --type-heading-1-size: var(--font-heading-display);
    --type-heading-2-size: var(--font-heading-xl);
    --type-heading-3-size: var(--font-heading-lg);
    --type-heading-4-size: var(--font-heading-md);
    --type-heading-5-size: var(--font-heading-sm);
    --type-heading-6-size: var(--font-heading-xs);
    --type-role-title-size: var(--font-heading-xl);
    --type-role-subtitle-size: var(--font-heading-md);
    --type-role-body-size: var(--font-body-md);
    --type-heading-leading: var(--font-heading-xl-line-height);
    --type-letter-spacing: var(--font-heading-letter-spacing);
    --type-label-case: var(--font-eyebrow-text-transform);

    --motion-duration-fast: 160ms;
    --motion-duration-standard: 280ms;
    --motion-duration-slow: 420ms;
    --motion-ease-standard: cubic-bezier(0.2, 0.8, 0.2, 1);
    --motion-ease-emphasized: cubic-bezier(0.2, 0.7, 0, 1);
    --motion-ease-linear: linear;
    --motion-distance-hover: -2px;
    --motion-distance-block: 1rem;

    --radius-square: 0px;
    --radius-slight: 4px;
    --radius-rounded: 8px;
    --radius-pill: 1000px;
    --radius-extra: 16px;

    --icon-size-small: 1.6rem;
    --icon-size-medium: 2rem;
    --icon-size-large: 2.4rem;

    --button-style: {{ button_default_variant }};
    --button-primary-background: {{ default_primary_background }};
    --button-primary-text: {{ default_primary_text }};
    --button-primary-border: {{ default_primary_border }};
    --button-primary-hover-background: {{ default_primary_hover_background }};
    --button-primary-hover-text: {{ default_primary_hover_text }};
    --button-primary-hover-border: {{ default_primary_hover_border }};
    --button-secondary-background: {{ default_secondary_background }};
    --button-secondary-text: {{ default_secondary_text }};
    --button-secondary-border: {{ default_secondary_border }};
    --button-secondary-hover-background: {{ default_secondary_hover_background }};
    --button-secondary-hover-text: {{ default_secondary_hover_text }};
    --button-secondary-hover-border: {{ default_secondary_hover_border }};
    --button-tertiary-background: transparent;
    --button-tertiary-text: {{ default_tertiary_text }};
    --button-tertiary-border: {{ default_tertiary_border }};
    --button-tertiary-hover-background: {{ default_tertiary_hover_background }};
    --button-tertiary-hover-text: {{ default_tertiary_hover_text }};
    --button-tertiary-hover-border: {{ default_tertiary_hover_border }};
    --button-background: var(--button-{{ button_default_variant }}-background);
    --button-foreground: var(--button-{{ button_default_variant }}-text);
    --button-border: var(--button-{{ button_default_variant }}-border);
    --button-hover-background: var(--button-{{ button_default_variant }}-hover-background);
    --button-hover-foreground: var(--button-{{ button_default_variant }}-hover-text);
    --button-hover-border: var(--button-{{ button_default_variant }}-hover-border);
    --swiper-nav-size: var(--button-height);
    --swiper-nav-size-mobile: var(--button-height-mobile);
    --swiper-nav-icon-size: var(--icon-size-medium);
    --swiper-pagination-progressbar-size: 2px;
    --swiper-pagination-bullet-hit-size: 24px;
    --swiper-pagination-bullet-hit-width: 24px;
    --swiper-pagination-bullet-active-hit-width: 48px;
    --swiper-pagination-bullet-size: 8px;
    --swiper-pagination-bullet-width: 8px;
    --swiper-pagination-bullet-height: 8px;
    --swiper-pagination-bullet-active-width: 32px;
    --swiper-pagination-bullet-active-height: 8px;
    --swiper-pagination-bullet-border-radius: var(--radius-pill, 1000px);
    --swiper-pagination-bullet-gap: 8px;
    --swiper-pagination-bullet-progress-duration: 4s;
    --control-height-2xs: 3.0rem;
    --control-height-xs: 3.4rem;
    --control-height-sm: 4.0rem;
    --control-height-md: 4.4rem;
    --control-height-lg: 4.8rem;
    --control-height-xl: 5.6rem;
    --button-font-weight: {% if button_font_weight == 'inherit' %}var(--font-body-weight){% else %}{{ button_font_weight }}{% endif %};
    --button-tertiary-border-width: 0px;

    --input-border-width: 0px;
    --input-background-color-solid: color-mix(in srgb, var(--body-color) 6%, transparent);
    --input-background-color: var(--input-background-color-solid);
    --input-border-color: var(--border-color);
    --input-focus-color: var(--accent-color);
    --input-error-color: var(--sale-price-color);
    --input-text-color: var(--body-color);

    /* Legacy aliases remain valid for existing snippets while new form code uses semantic tokens. */
    --input-background: var(--input-background-color);
    --input-border: var(--input-border-color);
    --input-focus: var(--input-focus-color);
    --style-border-radius-inputs: var(--input-radius);
    --quantity-selector-height: 3.4rem;
    --quantity-selector-height-mobile: 3.4rem;
    --quantity-selector-button-width: 3rem;
    --quantity-selector-input-width: 3rem;
    --quantity-selector-input-width-mobile: 2rem;
    --quantity-selector-icon-size: 1.4rem;


    /* Legacy aliases remain valid for existing product-card styles. */
    --product-card-secondary: var(--product-card-show-secondary-image);



    --badge-font-family: var(--font-body-family);
    --badge-font-size: var(--font-body-xs);
    --badge-font-weight: 500;
    --badge-letter-spacing: var(--font-body-letter-spacing);
    --badge-padding: 0.2rem 0.55rem;

    --price-font-family: var(--font-body-family);
    --price-font-style: var(--font-body-style);
    --price-font-size: var(--font-body-md);
    --price-font-weight: var(--font-body-weight);
    --price-line-height: var(--font-body-line-height);
    --price-sale-color: var(--badge-sale-price);
    --price-compare-color: var(--body-color);
    --price-unit-color: var(--body-color);

    --overlay-background-color: {{ overlay_background }};
    --overlay-text-color: {{ overlay_text_color }};
    --overlay-border-color: {{ overlay_border_color }};
    --overlay-shadow-color: {{ overlay_shadow_color }};
    --overlay-color: {{ overlay_color }};
    --overlay-opacity: {{ overlay_opacity_value }};
    --overlay-backdrop-color: {{ overlay_backdrop_color }};
    --overlay-backdrop-blur: {{ overlay_backdrop_blur }}px;
    --overlay-popover-border-width: {{ overlay_popover_border_width }}px;
    --overlay-popover-shadow: {{ overlay_popover_shadow }};
    --overlay-title-size: {{ overlay_title_size }};
    --overlay-drawer-padding-desktop: {{ overlay_drawer_padding_desktop }};
    --overlay-drawer-edge-radius-desktop: {{ overlay_drawer_edge_radius_desktop }};
    --overlay-drawer-padding-mobile: {{ overlay_drawer_padding_mobile }};
    --overlay-drawer-content-padding-desktop: {{ overlay_drawer_content_padding_desktop }};
    --overlay-drawer-content-padding-mobile: {{ overlay_drawer_content_padding_mobile }};
    --z-base: {{ overlay_z_base | default: 10 }};
    --z-drawer: {{ overlay_z_drawer | default: 200 }};
    --z-modal: {{ overlay_z_modal | default: 1000 }};
  }



  {% for scheme in settings.color_schemes %}
    {%- comment -%}
      Normalize every scheme token before emitting CSS. Older theme data can
      omit settings that were added later; a direct scheme.settings.* output
      would otherwise leave an invalid empty custom property behind.
    {%- endcomment -%}
    {% assign scheme_background = scheme.settings.background | default: default_background %}
    {% assign scheme_heading = scheme.settings.heading | default: default_heading %}
    {% assign scheme_heading_highlight = scheme.settings.heading_highlight | default: default_heading_highlight %}
    {% assign scheme_body = scheme.settings.text | default: default_body %}
    {% assign scheme_accent = scheme.settings.accent | default: default_accent %}
    {% assign scheme_border = scheme.settings.border | default: default_border %}
    {% assign scheme_shadow = scheme.settings.shadow | default: default_shadow %}
    {% assign scheme_sale_price = scheme.settings.sale_price | default: default_sale_price %}
    {% assign scheme_primary_background = scheme.settings.button_primary_background | default: default_primary_background %}
    {% assign scheme_primary_text = scheme.settings.button_primary_text | default: default_primary_text %}
    {% assign scheme_primary_border = scheme.settings.button_primary_border | default: default_primary_border %}
    {% assign scheme_primary_hover_background = scheme.settings.button_primary_hover_background | default: 'transparent' %}
    {% assign scheme_primary_hover_text = scheme.settings.button_primary_hover_text | default: default_primary_hover_text %}
    {% assign scheme_primary_hover_border = scheme.settings.button_primary_hover_border | default: default_primary_hover_border %}
    {% assign scheme_secondary_background = scheme.settings.button_secondary_background | default: default_secondary_background %}
    {% assign scheme_secondary_text = scheme.settings.button_secondary_text | default: default_secondary_text %}
    {% assign scheme_secondary_border = scheme.settings.button_secondary_border | default: default_secondary_border %}
    {% assign scheme_secondary_hover_background = scheme.settings.button_secondary_hover_background | default: 'transparent' %}
    {% assign scheme_secondary_hover_text = scheme.settings.button_secondary_hover_text | default: default_secondary_hover_text %}
    {% assign scheme_secondary_hover_border = scheme.settings.button_secondary_hover_border | default: default_secondary_hover_border %}
    {% assign scheme_tertiary_text = scheme.settings.button_tertiary_text | default: default_tertiary_text %}
    {% assign scheme_tertiary_hover_text = scheme.settings.button_tertiary_hover_text | default: default_tertiary_hover_text %}
    {% assign scheme_body_rgb = scheme_body | color_to_rgb | remove: 'rgba(' | remove: 'rgb(' | remove: ')' | split: ',' | slice: 0, 3 | join: ' ' | strip %}
    .{{ scheme.id }} {
      --background-color: {{ scheme_background }};
      --heading-color: {{ scheme_heading }};
      --heading-highlight-color: {{ scheme_heading_highlight }};
      --body-color: {{ scheme_body }};
      --color-foreground-rgb: {{ scheme_body_rgb }};
      --accent-color: {{ scheme_accent }};
      --input-focus-color: var(--accent-color);
      --input-focus: var(--input-focus-color);
      --input-text-color: var(--body-color);
      --price-compare-color: var(--body-color);
      --price-unit-color: var(--body-color);
      --border-color: {{ scheme_border }};
      --input-border-color: var(--border-color);
      --shadow-color: {{ scheme_shadow }};
      --sale-price-color: {{ scheme_sale_price }};
      --price-sale-color: var(--sale-price-color);
      --button-primary-background: {{ scheme_primary_background }};
      --button-primary-text: {{ scheme_primary_text }};
      --button-primary-border: {{ scheme_primary_border }};
      --button-primary-hover-background: {{ scheme_primary_hover_background }};
      --button-primary-hover-text: {{ scheme_primary_hover_text }};
      --button-primary-hover-border: {{ scheme_primary_hover_border }};
      --button-secondary-background: {{ scheme_secondary_background }};
      --button-secondary-text: {{ scheme_secondary_text }};
      --button-secondary-border: {{ scheme_secondary_border }};
      --button-secondary-hover-background: {{ scheme_secondary_hover_background }};
      --button-secondary-hover-text: {{ scheme_secondary_hover_text }};
      --button-secondary-hover-border: {{ scheme_secondary_hover_border }};
      --button-tertiary-background: transparent;
      --button-tertiary-text: {{ scheme_tertiary_text }};
      --button-tertiary-border: transparent;
      --button-tertiary-hover-background: transparent;
      --button-tertiary-hover-text: {{ scheme_tertiary_hover_text }};
      --button-tertiary-hover-border: transparent;

      --color-background: var(--background-color);
      --color-foreground: var(--body-color);
      --color-foreground-rgb: {{ scheme_body_rgb }};
      --color-accent: var(--accent-color);
      --color-border: var(--border-color);
      --color-surface: color-mix(in srgb, var(--background-color) 94%, var(--body-color));
      --placeholder-background-color: color-mix(in srgb, var(--background-color) 92%, var(--body-color));
      --placeholder-fill-color: color-mix(in srgb, var(--body-color) 30%, transparent);
      --button-background: var(--button-{{ button_default_variant }}-background);
      --button-foreground: var(--button-{{ button_default_variant }}-text);
      --button-border: var(--button-{{ button_default_variant }}-border);
      --button-hover-background: var(--button-{{ button_default_variant }}-hover-background);
      --button-hover-foreground: var(--button-{{ button_default_variant }}-hover-text);
      --button-hover-border: var(--button-{{ button_default_variant }}-hover-border);
    }
  {% endfor %}

  .btn {
    {% if button_primary_background_override != blank %}
      --button-primary-background: {{ button_primary_background_override }};
    {% endif %}
    {% if button_primary_text_override != blank %}
      --button-primary-text: {{ button_primary_text_override }};
    {% endif %}
    {% if button_secondary_background_override != blank %}
      --button-secondary-background: {{ button_secondary_background_override }};
    {% endif %}
    {% if button_secondary_text_override != blank %}
      --button-secondary-text: {{ button_secondary_text_override }};
    {% endif %}
  }
{% endstyle %}

