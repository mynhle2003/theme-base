    --motion-image-zoom: {{ motion_image_zoom }};
    --product-card-image-zoom: {{ product_card_image_zoom }};
    --motion-block-animations: {{ motion_block_animations }};
    --motion-block-animation: {{ motion_block_animation }};

    --radius-square: 0px;
    --radius-slight: 4px;
    --radius-rounded: 8px;
    --radius-pill: 1000px;
    --radius-extra: 16px;
