{% doc %}
  Renders the store logo with transparent-header fallback support.

  @param {boolean} [transparent] - Whether to use the transparent-header logo
{% enddoc %}

{% liquid
  assign default_logo = settings.logo
  assign transparent_logo = settings.logo_transparent
  assign default_logo_alt = default_logo.alt | default: shop.name
  assign transparent_logo_alt = transparent_logo.alt | default: shop.name
%}

<a
  class="site-logo{% if transparent and transparent_logo != blank %} site-logo--transparent{% endif %}"
  href="{{ routes.root_url }}"
  aria-label="{{ shop.name | escape }}"
  style="
    --logo-width: {{ settings.logo_width }}px;
    --logo-width-mobile: {{ settings.logo_width_mobile }}px;
  "
>
  {% if default_logo != blank %}
    {{ default_logo
      | image_url: width: 600
      | image_tag:
        class: 'site-logo__image site-logo__image--default',
        alt: default_logo_alt,
        loading: 'eager'
    }}
  {% else %}
    <span class="site-logo__text">
      {{ shop.name | escape }}
    </span>
  {% endif %}

  {% if transparent and transparent_logo != blank %}
    {{ transparent_logo
      | image_url: width: 600
      | image_tag:
        class: 'site-logo__image site-logo__image--transparent',
        alt: transparent_logo_alt,
        loading: 'eager'
    }}
  {% endif %}
</a>
