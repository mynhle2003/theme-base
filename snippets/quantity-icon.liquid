{% doc %}
  Renders a quantity icon with a Featured product Figma variant.
  @param {string} icon - minus or plus
{% enddoc %}

{% render 'icon', icon: icon, bare: true %}
{% case icon %}
  {% when 'minus' %}
    <svg class="quantity-icon--figma" aria-hidden="true" focusable="false" preserveAspectRatio="none" overflow="visible" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
<g opacity="0.6">
<path d="M4.16667 10H15.8333" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" stroke="#181818"/>
</g>
</svg>
  {% when 'plus' %}
    <svg class="quantity-icon--figma" aria-hidden="true" focusable="false" preserveAspectRatio="none" overflow="visible" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
<g>
<path d="M4.16667 10H15.8333M9.99583 15.8333L9.99583 4.16666" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" stroke="#181818"/>
</g>
</svg>
{% endcase %}
