{% doc %}
  Header icon artwork selected by the owning Header section. Falls back to the
  theme icon kernel for the default style. Decorative; the control owns its label.
  @param {string} icon - Theme icon name
  @param {string} [class] - Optional icon class
{% enddoc %}
{% liquid
  assign artwork = blank
  if section.settings.icon_style == 'outline'
    case icon
      when 'user'
        assign artwork = 'header-outline-user.webp'
      when 'shopping-bag'
        assign artwork = 'header-outline-bag.webp'
      when 'magnifying-glass'
        assign artwork = 'header-outline-search.webp'
      when 'bars-3'
        assign artwork = 'header-outline-menu.webp'
      when 'chevron-down'
        assign artwork = 'header-outline-chevron.webp'
      when 'category-chevron'
        assign artwork = 'header-outline-category-chevron.webp'
      when 'location'
        assign artwork = 'header-outline-location.webp'
    endcase
  endif
%}
{% capture figma_artwork %}{% if section.settings.icon_style == 'default' %}{% case icon %}{% when 'bars-3' %}<svg class="{{ class }}" width="24" height="24" viewBox="16 26 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M20 38H36M20 32H36M20 44H36" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor" />
</svg>{% when 'location' %}<svg class="{{ class }}" width="24" height="24" viewBox="229 26 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M249 36C249 40.993 243.461 46.193 241.601 47.799C241.428 47.9293 241.217 47.9998 241 47.9998C240.783 47.9998 240.572 47.9293 240.399 47.799C238.539 46.193 233 40.993 233 36C233 33.8783 233.843 31.8434 235.343 30.3431C236.843 28.8429 238.878 28 241 28C243.122 28 245.157 28.8429 246.657 30.3431C248.157 31.8434 249 33.8783 249 36ZM244 36C244 37.6569 242.657 39 241 39C239.343 39 238 37.6569 238 36C238 34.3431 239.343 33 241 33C242.657 33 244 34.3431 244 36Z" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor" />
</svg>{% when 'user' %}<svg class="{{ class }}" width="24" height="24" viewBox="277 26 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M289 39C291.761 39 294 36.7614 294 34C294 31.2386 291.761 29 289 29C286.239 29 284 31.2386 284 34C284 36.7614 286.239 39 289 39ZM289 39C291.122 39 293.157 39.8429 294.657 41.3431C296.157 42.8434 297 44.8783 297 47M289 39C286.878 39 284.843 39.8429 283.343 41.3431C281.843 42.8434 281 44.8783 281 47" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor" />
</svg>{% when 'magnifying-glass' %}<svg class="{{ class }}" width="20" height="20" viewBox="327 84 20 20" fill="none" aria-hidden="true" focusable="false"><path d="M344.5 101.5L340.917 97.9167M342.833 93.1667C342.833 96.8486 339.849 99.8333 336.167 99.8333C332.485 99.8333 329.5 96.8486 329.5 93.1667C329.5 89.4848 332.485 86.5 336.167 86.5C339.849 86.5 342.833 89.4848 342.833 93.1667Z" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor" />
</svg>{% when 'chevron-down', 'category-chevron' %}<svg class="{{ class }}" width="16" height="16" viewBox="62 86 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M65 91.5L70 96.5L75 91.5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor" />
</svg>{% when 'shopping-bag' %}<svg class="{{ class }}" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M2.0498 2.05005H4.0498L6.7098 14.47C6.80738 14.9249 7.06048 15.3315 7.42552 15.6199C7.79056 15.9083 8.24471 16.0604 8.7098 16.05H18.4898C18.945 16.0493 19.3863 15.8933 19.7408 15.6079C20.0954 15.3224 20.3419 14.9246 20.4398 14.48L22.0898 7.05005H5.1198M8.9998 21C8.9998 21.5523 8.55209 22 7.9998 22C7.44752 22 6.9998 21.5523 6.9998 21C6.9998 20.4478 7.44752 20 7.9998 20C8.55209 20 8.9998 20.4478 8.9998 21ZM19.9998 21C19.9998 21.5523 19.5521 22 18.9998 22C18.4475 22 17.9998 21.5523 17.9998 21C17.9998 20.4478 18.4475 20 18.9998 20C19.5521 20 19.9998 20.4478 19.9998 21Z" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"/>
</svg>{% endcase %}{% endif %}{% endcapture %}{% assign figma_artwork = figma_artwork | strip %}
{% if figma_artwork != blank %}{{ figma_artwork }}{% elsif artwork != blank %}<img class="{{ class }}" src="{{ artwork | asset_url }}" width="24" height="24" alt="" aria-hidden="true">{% elsif icon == 'location' %}<span class="{{ class }}" style="display: block; width: 100%; height: 100%; background: currentColor; mask: url('{{ 'header-outline-location.webp' | asset_url }}') center / contain no-repeat;" aria-hidden="true"></span>{% else %}{% assign fallback_icon = icon %}{% if icon == 'category-chevron' %}{% assign fallback_icon = 'chevron-down' %}{% endif %}{% render 'icon', icon: fallback_icon, bare: true, class: class %}{% endif %}
