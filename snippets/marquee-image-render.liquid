{% doc %}
  Renders a Basic marquee image with optional link suppression for compound blocks.
  @param {object} block - Image block and its editor settings.
  @param {boolean} [suppress_links] - Render the image without an independent link.
{% enddoc %}

{% liquid
  assign image_link = block.settings.image_link
  assign new_tab = block.settings.open_in_new_tab
  if suppress_links
    assign image_link = blank
    assign new_tab = false
  endif
  assign width = block.settings.width_custom_desktop | default: 300
  assign mobile_width = block.settings.width_custom_mobile | default: 50
  capture ratio
    render 'image-ratio-value', setting: block.settings.image_ratio, custom_width: block.settings.image_ratio_custom_width, custom_height: block.settings.image_ratio_custom_height
  endcapture
  assign ratio = ratio | strip
  assign radius = 'var(--media-radius, 0px)'
  case block.settings.corner_radius
    when 'square'
      assign radius = '0px'
    when 'rounded'
      assign radius = 'var(--radius-rounded)'
    when 'full'
      assign radius = '999px'
    when 'custom'
      assign radius = block.settings.custom_corner_radius | append: 'px'
  endcase
  capture sizes
    echo '(max-width:767px) '
    echo mobile_width
    echo 'px, '
    echo width
    echo 'px'
  endcapture
%}
<div class="marquee-image-block" style="--mq-image-width:{{ width }}px;--mq-image-width-mobile:{{ mobile_width }}px;--mq-image-ratio:{{ ratio }};--mq-image-radius:{{ radius }};" {{ block.shopify_attributes }}>
 {% render 'image', image: block.settings.image, url: image_link, open_in_new_tab: new_tab, width: 800, widths: '50,100,200,300,400,600,800', sizes: sizes %}
</div>
{% stylesheet %}
.marquee-image-block{flex:0 0 auto;width:var(--mq-image-width);border-radius:var(--mq-image-radius);overflow:hidden;} .marquee-image-block .image{aspect-ratio:var(--mq-image-ratio);} .marquee-image-block .image>img,.marquee-image-block .image>svg{width:100%;height:100%;object-fit:cover;} @media(max-width:767.98px){.marquee-image-block{width:var(--mq-image-width-mobile);}}
{% endstylesheet %}
