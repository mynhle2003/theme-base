{% stylesheet %}
  .product-list__promo-item { display:flex; align-self:stretch; }
  .product-list__promo-item > .promo-card { width:100%; aspect-ratio:var(--product-list-promo-ratio, var(--product-card-image-ratio, auto)); }
  .product-list__mobile-promos:empty { display:none; }
  .product-list__mobile-promos { display:grid; gap:16px; margin-bottom:24px; }
  .product-list__mobile-promos .product-list__promo-item { width:100%; }
{% endstylesheet %}
