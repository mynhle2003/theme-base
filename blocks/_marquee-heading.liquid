{% liquid
  assign size = block.settings.heading_size | default: 'xl'
  assign role = block.settings.color_role | default: 'heading'
  assign font_role = block.settings.font | default: 'heading'
  unless font_role == 'body' or font_role == 'heading' or font_role == 'accent'
    assign font_role = 'heading'
  endunless
  assign font_size = block.settings.custom_heading_size | default: 14
  assign opacity = block.settings.opacity | default: 50 | divided_by: 100.0
  assign plain_text = block.settings.text | strip_html | strip
%}
<div class="marquee-heading-block heading-text heading-{{ size }} font-{{ font_role }}{% if block.settings.outline %} marquee-heading-block--outline virelle-text-outline{% if section.settings.background_image != blank %} virelle-text-outline--transparent{% endif %}{% endif %}" style="--mq-color:var(--{% if role == 'heading' %}heading{% else %}body{% endif %}-color);--mq-opacity:{{ opacity }};{% if size == 'custom' %}--mq-size:{{ font_size }}px;{% endif %}" {% if plain_text == blank %}data-content-empty{% endif %} {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
{% stylesheet %}
.marquee-heading-block{flex:0 0 auto;width:max-content;max-width:none;margin:0;overflow-wrap:normal;color:var(--mq-color);opacity:var(--mq-opacity,1);} .marquee-heading-block.heading-custom{font-size:var(--mq-size);line-height:1.2;} .marquee-heading-block--outline{--text-outline-color:var(--mq-color);--text-outline-fill:var(--text-marquee-custom-background,var(--background-color));} .marquee-heading-block--outline.virelle-text-outline--transparent{--text-outline-fill:transparent;} .marquee-heading-block a{color:inherit;}
{% endstylesheet %}

{% schema %}
{
  "name": "Heading",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Welcome to our store"
    },
    {
      "type": "checkbox",
      "id": "outline",
      "label": "Outline text",
      "default": false
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font",
      "label": "t:labels.font",
      "options": [
        {
          "value": "body",
          "label": "t:options.menu_font.body"
        },
        {
          "value": "heading",
          "label": "t:options.menu_font.heading"
        },
        {
          "value": "accent",
          "label": "t:options.menu_font.accent"
        }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:labels.heading_size",
      "options": [
        {
          "value": "display",
          "label": "t:options.heading_size.display"
        },
        {
          "value": "xl",
          "label": "t:options.heading_size.xl"
        },
        {
          "value": "lg",
          "label": "t:options.heading_size.lg"
        },
        {
          "value": "md",
          "label": "t:options.heading_size.md"
        },
        {
          "value": "sm",
          "label": "t:options.heading_size.sm"
        },
        {
          "value": "xs",
          "label": "t:options.heading_size.xs"
        },
        {
          "value": "custom",
          "label": "t:options.heading_size.custom"
        }
      ],
      "default": "xl"
    },
    {
      "type": "range",
      "id": "custom_heading_size",
      "label": "Custom size",
      "min": 10,
      "max": 200,
      "step": 2,
      "default": 14,
      "unit": "px",
      "visible_if": "{{ block.settings.heading_size == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "select",
      "id": "color_role",
      "label": "Text color",
      "options": [
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "text",
          "label": "Text"
        }
      ],
      "default": "heading"
    },
    {
      "type": "range",
      "id": "opacity",
      "label": "Opacity",
      "min": 10,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%"
    }
  ],
  "presets": [
    {
      "name": "Heading",
      "category": "t:general.basic",
      "settings": {}
    }
  ]
}
{% endschema %}
