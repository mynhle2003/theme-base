{% liquid
  assign marquee_collection = block.settings.collection
  assign marquee_heading = block.settings.heading | strip
  if marquee_heading == blank
    assign marquee_heading = marquee_collection.title
  endif
  if marquee_heading == blank
    assign marquee_heading = 'collection_marquee.placeholder_title' | t
  endif
  assign size = block.settings.heading_size | default: 'display'
  assign font_role = block.settings.font | default: 'heading'
  unless font_role == 'heading' or font_role == 'body' or font_role == 'accent'
    assign font_role = 'heading'
  endunless
  assign mobile_size = block.settings.custom_heading_size | default: 68
  if block.settings.custom_mobile
    assign mobile_size = block.settings.custom_heading_size_mobile | default: 40
  endif
%}
<collection-marquee class="collection-marquee" data-speed="{{ block.settings.animation_speed | default: 0.6 }}" data-direction="{{ block.settings.animation_direction | default: 'backward' }}" style="--cm-gap:{{ block.settings.gap_desktop | default: 24 }}px;--cm-gap-mobile:{{ block.settings.gap_mobile | default: 20 }}px;--cm-font:var(--font-{{ font_role }}-family);--cm-weight:var(--font-{{ font_role }}-weight);--cm-style:var(--font-{{ font_role }}-style);{% if block.settings.text_color != blank %}--cm-color:{{ block.settings.text_color }};{% endif %}{% if size == 'custom' %}--cm-size:{{ block.settings.custom_heading_size | default: 68 }}px;--cm-size-mobile:{{ mobile_size }}px;--cm-case:{{ block.settings.text_case | default: 'uppercase' }};{% render 'marquee-letter-spacing', value: block.settings.letter_spacing %}{% endif %}" {{ block.shopify_attributes }}>
  {% if marquee_collection.url != blank %}
    <a class="collection-marquee__viewport" href="{{ marquee_collection.url }}" aria-label="{{ marquee_heading | escape }}">
  {% else %}
    <div class="collection-marquee__viewport" tabindex="0" role="region" aria-label="{{ marquee_heading | escape }}">
  {% endif %}
    <div class="collection-marquee__track">
      <div class="collection-marquee__cycle" data-cm-source>
        <h2 data-cm-title class="collection-marquee__solid collection-marquee__title heading-text heading-{{ size }}">{{ marquee_heading | escape }}</h2>
        {% content_for 'block', type: '_collection-marquee-image', id: 'image-1' %}
        {% content_for 'block', type: '_collection-marquee-image', id: 'image-2' %}
        <span class="collection-marquee__title collection-marquee__outline heading-text heading-{{ size }} virelle-text-outline" aria-hidden="true">{{ marquee_heading | escape }}</span>
      </div>
    </div>
  {% if marquee_collection.url != blank %}</a>{% else %}</div>{% endif %}
</collection-marquee>

{% stylesheet %}
  .collection-marquee { display: block; position: relative; width: 100%; min-width: 0; overflow: hidden; color: var(--heading-color); }
  .collection-marquee__title { flex: 0 0 auto; width: max-content; margin: 4px 0; white-space: nowrap; max-width: none; transition: translate 400ms cubic-bezier(.22, 1, .36, 1); }
  .collection-marquee .collection-marquee__title { font-family: var(--cm-font, var(--font-heading-family)); font-style: var(--cm-style, var(--font-heading-style)); font-weight: var(--cm-weight, var(--font-heading-weight)); color: var(--cm-color, var(--heading-color)); }
  .collection-marquee__title.heading-custom { font-family: var(--cm-font); font-style: var(--cm-style); font-weight: var(--cm-weight); font-size: var(--cm-size); line-height: 1.2; letter-spacing: var(--mq-tracking, 0em); text-transform: var(--cm-case); }
  .collection-marquee[data-active] .collection-marquee__title { translate: 0 -4px; }
  .collection-marquee__viewport { display: block; color: inherit; text-decoration: none; overflow-x: auto; scrollbar-width: none; overscroll-behavior-inline: contain; }
  .collection-marquee__viewport::-webkit-scrollbar { display: none; }
  .collection-marquee__track { display: flex; width: max-content; align-items: center; }
  .collection-marquee__cycle { display: flex; width: max-content; flex: 0 0 auto; align-items: center; gap: var(--cm-gap); padding-inline-end: 40px; min-height: 100px; }
  .collection-marquee__cycle > * { transition: opacity 100ms ease-out, translate 200ms cubic-bezier(.22, 1, .36, 1); }
  .collection-marquee__solid { order: 1; }
  .collection-marquee__cycle > .marquee-image-block { order: 2; }
  .collection-marquee__cycle > .marquee-image-block:first-of-type { order: 0; }
  .collection-marquee__outline { order: 3; margin-inline-start: calc(40px - var(--cm-gap)); --text-outline-color: var(--cm-color, var(--heading-color)); }
  .collection-marquee[data-ready]:not([data-strip-visible]):not([data-measuring]) .collection-marquee__cycle > * { opacity: 0; pointer-events: none; transition: none; }
  .collection-marquee[data-ready]:not([data-strip-visible]):not([data-measuring]) [data-cm-source] > [data-cm-title] { opacity: 1; pointer-events: auto; }
  .collection-marquee:not([data-ready]):not([data-measuring]) .collection-marquee__track { width: 100%; justify-content: center; }
  .collection-marquee:not([data-ready]):not([data-measuring]) .collection-marquee__cycle { padding-inline: 0; }
  .collection-marquee:not([data-ready]):not([data-measuring]) .collection-marquee__cycle > :not([data-cm-title]) { display: none; }
  .collection-marquee[data-ready] .collection-marquee__viewport { overflow-x: hidden; }
  @media (max-width: 767.98px), (hover: none) {
    .collection-marquee__cycle { min-height: 60px; gap: var(--cm-gap-mobile); padding-inline-end: 20px; }
    .collection-marquee__outline { margin-inline-start: 0; }
    .collection-marquee__title.heading-custom { font-size: var(--cm-size-mobile); }
    .collection-marquee[data-active] .collection-marquee__title { translate: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .collection-marquee[data-ready] .collection-marquee__viewport { overflow-x: auto; }
    .collection-marquee__cycle > * { transition: none; translate: none; }
    .collection-marquee[data-active] .collection-marquee__title { translate: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Marquee",
  "tag": null,
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the collection title."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font",
      "label": "Font",
      "options": [
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:labels.heading_size",
      "options": [
        {
          "value": "display",
          "label": "t:options.heading_size.display"
        },
        {
          "value": "xl",
          "label": "t:options.heading_size.xl"
        },
        {
          "value": "lg",
          "label": "t:options.heading_size.lg"
        },
        {
          "value": "md",
          "label": "t:options.heading_size.md"
        },
        {
          "value": "sm",
          "label": "t:options.heading_size.sm"
        },
        {
          "value": "xs",
          "label": "t:options.heading_size.xs"
        },
        {
          "value": "custom",
          "label": "t:options.heading_size.custom"
        }
      ],
      "default": "display"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "text_color",
      "label": "t:labels.text_color",
      "info": "t:info.heading_text_color"
    },
    {
      "type": "range",
      "id": "custom_heading_size",
      "label": "Font size",
      "min": 10,
      "max": 200,
      "step": 2,
      "default": 68,
      "unit": "px",
      "visible_if": "{{ block.settings.heading_size == 'custom' }}"
    },
    {
      "type": "select",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "options": [
        {
          "value": "tighter",
          "label": "Tighter"
        },
        {
          "value": "tight",
          "label": "Tight"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "relaxed",
          "label": "Relaxed"
        },
        {
          "value": "loose",
          "label": "Loose"
        },
        {
          "value": "extra_loose",
          "label": "Extra loose"
        },
        {
          "value": "ultra_loose",
          "label": "Ultra loose"
        },
        {
          "value": "mega_loose",
          "label": "Mega loose"
        }
      ],
      "default": "normal",
      "visible_if": "{{ block.settings.heading_size == 'custom' }}"
    },
    {
      "type": "select",
      "id": "text_case",
      "label": "Text case",
      "options": [
        {
          "value": "none",
          "label": "Original"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        }
      ],
      "default": "uppercase",
      "visible_if": "{{ block.settings.heading_size == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "custom_mobile",
      "label": "Custom for mobile",
      "default": false,
      "visible_if": "{{ block.settings.heading_size == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_heading_size_mobile",
      "label": "Font size mobile",
      "min": 10,
      "max": 80,
      "step": 1,
      "default": 40,
      "unit": "px",
      "visible_if": "{{ block.settings.heading_size == 'custom' and block.settings.custom_mobile }}"
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Speed",
      "min": 0.1,
      "max": 2,
      "step": 0.1,
      "default": 0.6,
      "unit": "x"
    },
    {
      "type": "select",
      "id": "animation_direction",
      "label": "Direction",
      "options": [
        {
          "value": "backward",
          "label": "Left"
        },
        {
          "value": "forward",
          "label": "Right"
        }
      ],
      "default": "backward"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Desktop gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Mobile gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "blocks": [
        {
          "type": "_collection-marquee-image",
          "settings": {
            "image_ratio": "custom",
            "image_ratio_custom_width": 2,
            "image_ratio_custom_height": 1,
            "width_custom_desktop": 200,
            "width_custom_mobile": 120,
            "corner_radius": "square"
          },
          "id": "image-1",
          "static": true
        },
        {
          "type": "_collection-marquee-image",
          "settings": {
            "image_ratio": "custom",
            "image_ratio_custom_width": 2,
            "image_ratio_custom_height": 1,
            "width_custom_desktop": 200,
            "width_custom_mobile": 120,
            "corner_radius": "square"
          },
          "id": "image-2",
          "static": true
        }
      ]
    }
  ]
}
{% endschema %}
