{% liquid
  assign group_alignment = block.settings.alignment | default: 'center'
  assign group_gap = block.settings.gap | default: 8 | plus: 0
  assign group_gap_mobile = block.settings.gap_mobile | default: group_gap | plus: 0
  assign group_alignment_mobile = group_alignment
  if block.settings.customize_mobile_alignment
    assign group_alignment_mobile = block.settings.alignment_mobile | default: group_alignment
  endif
%}

<div class="gallery-header-group" style="--gallery-header-align: {{ group_alignment }}; --gallery-header-align-mobile: {{ group_alignment_mobile }}; --gallery-header-gap: {{ group_gap }}px; --gallery-header-gap-mobile: {{ group_gap_mobile }}px;" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% render 'runtime-stylesheet', filename: 'component-runtime-blocks-gallery-header-group.css', section_index: section.index %}

{% schema %}
{
  "name": "Group",
  "tag": null,
  "blocks": [
  {
    "type": "button"
  },
  {
    "type": "buttons"
  },
  {
    "type": "countdown-timer"
  },
  {
    "type": "divider"
  },
  {
    "type": "editorial-text"
  },
  {
    "type": "eyebrow"
  },
  {
    "type": "header"
  },
  {
    "type": "heading"
  },
  {
    "type": "icon"
  },
  {
    "type": "image"
  },
  {
    "type": "logo"
  },
  {
    "type": "scroll-to"
  },
  {
    "type": "spacer"
  },
  {
    "type": "text"
  },
  {
    "type": "video"
  }
],
  "settings": [
    { "type": "select", "id": "alignment", "label": "Alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },
    { "type": "range", "id": "gap", "label": "Gap", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 8 },
    { "type": "checkbox", "id": "customize_mobile_alignment", "label": "Customize mobile alignment", "default": false },
    { "type": "select", "id": "alignment_mobile", "label": "Mobile alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center", "visible_if": "{{ block.settings.customize_mobile_alignment }}" },
    { "type": "range", "id": "gap_mobile", "label": "Mobile gap", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 8 }
  ],
  "presets": [{ "name": "Gallery header", "category": "Gallery" }]
}
{% endschema %}
