{% doc %}
  Renders a Video media kernel with uploaded or externally hosted video,
  optional poster, playback settings, play button styling, responsive sizing,
  and local padding.

  The Video kernel owns media presentation and playback behavior. Parent
  blocks own composition order and gap. This block has no business data or
  nested children.

  @example
  {% content_for 'block', type: 'video', id: 'video' %}
{% enddoc %}

{% liquid
  assign video_ratio = 'auto'
  assign video_width_desktop = 'fit-content'
  assign video_width_desktop_mode = 'fit'
  assign video_width_mobile = 'fit-content'
  assign video_width_mobile_mode = 'fit'
  assign video_max_width_desktop = 'none'
  assign video_max_width_mobile = 'none'
  assign video_radius = 'var(--media-radius)'
  assign video_id = block.id | prepend: 'video-'
  assign video_title = 'accessibility.video' | t
  assign video_padding_top_mobile = block.settings.padding_top
  assign video_padding_bottom_mobile = block.settings.padding_bottom
  assign video_padding_left_mobile = block.settings.padding_left
  assign video_padding_right_mobile = block.settings.padding_right
  assign video_has_media = false

  case block.settings.aspect_ratio
    when 'square'
      assign video_ratio = '1 / 1'
    when 'portrait'
      assign video_ratio = '3 / 4'
    when 'landscape'
      assign video_ratio = '4 / 3'
    when 'wide'
      assign video_ratio = '16 / 9'
    when 'custom'
      assign video_ratio = block.settings.custom_aspect_ratio | default: 1 | append: ' / 1'
  endcase

  if block.settings.width_desktop == blank or block.settings.width_desktop == 'fill'
    assign video_width_desktop = '100%'
    assign video_width_desktop_mode = 'fill'
  elsif block.settings.width_desktop == 'custom'
    assign video_width_desktop = block.settings.width_custom_desktop | append: '%'
    assign video_width_desktop_mode = 'custom'
  endif

  if block.settings.width_mobile == blank or block.settings.width_mobile == 'fill'
    assign video_width_mobile = '100%'
    assign video_width_mobile_mode = 'fill'
  elsif block.settings.width_mobile == 'custom'
    assign video_width_mobile = block.settings.width_custom_mobile | append: '%'
    assign video_width_mobile_mode = 'custom'
  endif

  if block.settings.limit_width_desktop
    assign video_max_width_desktop = block.settings.max_width_desktop | append: 'px'
  endif

  if block.settings.limit_width_mobile
    assign video_max_width_mobile = block.settings.max_width_mobile | append: 'px'
  endif

  case block.settings.corner_radius
    when 'none'
      assign video_radius = '0px'
    when 'small'
      assign video_radius = '4px'
    when 'medium'
      assign video_radius = '8px'
    when 'large'
      assign video_radius = '16px'
    when 'full'
      assign video_radius = '999px'
  endcase

  if block.settings.customize_mobile_padding
    assign video_padding_top_mobile = block.settings.padding_top_mobile
    assign video_padding_bottom_mobile = block.settings.padding_bottom_mobile
    assign video_padding_left_mobile = block.settings.padding_left_mobile
    assign video_padding_right_mobile = block.settings.padding_right_mobile
  endif

  if block.settings.video_source == 'uploaded' and block.settings.video != blank
    assign video_has_media = true
  elsif block.settings.video_source == 'external_url' and block.settings.external_video_url != blank
    assign video_has_media = true
  endif
%}

<div
  class="video-block{% if block.settings.show_video_first_mobile %} video-block--mobile-first{% endif %}"
  data-block-width="{{ video_width_desktop_mode }}"
  data-block-width-mobile="{{ video_width_mobile_mode }}"
  data-video-autoplay="{{ block.settings.autoplay }}"
  style="--video-ratio: {{ video_ratio }}; --video-width-desktop: {{ video_width_desktop }}; --video-width-mobile: {{ video_width_mobile }}; --video-max-width-desktop: {{ video_max_width_desktop }}; --video-max-width-mobile: {{ video_max_width_mobile }}; --video-radius: {{ video_radius }}; --video-play-button-size: {{ block.settings.play_button_size_desktop }}px; --video-play-button-size-mobile: {{ block.settings.play_button_size_mobile }}px; --video-play-button-background: {{ block.settings.play_button_background_color | escape }}; --video-play-button-icon: {{ block.settings.play_button_icon_color | escape }}; --video-padding-top: {{ block.settings.padding_top }}px; --video-padding-bottom: {{ block.settings.padding_bottom }}px; --video-padding-left: {{ block.settings.padding_left }}px; --video-padding-right: {{ block.settings.padding_right }}px; --video-padding-top-mobile: {{ video_padding_top_mobile }}px; --video-padding-bottom-mobile: {{ video_padding_bottom_mobile }}px; --video-padding-left-mobile: {{ video_padding_left_mobile }}px; --video-padding-right-mobile: {{ video_padding_right_mobile }}px;"
  {{ block.shopify_attributes }}
>
  <div class="video-block__media{% if block.settings.aspect_ratio == 'original' or block.settings.aspect_ratio == blank %} video-block__media--original{% endif %}{% unless video_has_media %} video-block__media--placeholder{% endunless %}" role="group" aria-label="{{ video_title }}">
    {% render 'media', media_type: 'video', video: block.settings.video, external_video_url: block.settings.external_video_url, video_source: block.settings.video_source, autoplay: false, muted: block.settings.autoplay, loop: block.settings.loop_video, controls: false, video_id: video_id, video_title: video_title, placeholder_class: 'video-block__placeholder' %}
    {% if video_has_media and block.settings.video_source == 'uploaded' and block.settings.cover_image != blank %}
      <div class="video-block__cover" data-video-cover aria-hidden="true">
        {{ block.settings.cover_image | image_url: width: 1600 | image_tag: alt: '', class: 'video-block__cover-image', loading: 'lazy' }}
      </div>
    {% endif %}
    {% if video_has_media and block.settings.video_source == 'uploaded' %}
      <button class="video-block__play-button" type="button" data-video-play-button data-video-state="paused" data-play-label="{{ 'accessibility.play_video' | t | escape }}" data-pause-label="{{ 'accessibility.pause_video' | t | escape }}" aria-label="{{ 'accessibility.play_video' | t | escape }}" aria-controls="{{ video_id | escape }}">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path data-video-play-icon d="m9 6 9 6-9 6z" /></svg>
      </button>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .video-block {
    max-width: 100%;
    min-width: 0;
    padding-block: var(--video-padding-top) var(--video-padding-bottom);
    padding-inline: var(--video-padding-left) var(--video-padding-right);
    width: var(--video-width-desktop);
  }

  .video-block__media {
    aspect-ratio: var(--video-ratio);
    background: var(--color-background);
    border-radius: var(--video-radius);
    display: block;
    max-width: var(--video-max-width-desktop);
    min-width: 0;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .video-block__media > video,
  .video-block__media > iframe {
    border: 0;
    display: block;
    height: 100%;
    object-fit: cover;
    position: relative;
    width: 100%;
    z-index: 0;
  }

  .video-block__media > iframe {
    aspect-ratio: 16 / 9;
  }

  .video-block__media--original > video {
    height: auto;
  }

  .video-block__media--original.video-block__media--placeholder {
    aspect-ratio: 16 / 9;
  }

  .video-block__cover {
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    position: absolute;
    z-index: 1;
  }

  .video-block__cover[hidden] {
    display: none;
  }

  .video-block__cover-image {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .video-block__placeholder {
    align-items: center;
    background: #f6f6f7;
    color: var(--color-text);
    display: flex;
    height: 100%;
    justify-content: center;
    width: 100%;
  }

  .video-block__placeholder svg {
    display: block;
    height: 100%;
    width: 100%;
  }

  .video-block__play-button {
    align-items: center;
    appearance: none;
    background: var(--video-play-button-background);
    border: 0;
    border-radius: 50%;
    color: var(--video-play-button-icon);
    cursor: pointer;
    display: grid;
    height: var(--video-play-button-size);
    inset: 50% auto auto 50%;
    padding: 0;
    place-items: center;
    position: absolute;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: opacity var(--motion-duration) var(--motion-ease);
    width: var(--video-play-button-size);
    z-index: 2;
  }

  .video-block__media:hover .video-block__play-button,
  .video-block__media:focus-within .video-block__play-button,
  .video-block__play-button[data-video-state='paused'],
  .video-block__play-button:focus-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .video-block__play-button[hidden] {
    display: none;
  }

  .video-block__play-button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .video-block__play-button svg {
    fill: currentColor;
    height: 45%;
    width: 45%;
  }

  @media (hover: none), (pointer: coarse) {
    .video-block__play-button {
      opacity: 1;
      pointer-events: auto;
    }
  }

  @media screen and (max-width: 767.98px) {
    .video-block {
      padding-block: var(--video-padding-top-mobile) var(--video-padding-bottom-mobile);
      padding-inline: var(--video-padding-left-mobile) var(--video-padding-right-mobile);
      width: var(--video-width-mobile);
    }

    .video-block__media {
      max-width: var(--video-max-width-mobile);
    }

    .video-block__play-button {
      height: var(--video-play-button-size-mobile);
      width: var(--video-play-button-size-mobile);
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const cleanups = new WeakMap();

    const getBlocks = (root) => {
      if (root.matches && root.matches('.video-block')) {
        return [root];
      }

      return Array.from(root.querySelectorAll('.video-block'));
    };

    const initBlock = (block) => {
      if (cleanups.has(block)) return;

      const video = block.querySelector('video');
      const playButton = block.querySelector('[data-video-play-button]');
      const cover = block.querySelector('[data-video-cover]');
      const playIcon = playButton && playButton.querySelector('[data-video-play-icon]');
      if (!video || !playButton) return;

      const hideCover = () => {
        if (cover) cover.hidden = true;
      };

      const syncPlayButton = () => {
        const isPlaying = !video.paused && !video.ended;
        playButton.dataset.videoState = isPlaying ? 'playing' : 'paused';
        playButton.setAttribute('aria-label', isPlaying ? playButton.dataset.pauseLabel : playButton.dataset.playLabel);
        if (playIcon) {
          playIcon.setAttribute('d', isPlaying ? 'M7 5h3v14H7zM14 5h3v14h-3z' : 'm9 6 9 6-9 6z');
        }
      };

      const playVideo = () => {
        const playPromise = video.play();
        if (playPromise) playPromise.catch(syncPlayButton);
      };

      const onPlay = () => {
        hideCover();
        syncPlayButton();
      };
      const onPause = () => {
        syncPlayButton();
      };
      const onEnded = () => {
        syncPlayButton();
      };
      const onClick = () => {
        if (video.paused || video.ended) {
          playVideo();
        } else {
          video.pause();
        }
      };

      video.addEventListener('play', onPlay);
      video.addEventListener('pause', onPause);
      video.addEventListener('ended', onEnded);
      playButton.addEventListener('click', onClick);
      syncPlayButton();

      if (block.dataset.videoAutoplay === 'true' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        playVideo();
      }

      cleanups.set(block, () => {
        video.removeEventListener('play', onPlay);
        video.removeEventListener('pause', onPause);
        video.removeEventListener('ended', onEnded);
        playButton.removeEventListener('click', onClick);
      });
    };

    const destroy = (root) => {
      getBlocks(root).forEach((block) => {
        const cleanup = cleanups.get(block);
        if (!cleanup) return;
        cleanup();
        cleanups.delete(block);
      });
    };

    const init = (root) => getBlocks(root).forEach(initBlock);
    const onSectionLoad = (event) => init(event.target);
    const onSectionUnload = (event) => destroy(event.target);

    document.addEventListener('shopify:section:load', onSectionLoad);
    document.addEventListener('shopify:section:unload', onSectionUnload);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => init(document), { once: true });
    } else {
      init(document);
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.video",
  "settings": [
    { "type": "select", "id": "video_source", "label": "t:labels.video_source", "options": [
      { "value": "uploaded", "label": "t:options.video_source.uploaded" },
      { "value": "external_url", "label": "t:options.video_source.external_url" }
    ], "default": "uploaded" },
    { "visible_if": "{{ block.settings.video_source == 'uploaded' }}", "type": "video", "id": "video", "label": "t:labels.video" },
    { "visible_if": "{{ block.settings.video_source == 'external_url' }}", "type": "video_url", "id": "external_video_url", "label": "t:labels.external_video_url", "accept": ["youtube", "vimeo"] },
    { "type": "checkbox", "id": "autoplay", "label": "t:labels.autoplay", "default": false },
    { "type": "checkbox", "id": "loop_video", "label": "t:labels.loop_video", "default": false },
    { "type": "image_picker", "id": "cover_image", "label": "t:labels.cover_image" },
    { "type": "checkbox", "id": "show_video_first_mobile", "label": "t:labels.show_video_first_mobile", "default": false },
    { "type": "select", "id": "aspect_ratio", "label": "t:labels.aspect_ratio", "options": [
      { "value": "original", "label": "t:options.aspect_ratio.original" },
      { "value": "square", "label": "t:options.aspect_ratio.square" },
      { "value": "portrait", "label": "t:options.aspect_ratio.portrait" },
      { "value": "landscape", "label": "t:options.aspect_ratio.landscape" },
      { "value": "wide", "label": "t:options.aspect_ratio.wide" },
      { "value": "custom", "label": "t:options.aspect_ratio.custom" }
    ], "default": "original" },
    { "visible_if": "{{ block.settings.aspect_ratio == 'custom' }}", "type": "range", "id": "custom_aspect_ratio", "label": "t:labels.custom_aspect_ratio", "min": 0.3, "max": 3, "step": 0.1, "default": 1 },
    { "type": "header", "content": "t:general.play_button" },
    { "type": "range", "id": "play_button_size_desktop", "label": "t:labels.play_button_size_desktop", "min": 24, "max": 96, "step": 1, "unit": "px", "default": 50 },
    { "type": "range", "id": "play_button_size_mobile", "label": "t:labels.play_button_size_mobile", "min": 24, "max": 96, "step": 1, "unit": "px", "default": 40 },
    { "type": "color", "id": "play_button_background_color", "label": "t:labels.play_button_background_color", "default": "#FFFFFF" },
    { "type": "color", "id": "play_button_icon_color", "label": "t:labels.play_button_icon_color", "default": "#1C1C1C" },
    { "type": "header", "content": "t:general.desktop" },
    { "type": "select", "id": "width_desktop", "label": "t:labels.width", "options": [
      { "value": "fit", "label": "t:options.width.fit" },
      { "value": "fill", "label": "t:options.width.fill" },
      { "value": "custom", "label": "t:options.width.custom" }
    ], "default": "fill" },
    { "visible_if": "{{ block.settings.width_desktop == 'custom' }}", "type": "range", "id": "width_custom_desktop", "label": "t:labels.custom_width", "min": 1, "max": 100, "step": 1, "unit": "%", "default": 100 },
    { "type": "checkbox", "id": "limit_width_desktop", "label": "t:labels.limit_width", "default": false },
    { "visible_if": "{{ block.settings.limit_width_desktop }}", "type": "range", "id": "max_width_desktop", "label": "t:labels.max_width", "min": 0, "max": 1600, "step": 16, "unit": "px", "default": 1600 },
    { "type": "header", "content": "t:general.mobile" },
    { "type": "select", "id": "width_mobile", "label": "t:labels.width_mobile", "options": [
      { "value": "fit", "label": "t:options.width.fit" },
      { "value": "fill", "label": "t:options.width.fill" },
      { "value": "custom", "label": "t:options.width.custom" }
    ], "default": "fill" },
    { "visible_if": "{{ block.settings.width_mobile == 'custom' }}", "type": "range", "id": "width_custom_mobile", "label": "t:labels.custom_width", "min": 1, "max": 100, "step": 1, "unit": "%", "default": 100 },
    { "type": "checkbox", "id": "limit_width_mobile", "label": "t:labels.limit_width", "default": false },
    { "visible_if": "{{ block.settings.limit_width_mobile }}", "type": "range", "id": "max_width_mobile", "label": "t:labels.max_width", "min": 0, "max": 1600, "step": 16, "unit": "px", "default": 1600 },
    { "type": "header", "content": "t:general.border" },
    { "type": "select", "id": "corner_radius", "label": "t:labels.corner_radius", "options": [
      { "value": "inherit", "label": "t:options.corner_radius.inherit" },
      { "value": "none", "label": "t:options.corner_radius.none" },
      { "value": "small", "label": "t:options.corner_radius.small" },
      { "value": "medium", "label": "t:options.corner_radius.medium" },
      { "value": "large", "label": "t:options.corner_radius.large" },
      { "value": "full", "label": "t:options.corner_radius.full" }
    ], "default": "inherit" },
    { "type": "header", "content": "t:general.padding" },
    { "type": "range", "id": "padding_top", "label": "t:labels.padding_top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "t:labels.padding_bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_left", "label": "t:labels.padding_left", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right", "label": "t:labels.padding_right", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "checkbox", "id": "customize_mobile_padding", "label": "t:labels.customize_mobile", "default": false },
    { "visible_if": "{{ block.settings.customize_mobile_padding }}", "type": "range", "id": "padding_top_mobile", "label": "t:labels.padding_top_mobile", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "visible_if": "{{ block.settings.customize_mobile_padding }}", "type": "range", "id": "padding_bottom_mobile", "label": "t:labels.padding_bottom_mobile", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "visible_if": "{{ block.settings.customize_mobile_padding }}", "type": "range", "id": "padding_left_mobile", "label": "t:labels.padding_left_mobile", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "visible_if": "{{ block.settings.customize_mobile_padding }}", "type": "range", "id": "padding_right_mobile", "label": "t:labels.padding_right_mobile", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "t:general.video", "category": "t:general.basic" }]
}
{% endschema %}
