{% liquid
  assign menu_toggle_position = block.settings.position | default: 'left'
  unless menu_toggle_position == 'left' or menu_toggle_position == 'center' or menu_toggle_position == 'right'
    assign menu_toggle_position = 'left'
  endunless
%}

<button
  class="header-menu-toggle btn btn--unstyled"
  type="button"
  aria-expanded="false"
  aria-controls="HeaderMobileDrawer-{{ section.id }}"
  aria-label="Open menu"
  data-header-position="{{ menu_toggle_position }}"
  data-header-menu-toggle
>
  <span class="header-action__icon-target" {{ block.shopify_attributes }}>
  <span class="icon header-menu-toggle__open-icon" aria-hidden="true">
    {% render 'icon', icon: 'mara-header-menu', bare: true %}
  </span>
  <span class="icon header-menu-toggle__close-icon" aria-hidden="true">
    {% render 'icon', icon: 'x-mark', bare: true %}
  </span>
  </span>
  <span class="visually-hidden">Menu</span>
</button>

{% stylesheet %}
  .header-menu-toggle.btn {
    display: none;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: auto;
    min-width: 0;
    min-height: var(--button-height);
    color: var(--body-color);
  }

  .header-menu-toggle .icon {
    display: inline-flex;
  }

  .header-menu-toggle .icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .header-menu-toggle__close-icon {
    display: none !important;
  }

  .header-top--menu-open .header-menu-toggle__open-icon {
    display: none !important;
  }

  .header-top--menu-open .header-menu-toggle__close-icon {
    display: inline-flex !important;
  }

  @media (width < 992px) {
    .header-top[data-layout-ready='true'] .header__column--center:has(.header-menu-toggle[data-header-position='center']) {
      justify-content: center;
    }

    .header-menu-toggle.btn {
      display: inline-flex;
      min-height: var(--header-action-icon-size);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header_menu_toggle",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:info.header_menu_toggle"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:labels.position",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "t:general.header_menu_toggle",
      "category": "t:general.header"
    }
  ]
}
{% endschema %}
