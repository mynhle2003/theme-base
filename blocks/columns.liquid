{% doc %}
  Renders a two-slot responsive columns composition for editable theme blocks.

  Columns owns the two-slot structure, ratio, gaps, alignment, responsive
  stacking, mobile order and outer padding. The private column slots own the
  content placed inside each column.

  @example
  {% content_for 'block', type: 'columns', id: 'columns' %}
{% enddoc %}

{% liquid
  assign columns_left_width = '1fr'
  assign columns_right_width = '1fr'
  assign columns_stack_class = 'block-columns--stack-mobile'

  case block.settings.column_ratio
    when 'one_two'
      assign columns_left_width = '1fr'
      assign columns_right_width = '2fr'
    when 'two_one'
      assign columns_left_width = '2fr'
      assign columns_right_width = '1fr'
    when 'custom'
      assign custom_left_width = block.settings.custom_left_width | default: 50
      assign custom_right_width = 100 | minus: custom_left_width
      assign columns_left_width = custom_left_width | append: '%'
      assign columns_right_width = custom_right_width | append: '%'
  endcase

  case block.settings.collapse_breakpoint
    when 'tablet'
      assign columns_stack_class = 'block-columns--stack-tablet'
    when 'never'
      assign columns_stack_class = 'block-columns--no-stack'
  endcase
%}

<div
  class="block-columns {{ columns_stack_class }}{% if block.settings.mobile_order == 'right_first' %} block-columns--right-first{% endif %}"
  style="--columns-left-width: {{ columns_left_width }}; --columns-right-width: {{ columns_right_width }}; --columns-desktop-gap: {{ block.settings.desktop_gap | default: 24 }}px; --columns-mobile-gap: {{ block.settings.mobile_gap | default: 16 }}px; --columns-cross-axis-alignment: {{ block.settings.cross_axis_alignment | default: 'stretch' }}; --columns-vertical-alignment: {{ block.settings.vertical_alignment | default: 'start' }}; --columns-padding-top: {{ block.settings.padding_top | default: 0 }}px; --columns-padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px; --columns-padding-left: {{ block.settings.padding_left | default: 0 }}px; --columns-padding-right: {{ block.settings.padding_right | default: 0 }}px;"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .block-columns {
    align-items: var(--columns-vertical-alignment);
    column-gap: var(--columns-desktop-gap);
    display: grid;
    grid-template-columns: minmax(0, var(--columns-left-width)) minmax(0, var(--columns-right-width));
    justify-items: var(--columns-cross-axis-alignment);
    min-width: 0;
    padding-block: var(--columns-padding-top) var(--columns-padding-bottom);
    padding-inline: var(--columns-padding-left) var(--columns-padding-right);
    row-gap: var(--columns-desktop-gap);
    width: 100%;
  }

  .block-columns > .block-columns__slot {
    min-width: 0;
  }

  @media screen and (max-width: 1023.98px) {
    .block-columns--stack-tablet {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media screen and (max-width: 767.98px) {
    .block-columns {
      column-gap: var(--columns-mobile-gap);
      row-gap: var(--columns-mobile-gap);
    }

    .block-columns--stack-mobile {
      grid-template-columns: minmax(0, 1fr);
    }

    .block-columns--right-first > .block-columns__slot:first-child {
      order: 2;
    }

    .block-columns--right-first > .block-columns__slot:nth-child(2) {
      order: 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.columns",
  "blocks": [{ "type": "_column" }],
  "settings": [
    { "type": "header", "content": "t:general.layout" },
    {
      "type": "select",
      "id": "column_ratio",
      "label": "t:labels.column_ratio",
      "options": [
        { "value": "equal", "label": "t:options.column_ratio.equal" },
        { "value": "one_two", "label": "t:options.column_ratio.one_two" },
        { "value": "two_one", "label": "t:options.column_ratio.two_one" },
        { "value": "custom", "label": "t:options.column_ratio.custom" }
      ],
      "default": "equal"
    },
    {
      "visible_if": "{{ block.settings.column_ratio == 'custom' }}",
      "type": "range",
      "id": "custom_left_width",
      "label": "t:labels.custom_left_width",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    { "type": "range", "id": "desktop_gap", "label": "t:labels.desktop_gap", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "mobile_gap", "label": "t:labels.mobile_gap", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 16 },
    {
      "type": "select",
      "id": "cross_axis_alignment",
      "label": "t:labels.cross_axis_alignment",
      "options": [
        { "value": "stretch", "label": "t:options.alignment.stretch" },
        { "value": "start", "label": "t:options.alignment.start" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "end", "label": "t:options.alignment.end" }
      ],
      "default": "stretch"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:labels.vertical_alignment",
      "options": [
        { "value": "start", "label": "t:options.alignment.start" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "end", "label": "t:options.alignment.end" },
        { "value": "stretch", "label": "t:options.alignment.stretch" }
      ],
      "default": "start"
    },
    { "type": "header", "content": "t:general.stacking" },
    {
      "type": "select",
      "id": "collapse_breakpoint",
      "label": "t:labels.breakpoint",
      "options": [
        { "value": "tablet", "label": "t:options.collapse_breakpoint.tablet" },
        { "value": "mobile", "label": "t:options.collapse_breakpoint.mobile" },
        { "value": "never", "label": "t:options.collapse_breakpoint.never" }
      ],
      "default": "tablet"
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "t:labels.mobile_order",
      "options": [
        { "value": "left_first", "label": "t:options.mobile_order.left_first_hyphen" },
        { "value": "right_first", "label": "t:options.mobile_order.right_first_hyphen" }
      ],
      "default": "left_first"
    },
    { "type": "header", "content": "t:general.padding" },
    { "type": "range", "id": "padding_top", "label": "t:labels.padding_top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "t:labels.padding_bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_left", "label": "t:labels.padding_left", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right", "label": "t:labels.padding_right", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [
    {
      "name": "t:general.columns",
      "category": "t:general.layout",
      "settings": {
        "column_ratio": "equal",
        "desktop_gap": 24,
        "mobile_gap": 16,
        "cross_axis_alignment": "stretch",
        "vertical_alignment": "start",
        "collapse_breakpoint": "tablet",
        "mobile_order": "left_first"
      },
      "blocks": [
        { "type": "_column", "blocks": [{ "type": "text" }] },
        { "type": "_column", "blocks": [{ "type": "text" }] }
      ]
    }
  ]
}
{% endschema %}
