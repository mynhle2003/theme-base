{% doc %}
  Retired private Compact block. Saved compositions migrate to product-card-compact.
  Keep this schema-only tombstone so existing theme watchers replace its old
  stylesheet on draft themes instead of leaving conflicting Compact CSS behind.
{% enddoc %}
{% schema %}
{
  "name": "Product card: Compact",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:labels.product",
      "info": "Leave blank to use the first product from the parent collection, when available."
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "t:labels.show_price",
      "default": true
    },
    {
      "type": "range",
      "id": "thumbnail_size",
      "label": "Thumbnail size",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add",
      "default": false
    }
  ]
}
{% endschema %}
