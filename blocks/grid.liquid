{% doc %}
  Renders a responsive grid of editable theme blocks.

  Grid owns the column structure, gaps, item alignment, responsive collapse
  behavior and outer padding. Child blocks own their content and presentation.

  @example
  {% content_for 'block', type: 'grid', id: 'grid' %}
{% enddoc %}

{% liquid
  assign grid_desktop_columns = block.settings.desktop_columns | default: 4
  assign grid_tablet_columns = block.settings.tablet_columns | default: 3
  assign grid_mobile_columns = block.settings.mobile_columns | default: 1
  assign grid_collapse_breakpoint = block.settings.collapse_breakpoint | default: 'tablet'
  assign grid_stacking_behavior = block.settings.stacking_behavior | default: 'stack'
%}

<div
  class="grid-block grid-block--collapse-{{ grid_collapse_breakpoint }} grid-block--{{ grid_stacking_behavior }} grid-block--{{ block.settings.item_height | default: 'auto' }}"
  style="--grid-columns-desktop: {{ grid_desktop_columns }}; --grid-columns-tablet: {{ grid_tablet_columns }}; --grid-columns-mobile: {{ grid_mobile_columns }}; --grid-column-gap: {{ block.settings.column_gap | default: 24 }}px; --grid-row-gap: {{ block.settings.row_gap | default: 24 }}px; --grid-mobile-gap: {{ block.settings.mobile_gap | default: 16 }}px; --grid-item-alignment: {{ block.settings.item_alignment | default: 'stretch' }}; --grid-padding-top: {{ block.settings.padding_top | default: 0 }}px; --grid-padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px; --grid-padding-left: {{ block.settings.padding_left | default: 0 }}px; --grid-padding-right: {{ block.settings.padding_right | default: 0 }}px;"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .grid-block {
    align-items: var(--grid-item-alignment);
    column-gap: var(--grid-column-gap);
    display: grid;
    grid-auto-rows: auto;
    grid-template-columns: repeat(var(--grid-columns-desktop), minmax(0, 1fr));
    justify-items: var(--grid-item-alignment);
    min-width: 0;
    padding-block: var(--grid-padding-top) var(--grid-padding-bottom);
    padding-inline: var(--grid-padding-left) var(--grid-padding-right);
    row-gap: var(--grid-row-gap);
    width: 100%;
  }

  .grid-block--equal {
    grid-auto-rows: 1fr;
  }

  .grid-block--scroll {
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }

  .grid-block--scroll > * {
    min-width: min(18rem, 80vw);
  }

  @media screen and (max-width: 1023.98px) {
    .grid-block--collapse-tablet {
      grid-template-columns: repeat(var(--grid-columns-tablet), minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 767.98px) {
    .grid-block {
      column-gap: var(--grid-mobile-gap);
      row-gap: var(--grid-mobile-gap);
      padding-block: var(--grid-padding-top) var(--grid-padding-bottom);
      padding-inline: var(--grid-padding-left) var(--grid-padding-right);
    }

    .grid-block--collapse-tablet,
    .grid-block--collapse-mobile {
      grid-template-columns: repeat(var(--grid-columns-mobile), minmax(0, 1fr));
    }

    .grid-block--collapse-mobile {
      grid-template-columns: repeat(var(--grid-columns-mobile), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

