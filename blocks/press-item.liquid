{% doc %}
  Renders one Press quote item with nested quote content and an inert logo
  template. The reveal runtime clones the template into the pagination row so
  this block remains the owner of its image settings.
{% enddoc %}

{% liquid
  assign press_item_ratio = block.settings.image_ratio | default: 'original'
  unless press_item_ratio == 'original' or press_item_ratio == 'square' or press_item_ratio == 'portrait' or press_item_ratio == 'landscape' or press_item_ratio == 'wide' or press_item_ratio == 'wide_2_1' or press_item_ratio == 'ratio_1_1' or press_item_ratio == 'ratio_4_5' or press_item_ratio == 'ratio_5_4' or press_item_ratio == 'ratio_6_7' or press_item_ratio == 'ratio_7_6' or press_item_ratio == 'ratio_5_7' or press_item_ratio == 'ratio_7_5' or press_item_ratio == 'ratio_2_3' or press_item_ratio == 'ratio_3_2' or press_item_ratio == 'ratio_4_3' or press_item_ratio == 'ratio_3_4' or press_item_ratio == 'ratio_2_1' or press_item_ratio == 'ratio_1_2' or press_item_ratio == 'ratio_16_9' or press_item_ratio == 'ratio_9_16' or press_item_ratio == 'ratio_12_5' or press_item_ratio == 'ratio_5_12' or press_item_ratio == 'ratio_48_17' or press_item_ratio == 'ratio_17_48' or press_item_ratio == 'ratio_5_8' or press_item_ratio == 'ratio_8_5'
    assign press_item_ratio = 'original'
  endunless

  assign press_item_ratio_value = 'auto'
  if press_item_ratio == 'original' and block.settings.image != blank
    assign press_item_ratio_value = block.settings.image.aspect_ratio | default: 'auto'
  endif
  case press_item_ratio
    when 'ratio_1_1'
      assign press_item_ratio_value = '1 / 1'
    when 'ratio_4_5'
      assign press_item_ratio_value = '4 / 5'
    when 'ratio_5_4'
      assign press_item_ratio_value = '5 / 4'
    when 'ratio_6_7'
      assign press_item_ratio_value = '6 / 7'
    when 'ratio_7_6'
      assign press_item_ratio_value = '7 / 6'
    when 'ratio_5_7'
      assign press_item_ratio_value = '5 / 7'
    when 'ratio_7_5'
      assign press_item_ratio_value = '7 / 5'
    when 'ratio_2_3'
      assign press_item_ratio_value = '2 / 3'
    when 'ratio_3_2'
      assign press_item_ratio_value = '3 / 2'
    when 'ratio_4_3'
      assign press_item_ratio_value = '4 / 3'
    when 'ratio_3_4'
      assign press_item_ratio_value = '3 / 4'
    when 'ratio_2_1'
      assign press_item_ratio_value = '2 / 1'
    when 'ratio_1_2'
      assign press_item_ratio_value = '1 / 2'
    when 'ratio_16_9'
      assign press_item_ratio_value = '16 / 9'
    when 'ratio_9_16'
      assign press_item_ratio_value = '9 / 16'
    when 'ratio_12_5'
      assign press_item_ratio_value = '12 / 5'
    when 'ratio_5_12'
      assign press_item_ratio_value = '5 / 12'
    when 'ratio_48_17'
      assign press_item_ratio_value = '48 / 17'
    when 'ratio_17_48'
      assign press_item_ratio_value = '17 / 48'
    when 'ratio_5_8'
      assign press_item_ratio_value = '5 / 8'
    when 'ratio_8_5'
      assign press_item_ratio_value = '8 / 5'
    when 'square'
      assign press_item_ratio_value = '1'
    when 'portrait'
      assign press_item_ratio_value = '0.8'
    when 'landscape'
      assign press_item_ratio_value = '1.3333'
    when 'wide_2_1'
      assign press_item_ratio_value = '2 / 1'
    when 'wide'
      assign press_item_ratio_value = '1.7778'
  endcase

  assign press_item_radius = block.settings.corner_radius | default: 'square'
  unless press_item_radius == 'inherit' or press_item_radius == 'square' or press_item_radius == 'rounded' or press_item_radius == 'full' or press_item_radius == 'custom'
    assign press_item_radius = 'square'
  endunless

  assign press_item_custom_radius = block.settings.custom_corner_radius | default: 0 | plus: 0
  if press_item_custom_radius < 0 or press_item_custom_radius > 100
    assign press_item_custom_radius = 0
  endif

  assign press_item_radius_value = 'var(--media-radius, var(--radius-square))'
  case press_item_radius
    when 'square'
      assign press_item_radius_value = 'var(--radius-square)'
    when 'rounded'
      assign press_item_radius_value = 'var(--radius-rounded)'
    when 'full'
      assign press_item_radius_value = 'var(--radius-pill)'
    when 'custom'
      assign press_item_radius_value = press_item_custom_radius | append: 'px'
  endcase

  assign press_item_width_desktop = block.settings.image_width_desktop | default: 110 | plus: 0
  assign press_item_width_mobile = block.settings.image_width_mobile | default: 70 | plus: 0
  if press_item_width_desktop < 40 or press_item_width_desktop > 240
    assign press_item_width_desktop = 110
  endif
  if press_item_width_mobile < 30 or press_item_width_mobile > 180
    assign press_item_width_mobile = 70
  endif
  capture press_item_image_sizes
    echo '(min-width: 768px) '
    echo press_item_width_desktop
    echo 'px, '
    echo press_item_width_mobile
    echo 'px'
  endcapture
%}

<article
  class="press-item reveal-carousel-item"
  data-carousel-slide
  data-press-image-width-desktop="{{ press_item_width_desktop }}"
  data-press-image-width-mobile="{{ press_item_width_mobile }}"
  data-press-image-ratio="{{ press_item_ratio_value }}"
  data-press-image-radius="{{ press_item_radius_value }}"
  {{ block.shopify_attributes }}
>
  <div class="press-item__content align-content">
    {% content_for 'blocks' %}
  </div>
  <template data-carousel-pagination-template>
    <div
      class="press-quotes__pagination-media reveal-carousel__pagination-adapt press-quotes__pagination-media--ratio-{{ press_item_ratio }} press-quotes__pagination-media--radius-{{ press_item_radius }}"
      style="--press-quotes-image-ratio: {{ press_item_ratio_value }}; --press-quotes-image-radius: {{ press_item_radius_value }}; --image-ratio: {{ press_item_ratio_value }};"
    >
      {% render 'image',
        image: block.settings.image,
        alt: block.settings.alt_text,
        class: 'press-quotes__pagination-image',
        width: 1200,
        widths: '160, 240, 320, 480, 640, 800, 1200',
        sizes: press_item_image_sizes
      %}
    </div>
  </template>
</article>

{% stylesheet %}
  .press-item {
    display: flex;
    flex-direction: column;
    align-items: var(--flex-align, start);
    width: 100%;
    min-width: 0;
    height: auto;
    color: var(--body-color);
    text-align: var(--text-align, inherit);
  }

  .press-item__content {
    align-self: stretch;
    width: 100%;
    min-width: 0;
    gap: var(--layout-grid-gap, 1rem);
  }

  .press-item__content:empty {
    display: none;
  }
{% endstylesheet %}

