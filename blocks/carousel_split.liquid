{% doc %}
  Renders the one-column carousel owned by Testimonial: split.
{% enddoc %}

{% liquid
  assign transition = block.settings.transition_style | default: 'slide'
  unless transition == 'slide' or transition == 'fade'
    assign transition = 'slide'
  endunless
  assign carousel_id = 'TestimonialSplit-' | append: block.id
  assign speed = block.settings.autoplay_speed | default: 4 | at_least: 3 | at_most: 7
  assign delay = speed | times: 1000
  assign carousel_label = 'general.testimonial_split' | t
  assign navigation_position = block.settings.navigation_position | default: 'right'
  unless navigation_position == 'left' or navigation_position == 'right'
    assign navigation_position = 'right'
  endunless
  assign navigation_position_mobile = block.settings.navigation_position_mobile | default: 'right'
  assign navigation_style = block.settings.navigation_style | default: 'icon_only'
  assign navigation_icon = block.settings.navigation_icon | default: 'long_arrow'
  assign navigation_behavior = block.settings.navigation_behavior | default: 'always'
%}
<script data-theme-module="{{ 'testimonial-split.js' | asset_url }}"></script>
{% if transition == 'fade' %}
  <link rel="stylesheet" href="{{ 'swiper-12.2.0-effect-fade.min.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'swiper-12.2.0-effect-fade.min.css' | asset_url | stylesheet_tag }}</noscript>
{% endif %}
{% capture slides %}{% content_for 'blocks' %}{% endcapture %}
{% capture carousel_style %}
  --carousel-padding-top: {{ block.settings.padding_top | default: 0 }}px;
  --carousel-padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px;
  {% if block.settings.customize_mobile_padding %}
    --carousel-padding-top-mobile: {{ block.settings.padding_top_mobile | default: 0 }}px;
    --carousel-padding-bottom-mobile: {{ block.settings.padding_bottom_mobile | default: 0 }}px;
  {% endif %}
{% endcapture %}
<div class="testimonial-split-carousel" style="{{ carousel_style | strip }}" data-testimonial-split
  data-navigation-mobile="{{ block.settings.show_navigation_on_mobile }}" data-navigation-position-mobile="{{ navigation_position_mobile }}" data-navigation-position="{{ navigation_position }}" data-navigation-style="{{ navigation_style }}" data-navigation-desktop="{{ block.settings.show_navigation_on_desktop }}"
  data-transition="{{ transition }}" data-swiper-columns-desktop="1" data-swiper-columns-mobile="1"
  data-swiper-gap-desktop="0" data-swiper-gap-mobile="0" data-swiper-pagination-desktop="false" data-swiper-pagination-mobile="false"
  data-carousel-loop="{{ block.settings.loop }}" data-swiper-autoplay="{{ block.settings.autoplay }}"
  data-swiper-autoplay-pause-on-hover="{{ block.settings.pause_on_hover }}" data-swiper-autoplay-delay="{{ delay }}"
  {{ block.shopify_attributes }}>
  {% render 'swiper-carousel', id: carousel_id, content: slides, root_class: 'testimonial-split-carousel__viewport', aria_label: carousel_label, autoplay: block.settings.autoplay, pause_on_hover: block.settings.pause_on_hover, autoplay_delay: delay, show_next_slide_preview: false, show_next_slide_preview_on_mobile: false %}
  {% render 'swiper-navigation',
    style: navigation_style,
    icon: navigation_icon,
    behavior: navigation_behavior,
    centered: false,
    wrapper_class: 'testimonial-split-controls',
    button_class: 'testimonial-split-controls__button',
    previous_attribute: 'data-carousel-previous',
    next_attribute: 'data-carousel-next'
  %}
</div>
{% stylesheet %}
  .testimonial-split-carousel { position: relative; width: 100%; min-width: 0; padding-block: var(--carousel-padding-top, 0px) var(--carousel-padding-bottom, 0px); }
  .testimonial-split-carousel__viewport > .swiper-wrapper { column-gap: 0; }
  .testimonial-split-carousel__viewport { width: 100%; min-width: 0; }
  .testimonial-split-carousel__viewport > .swiper-wrapper > .testimonial-split-slide { flex-basis: 100%; }
  .testimonial-split-carousel .swiper:not(.swiper-initialized) ~ .testimonial-split-controls { visibility: hidden; }
  .testimonial-split-carousel > .testimonial-split-controls { display: flex; align-items: center; gap: 16px; }
  .testimonial-split-carousel[data-navigation-style="icon_only"] .testimonial-split-controls__button { width: 24px; min-width: 24px; height: 24px; padding: 0; }
  .testimonial-split-carousel .testimonial-split-controls__button:disabled { opacity: 0.3; }
  @media (min-width: 768px) {
    .testimonial-split-carousel > .testimonial-split-controls { position: absolute; inset-block-end: var(--carousel-padding-bottom, 0px); inset-inline-end: 0; z-index: 2; }
    .testimonial-split-carousel[data-navigation-position="left"] > .testimonial-split-controls { inset-inline-start: 0; inset-inline-end: auto; }
    .testimonial-split-carousel[data-navigation-desktop="false"] > .testimonial-split-controls { display: none; }
  }
  @media (hover: hover) and (pointer: fine) {
    .testimonial-split-carousel > .swiper-carousel__navigation--show_on_hover { opacity: 0; transition: opacity var(--motion-duration-standard); }
    .testimonial-split-carousel:is(:hover, :focus-within) > .swiper-carousel__navigation--show_on_hover { opacity: 1; }
  }
  .testimonial-split-carousel.carousel-block--locked .testimonial-split-controls { display: none; }
  @media (max-width: 767.98px) {
    .testimonial-split-carousel > .testimonial-split-controls { justify-content: flex-end; margin-top: 24px; }
    .testimonial-split-carousel[data-navigation-position-mobile="left"] > .testimonial-split-controls { justify-content: flex-start; }
    .testimonial-split-carousel[data-navigation-mobile="false"] > .testimonial-split-controls { display: none; }
    .testimonial-split-carousel { padding-block: var(--carousel-padding-top-mobile, var(--carousel-padding-top, 0px)) var(--carousel-padding-bottom-mobile, var(--carousel-padding-bottom, 0px)); }
  }
{% endstylesheet %}
