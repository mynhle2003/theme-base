{% doc %}
  Banner owns its link and background. The fixed Banners parent owns shared presentation.

  @example
  {% content_for 'block', type: '_look-banner', id: 'banner' %}
{% enddoc %}

{% capture banner_children %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'media-card',
  inherit_presentation: true,
  media_card_block: block,
  children: banner_children,
  class_modifier: 'image-card--look-banner',
  use_image_ratio: true
%}

{% schema %}
{
  "name": "t:general.banner",
  "tag": null,
  "blocks": [
    {
      "type": "eyebrow"
    },
    {
      "type": "heading"
    },
    {
      "type": "text"
    },
    {
      "type": "button"
    },
    {
      "type": "buttons"
    },
    {
      "type": "icon"
    },
    {
      "type": "header"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    },
    {
      "type": "header",
      "content": "t:labels.background"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "t:labels.type",
      "options": [
        {
          "value": "image",
          "label": "t:general.image"
        },
        {
          "value": "video",
          "label": "t:general.video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "visible_if": "{{ block.settings.background_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:labels.mobile_image",
      "visible_if": "{{ block.settings.background_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:labels.video",
      "visible_if": "{{ block.settings.background_type == 'video' }}"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "t:labels.mobile_video",
      "visible_if": "{{ block.settings.background_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "t:labels.show_overlay",
      "default": false
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:labels.overlay_style",
      "options": [
        {
          "value": "solid",
          "label": "t:options.overlay_style.solid"
        },
        {
          "value": "gradient",
          "label": "t:options.overlay_style.gradient"
        }
      ],
      "default": "gradient",
      "visible_if": "{{ block.settings.show_overlay }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "default": "#00000033",
      "alpha": true,
      "label": "t:labels.overlay_color",
      "visible_if": "{{ block.settings.show_overlay and block.settings.overlay_style == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "overlay_gradient",
      "default": "linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.52))",
      "label": "t:labels.overlay_gradient",
      "visible_if": "{{ block.settings.show_overlay and block.settings.overlay_style == 'gradient' }}"
    }
  ],
  "presets": [
    {
      "name": "t:general.banner",
      "category": "t:general.cards",
      "settings": {},
      "blocks": [
        {
          "type": "eyebrow",
          "settings": {
            "text": "<p>Subheading</p>"
          }
        },
        {
          "type": "heading",
          "settings": {
            "text": "<p>Your Main Heading Goes Here</p>",
            "heading_size": "display",
            "html_tag": "h2"
          }
        },
        {
          "type": "button",
          "settings": {
            "button_label": "Button label",
            "button_style": "tertiary",
            "button_open_in_new_tab": false,
            "show_icon": true,
            "icon": "arrow",
            "icon_position": "after",
            "icon_size": "inherit",
            "icon_width": 20,
            "width": "fit",
            "width_mobile": "fit",
            "customize_mobile_padding": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
