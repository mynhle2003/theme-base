{% liquid
  assign social_network = block.settings.social_network | default: 'instagram'
  assign social_url = block.settings.social_url
  if social_url == blank
    assign social_setting_key = 'social_' | append: social_network
    assign social_url = settings[social_setting_key]
  endif
  assign text = block.settings.text | default: '@pam_sam'
  assign social_background = block.settings.social_background | default: '#F0E5E2'
  assign icon_size = block.settings.icon_size | default: 24 | plus: 0
  assign gallery_product = block.settings.product
  assign gallery_media_ratio = '1'
  capture gallery_media_ratio
    render 'image-ratio-value', setting: block.settings.image_ratio, fallback_ratio: '1'
  endcapture
  assign gallery_media_ratio = gallery_media_ratio | strip
%}

<article class="gallery-item swiper-slide{% if gallery_product != blank %} gallery-item--product{% endif %}" style="--gallery-item-social-background: {{ social_background | escape }}; --gallery-item-icon-size: {{ icon_size }}px; --gallery-item-media-ratio: {{ gallery_media_ratio }};" {{ block.shopify_attributes }}>
  <div class="gallery-item__media">
    {% render 'image', image: block.settings.image, mobile_image: block.settings.mobile_image, alt: block.settings.alt_text, class: 'gallery-item__image', width: 1600, widths: '320, 480, 640, 800, 1200, 1600', sizes: '(min-width: 1200px) 25vw, (min-width: 768px) 33vw, 100vw' %}
  </div>
  {% if gallery_product != blank %}
    <div class="gallery-item__product">
      <a class="gallery-item__product-image" href="{{ gallery_product.url }}">
        {{ gallery_product.featured_image | image_url: width: 140 | image_tag: loading: 'lazy', alt: gallery_product.title }}
      </a>
      <div class="gallery-item__product-details">
        {% render 'product-card-title', product: gallery_product, heading_tag: 'h3' %}
        {% render 'product-card-price', item: gallery_product %}
      </div>
      {% assign gallery_add_label = 'products.add_to_cart' | t %}
      {% assign gallery_add_accessible_label = gallery_add_label | append: ': ' | append: gallery_product.title %}
      {% assign gallery_add_disabled = false %}
      {% unless gallery_product.available %}{% assign gallery_add_disabled = true %}{% endunless %}
      <form action="{{ routes.cart_add_url }}" method="post">
        <input type="hidden" name="id" value="{{ gallery_product.selected_or_first_available_variant.id }}">
        {% render 'theme-button', type: 'submit', label: gallery_add_label, aria_label: gallery_add_accessible_label, variant: 'tertiary', icon: 'cart', icon_only: true, disabled: gallery_add_disabled, class: 'gallery-item__product-add' %}
      </form>
    </div>
  {% else %}
  <div class="gallery-item__footer">
    <div class="gallery-item__identity">
      <div class="gallery-item__avatar">
        {% render 'image', image: block.settings.avatar_image, alt: block.settings.avatar_alt, width: 96, height: 96, crop: 'center', class: 'gallery-item__avatar-image' %}
      </div>
      {% if text != blank %}<span class="gallery-item__text">{{ text | escape }}</span>{% endif %}
    </div>
    {% unless social_network == 'none' %}
      {% if social_url != blank %}<a class="gallery-item__social" href="{{ social_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ text | escape }}">{% else %}<span class="gallery-item__social" aria-hidden="true">{% endif %}
        {% case social_network %}
          {% when 'facebook' %}<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5h1.7V4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4V10H8v3h2.6v8h2.9Z"/></svg>
          {% when 'x' %}<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M5 4h4.2l3.1 4.3L16 4h2.7l-5.1 5.8L19 20h-4.2l-3.5-4.9L7.1 20H4.4l5.4-6.4L5 4Zm3.1 2 7.7 12h1.1L9.2 6H8.1Z"/></svg>
          {% when 'tiktok' %}<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14 4h2.4c.2 1.5 1.1 2.8 2.6 3.5v2.5a7 7 0 0 1-2.6-1V15a5 5 0 1 1-5-5h.5v2.6a2.5 2.5 0 1 0 1.9 2.4V4Z"/></svg>
          {% else %}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4.25" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/></svg>
        {% endcase %}
      {% if social_url != blank %}</a>{% else %}</span>{% endif %}
    {% endunless %}
  </div>
  {% endif %}
</article>

{% stylesheet %}
  .gallery-item { display: flex !important; flex-direction: column; min-width: 0; overflow: hidden; border: 1px solid var(--border-color); background: var(--background-color); }
  .gallery-item__media, .gallery-item__image, .gallery-item__image > picture, .gallery-item__image > img, .gallery-item__image .image__placeholder { display: block; width: 100%; height: 100%; }
  .gallery-item__media { aspect-ratio: var(--gallery-item-media-ratio, 1); overflow: hidden; }
  .gallery-item__media img, .gallery-item__media .image__placeholder { height: 100%; object-fit: cover; }
  .gallery-item__footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 16px; }
  .gallery-item__identity { display: flex; align-items: center; min-width: 0; gap: 8px; }
  .gallery-item__avatar { flex: 0 0 48px; width: 48px; height: 48px; overflow: hidden; border-radius: 50%; background: var(--color-foreground-alpha-10, rgb(0 0 0 / 0.08)); }
  .gallery-item__avatar-image, .gallery-item__avatar-image > img, .gallery-item__avatar-image .image__placeholder { display: block; width: 100%; height: 100%; }
  .gallery-item__avatar-image img, .gallery-item__avatar-image .image__placeholder { object-fit: cover; }
  .gallery-item__text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--font-body-sm); line-height: 1.2; }
  .gallery-item__social { display: inline-flex; flex: 0 0 calc(var(--gallery-item-icon-size, 24px) + 32px); align-items: center; justify-content: center; width: calc(var(--gallery-item-icon-size, 24px) + 32px); height: calc(var(--gallery-item-icon-size, 24px) + 32px); padding: 16px; color: currentColor; background: var(--gallery-item-social-background, #F0E5E2); border-radius: 50%; text-decoration: none; }
  .gallery-item__social svg { display: block; width: var(--gallery-item-icon-size, 24px); height: var(--gallery-item-icon-size, 24px); }
  .gallery-item--product { gap: 8px; border: 0; }
  .gallery-item__product { display: flex; align-items: center; gap: 12px; padding: 16px; border: 1px solid var(--border-color); }
  .gallery-item__product-image { display: block; flex: 0 0 70px; width: 70px; height: 70px; }
  .gallery-item__product-image img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .gallery-item__product-details { display: flex; flex: 1; flex-direction: column; min-width: 0; gap: 8px; }
  .gallery-item__product-details .product-card__title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; line-height: 1.5; }
  .gallery-item__product-add { width: 44px; height: 44px; padding: 0; }
{% endstylesheet %}

