{% doc %}
  Renders a configurable visual divider between groups of content.

  Divider owns only its line style, thickness, color, width, alignment and
  responsive spacing. It renders no text, interactive content, character or
  image.

  @example
  {% content_for 'block', type: 'divider', id: 'divider' %}
{% enddoc %}

{% liquid
  assign divider_style = block.settings.style | default: 'solid'
  assign divider_thickness = block.settings.thickness | default: 'thin'
  assign divider_color = block.settings.color | default: 'scheme'
  assign divider_width = block.settings.width | default: 'full'
  assign divider_alignment = block.settings.alignment | default: 'start'
  assign divider_thickness_value = 1
  assign divider_width_value = 100
  assign divider_spacing_mobile = block.settings.mobile_spacing | default: 16

  if divider_thickness == 'medium'
    assign divider_thickness_value = 2
  elsif divider_thickness == 'custom'
    assign divider_thickness_value = block.settings.custom_thickness | default: 1
  endif

  if divider_width == 'custom'
    assign divider_width_value = block.settings.custom_width | default: 100
  endif

  if divider_color == 'custom'
    assign divider_color_value = block.settings.custom_color | default: 'var(--color-border)'
  elsif divider_color == 'muted'
    assign divider_color_value = 'color-mix(in srgb, var(--color-border) 65%, transparent)'
  else
    assign divider_color_value = 'var(--color-border)'
  endif
%}

<div
  class="divider-block divider-block--{{ divider_style }} divider-block--{{ divider_width }} divider-block--align-{{ divider_alignment }}"
  style="--divider-color: {{ divider_color_value }}; --divider-thickness: {{ divider_thickness_value }}px; --divider-width: {{ divider_width_value }}%; --divider-spacing: {{ block.settings.desktop_spacing | default: 24 }}px; --divider-spacing-mobile: {{ divider_spacing_mobile }}px;"
  role="separator"
  aria-orientation="horizontal"
  {{ block.shopify_attributes }}
>
  <span class="divider-block__line"></span>
</div>

{% stylesheet %}
  .divider-block {
    display: flex;
    padding-block: var(--divider-spacing);
    width: 100%;
  }

  .divider-block__line {
    border-block-start: var(--divider-thickness) var(--divider-style, solid) var(--divider-color);
    display: block;
    width: var(--divider-width);
  }

  .divider-block--dashed .divider-block__line { --divider-style: dashed; }
  .divider-block--dotted .divider-block__line { --divider-style: dotted; }
  .divider-block--content .divider-block__line { width: min(100%, 40rem); }
  .divider-block--custom .divider-block__line { width: var(--divider-width); }
  .divider-block--align-start { justify-content: flex-start; }
  .divider-block--align-center { justify-content: center; }
  .divider-block--align-end { justify-content: flex-end; }

  @media screen and (max-width: 767.98px) {
    .divider-block {
      padding-block: var(--divider-spacing-mobile);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.divider",
  "settings": [
    { "type": "header", "content": "t:general.appearance" },
    {
      "type": "select",
      "id": "style",
      "label": "t:labels.style",
      "options": [
        { "value": "solid", "label": "t:options.divider_style.solid" },
        { "value": "dashed", "label": "t:options.divider_style.dashed" },
        { "value": "dotted", "label": "t:options.divider_style.dotted" }
      ],
      "default": "solid"
    },
    {
      "type": "select",
      "id": "thickness",
      "label": "t:labels.thickness",
      "options": [
        { "value": "thin", "label": "t:options.divider_thickness.thin" },
        { "value": "medium", "label": "t:options.divider_thickness.medium" },
        { "value": "custom", "label": "t:options.divider_thickness.custom" }
      ],
      "default": "thin"
    },
    { "visible_if": "{{ block.settings.thickness == 'custom' }}", "type": "range", "id": "custom_thickness", "label": "t:labels.custom_thickness", "min": 1, "max": 8, "step": 1, "unit": "px", "default": 1 },
    {
      "type": "select",
      "id": "color",
      "label": "t:labels.color",
      "options": [
        { "value": "scheme", "label": "t:options.divider_color.scheme" },
        { "value": "muted", "label": "t:options.divider_color.muted" },
        { "value": "custom", "label": "t:options.divider_color.custom" }
      ],
      "default": "scheme"
    },
    { "visible_if": "{{ block.settings.color == 'custom' }}", "type": "color", "id": "custom_color", "label": "t:labels.custom_color", "default": "#E5E5E5" },
    { "type": "header", "content": "t:general.layout" },
    {
      "type": "select",
      "id": "width",
      "label": "t:labels.width",
      "options": [
        { "value": "full", "label": "t:options.divider_width.full" },
        { "value": "content", "label": "t:options.divider_width.content" },
        { "value": "custom", "label": "t:options.divider_width.custom" }
      ],
      "default": "full"
    },
    { "visible_if": "{{ block.settings.width == 'custom' }}", "type": "range", "id": "custom_width", "label": "t:labels.custom_width", "min": 1, "max": 100, "step": 1, "unit": "%", "default": 100 },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        { "value": "start", "label": "t:options.alignment.start" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "end", "label": "t:options.alignment.end" }
      ],
      "default": "start"
    },
    { "type": "header", "content": "t:general.spacing" },
    { "type": "range", "id": "desktop_spacing", "label": "t:labels.desktop_spacing", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "mobile_spacing", "label": "t:labels.mobile_spacing", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 16 }
  ],
  "presets": [
    {
      "name": "t:general.divider",
      "category": "t:general.layout",
      "settings": {
        "style": "solid",
        "thickness": "thin",
        "color": "scheme",
        "width": "full",
        "alignment": "start",
        "desktop_spacing": 24,
        "mobile_spacing": 16
      }
    }
  ]
}
{% endschema %}
