{% doc %}
  Renders the controlled Product Card block for the product context supplied
  by its parent commerce surface.

  The block owns only ranking visibility and the optional local color-scheme
  override. Product selection, product iteration and card presentation rules
  remain owned by the parent surface and shared product-card snippet.

  @example
  {% content_for 'block', type: 'product-card', id: 'product-card' %}
{% enddoc %}

{% liquid
  assign card_product = closest.product | default: product
  assign card_color_scheme = blank
  assign use_theme_color = true

  if settings.product_card_style == 'card'
    if block.settings.color_type == 'color_scheme'
      assign card_color_scheme = block.settings.color_scheme
      assign use_theme_color = false
    endif
  endif
%}

<div class="product-card-block" {{ block.shopify_attributes }}>
  {% if card_product != blank %}
    {% render 'product-card', product: card_product, class: 'product-card-block__card', show_quick_add: true, show_ranking: block.settings.show_ranking, color_scheme: card_color_scheme, use_theme_color: use_theme_color %}
  {% else %}
    <p class="product-card-block__empty" role="status">
      {{ 'blocks.product_card.empty' | t }}
    </p>
  {% endif %}
</div>

{% stylesheet %}
  .product-card-block {
    min-width: 0;
    width: 100%;
  }

  .product-card-block__card {
    width: 100%;
  }

  .product-card-block__empty {
    color: var(--color-text);
    font-size: var(--font-body-sm);
    margin: 0;
    opacity: 0.75;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_card",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:info.product_card_style_settings"
    },
    {
      "type": "checkbox",
      "id": "show_ranking",
      "label": "t:labels.product_card_show_ranking",
      "default": false
    },
    {
      "type": "header",
      "content": "t:general.color",
      "visible_if": "{{ settings.product_card_style == 'card' }}"
    },
    {
      "type": "select",
      "id": "color_type",
      "label": "t:labels.type",
      "options": [
        { "value": "inherit", "label": "t:options.background_scheme.inherit" },
        { "value": "color_scheme", "label": "t:labels.color_scheme" }
      ],
      "default": "inherit",
      "visible_if": "{{ settings.product_card_style == 'card' }}"
    },
    {
      "visible_if": "{{ settings.product_card_style == 'card' and block.settings.color_type == 'color_scheme' }}",
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [{ "name": "t:general.product_card", "category": "t:general.commerce" }]
}
{% endschema %}
