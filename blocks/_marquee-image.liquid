{% doc %}
  Renders a Basic marquee image, including fixed image slots in Collection marquee.
  @example
  {% content_for 'block', type: '_marquee-image', id: 'image-1' %}
{% enddoc %}

{% render 'marquee-image-render', block: block %}

{% schema %}
{
  "name": "Image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "original",
          "label": "Original"
        },
        {
          "value": "ratio_1_1",
          "label": "Square (1:1)"
        },
        {
          "value": "ratio_4_5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "ratio_3_4",
          "label": "Portrait (3:4)"
        },
        {
          "value": "ratio_2_3",
          "label": "Portrait (2:3)"
        },
        {
          "value": "ratio_9_16",
          "label": "Portrait (9:16)"
        },
        {
          "value": "ratio_16_9",
          "label": "Landscape (16:9)"
        },
        {
          "value": "ratio_3_2",
          "label": "Landscape (3:2)"
        },
        {
          "value": "ratio_4_3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "ratio_5_4",
          "label": "Landscape (5:4)"
        },
        {
          "value": "custom",
          "label": "t:options.image_ratio.custom"
        }
      ],
      "default": "original"
    },
    {
      "type": "number",
      "id": "image_ratio_custom_width",
      "label": "W",
      "default": 16,
      "visible_if": "{{ block.settings.image_ratio == 'custom' }}"
    },
    {
      "type": "number",
      "id": "image_ratio_custom_height",
      "label": "H",
      "default": 9,
      "visible_if": "{{ block.settings.image_ratio == 'custom' }}"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Width"
    },
    {
      "type": "range",
      "id": "width_custom_desktop",
      "label": "Desktop",
      "min": 0,
      "max": 400,
      "step": 4,
      "default": 300,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "width_custom_mobile",
      "label": "Mobile",
      "min": 50,
      "max": 400,
      "step": 5,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "select",
      "id": "corner_radius",
      "label": "Corner radius",
      "options": [
        {
          "value": "inherit",
          "label": "Inherit"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "rounded",
          "label": "Rounded"
        },
        {
          "value": "full",
          "label": "Full"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "custom_corner_radius",
      "label": "Custom radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 0,
      "unit": "px",
      "visible_if": "{{ block.settings.corner_radius == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Image",
      "category": "t:general.basic",
      "settings": {}
    }
  ]
}
{% endschema %}
