{% liquid
  assign band_image = block.settings.image
  assign band_image_alt = block.settings.image_alt | default: band_image.alt
  assign band_heading_tag = section.settings.heading_tag | default: 'h2'
  unless band_heading_tag == 'div' or band_heading_tag == 'h1' or band_heading_tag == 'h2' or band_heading_tag == 'h3' or band_heading_tag == 'h4' or band_heading_tag == 'h5' or band_heading_tag == 'h6'
    assign band_heading_tag = 'h2'
  endunless
  assign band_heading_size = section.settings.heading_size | default: 'lg'
  assign band_heading_size_mobile = section.settings.heading_size_mobile | default: band_heading_size
  unless band_heading_size == 'display' or band_heading_size == 'xl' or band_heading_size == 'lg' or band_heading_size == 'md' or band_heading_size == 'sm' or band_heading_size == 'xs'
    assign band_heading_size = 'lg'
  endunless
  assign band_text_size = section.settings.text_size | default: 'md'
  assign band_text_size_mobile = section.settings.text_size_mobile | default: band_text_size
  unless band_text_size == 'xs' or band_text_size == 'sm' or band_text_size == 'md' or band_text_size == 'lg' or band_text_size == 'xl' or band_text_size == 'xxl'
    assign band_text_size = 'md'
  endunless
  assign band_button_style = section.settings.button_style | default: 'tertiary'
  unless band_button_style == 'primary' or band_button_style == 'secondary' or band_button_style == 'tertiary'
    assign band_button_style = 'tertiary'
  endunless
  assign band_button_icon = blank
  if section.settings.button_show_icon
    assign band_button_icon = section.settings.button_icon | default: 'arrow'
  endif
  capture band_heading_size
    render 'heading-size-token', size: band_heading_size, fallback: 'xl', html_tag: band_heading_tag
  endcapture
  assign band_heading_size = band_heading_size | strip
  capture band_heading_size_mobile
    render 'heading-size-token', size: band_heading_size_mobile, fallback: 'xl', html_tag: band_heading_tag
  endcapture
  assign band_heading_size_mobile = band_heading_size_mobile | strip
  assign band_container = 'page-width'
  if section.settings.section_width == 'full_width'
    assign band_container = 'full-width'
  endif
%}

<div id="images-with-text-scroll-{{ block.id }}" class="images-with-text-scroll__item" data-stacked-band {{ block.shopify_attributes }}>
  <div class="images-with-text-scroll__layout container {{ band_container }}" data-stacked-band-layout>
    <div class="images-with-text-scroll__text" data-stacked-band-content style="--images-with-text-scroll-gap: {{ block.settings.gap_desktop }}px; --images-with-text-scroll-gap-mobile: {{ block.settings.gap_mobile }}px; --band-heading-mobile-size: var(--font-heading-{{ band_heading_size_mobile }}); --band-heading-mobile-leading: var(--font-heading-{{ band_heading_size_mobile }}-line-height); --band-heading-mobile-tracking: var(--font-heading-{{ band_heading_size_mobile }}-letter-spacing); --band-heading-mobile-case: var(--font-heading-{{ band_heading_size_mobile }}-text-transform); --band-text-mobile-size: var(--font-body-{{ band_text_size_mobile }});{% if section.settings.heading_color != blank %}--images-with-text-scroll-heading-color: {{ section.settings.heading_color | escape }};{% endif %}{% if section.settings.text_color != blank %}--images-with-text-scroll-text-color: {{ section.settings.text_color | escape }};{% endif %}">
      {% if block.settings.tag != blank %}
        <div class="images-with-text-scroll__tag body-{{ band_text_size }}">{{ block.settings.tag }}</div>
      {% endif %}
      {% if block.settings.heading != blank %}
        <{{ band_heading_tag }} class="images-with-text-scroll__heading heading-{{ band_heading_size }}">{{ block.settings.heading | strip_html }}</{{ band_heading_tag }}>
      {% endif %}
      {% if block.settings.text != blank %}
        <div class="images-with-text-scroll__description body-{{ band_text_size }}">{{ block.settings.text }}</div>
      {% endif %}
      {% if block.settings.button_label != blank %}
        {% render 'theme-button',
          label: block.settings.button_label,
          url: block.settings.button_link,
          open_in_new_tab: section.settings.button_open_in_new_tab,
          variant: band_button_style,
          icon: band_button_icon,
          icon_position: 'after',
          icon_size: 'inherit'
        %}
      {% endif %}
    </div>
    {% if band_image != blank %}
      {{ band_image | image_url: width: 2000 | image_tag: widths: '343, 480, 640, 768, 1000, 1536, 2000', sizes: '(max-width: 1149px) calc(100vw - 32px), (max-width: 1695px) calc((100vw - 160px) / 2), 768px', alt: band_image_alt, class: 'images-with-text-scroll__image' }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'images-with-text-scroll__image placeholder-image' }}
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .images-with-text-scroll__item {
    display: block;
    min-width: 0;
  }

  .images-with-text-scroll__image {
    display: block;
    width: var(--band-image-width, 100%);
    max-width: 100%;
    justify-self: end;
    height: auto;
    aspect-ratio: var(--band-image-ratio, 1);
    object-fit: cover;
    object-position: center;
  }

  .images-with-text-scroll__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--images-with-text-scroll-gap, 32px);
    min-width: 0;
    width: 100%;
    text-align: left;
    color: var(--images-with-text-scroll-text-color, inherit);
  }

  .images-with-text-scroll__heading {
    width: 100%;
    margin: 0;
    color: var(--images-with-text-scroll-heading-color, inherit);
  }

  .images-with-text-scroll__description p,
  .images-with-text-scroll__tag p {
    margin: 0;
  }

  @media (max-width: 1149.98px) {
    .images-with-text-scroll__image {
      width: var(--band-image-width-mobile, var(--band-image-width, 100%));
      aspect-ratio: var(--band-image-ratio-mobile, var(--band-image-ratio, 1));
      justify-self: center;
    }

    .images-with-text-scroll__text {
      gap: var(--images-with-text-scroll-gap-mobile, 24px);
    }

    .images-with-text-scroll__heading {
      font-size: var(--band-heading-mobile-size);
      line-height: var(--band-heading-mobile-leading);
      letter-spacing: var(--band-heading-mobile-tracking);
      text-transform: var(--band-heading-mobile-case);
    }

    .images-with-text-scroll__tag,
    .images-with-text-scroll__description {
      font-size: var(--band-text-mobile-size);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image text band",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:general.image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:labels.alt_text"
    },
    {
      "type": "header",
      "content": "Gap"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "t:labels.desktop_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:labels.mobile_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "tag",
      "label": "Tag"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.link"
    }
  ],
  "presets": [
    {
      "name": "Image text band",
      "category": "Text",
      "settings": {
        "image_alt": "",
        "gap_desktop": 16,
        "gap_mobile": 12,
        "tag": "<p>#2</p>",
        "heading": "<p>Our commitments</p>",
        "text": "<p>At Léo et Violette, from day one we have made responsibility part of our values. Towards you, and also towards the environment through the way we produce our collections.</p>",
        "button_label": "Learn more",
        "button_link": ""
      }
    }
  ]
}
{% endschema %}
