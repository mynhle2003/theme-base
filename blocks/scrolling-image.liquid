{% doc %}
  Foreground media for the custom Zoom image banner. Uses the Image kernel's
  content, desktop/mobile size, radius and padding options plus an overlay.
  The parent owns positioning; this block owns the default scroll zoom runtime.
{% enddoc %}
{% liquid
  assign enable_zoom = true
  if settings.motion_image_zoom == false
    assign enable_zoom = false
  endif
  assign image_source = block.settings.image
  assign mobile_image_source = block.settings.mobile_image

  assign image_ratio_desktop_setting = block.settings.image_ratio_desktop | default: 'custom'
  capture image_ratio_desktop
    render 'image-ratio-value', setting: image_ratio_desktop_setting, fallback_ratio: 'auto', custom_width: block.settings.image_ratio_custom_width_desktop, custom_height: block.settings.image_ratio_custom_height_desktop
  endcapture
  assign image_ratio_desktop = image_ratio_desktop | strip
  assign image_height_desktop = 'auto'
  if image_ratio_desktop_setting == 'square' or image_ratio_desktop_setting == 'portrait' or image_ratio_desktop_setting == 'ratio_5_4' or image_ratio_desktop_setting == 'landscape' or image_ratio_desktop_setting == 'wide' or image_ratio_desktop_setting == 'custom'
    assign image_height_desktop = '100%'
  endif

  assign image_ratio_mobile_setting = block.settings.image_ratio_mobile | default: 'custom'
  capture image_ratio_mobile
    render 'image-ratio-value', setting: image_ratio_mobile_setting, fallback_ratio: 'auto', custom_width: block.settings.image_ratio_custom_width_mobile, custom_height: block.settings.image_ratio_custom_height_mobile
  endcapture
  assign image_ratio_mobile = image_ratio_mobile | strip
  assign image_height_mobile = 'auto'
  if image_ratio_mobile_setting == 'square' or image_ratio_mobile_setting == 'portrait' or image_ratio_mobile_setting == 'ratio_5_4' or image_ratio_mobile_setting == 'landscape' or image_ratio_mobile_setting == 'wide' or image_ratio_mobile_setting == 'custom'
    assign image_height_mobile = '100%'
  endif

  assign image_width_desktop_setting = block.settings.width_desktop | default: 'fill'
  unless image_width_desktop_setting == 'fit' or image_width_desktop_setting == 'fill' or image_width_desktop_setting == 'custom'
    assign image_width_desktop_setting = 'fit'
  endunless
  assign image_width_desktop = 'fit-content'
  assign image_size_desktop = '100vw'
  if image_width_desktop_setting == 'fill'
    assign image_width_desktop = '100%'
  elsif image_width_desktop_setting == 'custom'
    assign image_width_desktop_value = block.settings.width_custom_desktop | default: 100 | plus: 0
    if image_width_desktop_value < 10 or image_width_desktop_value > 100
      assign image_width_desktop_value = 100
    endif
    assign image_width_desktop = image_width_desktop_value | append: '%'
    assign image_size_desktop = image_width_desktop
  endif

  assign image_width_mobile_setting = block.settings.width_mobile | default: 'fill'
  unless image_width_mobile_setting == 'fit' or image_width_mobile_setting == 'fill' or image_width_mobile_setting == 'custom'
    assign image_width_mobile_setting = 'fit'
  endunless
  assign image_width_mobile = 'fit-content'
  assign image_size_mobile = '100vw'
  if image_width_mobile_setting == 'fill'
    assign image_width_mobile = '100%'
  elsif image_width_mobile_setting == 'custom'
    assign image_width_mobile_value = block.settings.width_custom_mobile | default: 100 | plus: 0
    if image_width_mobile_value < 10 or image_width_mobile_value > 100
      assign image_width_mobile_value = 100
    endif
    assign image_width_mobile = image_width_mobile_value | append: '%'
    assign image_size_mobile = image_width_mobile
  endif

  assign image_max_width_desktop = '100%'
  assign max_width_desktop = block.settings.max_width_desktop | default: 550 | plus: 0
  if max_width_desktop < 0 or max_width_desktop > 1600
    assign max_width_desktop = 1600
  endif
  if block.settings.limit_width_desktop and max_width_desktop > 0
    assign image_max_width_desktop = max_width_desktop | append: 'px'
  endif

  assign image_max_width_mobile = '100%'
  assign max_width_mobile = block.settings.max_width_mobile | default: 550 | plus: 0
  if max_width_mobile < 0 or max_width_mobile > 1600
    assign max_width_mobile = 1600
  endif
  if block.settings.limit_width_mobile and max_width_mobile > 0
    assign image_max_width_mobile = max_width_mobile | append: 'px'
  endif

  assign image_corner_radius = block.settings.corner_radius | default: 'square'
  assign image_custom_corner_radius = block.settings.custom_corner_radius | default: 0 | plus: 0
  unless image_corner_radius == 'inherit' or image_corner_radius == 'square' or image_corner_radius == 'rounded' or image_corner_radius == 'full' or image_corner_radius == 'custom'
    assign image_legacy_corner_radius = image_corner_radius | plus: 0
    if image_legacy_corner_radius > 0
      assign image_corner_radius = 'custom'
      assign image_custom_corner_radius = image_legacy_corner_radius
      if image_custom_corner_radius > 40
        assign image_custom_corner_radius = 40
      endif
    else
      assign image_corner_radius = 'square'
    endif
  endunless

  if image_custom_corner_radius < 0 or image_custom_corner_radius > 40
    assign image_custom_corner_radius = 0
  endif

  assign image_radius_value = 'var(--media-radius, var(--radius-square))'
  case image_corner_radius
    when 'square'
      assign image_radius_value = 'var(--radius-square)'
    when 'rounded'
      assign image_radius_value = 'var(--radius-rounded)'
    when 'full'
      assign image_radius_value = 'var(--radius-pill)'
    when 'custom'
      assign image_radius_value = image_custom_corner_radius | append: 'px'
  endcase

  assign padding_top = block.settings.padding_top | default: 0 | plus: 0
  assign padding_bottom = block.settings.padding_bottom | default: 0 | plus: 0
  assign padding_left = block.settings.padding_left | default: 0 | plus: 0
  assign padding_right = block.settings.padding_right | default: 0 | plus: 0
  assign padding_top_mobile = block.settings.padding_top_mobile | default: 0 | plus: 0
  assign padding_bottom_mobile = block.settings.padding_bottom_mobile | default: 0 | plus: 0
  assign padding_left_mobile = block.settings.padding_left_mobile | default: 0 | plus: 0
  assign padding_right_mobile = block.settings.padding_right_mobile | default: 0 | plus: 0

%}

{% capture image_style %}
  {% render 'size-style',
    width: image_width_desktop,
    max_width: image_max_width_desktop,
    width_mobile: image_width_mobile,
    max_width_mobile: image_max_width_mobile
  %}
  --scrolling-image-ratio: {{ image_ratio_desktop }};
  --scrolling-image-image-height: {{ image_height_desktop }};
  --scrolling-image-ratio-mobile: {{ image_ratio_mobile }};
  --scrolling-image-image-height-mobile: {{ image_height_mobile }};
  --scrolling-image-padding-top: {{ padding_top }}px;
  --scrolling-image-padding-bottom: {{ padding_bottom }}px;
  --scrolling-image-padding-left: {{ padding_left }}px;
  --scrolling-image-padding-right: {{ padding_right }}px;
  {% if block.settings.customize_mobile_padding %}
    --scrolling-image-padding-top-mobile: {{ padding_top_mobile }}px;
    --scrolling-image-padding-bottom-mobile: {{ padding_bottom_mobile }}px;
    --scrolling-image-padding-left-mobile: {{ padding_left_mobile }}px;
    --scrolling-image-padding-right-mobile: {{ padding_right_mobile }}px;
  {% endif %}
  --scrolling-image-radius: {{ image_radius_value }};
{% endcapture %}
{% assign image_style = image_style | strip | replace: '\n', ' ' %}

<zoom-foreground-image class="scrolling-image-block size-style size-style--contain"
  data-zoom-enabled="{{ enable_zoom }}"
  data-zoom-amount="12"
  style="{{ image_style }} --zoom-image-overlay: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"
  {{ block.shopify_attributes }}>
  <div class="scrolling-image-block__media" data-zoom-image>
    {% capture image_sizes %}(min-width: 768px) {{ image_size_desktop }}, {{ image_size_mobile }}{% endcapture %}
    {% render 'image',
      image: image_source,
      mobile_image: mobile_image_source,
      url: block.settings.image_link,
      open_in_new_tab: block.settings.open_in_new_tab,
      alt: block.settings.alt_text,
      class: 'scrolling-image-block__image',
      width: 2400,
      widths: '400, 600, 800, 1200, 1600, 2400',
      sizes: image_sizes
    %}
    <span class="scrolling-image-block__overlay" aria-hidden="true"></span>
  </div>
</zoom-foreground-image>

{% stylesheet %}
  .scrolling-image-block {
    display: block;
    min-width: 0;
    position: relative;
    overflow: clip;
    border-radius: var(--scrolling-image-radius, 0px);
    padding-top: var(--scrolling-image-padding-top, 0px);
    padding-right: var(--scrolling-image-padding-right, 0px);
    padding-bottom: var(--scrolling-image-padding-bottom, 0px);
    padding-left: var(--scrolling-image-padding-left, 0px);
  }

  .scrolling-image-block__media {
    position: relative;
    overflow: clip;
    border-radius: var(--scrolling-image-radius, 0px);
  }

  .scrolling-image-block__image {
    width: 100%;
    max-width: 100%;
    aspect-ratio: var(--scrolling-image-ratio, auto);
    border-radius: var(--scrolling-image-radius, 0px);
  }

  .scrolling-image-block .scrolling-image-block__image > picture,
  .scrolling-image-block .scrolling-image-block__image > img,
  .scrolling-image-block .scrolling-image-block__image > picture > img,
  .scrolling-image-block .scrolling-image-block__image .image__placeholder {
    display: block;
    width: 100%;
    height: var(--scrolling-image-image-height, auto);
  }

  .scrolling-image-block .scrolling-image-block__image > img,
  .scrolling-image-block .scrolling-image-block__image > picture > img {
    object-fit: cover;
  }

  @media (max-width: 767.98px) {
    .scrolling-image-block {
      padding-top: var(--scrolling-image-padding-top-mobile, var(--scrolling-image-padding-top, 0px));
      padding-right: var(--scrolling-image-padding-right-mobile, var(--scrolling-image-padding-right, 0px));
      padding-bottom: var(--scrolling-image-padding-bottom-mobile, var(--scrolling-image-padding-bottom, 0px));
      padding-left: var(--scrolling-image-padding-left-mobile, var(--scrolling-image-padding-left, 0px));
    }

    .scrolling-image-block__image {
      aspect-ratio: var(--scrolling-image-ratio-mobile, var(--scrolling-image-ratio, auto));
    }

    .scrolling-image-block .scrolling-image-block__image > picture,
    .scrolling-image-block .scrolling-image-block__image > img,
    .scrolling-image-block .scrolling-image-block__image > picture > img,
    .scrolling-image-block .scrolling-image-block__image .image__placeholder {
      height: var(--scrolling-image-image-height-mobile, var(--scrolling-image-image-height, auto));
    }
  }
{% endstylesheet %}

{% schema %}
