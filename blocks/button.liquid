{% doc %}
  Renders a configurable call-to-action button with an optional icon.

  @example
  {% content_for 'block', type: 'button', id: 'button' %}
{% enddoc %}

{% liquid
  assign button_label = block.settings.button_label | default: 'Button'
  assign button_style = block.settings.button_style | default: 'primary'
  assign button_alignment = 'flex-start'
  assign button_alignment_mobile = 'flex-start'
  assign button_padding_top_mobile = block.settings.padding_top
  assign button_padding_bottom_mobile = block.settings.padding_bottom
  assign button_padding_left_mobile = block.settings.padding_left
  assign button_padding_right_mobile = block.settings.padding_right

  if block.settings.alignment == 'center'
    assign button_alignment = 'center'
  elsif block.settings.alignment == 'end'
    assign button_alignment = 'flex-end'
  endif

  if block.settings.customize_mobile_alignment
    if block.settings.alignment_mobile == 'center'
      assign button_alignment_mobile = 'center'
    elsif block.settings.alignment_mobile == 'end'
      assign button_alignment_mobile = 'flex-end'
    else
      assign button_alignment_mobile = button_alignment
    endif
  else
    assign button_alignment_mobile = button_alignment
  endif

  if block.settings.customize_mobile_padding
    assign button_padding_top_mobile = block.settings.padding_top_mobile
    assign button_padding_bottom_mobile = block.settings.padding_bottom_mobile
    assign button_padding_left_mobile = block.settings.padding_left_mobile
    assign button_padding_right_mobile = block.settings.padding_right_mobile
  endif
%}

<div
  class="button-block"
  style="--button-alignment: {{ button_alignment }}; --button-padding-top: {{ block.settings.padding_top }}px; --button-padding-bottom: {{ block.settings.padding_bottom }}px; --button-padding-left: {{ block.settings.padding_left }}px; --button-padding-right: {{ block.settings.padding_right }}px; --button-alignment-mobile: {{ button_alignment_mobile }}; --button-padding-top-mobile: {{ button_padding_top_mobile }}px; --button-padding-bottom-mobile: {{ button_padding_bottom_mobile }}px; --button-padding-left-mobile: {{ button_padding_left_mobile }}px; --button-padding-right-mobile: {{ button_padding_right_mobile }}px;"
  {{ block.shopify_attributes }}
>
  {% render 'button',
    label: button_label,
    url: block.settings.button_link,
    style: button_style,
    open_in_new_tab: block.settings.button_open_in_new_tab,
    show_icon: block.settings.show_icon,
    icon: block.settings.icon,
    icon_position: block.settings.icon_position,
    icon_size: block.settings.icon_size,
    custom_icon_size: block.settings.custom_icon_size,
    width: block.settings.width,
    customize_mobile_alignment: block.settings.customize_mobile_alignment,
    width_mobile: block.settings.width_mobile
  %}
</div>

{% stylesheet %}
  .button-block { display: flex; justify-content: var(--button-alignment); min-width: 0; padding-block: var(--button-padding-top) var(--button-padding-bottom); padding-inline: var(--button-padding-left) var(--button-padding-right); width: 100%; }
  @media screen and (max-width: 767.98px) { .button-block { justify-content: var(--button-alignment-mobile); padding-block: var(--button-padding-top-mobile) var(--button-padding-bottom-mobile); padding-inline: var(--button-padding-left-mobile) var(--button-padding-right-mobile); } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.button",
  "settings": [
    { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Button" },
    { "type": "url", "id": "button_link", "label": "t:labels.button_link" },
    { "type": "select", "id": "button_style", "label": "t:labels.button_style", "options": [{ "value": "primary", "label": "t:options.button_style.primary" }, { "value": "secondary", "label": "t:options.button_style.secondary" }, { "value": "tertiary", "label": "t:options.button_style.tertiary" }], "default": "primary" },
    { "type": "checkbox", "id": "button_open_in_new_tab", "label": "t:labels.button_open_in_new_tab", "default": false },
    { "type": "header", "content": "t:general.icons" },
    { "type": "checkbox", "id": "show_icon", "label": "t:labels.show_icon", "default": false },
    { "visible_if": "{{ block.settings.show_icon }}", "type": "select", "id": "icon", "label": "t:labels.icon", "options": [{ "value": "arrow", "label": "t:options.icon.arrow" }, { "value": "chevron", "label": "t:options.icon.chevron" }, { "value": "plus", "label": "t:options.icon.plus" }], "default": "arrow" },
    { "visible_if": "{{ block.settings.show_icon }}", "type": "select", "id": "icon_position", "label": "t:labels.icon_position", "options": [{ "value": "before", "label": "t:options.icon_position.before" }, { "value": "after", "label": "t:options.icon_position.after" }], "default": "after" },
    { "visible_if": "{{ block.settings.show_icon }}", "type": "select", "id": "icon_size", "label": "t:labels.icon_size", "options": [{ "value": "inherit", "label": "t:options.icon_size.inherit" }, { "value": "custom", "label": "t:options.icon_size.custom" }], "default": "inherit" },
    { "visible_if": "{{ block.settings.show_icon and block.settings.icon_size == 'custom' }}", "type": "range", "id": "custom_icon_size", "label": "t:labels.custom_icon_size", "min": 8, "max": 48, "step": 2, "unit": "px", "default": 16 },
    { "type": "header", "content": "t:general.layout" },
    { "type": "select", "id": "width", "label": "t:labels.width", "options": [{ "value": "fit", "label": "t:options.width.fit" }, { "value": "fill", "label": "t:options.width.fill" }], "default": "fit" },
    { "visible_if": "{{ block.settings.width == 'fit' }}", "type": "select", "id": "alignment", "label": "t:labels.alignment", "options": [{ "value": "start", "label": "t:options.alignment.left" }, { "value": "center", "label": "t:options.alignment.center" }, { "value": "end", "label": "t:options.alignment.right" }], "default": "start" },
    { "type": "checkbox", "id": "customize_mobile_alignment", "label": "t:labels.customize_mobile", "default": false },
    { "visible_if": "{{ block.settings.customize_mobile_alignment }}", "type": "select", "id": "width_mobile", "label": "t:labels.width_mobile", "options": [{ "value": "fit", "label": "t:options.width.fit" }, { "value": "fill", "label": "t:options.width.fill" }], "default": "fit" },
    { "visible_if": "{{ block.settings.customize_mobile_alignment and block.settings.width_mobile == 'fit' }}", "type": "select", "id": "alignment_mobile", "label": "t:labels.alignment_mobile", "options": [{ "value": "start", "label": "t:options.alignment.left" }, { "value": "center", "label": "t:options.alignment.center" }, { "value": "end", "label": "t:options.alignment.right" }], "default": "start" },
    { "type": "header", "content": "t:general.padding" },
    { "type": "range", "id": "padding_top", "label": "t:labels.padding_top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "t:labels.padding_bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_left", "label": "t:labels.padding_left", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right", "label": "t:labels.padding_right", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "checkbox", "id": "customize_mobile_padding", "label": "t:labels.customize_mobile_padding", "default": false },
    { "visible_if": "{{ block.settings.customize_mobile_padding }}", "type": "range", "id": "padding_top_mobile", "label": "t:labels.padding_top_mobile", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "visible_if": "{{ block.settings.customize_mobile_padding }}", "type": "range", "id": "padding_bottom_mobile", "label": "t:labels.padding_bottom_mobile", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "visible_if": "{{ block.settings.customize_mobile_padding }}", "type": "range", "id": "padding_left_mobile", "label": "t:labels.padding_left_mobile", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "visible_if": "{{ block.settings.customize_mobile_padding }}", "type": "range", "id": "padding_right_mobile", "label": "t:labels.padding_right_mobile", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "t:general.button" }]
}
{% endschema %}
