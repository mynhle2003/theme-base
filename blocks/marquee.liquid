{% capture children %}{% content_for 'blocks' %}{% endcapture %}
{% render 'marquee-render', block: block, section: section, children: children %}

{% schema %}
{
  "name": "t:general.marquee",
  "tag": null,
  "blocks": [
    {
      "type": "_marquee-heading"
    },
    {
      "type": "_marquee-text"
    },
    {
      "type": "_marquee-image"
    },
    {
      "type": "_marquee-icon"
    },
    {
      "type": "_marquee-button"
    },
    {
      "type": "_marquee-countdown-timer"
    },
    {
      "type": "_marquee-coupon-code"
    },
    {
      "type": "_marquee-divider"
    },
    {
      "type": "_marquee-group"
    },
    {
      "type": "marquee-item"
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "show_top_divider",
      "label": "Show top divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_bottom_divider",
      "label": "Show bottom divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_blurred_edges",
      "label": "Show blurred edges",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_parallax",
      "label": "Enable parallax effect",
      "default": true
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Speed",
      "min": 0.1,
      "max": 2,
      "step": 0.1,
      "default": 0.6,
      "unit": "x"
    },
    {
      "type": "select",
      "id": "animation_direction",
      "label": "Motion direction",
      "options": [
        {
          "value": "backward",
          "label": "Left"
        },
        {
          "value": "forward",
          "label": "Right"
        }
      ],
      "default": "backward"
    },
    {
      "type": "header",
      "content": "Gap"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Desktop width",
      "options": [
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "select",
      "id": "color_type",
      "label": "Type",
      "options": [
        {
          "value": "inherit",
          "label": "Inherit"
        },
        {
          "value": "scheme",
          "label": "Color scheme"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.color_type == 'scheme' }}"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "Custom for mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "header",
      "content": "Visible"
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "category": "t:general.content",
      "blocks": [
        {
          "type": "_marquee-heading",
          "settings": {
            "text": "Diamond statement",
            "heading_size": "md",
            "color_role": "heading",
            "opacity": 100
          }
        },
        {
          "type": "_marquee-image",
          "settings": {
            "corner_radius": "square",
            "width_custom_desktop": 120,
            "width_custom_mobile": 80,
            "image_ratio": "original"
          }
        },
        {
          "type": "_marquee-heading",
          "settings": {
            "text": "Birthstone",
            "heading_size": "md",
            "color_role": "heading",
            "opacity": 100
          }
        },
        {
          "type": "_marquee-image",
          "settings": {
            "corner_radius": "square",
            "width_custom_desktop": 120,
            "width_custom_mobile": 80,
            "image_ratio": "original"
          }
        },
        {
          "type": "_marquee-heading",
          "settings": {
            "text": "Diamond statement",
            "heading_size": "md",
            "color_role": "heading",
            "opacity": 100
          }
        },
        {
          "type": "_marquee-image",
          "settings": {
            "corner_radius": "square",
            "width_custom_desktop": 120,
            "width_custom_mobile": 80,
            "image_ratio": "original"
          }
        }
      ],
      "settings": {
        "show_top_divider": false,
        "show_bottom_divider": false,
        "show_blurred_edges": false,
        "enable_parallax": true,
        "alignment": "center",
        "animation_speed": 0.6,
        "animation_direction": "backward",
        "gap_desktop": 40,
        "gap_mobile": 30,
        "width": "fill",
        "color_type": "inherit",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    {
      "name": "Marquee - Heading",
      "category": "t:general.content",
      "settings": {
        "show_top_divider": false,
        "show_bottom_divider": false,
        "show_blurred_edges": false,
        "enable_parallax": true,
        "alignment": "center",
        "animation_speed": 0.6,
        "animation_direction": "backward",
        "gap_desktop": 40,
        "gap_mobile": 30,
        "width": "fill",
        "color_type": "inherit",
        "padding_top": 0,
        "padding_bottom": 0
      },
      "blocks": [
        {
          "type": "_marquee-heading",
          "settings": {
            "text": "Welcome to our store",
            "heading_size": "xl",
            "color_role": "heading",
            "opacity": 100
          }
        }
      ]
    }
  ]
}
{% endschema %}
