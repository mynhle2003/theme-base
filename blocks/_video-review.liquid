        {
          "value": "square",
          "label": "t:options.radius_preset.square"
        },
        {
          "value": "slightly_rounded",
          "label": "t:options.radius_preset.slightly_rounded"
        },
        {
          "value": "rounded",
          "label": "t:options.radius_preset.rounded"
        },
