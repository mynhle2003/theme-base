{% doc %}
  A video review with one block-owned Compact product. The parent owns carousel
  layout and video playback policy; Compact owns product presentation.
{% enddoc %}
{% liquid
  assign video_label = block.settings.video.alt
  if video_label == blank
    assign video_label = 'video_reviews.label' | t
  endif
  assign poster = block.settings.cover_image | default: block.settings.video.preview_image
  assign poster_url = blank
  if poster != blank
    assign poster_url = poster | image_url: width: 800
  endif
  assign play_label = 'video.play' | t
  assign pause_label = 'video.pause' | t
  assign mute_label = 'video_reviews.mute' | t
  assign unmute_label = 'video_reviews.unmute' | t
%}
<div class="video-review swiper-slide" data-video-review {{ block.shopify_attributes }}>
  <div class="video-review__surface">
    <div class="video-review__media">
      {% if block.settings.video != blank %}
        {{ block.settings.video | video_tag: image_size: '800x', autoplay: false, loop: true, muted: true, controls: false, preload: 'none', playsinline: true, poster: poster_url, aria-label: video_label }}
      {% elsif poster != blank %}
        {{ poster | image_url: width: 800 | image_tag: loading: 'lazy', widths: '345, 480, 690, 800', sizes: '(max-width: 767px) 100vw, 25vw', class: 'video-review__cover', alt: video_label }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'video-review__placeholder' }}
      {% endif %}
    </div>
    {% if block.settings.video != blank %}
      <div class="video-review__controls" hidden>
        <button class="video-review__control" type="button" data-review-play data-play-label="{{ play_label | escape }}" data-pause-label="{{ pause_label | escape }}" aria-label="{{ play_label | escape }}" aria-pressed="false">
          <span data-play-icon>{% render 'video-review-icon', name: 'play' %}</span><span data-pause-icon>{% render 'icon', icon: 'pause', bare: true %}</span>
        </button>
        <button class="video-review__control" type="button" data-review-mute data-mute-label="{{ mute_label | escape }}" data-unmute-label="{{ unmute_label | escape }}" aria-label="{{ unmute_label | escape }}" aria-pressed="true">
          <span data-muted-icon class="video-review__asset-icon" aria-hidden="true">{% render 'video-review-icon', name: 'muted' %}</span>
          <svg data-sound-icon hidden width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4V5Zm5 4a5 5 0 0 1 0 6m3-9a9 9 0 0 1 0 12" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    {% endif %}
    {% if block.settings.product != blank or request.design_mode %}
      <div class="video-review__compact">
        {% render 'product-card-compact-render', card_settings: block.settings %}
      </div>
    {% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Video",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Cover image"
    },
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "checkbox",
      "id": "enable_boxed_layout",
      "label": "Enable boxed layout",
      "default": true
    },
    {
      "type": "header",
      "content": "Product thumbnail"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "original",
          "label": "Original"
        },
        {
          "value": "ratio_1_1",
          "label": "Square (1:1)"
        },
        {
          "value": "ratio_4_5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "ratio_3_4",
          "label": "Portrait (3:4)"
        },
        {
          "value": "ratio_2_3",
          "label": "Portrait (2:3)"
        },
        {
          "value": "ratio_9_16",
          "label": "Portrait (9:16)"
        },
        {
          "value": "ratio_16_9",
          "label": "Landscape (16:9)"
        },
        {
          "value": "ratio_3_2",
          "label": "Landscape (3:2)"
        },
        {
          "value": "ratio_4_3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "ratio_5_4",
          "label": "Landscape (5:4)"
        },
        {
          "value": "custom",
          "label": "t:options.image_ratio.custom"
        }
      ],
      "default": "original"
    },
    {
      "type": "number",
      "id": "image_ratio_custom_width",
      "label": "W",
      "default": 16,
      "visible_if": "{{ block.settings.image_ratio == 'custom' }}"
    },
    {
      "type": "number",
      "id": "image_ratio_custom_height",
      "label": "H",
      "default": 9,
      "visible_if": "{{ block.settings.image_ratio == 'custom' }}"
    },
    {
      "type": "range",
      "id": "thumbnail_width",
      "label": "Desktop width",
      "min": 30,
      "max": 120,
      "step": 1,
      "default": 70,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "thumbnail_width_mobile",
      "label": "Mobile width",
      "min": 30,
      "max": 120,
      "step": 1,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Product content"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "auto_position_price",
      "label": "Auto position price",
      "default": false,
      "info": "Places price beside the title when space allows.",
      "visible_if": "{{ block.settings.show_price }}"
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Desktop gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 4,
      "unit": "px",
      "visible_if": "{{ block.settings.show_price }}"
    },
    {
      "type": "range",
      "id": "content_gap_mobile",
      "label": "Mobile gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 4,
      "unit": "px",
      "visible_if": "{{ block.settings.show_price }}"
    },
    {
      "type": "header",
      "content": "Product add to cart button"
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show add to cart button",
      "default": true
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "tertiary",
          "label": "Tertiary"
        }
