{{ 'section-faq-image-accordion.css' | asset_url | stylesheet_tag }}
{% liquid
  assign faq_section_container_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign faq_section_container_width = 'full-width'
  elsif section.settings.section_width == 'full_width_no_padding'
    assign faq_section_container_width = 'full-width full-width--no-padding'
  endif

  assign faq_section_layout = section.settings.layout | default: 'horizontal'
  unless faq_section_layout == 'vertical' or faq_section_layout == 'horizontal'
    assign faq_section_layout = 'horizontal'
  endunless
  assign faq_section_alignment = section.settings.alignment | default: 'left'
  if faq_section_layout == 'horizontal'
    assign faq_section_alignment = section.settings.horizontal_alignment | default: faq_section_alignment
  endif
  unless faq_section_alignment == 'left' or faq_section_alignment == 'center' or faq_section_alignment == 'right' or faq_section_alignment == 'space-between'
    assign faq_section_alignment = 'left'
  endunless
  assign faq_section_mobile_alignment = section.settings.alignment_mobile | default: 'left'
  unless faq_section_mobile_alignment == 'left' or faq_section_mobile_alignment == 'center' or faq_section_mobile_alignment == 'right'
    assign faq_section_mobile_alignment = 'left'
  endunless
  assign faq_section_position = section.settings.position | default: 'top'
  unless faq_section_position == 'top' or faq_section_position == 'center' or faq_section_position == 'bottom'
    assign faq_section_position = 'top'
  endunless
  assign faq_section_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign faq_section_scheme = section.settings.color_scheme.id
  endif
  assign faq_section_scheme = faq_section_scheme | default: 'scheme-1' | handleize
%}

{% capture faq_section_style %}
  --faq-section-gap: {{ section.settings.gap_desktop | default: 80 }}px;
  --faq-section-gap-mobile: {{ section.settings.gap_mobile | default: 40 }}px;
  --faq-section-padding-top: {{ section.settings.padding_top | default: 0 }}px;
  --faq-section-padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
  {% if section.settings.background_color != blank %}--faq-section-background: {{ section.settings.background_color | escape }};{% endif %}
{% endcapture %}

<div class="faq-section faq-section--{{ faq_section_layout }} faq-section--align-{{ faq_section_alignment }} faq-section--position-{{ faq_section_position }}{% if section.settings.vertical_on_mobile %} faq-section--vertical-mobile faq-section--mobile-align-{{ faq_section_mobile_alignment }}{% endif %}">
  <div class="section-spacing color-scheme section-color-scope {{ faq_section_scheme }}" style="{{ faq_section_style | strip }}">
    <div class="container {{ faq_section_container_width }} faq-section__container">
      <div class="faq-section__content">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>



{% schema %}
{
  "name": "FAQ Image Accordion",
  "class": "section-faq-image-accordion",
  "enabled_on": {
    "templates": [
      "*"
    ]
  },
  "blocks": [
    {
      "type": "group"
    },
    {
      "type": "faq_accordion"
    },
    {
      "type": "images"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "page_width",
          "label": "t:options.section_width.page_width"
        },
        {
          "value": "full_width",
          "label": "t:options.section_width.full_width"
        },
        {
          "value": "full_width_no_padding",
          "label": "t:options.section_width.full_width_no_padding"
        }
      ],
      "default": "page_width"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "top",
      "visible_if": "{{ section.settings.layout == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.layout == 'vertical' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "Horizontal alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "space-between",
          "label": "Space between"
        }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.layout == 'horizontal' }}"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "Vertical on mobile",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "alignment_mobile",
      "label": "Mobile alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.layout == 'horizontal' and section.settings.vertical_on_mobile }}"
    },
    {
      "type": "header",
      "content": "Gap"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Desktop gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Mobile gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "FAQ Image Accordion",
      "settings": {
        "section_width": "page_width",
        "layout": "vertical",
        "alignment": "center",
        "gap_desktop": 56,
        "gap_mobile": 36,
        "color_scheme": "scheme-1",
        "background_color": "#f9f9f9",
        "padding_top": 0,
        "padding_bottom": 0
      },
      "blocks": [
        {
          "type": "group",
          "settings": {
            "direction": "vertical",
            "alignment": "center",
            "alignment_mobile": "center",
            "width": "fill",
            "width_mobile": "fill",
            "height": "fit",
            "gap_desktop": 16,
            "gap_mobile": 12,
            "border_type": "none",
            "corner_radius": "square",
            "shadow": "none",
            "limit_width": true,
            "max_width": 700,
            "padding_top": 80,
            "customize_mobile_padding": true,
            "padding_top_mobile": 56,
            "padding_bottom_mobile": 0,
            "padding_left_mobile": 0,
            "padding_right_mobile": 0
          },
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "text": "<p>Frequently Asked Questions</p>",
                "heading_size": "lg",
                "html_tag": "h2",
                "width": "fill",
                "customize_mobile_size": true,
                "width_mobile": "fill",
                "animation_type": "rotate-words",
                "animation_delay": 50
              }
            },
            {
              "type": "text",
              "settings": {
                "text": "<p>Explore our most frequently asked questions for clear, concise guidance designed to make your shopping experience seamless.</p>",
                "text_size": "md",
                "width": "fill",
                "animation_type": "slide-bottom",
                "animation_delay": 100
              }
            }
          ]
        },
        {
          "type": "group",
          "settings": {
            "direction": "horizontal",
            "alignment": "left",
            "alignment_mobile": "left",
            "width": "fill",
            "width_mobile": "fill",
            "height": "fit",
            "gap_desktop": 40,
            "gap_mobile": 36,
            "border_type": "none",
            "corner_radius": "square",
            "shadow": "none",
            "position_horizontal": "center",
            "horizontal_alignment": "left",
            "customize_mobile_alignment": true,
            "padding_bottom": 80,
            "customize_mobile_padding": true,
            "padding_top_mobile": 0,
            "padding_bottom_mobile": 56,
            "padding_left_mobile": 0,
            "padding_right_mobile": 0
          },
          "blocks": [
            {
              "type": "images",
              "settings": {
                "height_desktop": 540,
                "height_mobile": 300,
                "customize_mobile": true
              },
              "blocks": [
                {
                  "type": "image",
                  "static": true,
                  "settings": {
                    "image_ratio_desktop": "ratio_1_1",
                    "image_ratio_mobile": "ratio_1_1",
                    "width_desktop": "fill",
                    "width_mobile": "fill",
                    "corner_radius": "square",
                    "image": "shopify://shop_images/elara-figma-faq-pool.avif",
                    "mobile_image": "shopify://shop_images/elara-figma-faq-pool.avif"
                  },
                  "id": "first"
                },
                {
                  "type": "image",
                  "static": true,
                  "settings": {
                    "image_ratio_desktop": "ratio_2_3",
                    "image_ratio_mobile": "ratio_2_3",
                    "width_desktop": "fill",
                    "width_mobile": "fill",
                    "corner_radius": "square",
                    "image": "shopify://shop_images/elara-figma-faq-earrings.avif",
                    "mobile_image": "shopify://shop_images/elara-figma-faq-earrings.avif"
                  },
                  "id": "second"
                }
              ]
            },
            {
              "type": "group",
              "settings": {
                "direction": "vertical",
                "alignment": "left",
                "width": "fill",
                "width_mobile": "fill",
                "gap_desktop": 0,
                "gap_mobile": 0,
                "padding_right": 80,
                "customize_mobile_padding": true,
                "padding_top_mobile": 0,
                "padding_bottom_mobile": 0,
                "padding_left_mobile": 0,
                "padding_right_mobile": 0
              },
              "blocks": [
                {
                  "type": "faq_accordion",
                  "settings": {
                    "style": "simple",
                    "icon": "chevron",
                    "dividers": true,
                    "question_font_size": "sm",
                    "gap_desktop": 20,
                    "gap_mobile": 20,
                    "width": "fill",
                    "padding": "custom",
                    "padding_top": 20,
                    "padding_bottom": 20,
                    "padding_left": 0,
                    "padding_right": 0,
                    "question_font": "heading"
                  },
                  "blocks": [
                    {
                      "type": "faq_item",
                      "settings": {
                        "question": "How can I track the status of my order?",
                        "show_question_icon": false,
                        "initially_open": true
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "settings": {
                            "text": "<p>Once your order ships, you’ll receive a confirmation email with a tracking link so you can follow your package in real time. Please contact our support team immediately with your order number and a photo of the item.</p>",
                            "text_size": "sm",
                            "width": "fill",
                            "animation_type": "slide-bottom",
                            "animation_delay": 100
                          }
                        }
                      ]
                    },
                    {
                      "type": "faq_item",
                      "settings": {
                        "question": "How do I place an order on your website?",
                        "show_question_icon": false,
                        "initially_open": false
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "settings": {
                            "text": "<p>Select the items you would like to purchase, choose the available options, and add them to your cart. Review your cart, then proceed to checkout to enter your delivery and payment details.</p>",
                            "text_size": "sm",
                            "width": "fill",
                            "animation_type": "slide-bottom",
                            "animation_delay": 100
                          }
                        }
                      ]
                    },
                    {
                      "type": "faq_item",
                      "settings": {
                        "question": "What shipping options do you offer?",
                        "show_question_icon": false,
                        "initially_open": false
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "settings": {
                            "text": "<p>Available shipping methods, delivery estimates, and costs are shown at checkout after you enter your delivery address. Please review these options before completing your order.</p>",
                            "text_size": "sm",
                            "width": "fill",
                            "animation_type": "slide-bottom",
                            "animation_delay": 100
                          }
                        }
                      ]
                    },
                    {
                      "type": "faq_item",
                      "settings": {
                        "question": "Can I change or cancel my order after it’s been placed?",
                        "show_question_icon": false,
                        "initially_open": false
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "settings": {
                            "text": "<p>Please contact our support team as soon as possible with your order number and the changes you would like to make. We will check your order status and let you know whether a change or cancellation is possible.</p>",
                            "text_size": "sm",
                            "width": "fill",
                            "animation_type": "slide-bottom",
                            "animation_delay": 100
                          }
                        }
                      ]
                    },
                    {
                      "type": "faq_item",
                      "settings": {
                        "question": "What should I do if my package is delayed or lost?",
                        "show_question_icon": false,
                        "initially_open": false
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "settings": {
                            "text": "<p>Check the latest updates using your tracking link. If your package appears delayed or lost, contact our support team with your order number and tracking details so we can help you check its status.</p>",
                            "text_size": "sm",
                            "width": "fill",
                            "animation_type": "slide-bottom",
                            "animation_delay": 100
                          }
                        }
                      ]
                    },
                    {
                      "type": "faq_item",
                      "settings": {
                        "question": "Do you offer international shipping for orders outside my country?",
                        "show_question_icon": false,
                        "initially_open": false
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "settings": {
                            "text": "<p>Enter your delivery address at checkout to see whether shipping is available to your country and which delivery options apply. Contact our support team if you need help checking your destination.</p>",
                            "text_size": "sm",
                            "width": "fill",
                            "animation_type": "slide-bottom",
                            "animation_delay": 100
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "category": "Content"
    }
  ]
}
{% endschema %}
