              },
              "blocks": [
                {
                  "type": "text",
                  "settings": {
                    "text": "<p>Contact our support team for help with products, delivery and care.</p>",
                    "text_size": "md",
                    "width": "fill",
                    "animation_type": "slide-bottom",
                    "animation_delay": 0
                  }
                }
              ]
            },
            {
              "type": "faq_item",
              "settings": {
                "question": "Careers at Our Company",
                "initially_open": false,
