{% liquid
  assign section_width = section.settings.section_width | default: 'page_width'
  unless section_width == 'page_width' or section_width == 'full_width' or section_width == 'full_width_no_padding'
    assign section_width = 'page_width'
  endunless

  assign container_width = 'page-width'
  assign container_no_padding = false
  if section_width == 'full_width' or section_width == 'full_width_no_padding'
    assign container_width = 'full-width'
  endif
  if section_width == 'full_width_no_padding'
    assign container_no_padding = true
  endif

  assign color_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign color_scheme = section.settings.color_scheme.id
  endif

  assign alignment = section.settings.alignment | default: 'center'
  assign flex_align = 'flex-start'
  if alignment == 'center'
    assign flex_align = 'center'
  elsif alignment == 'right'
    assign flex_align = 'flex-end'
  endif

  assign mobile_flex_align = flex_align
  if section.settings.customize_mobile_alignment
    assign mobile_alignment = section.settings.alignment_mobile | default: alignment
    if mobile_alignment == 'center'
      assign mobile_flex_align = 'center'
    elsif mobile_alignment == 'right'
      assign mobile_flex_align = 'flex-end'
    else
      assign mobile_flex_align = 'flex-start'
    endif
  endif

  assign content_gap = section.settings.content_gap | default: 40 | plus: 0
  assign content_gap_mobile = content_gap
  if section.settings.customize_mobile_gap
    assign content_gap_mobile = section.settings.content_gap_mobile | default: content_gap | plus: 0
  endif

  assign padding_top = section.settings.padding_top | default: 0 | plus: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0 | plus: 0
  assign padding_top_mobile = padding_top
  assign padding_bottom_mobile = padding_bottom
  if section.settings.customize_mobile_padding
    assign padding_top_mobile = section.settings.padding_top_mobile | default: padding_top | plus: 0
    assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: padding_bottom | plus: 0
  endif
%}

  <div
    class="section-spacing icon-with-text-custom icon-with-text-custom__spacing color-scheme section-color-scope {{ color_scheme | handleize }}"
    style="--icon-with-text-custom-align: {{ flex_align }}; --icon-with-text-custom-align-mobile: {{ mobile_flex_align }}; --icon-with-text-custom-gap: {{ content_gap }}px; --icon-with-text-custom-gap-mobile: {{ content_gap_mobile }}px; --icon-with-text-custom-padding-top: {{ padding_top }}px; --icon-with-text-custom-padding-bottom: {{ padding_bottom }}px; --icon-with-text-custom-padding-top-mobile: {{ padding_top_mobile }}px; --icon-with-text-custom-padding-bottom-mobile: {{ padding_bottom_mobile }}px;{% if section.settings.background_color != blank %} --icon-with-text-custom-background: {{ section.settings.background_color | escape }};{% endif %}"
  >
    {% if section.settings.background_image != blank %}
      <div class="icon-with-text-custom__background" aria-hidden="true">
        {{ section.settings.background_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: '' }}
      </div>
    {% endif %}
    <div class="container {{ container_width }} icon-with-text-custom__container{% if container_no_padding %} icon-with-text-custom__container--no-padding{% endif %}">
      <div class="icon-with-text-custom__content">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>

{% stylesheet %}
  .icon-with-text-custom { width: 100%; min-width: 0; }
  .icon-with-text-custom__spacing {
    position: relative;
    overflow: hidden;
    width: 100%;
    padding-top: var(--icon-with-text-custom-padding-top);
    padding-bottom: var(--icon-with-text-custom-padding-bottom);
    background-color: var(--icon-with-text-custom-background, var(--background-color));
  }
  .icon-with-text-custom__background { position: absolute; z-index: 0; inset: 0; pointer-events: none; }
  .icon-with-text-custom__background img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .icon-with-text-custom__container { position: relative; z-index: 1; min-width: 0; }
  .container.full-width.icon-with-text-custom__container--no-padding { padding-inline: 0; }
  .icon-with-text-custom__content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: var(--icon-with-text-custom-align);
    gap: var(--icon-with-text-custom-gap);
  }
  .icon-with-text-custom__content > * { min-width: 0; max-width: 100%; }
  @media (max-width: 767.98px) {
    .icon-with-text-custom__spacing {
      padding-top: var(--icon-with-text-custom-padding-top-mobile);
      padding-bottom: var(--icon-with-text-custom-padding-bottom-mobile);
    }
    .icon-with-text-custom__content { align-items: var(--icon-with-text-custom-align-mobile); gap: var(--icon-with-text-custom-gap-mobile, var(--icon-with-text-custom-gap)); }
  }
{% endstylesheet %}

