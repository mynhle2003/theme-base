{% liquid
  assign footer_container_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign footer_container_width = 'full-width'
  endif

  assign footer_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign footer_scheme = section.settings.color_scheme.id
  endif
  assign footer_scheme = footer_scheme | default: 'scheme-1' | handleize

  assign footer_padding_top = section.settings.padding_top | default: 48 | plus: 0
  assign footer_padding_bottom = section.settings.padding_bottom | default: 48 | plus: 0
  assign footer_padding_top_mobile = section.settings.padding_top_mobile | default: 32 | plus: 0
  assign footer_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 32 | plus: 0
  assign footer_gap_desktop = section.settings.gap_desktop | default: 24 | plus: 0
  assign footer_gap_mobile = section.settings.gap_mobile | default: 24 | plus: 0

  if footer_padding_top < 0 or footer_padding_top > 100
    assign footer_padding_top = 48
  endif
  if footer_padding_bottom < 0 or footer_padding_bottom > 100
    assign footer_padding_bottom = 48
  endif
  if footer_padding_top_mobile < 0 or footer_padding_top_mobile > 100
    assign footer_padding_top_mobile = 32
  endif
  if footer_padding_bottom_mobile < 0 or footer_padding_bottom_mobile > 100
    assign footer_padding_bottom_mobile = 32
  endif
  if footer_gap_desktop < 0 or footer_gap_desktop > 100
    assign footer_gap_desktop = 24
  endif
  if footer_gap_mobile < 0 or footer_gap_mobile > 100
    assign footer_gap_mobile = 24
  endif
%}

{% capture footer_style %}
  --footer-padding-top: {{ footer_padding_top }}px;
  --footer-padding-bottom: {{ footer_padding_bottom }}px;
  {% if section.settings.customize_mobile_padding %}
    --footer-padding-top-mobile: {{ footer_padding_top_mobile }}px;
    --footer-padding-bottom-mobile: {{ footer_padding_bottom_mobile }}px;
  {% endif %}
{% endcapture %}
{% assign footer_style = footer_style | strip %}

{% capture footer_layout_style %}
  {% render 'layout-flow-style',
    direction: 'column',
    wrap: 'nowrap',
    align_items: 'stretch',
    gap: footer_gap_desktop,
    gap_mobile: footer_gap_mobile
  %}
{% endcapture %}
{% assign footer_layout_style = footer_layout_style | strip %}

<footer-scroll-reveal data-enabled="{{ section.settings.enable_scroll_reveal }}">
<footer
  class="section-spacing footer footer--virelle{% if section.settings.show_top_divider %} footer--top-divider{% endif %} color-scheme section-color-scope {{ footer_scheme }}"
  {% if footer_style != blank %}style="{{ footer_style }}"{% endif %}
>
  {% if section.settings.background_media == 'image' or section.settings.background_media == 'video' %}
    {% render 'media-background', media_type: section.settings.background_media, image: section.settings.background_image, video: section.settings.background_video, aria_hidden: true, sizes: '100vw' %}
  {% endif %}
  <div class="container {{ footer_container_width }} footer__container">
    <div class="footer__layout layout-flow layout-flow--responsive" style="{{ footer_layout_style }}">
      {% content_for 'blocks' %}
    </div>
  </div>
</footer>
</footer-scroll-reveal>

{% stylesheet %}
  footer-scroll-reveal { display: block; position: relative; }
  .footer-reveal--active { height: var(--footer-reveal-height); clip-path: inset(0); }
  .footer-reveal--active > .footer { position: fixed; bottom: 0; left: var(--footer-reveal-left); width: var(--footer-reveal-width); }
  .footer-reveal--active.footer-reveal--past > .footer { position: absolute; left: 0; width: 100%; }
  .footer--top-divider { border-top: 1px solid var(--border-color); }
  .footer__container { position: relative; z-index: 1; }
  .footer {
    position: relative;
    isolation: isolate;
    width: 100%;
    padding-top: var(--footer-padding-top, 3rem);
    padding-bottom: var(--footer-padding-bottom, 3rem);
  }

  .footer__container,
  .footer__layout {
    width: 100%;
    min-width: 0;
  }

  .footer__layout > * {
    min-width: 0;
    max-width: 100%;
  }

  @media (max-width: 767.98px) {
    .footer {
      padding-top: var(--footer-padding-top-mobile, var(--footer-padding-top, 2rem));
      padding-bottom: var(--footer-padding-bottom-mobile, var(--footer-padding-bottom, 2rem));
    }
  }

  .footer--virelle { --body-color: #fff; --border-color: #ccc; --footer-page-margin: 50px; }
  .footer--virelle .footer__container { width: calc(100% - var(--footer-page-margin) * 2); max-width: none; }
  .footer--virelle .footer__layout > .block-row {
    display: grid;
    grid-template-columns: 30% 50%;
    justify-content: space-between;
    column-gap: 0;
  }
  .footer--virelle .footer__layout > .block-row > .block-column { width: 100%; min-width: 0; }
  .footer--virelle .footer__layout > .block-row > .block-column:last-child > .group { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); }
  .footer--virelle .menu-block__heading { padding-block: 0 var(--menu-block-heading-gap,16px); line-height: 1.4; letter-spacing: 0; }
  .footer--virelle .menu-block__content-inner { padding-block-end: 0; }
  .footer--virelle .menu-block__link { padding-block: 2px; letter-spacing: .1px; line-height: 1.5; }
  .footer--virelle .text-block.body-md { letter-spacing: .1px; }
  .footer--virelle .text-block.body-xs { letter-spacing: 0; }
  .footer--virelle .email-signup-block--layout-input_with_button .email-signup-block__input-wrap {
    height: 56px;
    min-height: 0;
    padding: 0 16px;
    border: 1px solid var(--border-color);
    background: transparent;
  }
  .footer--virelle .email-signup-block__input-wrap > input.form__control:not([type='hidden']) {
    height: 100%;
    min-height: 0;
    padding: 0;
    color: #dfdfdf;
    font-size: var(--font-body-sm,14px);
    letter-spacing: .1px;
  }
  .footer--virelle .email-signup-block__input-wrap > .email-signup-block__button { align-self: stretch; display: flex; align-items: center; }
  .footer--virelle .email-signup-block__submit { width: 44px; min-width: 44px; min-height: 40px; height: 100%; margin-inline-end: -12px; padding: 0; color: #fff; }
  .footer--virelle .email-signup-block__submit .btn__label { gap: 0; }
  .footer--virelle .email-signup-block .form__control::placeholder { color: #dfdfdf; opacity: .6; }
  .footer--virelle .footer__layout > .group > .group { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
  .footer--virelle .footer__layout > .group > .group > .group { display: flex; flex-direction: row; align-items: center; flex-wrap: nowrap; }
  .footer--virelle .footer__layout > .group .menu-block__heading { display: none; }
  .footer--virelle .footer__layout > .group .menu-block__list { display: flex; flex-direction: row; gap: var(--menu-block-menu-gap,24px); }
  .footer--virelle .footer__layout > .group .menu-block { width: fit-content; }
  .footer--virelle .footer__layout > .group .localization-block { width: 285px; }
  .footer--virelle .footer__layout > .group .header-localization__summary { width: 285px; height: 48px; min-height: 0; padding: 0 16px; justify-content: space-between; border: 1px solid var(--border-color); border-radius: 0; }
  .footer--virelle .footer__layout > .group .header-localization__icon { width: 20px; height: 20px; }
  @media (width < 1200px) {
    .footer--virelle .footer__layout > .group > .group { flex-direction: column; align-items: flex-start; }
    .footer--virelle .footer__layout > .group > .group > .group:last-child { flex-wrap: wrap; }
  }
  @media (width < 992px) {
    .footer--virelle { --footer-page-margin: 30px; padding-top: 64px; }
    .footer--virelle .footer__layout { gap: 40px; }
    .footer--virelle .footer__layout > .block-row { grid-template-columns: minmax(0,1fr); gap: 48px; }
    .footer--virelle .footer__layout > .block-row > .block-column:first-child { gap: 32px; }
    .footer--virelle .footer__layout > .group .localization-block { display: none; }
    .footer--virelle .email-signup-block--layout-input_with_button .email-signup-block__input-wrap { height: 48px; }
  }
  @media (width < 768px) {
    .footer--virelle { --footer-page-margin: 16px; padding-top: var(--footer-padding-top-mobile,48px); }
    .footer--virelle .footer__layout { gap: var(--layout-flow-gap-mobile,24px); }
    .footer--virelle .footer__layout > .block-row { gap: 40px; }
    .footer--virelle .footer__layout > .block-row > .block-column:first-child { gap: 24px; }
    .footer--virelle .footer__layout > .block-row > .block-column:last-child > .group { grid-template-columns: minmax(0,1fr); gap: 24px; }
    .footer--virelle .footer__layout > .group > .group,
    .footer--virelle .footer__layout > .group > .group > .group { flex-direction: column; align-items: flex-start; gap: 12px; }
    .footer--virelle .footer__layout > .group .menu-block__list { flex-direction: column; gap: 12px; }
    .footer--virelle .email-signup-block--layout-input_with_button .email-signup-block__input-wrap { height: 44px; }
  }
{% endstylesheet %}

{% javascript %}
if (!customElements.get('footer-scroll-reveal')) {
  customElements.define('footer-scroll-reveal', class extends HTMLElement {
    static get observedAttributes() { return ['data-enabled']; }
    attributeChangedCallback() {
      if (!this.isConnected) return;
      this.disconnectedCallback();
      this.connectedCallback();
    }
    connectedCallback() {
      if (this.dataset.enabled !== 'true' || this.cleanup || this.waiting) return;
      this.footer = this.querySelector('footer');
      if (!this.footer) {
        this.waiting = new MutationObserver(() => {
          if (!this.querySelector('footer')) return;
          this.waiting.disconnect();
          this.waiting = null;
          this.connectedCallback();
        });
        this.waiting.observe(this, { childList: true, subtree: true });
        return;
      }
      let frame = 0;
      const update = () => {
        frame = 0;
        const height = this.footer.getBoundingClientRect().height;
        const viewport = document.documentElement.clientHeight;
        const active = height > 0 && height <= viewport;
        this.classList.toggle('footer-reveal--active', active);
        if (active) {
          this.style.setProperty('--footer-reveal-height', `${height}px`);
          const rect = this.getBoundingClientRect();
          this.style.setProperty('--footer-reveal-left', `${rect.left}px`);
          this.style.setProperty('--footer-reveal-width', `${rect.width}px`);
          this.classList.toggle('footer-reveal--past', rect.bottom <= viewport);
        } else {
          this.classList.remove('footer-reveal--past');
          this.removeAttribute('style');
        }
      };
      const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
      const select = event => {
        if (!this.closest('.shopify-section')?.contains(event.target)) return;
        schedule();
      };
      const focus = event => {
        if (this.classList.contains('footer-reveal--active') && this.getBoundingClientRect().bottom > document.documentElement.clientHeight) {
          this.scrollIntoView({ block: 'end', behavior: 'instant' });
        }
      };
      const observer = new ResizeObserver(schedule);
      observer.observe(this.footer);
      observer.observe(document.documentElement);
      addEventListener('scroll', schedule, { passive: true });
      addEventListener('resize', schedule);
      this.addEventListener('focusin', focus);
      const events = ['shopify:section:select', 'shopify:section:deselect', 'shopify:block:select', 'shopify:block:deselect'];
      events.forEach(name => document.addEventListener(name, select));
      // Reordering one Footer moves its siblings without resizing them.
      const layoutEvents = ['shopify:section:load', 'shopify:section:unload', 'shopify:section:reorder'];
      layoutEvents.forEach(name => document.addEventListener(name, schedule));
      this.cleanup = () => {
        cancelAnimationFrame(frame);
        observer.disconnect();
        removeEventListener('scroll', schedule);
        removeEventListener('resize', schedule);
        this.removeEventListener('focusin', focus);
        events.forEach(name => document.removeEventListener(name, select));
        layoutEvents.forEach(name => document.removeEventListener(name, schedule));
        this.classList.remove('footer-reveal--active', 'footer-reveal--past');
        this.removeAttribute('style');
      };
      update();
    }
    disconnectedCallback() {
      this.waiting?.disconnect();
      this.waiting = null;
      this.cleanup?.();
      this.cleanup = null;
    }
  });
}
{% endjavascript %}

