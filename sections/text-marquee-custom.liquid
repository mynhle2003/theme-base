{% comment %}
  Elara compatibility: saved instances retain their original rendering and
  responsive contract. New presets explicitly opt into the rebuilt layout.
{% endcomment %}
{% capture text_marquee_child_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}
{% if section.settings.use_elara_layout %}
{% liquid
  assign section_container_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign section_container_width = 'full-width'
  elsif section.settings.section_width == 'full_width_no_padding'
    assign section_container_width = 'full-width full-width--no-padding'
  endif

  assign section_direction = section.settings.direction | default: 'vertical'
  unless section_direction == 'horizontal' or section_direction == 'vertical' or section_direction == 'group--horizontal' or section_direction == 'group--vertical'
    assign section_direction = 'vertical'
  endunless
  if section_direction == 'group--horizontal'
    assign section_direction = 'horizontal'
  elsif section_direction == 'group--vertical'
    assign section_direction = 'vertical'
  endif

  assign section_alignment_source = section.settings.alignment | default: 'left'
  if section_direction == 'horizontal'
    assign section_alignment_source = section.settings.horizontal_alignment | default: section_alignment_source
  endif

  assign section_alignment = 'start'
  assign section_justify = 'flex-start'
  case section_alignment_source
    when 'center'
      assign section_alignment = 'center'
      assign section_justify = 'center'
    when 'right', 'end', 'flex-end'
      assign section_alignment = 'end'
      assign section_justify = 'flex-end'
    when 'space-between'
      assign section_justify = 'space-between'
    else
      assign section_alignment = 'start'
  endcase

  assign section_position_source = 'top'
  if section_direction == 'horizontal'
    assign section_position_source = section.settings.position_horizontal | default: 'center'
  endif
  assign section_position_name = section_position_source
  case section_position_name
    when 'center'
      assign section_position_name = 'center'
    when 'bottom', 'flex-end'
      assign section_position_name = 'bottom'
    when 'space-between'
      assign section_position_name = 'space-between'
    else
      assign section_position_name = 'top'
  endcase

  assign section_vertical_on_mobile = false
  if section_direction == 'horizontal' and section.settings.customize_mobile_alignment
    assign section_vertical_on_mobile = true
  endif

  assign section_alignment_mobile = section_alignment
  assign section_justify_mobile = section_justify
  assign section_mobile_alignment_enabled = false
  if section_direction == 'vertical' or section_vertical_on_mobile
    assign section_mobile_alignment_enabled = true
  endif
  assign section_alignment_mobile_source = section.settings.alignment_mobile | default: 'left'
  unless section_alignment_mobile_source == 'left' or section_alignment_mobile_source == 'center' or section_alignment_mobile_source == 'right'
    assign section_alignment_mobile_source = 'left'
  endunless
  if section_mobile_alignment_enabled
    case section_alignment_mobile_source
      when 'center'
        assign section_alignment_mobile = 'center'
        assign section_justify_mobile = 'center'
      when 'right'
        assign section_alignment_mobile = 'end'
        assign section_justify_mobile = 'flex-end'
      else
        assign section_alignment_mobile = 'start'
        assign section_justify_mobile = 'flex-start'
    endcase
  endif

  assign section_flow_mobile_alignment = blank
  if section_mobile_alignment_enabled
    assign section_flow_mobile_alignment = section_alignment_mobile
  endif

  assign section_gap_desktop = section.settings.gap_desktop | default: 16 | plus: 0
  if section_gap_desktop < 0 or section_gap_desktop > 100
    assign section_gap_desktop = 16
  endif
  assign section_gap_mobile = section.settings.gap_mobile | default: 12 | plus: 0
  if section_gap_mobile < 0 or section_gap_mobile > 100
    assign section_gap_mobile = 12
  endif

  assign padding_top = section.settings.padding_top | default: 0 | plus: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0 | plus: 0
  assign padding_top_mobile = section.settings.padding_top_mobile | default: padding_top | plus: 0
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: padding_bottom | plus: 0

  assign color_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign color_scheme = section.settings.color_scheme.id
  endif
  assign color_scheme = color_scheme | default: 'scheme-1' | handleize
%}

{% capture section_style %}
  {% if section.settings.background_color != blank %}--text-marquee-custom-background: {{ section.settings.background_color | escape }};{% endif %}
  {% if section.settings.background_image != blank %}--text-marquee-custom-background-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');{% endif %}
  {% if padding_top != 0 %}--text-marquee-custom-padding-top: {{ padding_top }}px;{% endif %}
  {% if padding_bottom != 0 %}--text-marquee-custom-padding-bottom: {{ padding_bottom }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    --text-marquee-custom-padding-top-mobile: {{ padding_top_mobile }}px;
    --text-marquee-custom-padding-bottom-mobile: {{ padding_bottom_mobile }}px;
  {% endif %}
{% endcapture %}
{% assign section_style = section_style | strip %}

{% capture section_content_style %}
  {% render 'layout-flow-group-style',
    direction: section_direction,
    position: section_position_name,
    alignment: section_alignment,
    horizontal_alignment: section_justify,
    mobile_vertical: section_vertical_on_mobile,
    mobile_alignment: section_flow_mobile_alignment,
    mobile_justify: section_justify_mobile,
    gap: section_gap_desktop,
    gap_mobile: section_gap_mobile
  %}
  --text-marquee-custom-align: {{ section_alignment }};
  {% if section_mobile_alignment_enabled %}--text-marquee-custom-align-mobile: {{ section_alignment_mobile }};{% endif %}
{% endcapture %}
{% assign section_content_style = section_content_style | strip %}

<div
  class="section-spacing elara-text-marquee-custom elara-text-marquee-custom--{{ section_direction }}{% if section_vertical_on_mobile %} elara-text-marquee-custom--mobile-vertical{% endif %} color-scheme {{ color_scheme }}"
  {% if section_style != blank %}style="{{ section_style }}"{% endif %}
>
  {% if section.settings.background_image != blank %}
    <div class="elara-text-marquee-custom__background" aria-hidden="true"></div>
  {% endif %}
  {% if section.settings.show_header %}
  <div class="container page-width marquee-section-layout{% if section.settings.full_bleed_marquee %} marquee-section-layout--bleed{% endif %}" style="--marquee-section-gap:{{ section.settings.gap_desktop }}px;--marquee-section-gap-mobile:{{ section.settings.gap_mobile }}px;">
    <div class="marquee-section-layout__header">{% content_for 'block', type: 'header', id: 'marquee-header' %}</div>
    <div class="marquee-section-layout__action">{% content_for 'block', type: 'button', id: 'marquee-action' %}</div>
    <div class="marquee-section-layout__track">{{ text_marquee_child_blocks }}</div>
  </div>
  {% else %}
  <div class="container {{ section_container_width }} elara-text-marquee-custom__container">
    <div class="elara-text-marquee-custom__content layout-flow layout-flow--responsive layout-flow--{{ section_direction }}{% if section_vertical_on_mobile %} layout-flow--mobile-vertical{% endif %}" style="{{ section_content_style }}">
      {{ text_marquee_child_blocks }}
    </div>
  </div>
  {% endif %}
</div>
{% else %}
{% liquid
  assign section_container_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign section_container_width = 'full-width'
  elsif section.settings.section_width == 'full_width_no_padding'
    assign section_container_width = 'full-width full-width--no-padding'
  endif

  assign section_direction = section.settings.direction | default: 'vertical'
  unless section_direction == 'horizontal' or section_direction == 'vertical'
    assign section_direction = 'vertical'
  endunless

  assign section_position = section.settings.position | default: 'top'
  unless section_position == 'top' or section_position == 'center' or section_position == 'bottom'
    assign section_position = 'top'
  endunless

  assign section_alignment = section.settings.alignment | default: 'left'
  if section_direction == 'vertical'
    assign section_alignment = section.settings.position_vertical | default: 'left'
  endif
  unless section_alignment == 'left' or section_alignment == 'center' or section_alignment == 'right' or section_alignment == 'space-between'
    assign section_alignment = 'left'
  endunless

  assign section_alignment_mobile = section.settings.alignment_mobile | default: section_alignment
  unless section_alignment_mobile == 'left' or section_alignment_mobile == 'center' or section_alignment_mobile == 'right' or section_alignment_mobile == 'space-between'
    assign section_alignment_mobile = section_alignment
  endunless

  assign section_alignment_mobile_css = 'flex-start'
  assign section_justify_mobile_css = 'flex-start'
  case section_alignment_mobile
    when 'center'
      assign section_alignment_mobile_css = 'center'
      assign section_justify_mobile_css = 'center'
    when 'right'
      assign section_alignment_mobile_css = 'flex-end'
      assign section_justify_mobile_css = 'flex-end'
    when 'space-between'
      assign section_justify_mobile_css = 'space-between'
  endcase

  assign padding_top = section.settings.padding_top | default: 0 | plus: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0 | plus: 0
  assign padding_top_mobile = section.settings.padding_top_mobile | default: padding_top | plus: 0
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: padding_bottom | plus: 0

  assign color_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign color_scheme = section.settings.color_scheme.id
  endif
  assign color_scheme = color_scheme | default: 'scheme-1' | handleize
%}

{% capture section_style %}
  --text-marquee-custom-gap: {{ section.settings.gap_desktop | default: 16 | plus: 0 }}px;
  --text-marquee-custom-gap-mobile: {{ section.settings.gap_mobile | default: 12 | plus: 0 }}px;
  {% if section.settings.background_color != blank %}--text-marquee-custom-background: {{ section.settings.background_color | escape }};{% endif %}
  {% if section.settings.background_image != blank %}--text-marquee-custom-background-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');{% endif %}
  {% if section.settings.direction == 'horizontal' and section.settings.customize_mobile_alignment %}
    --text-marquee-custom-align-mobile: {{ section_alignment_mobile_css }};
    --text-marquee-custom-justify-mobile: {{ section_justify_mobile_css }};
  {% endif %}
  {% if padding_top != 0 %}--text-marquee-custom-padding-top: {{ padding_top }}px;{% endif %}
  {% if padding_bottom != 0 %}--text-marquee-custom-padding-bottom: {{ padding_bottom }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    --text-marquee-custom-padding-top-mobile: {{ padding_top_mobile }}px;
    --text-marquee-custom-padding-bottom-mobile: {{ padding_bottom_mobile }}px;
  {% endif %}
{% endcapture %}
{% assign section_style = section_style | strip %}

<div
  class="text-marquee-custom color-scheme {{ color_scheme }} text-marquee-custom--{{ section_direction }} text-marquee-custom--align-{{ section_alignment }} text-marquee-custom--position-{{ section_position }}{% if section_direction == 'horizontal' and section.settings.customize_mobile_alignment %} text-marquee-custom--mobile-vertical{% endif %}"
  {% if section_style != blank %}style="{{ section_style }}"{% endif %}
>
  {% if section.settings.background_image != blank %}
    <div class="media-background-surface text-marquee-custom__background" aria-hidden="true"></div>
  {% endif %}
  <div class="container {{ section_container_width }} text-marquee-custom__container">
    <div class="text-marquee-custom__content">
      {{ text_marquee_child_blocks }}
    </div>
  </div>
</div>
{% endif %}

{% stylesheet %}
  .marquee-section-layout{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:var(--marquee-section-gap,32px);}
  .marquee-section-layout__header{min-width:0;}
  .marquee-section-layout__action{justify-self:end;}
  .marquee-section-layout__track{grid-column:1 / -1;min-width:0;width:100%;}
  .marquee-section-layout--bleed .marquee-section-layout__track{width:100vw;margin-inline:calc((100% - 100vw) / 2);}
  @media(max-width:767.98px){.marquee-section-layout{grid-template-columns:minmax(0,1fr);gap:var(--marquee-section-gap-mobile,var(--marquee-section-gap));}.marquee-section-layout__action{order:3;justify-self:start;}.marquee-section-layout__track{order:2;}}

  .text-marquee-custom {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: var(--text-marquee-custom-align, flex-start);
    justify-content: var(--text-marquee-custom-position, flex-start);
    gap: var(--text-marquee-custom-gap, 16px);
    min-width: 0;
    width: 100%;
    overflow: hidden;
    padding-top: var(--text-marquee-custom-padding-top, 0px);
    padding-bottom: var(--text-marquee-custom-padding-bottom, 0px);
    background-color: var(--text-marquee-custom-background, var(--background-color));
    background-image: var(--text-marquee-custom-background-image, none);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }
  .section-text-marquee-custom .text-marquee-custom {
    --text-marquee-custom-padding-scale: 1;
    padding-top: calc(var(--text-marquee-custom-padding-top, 0px) * var(--text-marquee-custom-padding-scale));
    padding-bottom: calc(var(--text-marquee-custom-padding-bottom, 0px) * var(--text-marquee-custom-padding-scale));
  }
  @media (max-width: 767.98px) {
    .section-text-marquee-custom .text-marquee-custom {
      --text-marquee-custom-padding-scale: 1;
      padding-top: var(--text-marquee-custom-padding-top-mobile, calc(var(--text-marquee-custom-padding-top, 0px) * var(--text-marquee-custom-padding-scale)));
      padding-bottom: var(--text-marquee-custom-padding-bottom-mobile, calc(var(--text-marquee-custom-padding-bottom, 0px) * var(--text-marquee-custom-padding-scale)));
    }
  }
  .text-marquee-custom .container.full-width--no-padding { padding-inline: 0; }
  .text-marquee-custom__container { min-width: 0; }
  .section-text-marquee-custom .text-marquee-custom__container {
    display: flex;
    flex-direction: inherit;
    align-items: inherit;
    justify-content: inherit;
    gap: inherit;
  }
  .text-marquee-custom__content > .marquee .container.full-width { padding-inline: 0; }

  .text-marquee-custom--horizontal {
    flex-direction: row;
  }

  .text-marquee-custom--align-left {
    --text-marquee-custom-align: flex-start;
    --text-marquee-custom-justify: flex-start;
  }

  .text-marquee-custom--align-center {
    --text-marquee-custom-align: center;
    --text-marquee-custom-justify: center;
    --text-align-default: center;
  }

  .text-marquee-custom--align-right {
    --text-marquee-custom-align: flex-end;
    --text-marquee-custom-justify: flex-end;
  }

  .text-marquee-custom--align-space-between {
    --text-marquee-custom-align: flex-start;
    --text-marquee-custom-justify: space-between;
  }

  .text-marquee-custom--horizontal {
    justify-content: var(--text-marquee-custom-justify, flex-start);
  }

  .text-marquee-custom--position-top {
    --text-marquee-custom-position: flex-start;
  }

  .text-marquee-custom--position-center {
    --text-marquee-custom-position: center;
  }

  .text-marquee-custom--position-bottom {
    --text-marquee-custom-position: flex-end;
  }

  .text-marquee-custom__content {
    display: flex;
    flex: 1 1 auto;
    flex-direction: inherit;
    align-items: inherit;
    justify-content: inherit;
    gap: inherit;
    min-width: 0;
    width: 100%;
  }

  .text-marquee-custom__content > * {
    min-width: 0;
  }

  .text-marquee-custom__background {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  @media (max-width: 767.98px) {
    .text-marquee-custom {
      gap: var(--text-marquee-custom-gap-mobile, var(--text-marquee-custom-gap, 12px));
      padding-top: var(--text-marquee-custom-padding-top-mobile, var(--text-marquee-custom-padding-top, 0px));
      padding-bottom: var(--text-marquee-custom-padding-bottom-mobile, var(--text-marquee-custom-padding-bottom, 0px));
    }

    .text-marquee-custom--horizontal.text-marquee-custom--mobile-vertical {
      flex-direction: column;
      align-items: var(--text-marquee-custom-align-mobile, flex-start);
      justify-content: var(--text-marquee-custom-justify-mobile, flex-start);
    }
  }


  .section-text-marquee-custom .elara-text-marquee-custom {
    position: relative;
    min-width: 0;
    width: 100%;
    overflow: hidden;
    padding-top: var(--text-marquee-custom-padding-top, 0px);
    padding-bottom: var(--text-marquee-custom-padding-bottom, 0px);
    background-color: var(--text-marquee-custom-background, var(--background-color));
    background-image: var(--text-marquee-custom-background-image, none);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }
  .section-text-marquee-custom .elara-text-marquee-custom {
    --text-marquee-custom-padding-scale: 1;
    padding-top: calc(var(--text-marquee-custom-padding-top, 0px) * var(--text-marquee-custom-padding-scale));
    padding-bottom: calc(var(--text-marquee-custom-padding-bottom, 0px) * var(--text-marquee-custom-padding-scale));
  }
  @media (min-width: 768px) and (max-width: 1149.98px) {
    .section-text-marquee-custom .elara-text-marquee-custom { --text-marquee-custom-padding-scale: 0.75; }
  }
  @media (max-width: 767.98px) {
    .section-text-marquee-custom .elara-text-marquee-custom {
      --text-marquee-custom-padding-scale: 0.5;
      padding-top: var(--text-marquee-custom-padding-top-mobile, calc(var(--text-marquee-custom-padding-top, 0px) * var(--text-marquee-custom-padding-scale)));
      padding-bottom: var(--text-marquee-custom-padding-bottom-mobile, calc(var(--text-marquee-custom-padding-bottom, 0px) * var(--text-marquee-custom-padding-scale)));
    }
  }
  .section-text-marquee-custom .elara-text-marquee-custom .container.full-width--no-padding { width: 100%; max-width: none; padding-inline: 0; }
  .section-text-marquee-custom .elara-text-marquee-custom__container { min-width: 0; }
  .section-text-marquee-custom .elara-text-marquee-custom__content > .marquee .container.full-width { padding-inline: 0; }

  .section-text-marquee-custom .elara-text-marquee-custom__content {
    --flex-align: var(--text-marquee-custom-align, start);
    --flex-align-mobile: var(--text-marquee-custom-align-mobile, var(--text-marquee-custom-align, start));
    min-width: 0;
    width: 100%;
    text-align: var(--flex-align);
  }


  .section-text-marquee-custom .elara-text-marquee-custom__content > * {
    min-width: 0;
  }

  .section-text-marquee-custom .elara-text-marquee-custom__background {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  @media (max-width: 767.98px) {
    .section-text-marquee-custom .elara-text-marquee-custom {
      padding-top: var(--text-marquee-custom-padding-top-mobile, var(--text-marquee-custom-padding-top, 0px));
      padding-bottom: var(--text-marquee-custom-padding-bottom-mobile, var(--text-marquee-custom-padding-bottom, 0px));
    }

    .section-text-marquee-custom .elara-text-marquee-custom__content {
      --flex-align: var(--text-marquee-custom-align-mobile, var(--text-marquee-custom-align, start));
      text-align: var(--flex-align);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Text marquee (custom)",
  "class": "section-text-marquee-custom",
  "enabled_on": {
    "templates": [
      "*"
    ]
  },
  "blocks": [
    {
      "type": "header"
    },
    {
      "type": "eyebrow"
    },
    {
      "type": "heading"
    },
    {
      "type": "text"
    },
    {
      "type": "image"
    },
    {
      "type": "video"
    },
    {
      "type": "button"
    },
    {
      "type": "buttons"
    },
    {
      "type": "icon"
    },
    {
      "type": "spacer"
    },
    {
      "type": "scroll-to"
    },
    {
      "type": "marquee"
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "use_elara_layout",
      "label": "Use Elara layout",
      "default": false,
      "info": "Enable the rebuilt layout. Existing content keeps its original appearance until enabled."
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show header and action",
      "default": false,
      "visible_if": "{{ section.settings.use_elara_layout }}"
    },
    {
      "type": "checkbox",
      "id": "full_bleed_marquee",
      "label": "Extend marquee to screen edges",
      "default": false,
      "visible_if": "{{ section.settings.use_elara_layout and section.settings.show_header }}"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "page_width",
          "label": "t:options.section_width.page_width"
        },
        {
          "value": "full_width",
          "label": "t:options.section_width.full_width"
        },
        {
          "value": "full_width_no_padding",
          "label": "t:options.section_width.full_width_no_padding"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:labels.direction",
      "options": [
        {
          "value": "horizontal",
          "label": "t:options.direction.horizontal"
        },
        {
          "value": "vertical",
          "label": "t:options.direction.vertical"
        }
      ],
      "default": "vertical"
    },
    {
      "type": "select",
      "id": "position_horizontal",
      "label": "t:labels.position",
      "options": [
        {
          "value": "top",
          "label": "t:options.position.top"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "bottom",
          "label": "t:options.position.bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:labels.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        },
        {
          "value": "space-between",
          "label": "t:options.alignment.space_between"
        }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.direction == 'horizontal' }}"
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_alignment",
      "label": "t:labels.vertical_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        },
        {
          "value": "space-between",
          "label": "t:options.alignment.space_between"
        }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.direction == 'vertical' }}"
