{% liquid
  assign gallery_width = section.settings.section_width | default: 'full_width'
  assign gallery_container = 'full-width'
  if gallery_width == 'page_width'
    assign gallery_container = 'page-width'
  endif
  assign gallery_header_vertical_alignment = section.settings.header_vertical_alignment | default: 'middle'
  unless gallery_header_vertical_alignment == 'top' or gallery_header_vertical_alignment == 'middle' or gallery_header_vertical_alignment == 'bottom'
    assign gallery_header_vertical_alignment = 'middle'
  endunless
  assign gallery_header_position = section.settings.header_position | default: 'beside'
  unless gallery_header_position == 'above' or gallery_header_position == 'beside'
    assign gallery_header_position = 'beside'
  endunless
  assign gallery_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'scheme-1'
%}

<div
  class="section-content-scope hotspot-gallery section-spacing section-color-scope color-scheme {{ gallery_scheme | handleize }}"
  style="
    --section-padding-top: {{ section.settings.padding_top | default: 40 }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
    {% if section.settings.customize_mobile_padding %}
      --section-padding-top-mobile: {{ section.settings.padding_top_mobile | default: 40 }}px;
      --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
    {% endif %}
    --hotspot-gallery-content-gap: {{ section.settings.content_gap | default: 40 }}px;
    {% if gallery_width != 'full_width_no_padding' and section.settings.background_color != blank %}
      --hotspot-gallery-background: {{ section.settings.background_color | escape }};
    {% endif %}
  "
>
  {% if gallery_width != 'full_width_no_padding' and section.settings.background_media != 'none' %}
    {% render 'media-background',
      media_type: section.settings.background_media,
      image: section.settings.background_image,
      video: section.settings.background_video,
      alt: '',
      aria_hidden: true,
      sizes: '100vw',
      class: 'hotspot-gallery__background'
    %}
  {% endif %}
  <div class="hotspot-gallery__layout container {{ gallery_container }}{% if gallery_width == 'full_width_no_padding' %} hotspot-gallery__layout--no-padding{% endif %}" data-header-position="{{ gallery_header_position }}">
    {% capture hotspot_gallery_header_content %}{% content_for 'block', type: 'header', id: 'header' %}{% endcapture %}
    {% capture hotspot_gallery_header_class %}hotspot-gallery__header hotspot-gallery__header--{{ gallery_header_vertical_alignment }}{% if section.settings.enable_header_sticky %} hotspot-gallery__header--sticky{% endif %}{% endcapture %}
    {% render 'section-content-slot', content: hotspot_gallery_header_content, class: hotspot_gallery_header_class %}
    {% content_for 'block', type: 'product-callout-gallery', id: 'product-callout' %}
  </div>
</div>

{% stylesheet %}
  .hotspot-gallery {
    position: relative;
    isolation: isolate;
    background: var(--hotspot-gallery-background, var(--background-color));
  }

  .hotspot-gallery__background {
    z-index: -1;
    pointer-events: none;
  }

  .hotspot-gallery__layout {
    display: grid;
    grid-template-columns: fit-content(50%) minmax(0, 1fr);
    align-items: center;
    gap: var(--hotspot-gallery-content-gap, 40px);
  }

  .hotspot-gallery__layout[data-header-position="above"] {
    grid-template-columns: minmax(0, 1fr);
  }

  .hotspot-gallery__layout[data-header-position="above"] .hotspot-gallery__header--sticky {
    position: static;
  }

  .hotspot-gallery__header {
    min-width: 0;
  }

  .hotspot-gallery__header--top {
    align-self: start;
  }

  .hotspot-gallery__header--middle {
    align-self: center;
  }

  .hotspot-gallery__header--bottom {
    align-self: end;
  }

  @media (min-width: 768px) {
    .hotspot-gallery__header--sticky {
      position: sticky;
      top: calc(var(--header-height, 0px) + var(--layout-grid-gap, 1rem));
    }
  }

  .hotspot-gallery__header:not(:has(.block-header:not([data-content-empty]))) {
    display: none;
  }

  .hotspot-gallery__layout:not(:has(.block-header:not([data-content-empty]))) {
    grid-template-columns: minmax(0, 1fr);
  }

  .container.hotspot-gallery__layout--no-padding {
    padding-inline: 0;
  }

  .hotspot-gallery__layout[data-header-position="beside"]:has(.product-callout-gallery__navigation--top) {
    position: relative;
    grid-template-columns: minmax(0, 23%) minmax(0, 1fr);
  }

  .hotspot-gallery__layout[data-header-position="beside"]:has(.product-callout-gallery__navigation--top) > .product-callout-gallery {
    position: static;
    min-width: 0;
  }

  .hotspot-gallery__layout[data-header-position="beside"]:has(.product-callout-gallery__navigation--top) .product-callout-gallery__carousel-wrap {
    position: static;
  }

  .hotspot-gallery__layout[data-header-position="beside"] .product-callout-gallery__navigation--top {
    --swiper-nav-size: 48px;
    --swiper-nav-size-mobile: 48px;
    gap: 12px;
  }

  @media (min-width: 768px) {
    .hotspot-gallery__layout[data-header-position="beside"]:has(.product-callout-gallery__navigation--top) > .hotspot-gallery__header {
      padding-block-end: calc(var(--swiper-nav-size, var(--button-height)) + 32px);
    }

    .hotspot-gallery__layout[data-header-position="beside"]:has(.product-callout-gallery__navigation--top) > .hotspot-gallery__header--top {
      padding-block-start: 64px;
    }

    .hotspot-gallery__layout[data-header-position="beside"] .product-callout-gallery__navigation--top {
      position: absolute;
      inset: auto auto 0 var(--page-margin-current);
      margin: 0;
    }

    .hotspot-gallery__layout--no-padding[data-header-position="beside"] .product-callout-gallery__navigation--top {
      inset-inline-start: 0;
    }

    .hotspot-gallery__layout[data-header-position="beside"]:not(:has(.block-header:not([data-content-empty]))) {
      grid-template-columns: minmax(0, 1fr);
    }

    .hotspot-gallery__layout[data-header-position="beside"]:not(:has(.block-header:not([data-content-empty]))) .product-callout-gallery__navigation--top {
      position: relative;
      inset: auto;
      margin-block-end: 1rem;
    }
  }

  @media (max-width: 767.98px) {
    .hotspot-gallery__layout,
    .hotspot-gallery__layout[data-header-position="beside"]:has(.product-callout-gallery__navigation--top) {
      grid-template-columns: minmax(0, 1fr);
    }

    .hotspot-gallery__layout[data-header-position="beside"]:has(.product-callout-gallery__navigation--top) {
      row-gap: 24px;
    }

    .hotspot-gallery__layout[data-header-position="beside"] .product-callout-gallery__navigation--top {
      display: flex;
      margin-block-end: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hotspot_gallery",
  "class": "section-hotspot-gallery",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "blocks": [
    {
      "type": "header"
    },
    {
      "type": "product-callout-gallery"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "page_width",
          "label": "t:options.section_width.page_width"
        },
        {
          "value": "full_width",
          "label": "t:options.section_width.full_width"
        },
        {
          "value": "full_width_no_padding",
          "label": "t:options.section_width.full_width_no_padding"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "select",
      "id": "header_position",
      "label": "Header position",
      "options": [
        {
          "value": "above",
          "label": "Above section"
        },
        {
          "value": "beside",
          "label": "Beside images"
        }
      ],
      "default": "beside"
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "t:labels.content_gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "header_vertical_alignment",
      "label": "t:labels.header_vertical_alignment",
      "options": [
        {
          "value": "top",
          "label": "t:options.vertical_alignment.top"
        },
        {
          "value": "middle",
          "label": "t:options.vertical_alignment.middle"
        },
        {
          "value": "bottom",
          "label": "t:options.vertical_alignment.bottom"
        }
      ],
      "default": "middle"
    },
    {
      "type": "checkbox",
      "id": "enable_header_sticky",
      "label": "t:labels.enable_sticky",
      "info": "t:info.hotspot_gallery_sticky_header",
      "default": false
    },
    {
      "type": "header",
      "content": "t:general.product_card"
    },
    {
      "type": "checkbox",
      "id": "show_product_type",
      "label": "t:labels.show_product_type",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_product_image",
      "label": "t:labels.show_product_image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "t:labels.show_price",
      "default": true
    },
    {
      "type": "text",
      "id": "product_link_label",
      "label": "t:labels.product_link_label",
      "default": "View product"
    },
    {
      "type": "header",
      "content": "t:general.appearance",
      "visible_if": "{{ section.settings.section_width != 'full_width_no_padding' }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ section.settings.section_width != 'full_width_no_padding' }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "background_color",
      "label": "t:labels.background_color",
      "visible_if": "{{ section.settings.section_width != 'full_width_no_padding' }}"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:general.media",
      "options": [
        {
          "value": "none",
          "label": "t:options.background_media.none"
        },
        {
          "value": "image",
          "label": "t:general.image"
        },
        {
          "value": "video",
          "label": "t:general.video"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.section_width != 'full_width_no_padding' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image",
      "visible_if": "{{ section.settings.section_width != 'full_width_no_padding' and section.settings.background_media == 'image' }}"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "t:labels.background_video",
      "visible_if": "{{ section.settings.section_width != 'full_width_no_padding' and section.settings.background_media == 'video' }}"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "t:general.hotspot_gallery",
      "category": "t:general.banners",
      "settings": {
        "color_scheme": "scheme-1",
        "padding_top": 96,
        "padding_bottom": 96,
        "customize_mobile_padding": true,
        "padding_top_mobile": 48,
        "padding_bottom_mobile": 48,
        "section_width": "full_width",
        "header_position": "beside",
        "content_gap": 40,
        "header_vertical_alignment": "top",
        "show_product_type": false,
        "show_product_image": true,
        "show_price": true,
        "product_link_label": "View product"
      },
      "blocks": [
        {
          "type": "header",
          "settings": {
            "width": "custom",
            "inherit_alignment": false,
            "alignment": "left",
            "customize_mobile_alignment": true,
            "alignment_mobile": "left",
            "gap_desktop": 16,
            "gap_mobile": 12,
            "max_width": 360
          },
          "static": true,
          "id": "header",
          "blocks": [
            {
              "type":  "eyebrow",
                  "settings": {
                    "animation_delay": 0,
                    "animation_type": "fade",
                    "text": "<p>Discover</p>",
                    "show_icon": true,
                    "icon": "square",
                    "show_background": false
                  }

            },
            {
              "type": "heading",
              "settings": {
                "text": "<p>This week’s highlights</p>",
                "heading_size": "xl",
                "html_tag": "h2",
                "width": "fill"
              ,
                "animation_type": "slide-bottom",
                "animation_delay": 50}
            },
            {
              "type": "text",
              "settings": {
                "text": "<p>Uncover the must-have items that are capturing the hearts of our shoppers this week, ensuring you stay comfortable during your workouts</p>",
                "text_size": "md",
                "width": "fill"
              ,
                "animation_type": "fade",
                "animation_delay": 100}
            }
          ]
        },
        {
          "type": "product-callout-gallery",
          "settings": {
            "layout_type": "carousel",
            "columns_desktop": "2",
            "columns_mobile": "1",
            "show_next_slide_preview_on_desktop": true,
            "image_ratio": "custom",
            "image_ratio_custom_width": 6,
            "image_ratio_custom_height": 7,
            "gap_desktop": 20,
            "gap_mobile": 20,
            "hotspot_icon_style": "dot",
            "hotspot_behavior": "click",
            "show_navigation_on_desktop": true,
            "navigation_position": "top",
            "navigation_style": "primary",
            "navigation_icon": "chevron",
            "navigation_behavior": "always",
            "show_pagination_on_desktop": false
          },
          "static": true,
          "id": "product-callout",
          "blocks": [
            {
              "type": "gallery-hotspot",
              "settings": {
                "image": "shopify://shop_images/kinetra-highlight-pink.avif",
                "product": "virelle-soft-motion-leggings",
                "horizontal_position": 65,
                "vertical_position": 63,
                "customize_mobile_position": true,
                "mobile_horizontal_position": 65,
                "mobile_vertical_position": 63
              }
            },
            {
              "type": "gallery-hotspot",
              "settings": {
                "image": "shopify://shop_images/kinetra-highlight-brown.avif",
                "product": "kinetra-mocha-scoop-sports-bra"
              }
            },
            {
              "type": "gallery-hotspot",
              "settings": {
                "image": "shopify://shop_images/kinetra-highlight-black.avif",
                "product": "kinetra-everyday-high-rise-leggings"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
