{% liquid
  assign blog_posts_container_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign blog_posts_container_width = 'full-width'
  endif

  assign blog_posts_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign blog_posts_scheme = section.settings.color_scheme.id
  endif
  assign blog_posts_scheme = blog_posts_scheme | default: 'scheme-1' | handleize

  assign blog_posts_desktop_alignment = section.settings.desktop_alignment | default: 'left'
  unless blog_posts_desktop_alignment == 'left' or blog_posts_desktop_alignment == 'center' or blog_posts_desktop_alignment == 'right'
    assign blog_posts_desktop_alignment = 'left'
  endunless

  assign blog_posts_mobile_alignment = section.settings.mobile_alignment | default: 'left'
  unless blog_posts_mobile_alignment == 'left' or blog_posts_mobile_alignment == 'center' or blog_posts_mobile_alignment == 'right'
    assign blog_posts_mobile_alignment = 'left'
  endunless

  assign blog_posts_gap_desktop = section.settings.gap_desktop | default: 32 | plus: 0
  if blog_posts_gap_desktop < 0 or blog_posts_gap_desktop > 100
    assign blog_posts_gap_desktop = 32
  endif
  assign blog_posts_gap_mobile = section.settings.gap_mobile | default: 24 | plus: 0
  if blog_posts_gap_mobile < 0 or blog_posts_gap_mobile > 100
    assign blog_posts_gap_mobile = 24
  endif

  assign blog_posts_source = section.settings.blog

  assign blog_posts_padding_top = section.settings.padding_top | default: 0 | plus: 0
  assign blog_posts_padding_bottom = section.settings.padding_bottom | default: 0 | plus: 0
  assign blog_posts_padding_top_mobile = section.settings.padding_top_mobile | default: 0 | plus: 0
  assign blog_posts_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 0 | plus: 0
%}

{% capture blog_posts_style %}
  {% if blog_posts_gap_desktop != 32 %}--blog-posts-gap-desktop: {{ blog_posts_gap_desktop }}px;{% endif %}
  {% if blog_posts_gap_mobile != 24 %}--blog-posts-gap-mobile: {{ blog_posts_gap_mobile }}px;{% endif %}
  {% if blog_posts_padding_top != 0 %}--blog-posts-padding-top: {{ blog_posts_padding_top }}px;{% endif %}
  {% if blog_posts_padding_bottom != 0 %}--blog-posts-padding-bottom: {{ blog_posts_padding_bottom }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    {% if blog_posts_padding_top_mobile != blog_posts_padding_top %}--blog-posts-padding-top-mobile: {{ blog_posts_padding_top_mobile }}px;{% endif %}
    {% if blog_posts_padding_bottom_mobile != blog_posts_padding_bottom %}--blog-posts-padding-bottom-mobile: {{ blog_posts_padding_bottom_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign blog_posts_style = blog_posts_style | strip %}

<div
  class="section-spacing blog-posts section-content-scope section-content-surface section-color-scope {{ blog_posts_scheme }}"
  {% if blog_posts_style != blank %}style="{{ blog_posts_style }}"{% endif %}
>
  <div
    class="container {{ blog_posts_container_width }} blog-posts__container section-list-layout"
    data-blog-posts
    data-desktop-alignment="{{ blog_posts_desktop_alignment }}"
    data-mobile-alignment="{{ blog_posts_mobile_alignment }}"
  >
    {% capture blog_posts_header_content %}{% content_for 'block', type: 'header', id: 'header' %}{% endcapture %}
    {% render 'section-content-slot', content: blog_posts_header_content, class: 'blog-posts__header section-list-layout__header' %}
    {% capture blog_posts_actions_content %}{% content_for 'block', type: 'view-all-button', id: 'blog-posts-view-all', closest.blog: blog_posts_source %}{% endcapture %}
    {% render 'section-content-slot', content: blog_posts_actions_content, class: 'blog-posts__actions section-list-layout__actions' %}
    {% capture blog_posts_list_content %}{% content_for 'block', type: 'blog-list', id: 'blog-list', closest.blog: blog_posts_source, use_section_blog: true %}{% endcapture %}
    {% render 'section-content-slot', content: blog_posts_list_content, class: 'blog-posts__list section-list-layout__body' %}
  </div>
</div>

{% stylesheet %}
  .blog-posts {
    width: 100%;
    padding-top: var(--blog-posts-padding-top, 0px);
    padding-bottom: var(--blog-posts-padding-bottom, 0px);
  }
  .blog-posts__container {
    --section-list-gap: var(--blog-posts-gap-desktop, 32px);
    --section-list-gap-mobile: var(--blog-posts-gap-mobile, 24px);
  }

  @media (max-width: 767.98px) {
    .blog-posts {
      padding-top: var(--blog-posts-padding-top-mobile, var(--blog-posts-padding-top, 0px));
      padding-bottom: var(--blog-posts-padding-bottom-mobile, var(--blog-posts-padding-bottom, 0px));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog posts",
  "class": "section-blog-posts",
  "disabled_on": {
    "templates": [
      "article",
      "blog"
    ]
  },
  "blocks": [
    {
      "type": "header"
    },
    {
      "type": "view-all-button"
    },
    {
      "type": "blog-list"
    }
  ],
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "page_width",
          "label": "t:options.section_width.page_width"
        },
        {
          "value": "full_width",
          "label": "t:options.section_width.full_width"
        }
      ],
      "default": "page_width"
    },
    {
      "type": "select",
      "id": "desktop_alignment",
      "label": "t:labels.desktop_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "t:labels.mobile_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:general.gap"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "t:options.device.desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:options.device.mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Blog posts",
      "category": "Blog",
      "settings": {
        "blog": "discover-our-story-elara",
        "section_width": "full_width",
        "desktop_alignment": "center",
        "mobile_alignment": "center",
        "gap_desktop": 48,
        "gap_mobile": 40,
        "color_scheme": "scheme-1",
        "padding_top": 10,
        "padding_bottom": 80,
        "customize_mobile_padding": true,
        "padding_top_mobile": 10,
        "padding_bottom_mobile": 56
      },
      "blocks": [
        {
          "type": "header",
          "settings": {
            "width": "fill",
            "alignment": "center",
            "customize_mobile_alignment": true,
            "alignment_mobile": "center",
            "gap_desktop": 16,
            "gap_mobile": 12
          },
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "text": "<p>Discover Our Story</p>",
                "heading_size": "xl",
                "html_tag": "h2",
                "width": "fill",
                "customize_mobile_size": true,
                "width_mobile": "fill",
                "animation_type": "rotate-words",
                "animation_delay": 50
              }
            }
          ],
          "id": "header",
          "static": true
        },
        {
          "type": "view-all-button",
          "id": "blog-posts-view-all",
          "static": true,
          "settings": {
            "button_label": "View all",
            "button_style": "text",
            "button_style_mobile": "outline",
            "button_height_mobile": "inherit",
            "full_width_mobile": true,
            "show_icon": false,
            "show_icon_mobile": false,
            "hide_view_all_mobile": false
          }
        },
        {
          "type": "blog-list",
          "settings": {
            "max_posts": 3,
            "layout_type": "carousel",
            "columns_desktop": "3",
            "columns_mobile": "1",
            "show_next_slide_preview_on_desktop": false,
            "show_next_slide_preview_on_mobile": false,
            "gap_desktop": 20,
            "gap_mobile": 16,
            "show_navigation_on_desktop": true,
            "show_pagination_on_desktop": false,
            "pagination_type": "progress_bar",
            "pagination_padding_desktop": 48,
            "pagination_padding_mobile": 36,
            "pagination_limit_width": false,
            "autoplay": false,
            "navigation_style": "primary",
            "navigation_behavior": "show_on_hover"
          },
          "blocks": [
            {
              "type": "blog-card",
              "settings": {
                "ratio": "ratio_4_3",
                "media_layout": "stacked",
                "alignment": "center",
                "position": "flex-start",
                "desktop_gap": 8,
                "mobile_gap": 8,
                "border_thickness": 0,
                "corner_radius": "square",
                "shadow": "none",
                "color_type": "inherit",
                "padding_top": 20,
                "padding_bottom": 8,
                "padding_left": 24,
                "padding_right": 24,
                "customize_mobile_padding": true,
                "padding_top_mobile": 12,
                "padding_bottom_mobile": 8,
                "padding_left_mobile": 24,
                "padding_right_mobile": 24
              },
              "blocks": [
                {
                  "type": "blog-card-title",
                  "settings": {
                    "heading_size": "xs",
                    "html_tag": "h3",
                    "line_limit": "two",
                    "padding_top": 0,
                    "padding_bottom": 0
                  }
                },
                {
                  "type": "blog-card-meta",
                  "settings": {
                    "show_date": true,
                    "show_author": false,
                    "show_comment_count": false,
                    "show_date_icon": false,
                    "date_format": "medium",
                    "layout": "horizontal",
                    "size": "sm",
                    "text_color": "#999999",
                    "padding_top": 0,
                    "padding_bottom": 4
                  }
                },
                {
                  "type": "blog-card-description",
                  "settings": {
                    "text_limit": "two",
                    "size": "md",
                    "padding_top": 0,
                    "padding_bottom": 8
                  }
                },
                {
                  "type": "blog-card-button",
                  "settings": {
                    "style": "tertiary",
                    "show_icon": false,
                    "padding_top": 0,
                    "padding_bottom": 0
                  }
                }
              ],
              "id": "blog-card",
              "static": true
            }
          ],
          "id": "blog-list",
          "static": true
        }
      ]
    }
  ]
}
{% endschema %}
