{% liquid
  assign stacked_bands_first_image = section.blocks.first.settings.image
  assign stacked_bands_auto_ratio = stacked_bands_first_image.aspect_ratio | default: 1 | plus: 0
  assign stacked_bands_desktop_ratio_setting = section.settings.image_ratio | default: 'auto'
  assign stacked_bands_desktop_ratio = stacked_bands_auto_ratio
  case stacked_bands_desktop_ratio_setting
    when 'square'
      assign stacked_bands_desktop_ratio = 1
    when 'portrait'
      assign stacked_bands_desktop_ratio = 0.8
    when 'ratio_5_4'
      assign stacked_bands_desktop_ratio = 1.25
    when 'landscape'
      assign stacked_bands_desktop_ratio = 1.3333
    when 'wide'
      assign stacked_bands_desktop_ratio = 1.7778
    when 'custom'
      assign stacked_bands_desktop_ratio_width = section.settings.custom_image_ratio_width | default: 16 | times: 1.0
      assign stacked_bands_desktop_ratio_height = section.settings.custom_image_ratio_height | default: 9 | times: 1.0
      assign stacked_bands_desktop_ratio = stacked_bands_desktop_ratio_width | divided_by: stacked_bands_desktop_ratio_height
  endcase
  assign stacked_bands_mobile_ratio = stacked_bands_desktop_ratio
  if section.settings.customize_mobile_image
    assign stacked_bands_mobile_ratio_setting = section.settings.image_ratio_mobile | default: stacked_bands_desktop_ratio_setting
    case stacked_bands_mobile_ratio_setting
      when 'square'
        assign stacked_bands_mobile_ratio = 1
      when 'portrait'
        assign stacked_bands_mobile_ratio = 0.8
      when 'ratio_5_4'
        assign stacked_bands_mobile_ratio = 1.25
      when 'landscape'
        assign stacked_bands_mobile_ratio = 1.3333
      when 'wide'
        assign stacked_bands_mobile_ratio = 1.7778
      when 'custom'
        assign stacked_bands_mobile_ratio_width = section.settings.custom_image_ratio_width_mobile | default: section.settings.custom_image_ratio_width | default: 16 | times: 1.0
        assign stacked_bands_mobile_ratio_height = section.settings.custom_image_ratio_height_mobile | default: section.settings.custom_image_ratio_height | default: 9 | times: 1.0
        assign stacked_bands_mobile_ratio = stacked_bands_mobile_ratio_width | divided_by: stacked_bands_mobile_ratio_height
      else
        assign stacked_bands_mobile_ratio = stacked_bands_auto_ratio
    endcase
  endif
  assign stacked_bands_image_max_width = section.settings.image_max_width | default: 100 | plus: 0
  assign stacked_bands_image_max_width_mobile = stacked_bands_image_max_width
  if section.settings.customize_mobile_image
    assign stacked_bands_image_max_width_mobile = section.settings.image_max_width_mobile | default: stacked_bands_image_max_width | plus: 0
  endif
  assign stacked_bands_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign stacked_bands_scheme = section.settings.color_scheme.id
  endif
  assign stacked_bands_top_mobile = section.settings.padding_top
  assign stacked_bands_right_mobile = section.settings.padding_right
  assign stacked_bands_bottom_mobile = section.settings.padding_bottom
  assign stacked_bands_left_mobile = section.settings.padding_left
  if section.settings.customize_mobile_padding
    assign stacked_bands_top_mobile = section.settings.padding_top_mobile
    assign stacked_bands_right_mobile = section.settings.padding_right_mobile
    assign stacked_bands_bottom_mobile = section.settings.padding_bottom_mobile
    assign stacked_bands_left_mobile = section.settings.padding_left_mobile
  endif
%}

<script type="module" src="{{ 'image-text-stacked-bands.js' | asset_url }}"></script>

<div class="images-with-text-scroll section-spacing color-scheme section-color-scope {{ stacked_bands_scheme }}" data-images-with-text-scroll style="--band-image-ratio: {{ stacked_bands_desktop_ratio }}; --band-image-ratio-mobile: {{ stacked_bands_mobile_ratio }}; --band-image-width: {{ stacked_bands_image_max_width }}%; --band-image-width-mobile: {{ stacked_bands_image_max_width_mobile }}%; --bands-padding-top: {{ section.settings.padding_top }}px; --bands-padding-right: {{ section.settings.padding_right }}px; --bands-padding-bottom: {{ section.settings.padding_bottom }}px; --bands-padding-left: {{ section.settings.padding_left }}px; --bands-padding-top-mobile: {{ stacked_bands_top_mobile }}px; --bands-padding-right-mobile: {{ stacked_bands_right_mobile }}px; --bands-padding-bottom-mobile: {{ stacked_bands_bottom_mobile }}px; --bands-padding-left-mobile: {{ stacked_bands_left_mobile }}px;">
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .images-with-text-scroll {
    position: relative;
    isolation: isolate;
    width: 100%;
    min-width: 0;
    padding: 0;
    background: var(--background-color);
  }

  .images-with-text-scroll > .images-with-text-scroll__item {
    position: sticky;
    top: var(--band-sticky-top, var(--header-sticky-height, 0px));
    padding: 0 var(--bands-padding-right, 0px) var(--bands-padding-bottom, 96px) var(--bands-padding-left, 0px);
    background: var(--background-color);
  }

  .images-with-text-scroll > .images-with-text-scroll__item:first-child {
    padding-top: var(--bands-padding-top, 96px);
  }

  .images-with-text-scroll__layout.container {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 64px;
    width: calc(100% - 2 * var(--page-margin-current));
    padding: 0;
  }

  .images-with-text-scroll__layout.page-width {
    max-width: min(var(--page-width), 1600px);
  }

  .images-with-text-scroll__layout.full-width {
    max-width: none;
  }

  .images-with-text-scroll__layout > .images-with-text-scroll__text {
    padding-inline: 64px;
  }

  .images-with-text-scroll[data-editor-selection] > .images-with-text-scroll__item {
    position: relative;
    top: auto;
  }

  .images-with-text-scroll > .images-with-text-scroll__item:focus-within {
    z-index: 1;
  }

  @media (max-width: 1149.98px) {
    .images-with-text-scroll__layout.container {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .images-with-text-scroll > .images-with-text-scroll__item {
      padding: 0 var(--bands-padding-right-mobile, 0px) var(--bands-padding-bottom-mobile, 56px) var(--bands-padding-left-mobile, 0px);
    }

    .images-with-text-scroll > .images-with-text-scroll__item:first-child {
      padding-top: var(--bands-padding-top-mobile, 56px);
    }

    .images-with-text-scroll__layout > .images-with-text-scroll__text {
      padding: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .images-with-text-scroll > .images-with-text-scroll__item {
      position: relative;
      top: auto;
    }
  }
{% endstylesheet %}

