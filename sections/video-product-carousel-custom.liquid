{% liquid
  assign video_product_carousel_alignment = 'start'
  case section.settings.alignment
    when 'center'
      assign video_product_carousel_alignment = 'center'
    when 'right'
      assign video_product_carousel_alignment = 'end'
  endcase

  assign video_product_carousel_alignment_mobile = video_product_carousel_alignment
  if section.settings.customize_mobile_alignment
    assign video_product_carousel_alignment_mobile = 'start'
    case section.settings.alignment_mobile
      when 'center'
        assign video_product_carousel_alignment_mobile = 'center'
      when 'right'
        assign video_product_carousel_alignment_mobile = 'end'
    endcase
  endif

  assign padding_top = section.settings.padding_top | default: 0 | plus: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0 | plus: 0
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 0 | plus: 0
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 0 | plus: 0
  assign video_product_carousel_gap_desktop = section.settings.content_gap | default: 16 | plus: 0
  assign video_product_carousel_gap_mobile = video_product_carousel_gap_desktop
  if section.settings.customize_mobile_gap
    assign video_product_carousel_gap_mobile = section.settings.content_gap_mobile | default: video_product_carousel_gap_desktop | plus: 0
  endif

  assign video_product_carousel_container_width = 'page-width'
  case section.settings.section_width
    when 'full_width'
      assign video_product_carousel_container_width = 'full-width'
  endcase

  assign video_product_carousel_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign video_product_carousel_scheme = section.settings.color_scheme.id
  endif
  assign video_product_carousel_scheme = video_product_carousel_scheme | default: 'scheme-1' | handleize
%}

{% capture video_product_carousel_style %}
  {% if video_product_carousel_alignment != 'start' %}--flex-align: {{ video_product_carousel_alignment }};{% endif %}
  {% if section.settings.customize_mobile_alignment and video_product_carousel_alignment_mobile != video_product_carousel_alignment %}--flex-align-mobile: {{ video_product_carousel_alignment_mobile }};{% endif %}
  {% if section.settings.background_color != blank %}--video-product-carousel-background-color: {{ section.settings.background_color | escape }};{% endif %}
  {% if padding_top != 0 %}--video-product-carousel-padding-top: {{ padding_top }}px;{% endif %}
  {% if padding_bottom != 0 %}--video-product-carousel-padding-bottom: {{ padding_bottom }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    {% if padding_top_mobile != padding_top %}--video-product-carousel-padding-top-mobile: {{ padding_top_mobile }}px;{% endif %}
    {% if padding_bottom_mobile != padding_bottom %}--video-product-carousel-padding-bottom-mobile: {{ padding_bottom_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign video_product_carousel_style = video_product_carousel_style | strip %}

{% capture video_product_carousel_content_style %}
  {% render 'layout-flow-style',
    direction: 'column',
    wrap: 'nowrap',
    align_items: 'var(--flex-align, flex-start)',
    align_items_mobile: 'var(--flex-align-mobile, var(--flex-align, flex-start))',
    gap: video_product_carousel_gap_desktop,
    gap_mobile: video_product_carousel_gap_mobile
  %}
{% endcapture %}
{% assign video_product_carousel_content_style = video_product_carousel_content_style | strip %}

<div
    class="section-spacing video-product-carousel video-product-carousel__spacing color-scheme section-color-scope {{ video_product_carousel_scheme }}"
    {% if video_product_carousel_style != blank %}style="{{ video_product_carousel_style }}"{% endif %}
  >
    {% if section.settings.background_image != blank %}
      <div class="video-product-carousel__background" aria-hidden="true">
        {{ section.settings.background_image | image_url: width: 2000 | image_tag }}
      </div>
    {% endif %}

    <div class="container {{ video_product_carousel_container_width }} video-product-carousel__container">
      <div class="video-product-carousel__content layout-flow layout-flow--responsive align-content" style="{{ video_product_carousel_content_style }}">
        {% content_for 'blocks' %}
      </div>
    </div>
</div>

{% stylesheet %}
  .video-product-carousel {
    width: 100%;
    min-width: 0;
  }
  .video-product-carousel__spacing {
    position: relative;
    overflow: clip;
    width: 100%;
    padding-top: var(--video-product-carousel-padding-top, 0px);
    padding-bottom: var(--video-product-carousel-padding-bottom, 0px);
    background-color: var(--video-product-carousel-background-color, var(--background-color));
  }
  .video-product-carousel__container {
    position: relative;
    z-index: 1;
  }
  .video-product-carousel__background {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .video-product-carousel__background img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video-product-carousel__content {
    min-width: 0;
  }

  @media (max-width: 767.98px) {
    .video-product-carousel__spacing {
      padding-top: var(--video-product-carousel-padding-top-mobile, var(--video-product-carousel-padding-top, 0px));
      padding-bottom: var(--video-product-carousel-padding-bottom-mobile, var(--video-product-carousel-padding-bottom, 0px));
    }
  }
{% endstylesheet %}

