  .testimonial-carousel { width: 100%; min-width: 0; }
  .testimonial-carousel__spacing {
    position: relative;
    overflow: clip;
    width: 100%;
    padding-top: var(--testimonial-carousel-padding-top, 0px);
    padding-bottom: var(--testimonial-carousel-padding-bottom, 0px);
    background-color: var(--testimonial-carousel-background-color, var(--background-color));
  }
  .testimonial-carousel__container { position: relative; z-index: 1; }
  .testimonial-carousel__container.full-width--no-padding { padding-inline: 0; }
  .testimonial-carousel__background { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
  .testimonial-carousel__background img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .testimonial-carousel__content { min-width: 0; }
  .testimonial-carousel .carousel-block__container { position: relative; }
  .testimonial-carousel .carousel-block__fraction-controls {
    position: absolute;
    left: calc(50% + var(--testimonial-controls-gap-half, 40px));
    right: auto;
    bottom: 0;
    z-index: 3;
    width: calc(50% - var(--testimonial-controls-gap-half, 40px));
    margin-top: 0;
    padding-inline: 0;
  }
  @media (min-width: 768px) {
    .testimonial-carousel .testimonial-item--horizontal.testimonial-item--position-bottom > .group {
      padding-bottom: 56px !important;
    }
  }
  @media (max-width: 767.98px) {
    .testimonial-carousel__spacing {
      padding-top: var(--testimonial-carousel-padding-top-mobile, var(--testimonial-carousel-padding-top, 0px));
      padding-bottom: var(--testimonial-carousel-padding-bottom-mobile, var(--testimonial-carousel-padding-bottom, 0px));
    }
    .testimonial-carousel .carousel-block__fraction-controls {
      position: static;
      width: 100%;
      margin-top: 1rem;
      padding-inline: 0;
    }
  }

  .testimonial-carousel { display: block; }
  .testimonial-carousel--malandra .testimonial-item--horizontal.swiper-slide {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0;
    background: transparent;
  }
  .testimonial-carousel--malandra .testimonial-item > .group {
    height: auto;
    padding: 0 clamp(32px, 5vw, 96px) 72px;
    gap: 36px;
    align-items: var(--testimonial-align, start);
    text-align: var(--testimonial-align, start);
  }
  .testimonial-carousel--malandra .testimonial-item > .group .eyebrow-block {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 1.5;
    letter-spacing: 1.5px;
    color: #636363;
  }
  .testimonial-carousel--malandra .testimonial-item .group {
    align-items: var(--testimonial-align, start);
    text-align: var(--testimonial-align, start);
    --text-align-default: var(--testimonial-align, start);
  }
  .testimonial-carousel--malandra .testimonial-item .heading-block {
    font-size: 26px;
    line-height: 1.4;
    font-weight: 400;
    letter-spacing: 0;
    color: #181818;
  }
  .testimonial-carousel--malandra .testimonial-item .text-block {
    font-size: 14px;
    line-height: 1.5;
    letter-spacing: 0;
    color: #636363;
  }
  .testimonial-carousel--malandra .testimonial-item .icon-block:has(svg[viewBox="0 0 144 24"]) {
    width: 88px;
    height: 16px;
    padding: 0;
    background-image: var(--testimonial-star);
    background-size: 16px 16px;
    background-repeat: space no-repeat;
  }
  .testimonial-carousel--malandra .testimonial-item .icon-block svg[viewBox="0 0 144 24"] { visibility: hidden; }
  .testimonial-carousel--malandra .testimonial-item > .image-block { align-self: stretch; }
  .testimonial-carousel--malandra .testimonial-item > .image-block .image-block__media { aspect-ratio: var(--image-block-ratio, 5 / 4); }
  @media (max-width: 767.98px) {
    .testimonial-carousel--malandra .testimonial-item > .image-block .image-block__media { aspect-ratio: var(--image-block-ratio-mobile, var(--image-block-ratio, 5 / 4)); }
  }
  .testimonial-carousel--malandra .carousel-block__fraction { display: none; }
  .testimonial-carousel--malandra .carousel-block__fraction-controls {
    left: var(--testimonial-controls-left, 5%);
    top: var(--testimonial-controls-top, auto);
    bottom: auto;
    width: var(--testimonial-controls-width, 40%);
    justify-content: var(--testimonial-align, start);
    gap: 16px;
  }
  .testimonial-carousel--malandra .carousel-block__fraction-button { position: relative; }
  .testimonial-carousel--malandra .carousel-block__fraction-button svg { visibility: hidden; }
  .testimonial-carousel--malandra .carousel-block__fraction-button::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--testimonial-right-shaft), var(--testimonial-right-tip);
    background-size: 23.8781px 4.81346px, 4.81923px 4.81962px;
    background-position: 0.0624px 7.6752px, 19.1208px 11.5032px;
    background-repeat: no-repeat;
    pointer-events: none;
  }
  .testimonial-carousel--malandra [data-carousel-fraction-previous]::before {
    background-image: var(--testimonial-left-shaft), var(--testimonial-left-tip);
    transform: scaleX(-1);
  }
  @media (max-width: 767.98px) {
    .testimonial-carousel--malandra .testimonial-item--horizontal.swiper-slide {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
    .testimonial-carousel--malandra .testimonial-item > .image-block { order: -1; }
    .testimonial-carousel--malandra .testimonial-item > .group {
      padding: 0 16px;
      gap: 24px;
      justify-content: start;
    }
    .testimonial-carousel--malandra .testimonial-item .group {
      align-items: var(--testimonial-align-mobile, start);
      text-align: var(--testimonial-align-mobile, start);
      --text-align-default: var(--testimonial-align-mobile, start);
    }
    .testimonial-carousel--malandra .testimonial-item .heading-block { font-size: 22px; }
    .testimonial-carousel--malandra .carousel-block__fraction-controls {
      position: static;
      margin-top: 24px;
      padding-inline: 16px;
      width: 100%;
      justify-content: var(--testimonial-align-mobile, start);
    }
  }
{% endstylesheet %}

