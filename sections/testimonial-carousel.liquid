{% capture children %}{% content_for 'blocks' %}{% endcapture %}
{% render 'custom-section-layout', section: section, children: children, root_class: 'testimonial-carousel' %}

{% schema %}
{
  "name": "Testimonial: split",
  "class": "section-testimonial-split",
  "enabled_on": {
    "templates": [
      "*"
    ]
  },
  "blocks": [
    {
      "type": "carousel_split"
    },
    {
      "type": "carousel"
    },
    {
      "type": "header"
    },
    {
      "type": "heading"
    },
    {
      "type": "editorial-text"
    },
    {
      "type": "eyebrow"
    },
    {
      "type": "text"
    },
    {
      "type": "image"
    },
    {
      "type": "image-comparison"
    },
    {
      "type": "image-card"
    },
    {
      "type": "video"
    },
    {
      "type": "button"
    },
    {
      "type": "buttons"
    },
    {
      "type": "icon"
    },
    {
      "type": "divider"
    },
    {
      "type": "spacer"
    },
    {
      "type": "group"
    },
    {
      "type": "marquee"
    },
    {
      "type": "row"
    },
    {
      "type": "columns"
    },
    {
      "type": "email-signup"
    },
    {
      "type": "contact-form"
    },
    {
      "type": "product-list"
    },
    {
      "type": "countdown-timer"
    },
    {
      "type": "product-card-compact"
    },
    {
      "type": "payment-icons"
    },
    {
      "type": "comparison-table"
    },
    {
      "type": "popup"
    },
    {
      "type": "social-links"
    },
    {
      "type": "discount-code"
    },
    {
      "type": "faq_accordion"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:custom_section.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "page_width",
          "label": "t:custom_section.page"
        },
        {
          "value": "full_width",
          "label": "t:custom_section.full"
        },
        {
          "value": "full_width_no_padding",
          "label": "t:custom_section.full_no_padding"
        }
      ],
      "default": "page_width"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:custom_section.section_height",
      "options": [
        {
          "value": "auto",
          "label": "t:custom_section.auto"
        },
        {
          "value": "full_screen",
          "label": "t:custom_section.full_screen"
        },
        {
          "value": "custom",
          "label": "t:custom_section.custom"
        }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "t:custom_section.custom_height",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.height == 'custom' }}"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:custom_section.direction",
      "options": [
        {
          "value": "horizontal",
          "label": "t:custom_section.horizontal"
        },
        {
          "value": "vertical",
          "label": "t:custom_section.vertical"
        }
      ],
      "default": "vertical"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "default": "left",
      "visible_if": "{{ section.settings.direction != 'horizontal' }}",
      "options": [
        {
          "value": "left",
          "label": "t:custom_section.left"
        },
        {
          "value": "center",
          "label": "t:custom_section.center"
        },
        {
          "value": "right",
          "label": "t:custom_section.right"
        }
      ]
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:custom_section.position",
      "options": [
        {
          "value": "top",
          "label": "t:custom_section.top"
        },
        {
          "value": "center",
          "label": "t:custom_section.center"
        },
        {
          "value": "bottom",
          "label": "t:custom_section.bottom"
        },
        {
          "value": "space-between",
          "label": "t:custom_section.space_between"
        }
      ],
      "default": "top",
      "visible_if": "{{ section.settings.direction == 'vertical' and section.settings.height != 'auto' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:custom_section.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:custom_section.left"
        },
        {
          "value": "center",
          "label": "t:custom_section.center"
        },
        {
          "value": "right",
          "label": "t:custom_section.right"
        },
        {
          "value": "space-between",
          "label": "t:custom_section.space_between"
        }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "position_horizontal",
      "label": "t:custom_section.position",
      "options": [
        {
          "value": "top",
          "label": "t:custom_section.top"
        },
        {
          "value": "center",
          "label": "t:custom_section.center"
        },
        {
          "value": "bottom",
          "label": "t:custom_section.bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.direction == 'horizontal' }}"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:custom_section.vertical_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_mobile",
      "label": "t:labels.mobile_alignment",
      "default": "left",
      "visible_if": "{{ section.settings.direction == 'horizontal' and section.settings.vertical_on_mobile }}",
      "options": [
        {
          "value": "left",
          "label": "t:custom_section.left"
        },
        {
          "value": "center",
          "label": "t:custom_section.center"
        },
        {
          "value": "right",
          "label": "t:custom_section.right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_alignment",
      "label": "t:labels.customize_mobile_alignment",
      "default": false,
      "visible_if": "{{ section.settings.direction != 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "alignment_mobile",
      "label": "t:labels.mobile_alignment",
      "default": "left",
      "visible_if": "{{ section.settings.direction != 'horizontal' and section.settings.customize_mobile_alignment }}",
      "options": [
        {
          "value": "left",
          "label": "t:custom_section.left"
        },
        {
          "value": "center",
          "label": "t:custom_section.center"
        },
        {
          "value": "right",
          "label": "t:custom_section.right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_content",
      "label": "t:custom_section.enable_sticky_content",
      "default": false,
      "visible_if": "{{ section.settings.direction == 'horizontal' }}"
    },
    {
      "type": "header",
      "content": "t:custom_section.divider"
    },
    {
      "type": "checkbox",
      "id": "show_top_divider",
      "label": "t:custom_section.show_top_divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_bottom_divider",
      "label": "t:custom_section.show_bottom_divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "divider_full_width",
      "label": "t:custom_section.full_width_divider",
      "default": true,
      "visible_if": "{{ section.settings.section_width != 'full_width_no_padding' and section.settings.show_top_divider or section.settings.show_bottom_divider }}"
    },
    {
      "type": "header",
      "content": "t:custom_section.gap"
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "t:custom_section.desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_gap",
      "label": "t:labels.customize_mobile_layout",
      "default": false
    },
    {
      "type": "range",
      "id": "content_gap_mobile",
      "label": "t:custom_section.mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ section.settings.customize_mobile_gap }}"
    },
    {
      "type": "header",
      "content": "t:custom_section.background"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:custom_section.media",
      "options": [
        {
          "value": "none",
          "label": "t:custom_section.none"
        },
        {
          "value": "image",
          "label": "t:custom_section.image"
        },
        {
          "value": "video",
          "label": "t:custom_section.video"
        }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "t:custom_section.mobile_image_optional",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "t:custom_section.video",
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "t:custom_section.overlay",
      "default": true,
      "visible_if": "{{ section.settings.background_media != 'none' }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:custom_section.overlay_color",
      "alpha": true,
      "default": "#00000080",
      "visible_if": "{{ section.settings.background_media != 'none' and section.settings.show_overlay }}"
    },
    {
      "type": "select",
      "id": "parallax_effect",
      "label": "t:custom_section.parallax_effect",
      "options": [
        {
          "value": "none",
          "label": "t:custom_section.none"
        },
        {
          "value": "fixed",
          "label": "t:custom_section.fixed"
        },
        {
          "value": "vertical",
          "label": "t:custom_section.vertical"
        },
        {
          "value": "horizontal",
          "label": "t:custom_section.horizontal"
        },
        {
          "value": "zoom",
          "label": "t:custom_section.zoom"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.background_media != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:custom_section.color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "background_color",
      "label": "t:labels.background"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Testimonial: split",
      "category": "Trust & social proof",
      "settings": {
        "section_width": "page_width",
        "color_scheme": "scheme-1",
        "padding_top": 96,
        "padding_bottom": 96,
        "customize_mobile_padding": true,
        "padding_top_mobile": 48,
        "padding_bottom_mobile": 48,
        "direction": "vertical",
        "content_gap": 48,
        "customize_mobile_gap": true,
        "content_gap_mobile": 32
      },
      "blocks": [
        {
          "type": "header",
          "settings": {
            "width": "fill",
            "inherit_alignment": false,
            "alignment": "left",
            "customize_mobile_alignment": true,
            "alignment_mobile": "center",
            "gap_desktop": 12,
            "gap_mobile": 12
          },
          "blocks": [
            {
              "type": "group",
              "settings": {
                "direction": "horizontal",
                "position_horizontal": "center",
                "horizontal_alignment": "left",
                "customize_mobile_alignment": false,
                "gap_desktop": 8,
                "gap_mobile": 8,
                "width": "fit",
                "width_mobile": "fit",
                "height": "fit",
                "appearance_type": "inherit",
                "backdrop_blur": 0,
                "show_overlay": false
              },
              "blocks": [
                {
                  "type": "icon",
                  "settings": {
                    "animation_delay": 0,
                    "animation_type": "fade",
                    "source": "custom",
                    "custom_icon": "<svg width=\"8\" height=\"8\" viewBox=\"0 0 8 8\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<rect width=\"8\" height=\"8\" fill=\"#181818\"/>\n</svg>",
                    "icon_width": 8,
                    "icon_padding": 0,
                    "custom_mobile": false,
                    "icon_width_mobile": 8,
                    "icon_padding_mobile": 0
                  }
                },
                {
                  "type": "eyebrow",
                  "settings": {
                    "animation_delay": 0,
                    "animation_type": "fade",
                    "text": "<p>Our commitment</p>",
                    "show_icon": false,
                    "icon": "square"
                  }
                }
              ]
            },
            {
              "type": "heading",
              "settings": {
                "animation_delay": 100,
                "animation_type": "fade",
                "text": "<p>What athletes are saying</p>",
                "html_tag": "h2",
                "heading_size": "display",
                "width": "fill"
              }
            }
          ]
        },
        {
          "type": "carousel_split",
          "settings": {
            "loop": false,
            "transition_style": "slide",
            "show_mobile_pagination": true,
            "show_navigation": true
          },
          "blocks": [
            {
              "type": "slide_split",
              "settings": {
                "position_horizontal": "top",
                "horizontal_alignment": "left",
                "alignment_mobile": "left",
                "gap_desktop": 0,
                "gap_mobile": 32,
                "height": "fill",
                "appearance_type": "inherit",
                "border_type": "none",
                "corner_radius": "square",
                "shadow": "none"
              },
              "blocks": [
                {
                  "type": "image",
                  "id": "image",
                  "static": true,
                  "settings": {
                    "image_ratio_desktop": "custom",
                    "image_ratio_mobile": "custom",
                    "width_desktop": "fill",
                    "width_mobile": "fill",
                    "image_ratio_custom_width_desktop": 1,
                    "image_ratio_custom_height_desktop": 1,
                    "image_ratio_custom_width_mobile": 4,
                    "image_ratio_custom_height_mobile": 3,
                    "image": "shopify://shop_images/virelle-testimonial-eva.avif"
                  }
                },
                {
                  "type": "group",
                  "id": "content",
                  "static": true,
                  "settings": {
                    "direction": "vertical",
                    "width": "fill",
                    "alignment": "left",
                    "gap_desktop": 48,
                    "gap_mobile": 24,
                    "appearance_type": "inherit"
                  },
                  "blocks": [
                    {
                      "type": "group",
                      "settings": {
                        "direction": "vertical",
                        "width": "fill",
                        "alignment": "left",
                        "gap_desktop": 16,
                        "gap_mobile": 16,
                        "appearance_type": "inherit"
                      },
                      "blocks": [
                        {
                          "type": "icon",
                          "settings": {
                            "animation_delay": 50,
                            "animation_type": "scale",
                            "source": "custom",
                            "icon": "five-stars",
                            "icon_width": 88,
