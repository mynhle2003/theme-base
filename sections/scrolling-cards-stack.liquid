{% liquid
  assign stack_width = section.settings.section_width | default: 'page_width'
  unless stack_width == 'page_width' or stack_width == 'full_width' or stack_width == 'custom'
    assign stack_width = 'page_width'
  endunless

  assign stack_container_width = 'page-width'
  if stack_width == 'full_width'
    assign stack_container_width = 'full-width'
  endif

  assign stack_custom_width = section.settings.custom_width | default: 1200 | plus: 0
  if stack_custom_width < 640 or stack_custom_width > 1800
    assign stack_custom_width = 1200
  endif

  assign stack_gap_desktop = section.settings.gap_desktop | default: 60 | plus: 0
  assign stack_gap_mobile = section.settings.gap_mobile | default: 40 | plus: 0
  assign stack_padding_top = section.settings.padding_top | default: 80 | plus: 0
  assign stack_padding_bottom = section.settings.padding_bottom | default: 90 | plus: 0
  assign stack_padding_top_mobile = section.settings.padding_top_mobile | default: 50 | plus: 0
  assign stack_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 50 | plus: 0

  assign stack_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign stack_scheme = section.settings.color_scheme.id
  endif
  assign stack_scheme = stack_scheme | default: 'scheme-1' | handleize
%}

{% capture stack_style %}
  --scrolling-cards-stack-gap: {{ stack_gap_desktop }}px;
  --scrolling-cards-stack-gap-mobile: {{ stack_gap_mobile }}px;
  --section-padding-top: {{ stack_padding_top }}px;
  --section-padding-bottom: {{ stack_padding_bottom }}px;
  {% if stack_width == 'custom' %}--scrolling-cards-custom-width: {{ stack_custom_width }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    --section-padding-top-mobile: {{ stack_padding_top_mobile }}px;
    --section-padding-bottom-mobile: {{ stack_padding_bottom_mobile }}px;
  {% endif %}
{% endcapture %}

<script type="module" src="{{ 'scrolling-cards.js' | asset_url }}"></script>

<div class="section-content-scope scrolling-cards-stack-section scrolling-cards-stack-section--{{ stack_width }}">
  <div class="section-spacing color-scheme section-color-scope {{ stack_scheme }}" style="{{ stack_style | strip }}">
    <div class="container {{ stack_container_width }} scrolling-cards-stack-section__container">
      <div class="scrolling-cards-stack" data-scrolling-cards data-sticky-mobile="{{ section.settings.enable_sticky_mobile }}" data-stack-effect="{{ section.settings.stack_effect | default: 'fade' }}">
        {% capture stack_items %}{% content_for 'blocks' %}{% endcapture %}
        {% render 'section-content-slot', content: stack_items, class: 'scrolling-cards__items' %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .scrolling-cards-stack-section {
    width: 100%;
    min-width: 0;
  }

  .scrolling-cards-stack-section--custom .scrolling-cards-stack-section__container {
    max-width: var(--scrolling-cards-custom-width, 1200px);
  }

  .scrolling-cards-stack-section__container {
    position: relative;
    z-index: 1;
  }

  .scrolling-cards-stack {
    width: 100%;
    min-width: 0;
  }

  .scrolling-cards-stack .scrolling-cards__items {
    display: flex;
    flex-direction: column;
    gap: var(--scrolling-cards-stack-gap, 96px);
    width: 100%;
    min-width: 0;
  }

  .scrolling-cards-stack .scrolling-cards__items > .scrolling-card:not(:first-child) {
    --scrolling-card-offset-top: -1px;
  }

  @media (max-width: 767.98px) {
    .scrolling-cards-stack .scrolling-cards__items {
      gap: var(--scrolling-cards-stack-gap-mobile, var(--scrolling-cards-stack-gap, 68px));
    }
  }
{% endstylesheet %}

