{% liquid
  assign image_text_split_width = section.settings.section_width | default: 'page_width'
  assign image_text_split_container_width = 'page-width'
  if image_text_split_width == 'full_width'
    assign image_text_split_container_width = 'full-width'
  elsif image_text_split_width == 'full_width_no_padding'
    assign image_text_split_container_width = 'full-width full-width--no-padding'
  endif

  assign section_direction = section.settings.direction | default: 'horizontal'
  unless section_direction == 'horizontal' or section_direction == 'vertical' or section_direction == 'group--horizontal' or section_direction == 'group--vertical'
    assign section_direction = 'vertical'
  endunless
  if section_direction == 'group--horizontal'
    assign section_direction = 'horizontal'
  elsif section_direction == 'group--vertical'
    assign section_direction = 'vertical'
  endif

  assign section_alignment_source = section.settings.alignment | default: 'left'
  if section_direction == 'horizontal'
    assign section_alignment_source = section.settings.horizontal_alignment | default: section_alignment_source
  endif

  assign section_alignment = 'start'
  assign section_justify = 'flex-start'
  case section_alignment_source
    when 'center'
      assign section_alignment = 'center'
      assign section_justify = 'center'
    when 'right', 'end', 'flex-end'
      assign section_alignment = 'end'
      assign section_justify = 'flex-end'
    when 'space-between'
      assign section_justify = 'space-between'
    else
      assign section_alignment = 'start'
  endcase

  assign section_height_mode = section.settings.height | default: 'fit'
  unless section_height_mode == 'fit' or section_height_mode == 'fill'
    assign section_height_mode = 'fit'
  endunless

  assign section_position_source = 'top'
  if section_direction == 'horizontal'
    assign section_position_source = section.settings.position_horizontal | default: 'center'
  elsif section_height_mode == 'fill'
    assign section_position_source = section.settings.position | default: 'center'
  endif
  assign section_position_name = section_position_source
  case section_position_name
    when 'center'
      assign section_position_name = 'center'
    when 'bottom', 'flex-end'
      assign section_position_name = 'bottom'
    when 'space-between'
      assign section_position_name = 'space-between'
    else
      assign section_position_name = 'top'
  endcase

  assign section_vertical_on_mobile = false
  if section_direction == 'horizontal' and section.settings.customize_mobile_alignment
    assign section_vertical_on_mobile = true
  endif

  assign section_alignment_mobile = section_alignment
  assign section_justify_mobile = section_justify
  assign section_mobile_alignment_enabled = false
  if section_direction == 'vertical' or section_vertical_on_mobile
    assign section_mobile_alignment_enabled = true
  endif
  assign section_alignment_mobile_source = section.settings.alignment_mobile | default: 'left'
  unless section_alignment_mobile_source == 'left' or section_alignment_mobile_source == 'center' or section_alignment_mobile_source == 'right'
    assign section_alignment_mobile_source = 'left'
  endunless
  if section_mobile_alignment_enabled
    case section_alignment_mobile_source
      when 'center'
        assign section_alignment_mobile = 'center'
        assign section_justify_mobile = 'center'
      when 'right'
        assign section_alignment_mobile = 'end'
        assign section_justify_mobile = 'flex-end'
      else
        assign section_alignment_mobile = 'start'
        assign section_justify_mobile = 'flex-start'
    endcase
  endif

  assign section_flow_mobile_alignment = blank
  if section_mobile_alignment_enabled
    assign section_flow_mobile_alignment = section_alignment_mobile
  endif

  assign section_gap_desktop = section.settings.gap_desktop | default: section.settings.content_gap | default: 64 | plus: 0
  assign section_gap_mobile = section.settings.gap_mobile | default: section.settings.content_gap_mobile | default: 32 | plus: 0
  assign image_text_split_padding_top = section.settings.padding_top | default: 0 | plus: 0
  assign image_text_split_padding_bottom = section.settings.padding_bottom | default: 0 | plus: 0
  assign image_text_split_padding_top_mobile = section.settings.padding_top_mobile | default: image_text_split_padding_top | plus: 0
  assign image_text_split_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: image_text_split_padding_bottom | plus: 0

  assign image_text_split_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign image_text_split_scheme = section.settings.color_scheme.id
  endif
  assign image_text_split_scheme = image_text_split_scheme | default: 'scheme-1' | handleize
%}

{% capture image_text_split_style %}
  {% if section.settings.background_color != blank %}--image-text-split-background-color: {{ section.settings.background_color | escape }};{% endif %}
  {% if image_text_split_padding_top != 0 %}--image-text-split-padding-top: {{ image_text_split_padding_top }}px;{% endif %}
  {% if image_text_split_padding_bottom != 0 %}--image-text-split-padding-bottom: {{ image_text_split_padding_bottom }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    {% if image_text_split_padding_top_mobile != image_text_split_padding_top %}--image-text-split-padding-top-mobile: {{ image_text_split_padding_top_mobile }}px;{% endif %}
    {% if image_text_split_padding_bottom_mobile != image_text_split_padding_bottom %}--image-text-split-padding-bottom-mobile: {{ image_text_split_padding_bottom_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign image_text_split_style = image_text_split_style | strip | replace: '\n', ' ' %}

{% capture section_content_style %}
  {% render 'layout-flow-group-style',
    direction: section_direction,
    position: section_position_name,
    alignment: section_alignment,
    horizontal_alignment: section_justify,
    mobile_vertical: section_vertical_on_mobile,
    mobile_alignment: section_flow_mobile_alignment,
    mobile_justify: section_justify_mobile,
    gap: section_gap_desktop,
    gap_mobile: section_gap_mobile
  %}
  --image-text-split-align: {{ section_alignment }};
  {% if section_mobile_alignment_enabled %}--image-text-split-align-mobile: {{ section_alignment_mobile }};{% endif %}
{% endcapture %}
{% assign section_content_style = section_content_style | strip %}

<div class="image-text-split-layout image-text-split-layout--{{ section_direction }} image-text-split-layout--height-{{ section_height_mode }}{% if section_vertical_on_mobile %} image-text-split-layout--mobile-vertical{% endif %}">
  <div
    class="section-spacing image-text-split-layout__spacing color-scheme section-color-scope {{ image_text_split_scheme }}"
    {% if image_text_split_style != blank %}style="{{ image_text_split_style }}"{% endif %}
  >
    {% if section.settings.background_image != blank %}
      <div class="image-text-split-layout__background" aria-hidden="true">
        {{ section.settings.background_image | image_url: width: 2000 | image_tag: class: 'background-media-paint' }}
      </div>
    {% endif %}

    <div class="container {{ image_text_split_container_width }} image-text-split-layout__container">
      <div class="image-text-split-layout__grid layout-flow layout-flow--responsive layout-flow--{{ section_direction }}{% if section_vertical_on_mobile %} layout-flow--mobile-vertical{% endif %}" style="{{ section_content_style }}">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .image-text-split-layout {
    width: 100%;
    min-width: 0;
  }

  .image-text-split-layout__spacing {
    position: relative;
    overflow: hidden;
    width: 100%;
    padding-top: var(--image-text-split-padding-top, 0px);
    padding-bottom: var(--image-text-split-padding-bottom, 0px);
    background-color: var(--image-text-split-background-color, var(--background-color));
  }

  .image-text-split-layout__background {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .image-text-split-layout__background img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-text-split-layout__container {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .image-text-split-layout__container.full-width--no-padding { width: 100%; max-width: none; padding-inline: 0; }
  .image-text-split-layout__grid {
    --flex-align: var(--image-text-split-align, start);
    --flex-align-mobile: var(--image-text-split-align-mobile, var(--flex-align));
    width: 100%;
    min-width: 0;
    text-align: var(--flex-align);
  }
  .image-text-split-layout__grid > * { max-width: 100%; min-width: 0; }
  /* Divide outer columns on the parent so child gap/padding cannot change their width. */
  @media (min-width: 768px) {
    .image-text-split-layout--horizontal .image-text-split-layout__grid:has(> .group--width-fill:first-child:nth-last-child(2)):has(> .group--width-fill:last-child) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 767.98px) {
    .image-text-split-layout--horizontal:not(.image-text-split-layout--mobile-vertical) .image-text-split-layout__grid:has(> .group--width-mobile-fill:first-child:nth-last-child(2)):has(> .group--width-mobile-fill:last-child) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .image-text-split-layout--height-fill,
  .image-text-split-layout--height-fill > .image-text-split-layout__spacing,
  .image-text-split-layout--height-fill .image-text-split-layout__container,
  .image-text-split-layout--height-fill .image-text-split-layout__grid { height: 100%; }
  @media (max-width: 767.98px) {
    .image-text-split-layout__spacing {
      padding-top: var(--image-text-split-padding-top-mobile, var(--image-text-split-padding-top, 0px));
      padding-bottom: var(--image-text-split-padding-bottom-mobile, var(--image-text-split-padding-bottom, 0px));
    }

    .image-text-split-layout__grid { --flex-align: var(--image-text-split-align-mobile, var(--image-text-split-align, start)); }
    .image-text-split-layout--mobile-vertical .image-text-split-layout__grid > * { flex: 0 1 auto; }

  }
{% endstylesheet %}

