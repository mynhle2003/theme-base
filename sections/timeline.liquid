{% liquid
  assign timeline_container_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign timeline_container_width = 'full-width'
  endif

  assign timeline_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign timeline_scheme = section.settings.color_scheme.id
  endif
  assign timeline_scheme = timeline_scheme | default: 'scheme-1' | handleize

  assign timeline_desktop_alignment = section.settings.desktop_alignment | default: 'left'
  unless timeline_desktop_alignment == 'left' or timeline_desktop_alignment == 'center' or timeline_desktop_alignment == 'right'
    assign timeline_desktop_alignment = 'left'
  endunless

  assign timeline_mobile_alignment = section.settings.mobile_alignment | default: 'left'
  unless timeline_mobile_alignment == 'left' or timeline_mobile_alignment == 'center' or timeline_mobile_alignment == 'right'
    assign timeline_mobile_alignment = 'left'
  endunless

  assign timeline_gap_desktop = section.settings.gap_desktop | default: 32 | plus: 0
  if timeline_gap_desktop < 0 or timeline_gap_desktop > 100
    assign timeline_gap_desktop = 32
  endif
  assign timeline_gap_mobile = section.settings.gap_mobile | default: 24 | plus: 0
  if timeline_gap_mobile < 0 or timeline_gap_mobile > 100
    assign timeline_gap_mobile = 24
  endif

  assign timeline_padding_top = section.settings.padding_top | default: 0 | plus: 0
  assign timeline_padding_bottom = section.settings.padding_bottom | default: 0 | plus: 0
  assign timeline_padding_top_mobile = section.settings.padding_top_mobile | default: 0 | plus: 0
  assign timeline_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 0 | plus: 0
%}

{% capture timeline_style %}
  {% if timeline_gap_desktop != 32 %}--timeline-gap-desktop: {{ timeline_gap_desktop }}px;{% endif %}
  {% if timeline_gap_mobile != 24 %}--timeline-gap-mobile: {{ timeline_gap_mobile }}px;{% endif %}
  {% if timeline_padding_top != 0 %}--timeline-padding-top: {{ timeline_padding_top }}px;{% endif %}
  {% if timeline_padding_bottom != 0 %}--timeline-padding-bottom: {{ timeline_padding_bottom }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    {% if timeline_padding_top_mobile != timeline_padding_top %}--timeline-padding-top-mobile: {{ timeline_padding_top_mobile }}px;{% endif %}
    {% if timeline_padding_bottom_mobile != timeline_padding_bottom %}--timeline-padding-bottom-mobile: {{ timeline_padding_bottom_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign timeline_style = timeline_style | strip %}

<div
  class="section-content-scope section-spacing timeline-section color-scheme section-color-scope {{ timeline_scheme }}"
  {% if timeline_style != blank %}style="{{ timeline_style }}"{% endif %}
>
  <div class="container {{ timeline_container_width }} timeline-section__container">
    <div
      class="timeline-section__content align-content"
      data-desktop-alignment="{{ timeline_desktop_alignment }}"
      data-mobile-alignment="{{ timeline_mobile_alignment }}"
    >
      {% capture timeline_header_content %}{% content_for 'block', type: 'header', id: 'header' %}{% endcapture %}
      {% render 'section-content-slot', content: timeline_header_content, class: 'timeline-section__header' %}
      {% capture timeline_list_content %}{% content_for 'block', type: 'timeline-list', id: 'timeline-list' %}{% endcapture %}
      {% render 'section-content-slot', content: timeline_list_content, class: 'timeline-section__list' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .timeline-section {
    width: 100%;
    min-width: 0;
    padding-top: var(--timeline-padding-top, 0px);
    padding-bottom: var(--timeline-padding-bottom, 0px);
  }

  .timeline-section__container,
  .timeline-section__content,
  .timeline-section__header,
  .timeline-section__list {
    min-width: 0;
  }

  .timeline-section__content {
    width: 100%;
    gap: var(--timeline-gap-desktop, 32px);
  }

  .timeline-section__header,
  .timeline-section__list {
    width: 100%;
  }

  .timeline-section__header {
    display: flex;
    align-items: flex-start;
  }

  .timeline-section__header > .block-header {
    min-width: 0;
  }

  .timeline-section__content[data-desktop-alignment='left'] {
    --flex-align: start;
    --text-align-default: left;
  }

  .timeline-section__content[data-desktop-alignment='center'] {
    --flex-align: center;
    --text-align-default: center;
  }

  .timeline-section__content[data-desktop-alignment='right'] {
    --flex-align: end;
    --text-align-default: right;
  }

  .timeline-section__content[data-desktop-alignment='left'] .timeline-section__header {
    justify-content: flex-start;
  }

  .timeline-section__content[data-desktop-alignment='center'] .timeline-section__header {
    justify-content: center;
  }

  .timeline-section__content[data-desktop-alignment='right'] .timeline-section__header {
    justify-content: flex-end;
  }

  @media (max-width: 767.98px) {
    .timeline-section {
      padding-top: var(--timeline-padding-top-mobile, var(--timeline-padding-top, 0px));
      padding-bottom: var(--timeline-padding-bottom-mobile, var(--timeline-padding-bottom, 0px));
    }

    .timeline-section__content {
      gap: var(--timeline-gap-mobile, var(--timeline-gap-desktop, 32px));
    }

    .timeline-section__content[data-mobile-alignment='left'] {
      --flex-align-mobile: start;
      --text-align-default: left;
    }

    .timeline-section__content[data-mobile-alignment='center'] {
      --flex-align-mobile: center;
      --text-align-default: center;
    }

    .timeline-section__content[data-mobile-alignment='right'] {
      --flex-align-mobile: end;
      --text-align-default: right;
    }

    .timeline-section__content[data-mobile-alignment='left'] .timeline-section__header {
      justify-content: flex-start;
    }

    .timeline-section__content[data-mobile-alignment='center'] .timeline-section__header {
      justify-content: center;
    }

    .timeline-section__content[data-mobile-alignment='right'] .timeline-section__header {
      justify-content: flex-end;
    }
  }
  /* Zevra Timeline: keep global margins and all merchant spacing/color controls. */
  .timeline-section .timeline-section__container.page-width {
    max-width: calc(1600px + var(--page-margin-current, 0px) * 2);
  }

  .timeline-section .timeline-list[data-timeline-position='left']:has(.timeline-list__navigation--tabs) {
    grid-template-columns: 100px minmax(0, 1fr);
  }

  .timeline-section .timeline-list[data-timeline-position='left'] .timeline-list__navigation--tabs {
    overflow: visible;
  }

  .timeline-section .timeline-list[data-timeline-position='left'] .timeline-list__navigation--tabs .timeline-list__navigation-list {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .timeline-section .timeline-list[data-timeline-position='left'] .timeline-list__navigation--tabs .timeline-list__navigation-item {
    flex: 0 0 auto;
  }

  .timeline-section .timeline-list[data-timeline-position='left'] .timeline-list__navigation--tabs .timeline-list__navigation-list::after {
    display: none;
  }

  .timeline-section .timeline-list[data-timeline-position='left'] .timeline-list__navigation--tabs .timeline-list__control {
    position: relative;
    width: auto;
    min-height: 0;
    padding: 0 0 4px;
    font-family: var(--font-heading-family);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.4px;
    color: var(--timeline-list-inactive-color, var(--body-color));
    text-align: right;
    transition:
      font-size 240ms var(--motion-ease-standard, ease),
      line-height 240ms var(--motion-ease-standard, ease),
      letter-spacing 240ms var(--motion-ease-standard, ease),
      color 240ms var(--motion-ease-standard, ease);
  }

  /* Expand the pointer target without changing the Figma label spacing. */
  .timeline-section .timeline-list[data-timeline-position='left'] .timeline-list__navigation--tabs .timeline-list__control::after {
    position: absolute;
    inset: 50% 0 auto;
    min-width: 44px;
    height: max(100%, 44px);
    transform: translateY(-50%);
    content: '';
  }

  .timeline-section .timeline-list[data-timeline-position='left'] .timeline-list__navigation--tabs .timeline-list__control.is-active {
    font-size: var(--font-heading-xl);
    line-height: 1.2;
    letter-spacing: 2px;
    color: var(--timeline-list-active-color, var(--heading-color));
  }

  .timeline-section .timeline-list[data-timeline-position='left'] .timeline-list__navigation--tabs .timeline-list__control > span {
    font: inherit;
    letter-spacing: inherit;
    position: relative;
  }

  .timeline-section .timeline-list[data-timeline-position='left'] .timeline-list__navigation--tabs .timeline-list__control > span::after {
    position: absolute;
    inset: auto 0 -4px;
    height: 1px;
    background: currentColor;
    content: '';
    opacity: 0;
    transition: opacity 240ms var(--motion-ease-standard, ease);
  }

  .timeline-section .timeline-list[data-timeline-position='left'] .timeline-list__navigation--tabs .timeline-list__control.is-active > span::after {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-section .timeline-list[data-timeline-position='left'] .timeline-list__navigation--tabs .timeline-list__control,
    .timeline-section .timeline-list[data-timeline-position='left'] .timeline-list__navigation--tabs .timeline-list__control > span::after {
      transition: none;
    }
  }

  .timeline-section .timeline-list[data-timeline-position='left'] .carousel-slide-layout--horizontal {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .timeline-section .heading-block.heading-xl {
    letter-spacing: 2px;
  }

  .timeline-section .text-block {
    letter-spacing: 0.2px;
  }

  @media (max-width: 767.98px) {
    .timeline-section .timeline-list[data-timeline-position='left']:has(.timeline-list__navigation--tabs) {
      grid-template-columns: 52px minmax(0, 1fr);
    }

    .timeline-section .timeline-list[data-timeline-position='left'] .timeline-list__navigation--tabs .timeline-list__navigation-list {
      justify-content: flex-start;
      gap: 48px;
    }

    .timeline-section .timeline-list[data-timeline-position='left'] .timeline-list__navigation--tabs .timeline-list__control {
      font-size: 18px;
    }

    .timeline-section .timeline-list[data-timeline-position='left'] .timeline-list__navigation--tabs .timeline-list__control.is-active {
      font-size: var(--font-heading-xl);
    }

    .timeline-section .timeline-list[data-timeline-position='left'] .carousel-slide-layout--horizontal.carousel-slide-layout--mobile-vertical {
      display: flex;
    }
  }
{% endstylesheet %}

