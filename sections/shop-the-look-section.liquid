{% liquid
  assign shop_the_look_section_width = 'page-width'
  assign shop_the_look_section_no_padding = false
  case section.settings.section_width
    when 'full_width'
      assign shop_the_look_section_width = 'full-width'
    when 'full_width_no_padding'
      assign shop_the_look_section_width = 'full-width'
      assign shop_the_look_section_no_padding = true
  endcase

  assign shop_the_look_media_position = section.settings.media_position | default: 'right'
  unless shop_the_look_media_position == 'left' or shop_the_look_media_position == 'right'
    assign shop_the_look_media_position = 'right'
  endunless

  assign shop_the_look_mobile_media_position = section.settings.mobile_media_position | default: 'first'
  unless shop_the_look_mobile_media_position == 'first' or shop_the_look_mobile_media_position == 'last'
    assign shop_the_look_mobile_media_position = 'first'
  endunless

  assign shop_the_look_gap_desktop = section.settings.gap_desktop | default: 50 | plus: 0
  if shop_the_look_gap_desktop < 0 or shop_the_look_gap_desktop > 100
    assign shop_the_look_gap_desktop = 50
  endif

  assign shop_the_look_gap_mobile = section.settings.gap_mobile | default: 16 | plus: 0
  if shop_the_look_gap_mobile < 0 or shop_the_look_gap_mobile > 100
    assign shop_the_look_gap_mobile = 16
  endif

  assign shop_the_look_image_block = section.blocks | where: 'type', 'image' | first
  assign shop_the_look_image_ratio_desktop = 'auto'
  if shop_the_look_image_block != blank
    assign shop_the_look_image_ratio_desktop = shop_the_look_image_block.settings.image_ratio_desktop | default: 'auto'
  endif
  unless shop_the_look_image_ratio_desktop == 'auto' or shop_the_look_image_ratio_desktop == 'square' or shop_the_look_image_ratio_desktop == 'portrait' or shop_the_look_image_ratio_desktop == 'landscape' or shop_the_look_image_ratio_desktop == 'wide' or shop_the_look_image_ratio_desktop == 'custom'
    assign shop_the_look_image_ratio_desktop = 'auto'
  endunless

  assign shop_the_look_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign shop_the_look_scheme = section.settings.color_scheme.id
  endif
  assign shop_the_look_scheme = shop_the_look_scheme | default: 'scheme-1' | handleize

  assign shop_the_look_padding_top = section.settings.padding_top | default: 0 | plus: 0
  assign shop_the_look_padding_bottom = section.settings.padding_bottom | default: 0 | plus: 0
  assign shop_the_look_padding_top_mobile = section.settings.padding_top_mobile | default: 0 | plus: 0
  assign shop_the_look_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 0 | plus: 0

%}

{% capture shop_the_look_style %}
  {% if shop_the_look_gap_desktop != 50 %}--shop-the-look-gap-desktop: {{ shop_the_look_gap_desktop }}px;{% endif %}
  {% if shop_the_look_gap_mobile != 16 %}--shop-the-look-gap-mobile: {{ shop_the_look_gap_mobile }}px;{% endif %}
  {% if shop_the_look_padding_top != 0 %}--shop-the-look-padding-top: {{ shop_the_look_padding_top }}px;{% endif %}
  {% if shop_the_look_padding_bottom != 0 %}--shop-the-look-padding-bottom: {{ shop_the_look_padding_bottom }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    {% if shop_the_look_padding_top_mobile != shop_the_look_padding_top %}--shop-the-look-padding-top-mobile: {{ shop_the_look_padding_top_mobile }}px;{% endif %}
    {% if shop_the_look_padding_bottom_mobile != shop_the_look_padding_bottom %}--shop-the-look-padding-bottom-mobile: {{ shop_the_look_padding_bottom_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign shop_the_look_style = shop_the_look_style | strip %}

<div
  class="section-spacing shop-the-look-section section-color-scope {{ shop_the_look_scheme }} shop-the-look-section--media-{{ shop_the_look_media_position }} shop-the-look-section--mobile-media-{{ shop_the_look_mobile_media_position }}{% if shop_the_look_section_no_padding %} shop-the-look-section--no-padding{% endif %}"
  {% if shop_the_look_style != blank %}style="{{ shop_the_look_style }}"{% endif %}
  data-shop-the-look-image-ratio-desktop="{{ shop_the_look_image_ratio_desktop }}"
  data-shop-the-look-section
>
  <div class="container {{ shop_the_look_section_width }} shop-the-look-section__container{% if shop_the_look_section_no_padding %} shop-the-look-section__container--no-padding{% endif %}">
    <div class="shop-the-look-section__layout">
      <div class="shop-the-look-section__media">
        {% content_for 'block', type: 'image', id: 'image' %}
        <div
          class="shop-the-look-section__hotspots"
          data-shop-the-look-hotspots
          role="group"
          aria-label="{{ 'accessibility.shop_the_look_products' | t | escape }}"
        ></div>
      </div>

      <div class="shop-the-look-section__content section-content-scope">
        {% content_for 'block', type: 'header', id: 'header' %}
        {% content_for 'block', type: 'shop-the-look-products', id: 'product-list' %}
      </div>
    </div>
  </div>
</div>

{{ 'section-shop-the-look-section.css' | asset_url | stylesheet_tag }}

