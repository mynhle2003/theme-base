<div class="section-spacing countdown-with-marquee" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="container full-width">
    <countdown-marquee-layout class="countdown-with-marquee__layout color-scheme section-color-scope {{ section.settings.color_scheme }}">
      <div class="countdown-with-marquee__rail countdown-with-marquee__rail--left">
        {% content_for 'block', type: '_countdown-marquee', id: 'marquee-left' %}
      </div>
      <div class="countdown-with-marquee__content">
        {% content_for 'block', type: 'group', id: 'content' %}
      </div>
      <div class="countdown-with-marquee__rail countdown-with-marquee__rail--right">
        {% content_for 'block', type: '_countdown-marquee', id: 'marquee-right' %}
      </div>
    </countdown-marquee-layout>
  </div>
</div>
{% stylesheet %}
  .countdown-with-marquee__layout { display: grid; grid-template-columns: 146px minmax(0, 1fr) 146px; column-gap: 80px; }
  .countdown-with-marquee__rail { position: relative; min-width: 0; overflow: hidden; }
  .countdown-with-marquee__content { min-width: 0; container-type: inline-size; }
  @media (min-width: 768px) {
    .countdown-with-marquee__content > .group { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--countdown-content-gap, var(--layout-flow-gap)); row-gap: 32px; }
    .countdown-with-marquee__content > .group > :first-child { grid-column: 1; grid-row: 1; }
    .countdown-with-marquee__content > .group > .countdown-timer { grid-column: 2; grid-row: 1 / span 2; justify-self: center; align-self: center; }
    .countdown-with-marquee__content > .group > :last-child { grid-column: 1; grid-row: 2; }
  }
  @media (min-width: 768px) and (max-width: 1199.98px) {
    .countdown-with-marquee__layout { grid-template-columns: 100px minmax(0, 1fr) 100px; column-gap: 24px; }
    .countdown-with-marquee__layout:not([data-countdown-layout-ready]) .countdown-with-marquee__content > .group { display: flex; flex-direction: column; align-items: flex-start; gap: var(--layout-flow-gap-mobile, 24px); }
  }
  @media (max-width: 767.98px) {
    .countdown-with-marquee__layout { grid-template-columns: minmax(0, 1fr) 68px; column-gap: 8px; }
    .countdown-with-marquee__rail--left { display: none; }

  }
  .countdown-with-marquee__layout[data-countdown-stacked] .countdown-with-marquee__content > .group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--layout-flow-gap-mobile, 24px);
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    if (customElements.get('countdown-marquee-layout')) return;

    // Timer gaps collapse inside each half-column before the parent gap changes.
    function countdownGroupFit(available, timerMinimum, desiredGap) {
      return {
        gap: Math.max(0, Math.min(desiredGap, available - 2 * timerMinimum)),
        stacked: available < 2 * timerMinimum
      };
    }

    class CountdownMarqueeLayout extends HTMLElement {
      connectedCallback() {
        if (this.resizeObserver) return;
        this.group = this.querySelector('.countdown-with-marquee__content > .group');
        this.timer = this.group?.querySelector(':scope > .countdown-timer--style-with-labels-compact');
        if (!this.timer) return;
        this.schedule = () => {
          if (this.frame) return;
          this.frame = requestAnimationFrame(() => {
            this.frame = 0;
            if (!this.isConnected) return;
            const style = getComputedStyle(this.group);
            const available = this.group.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
            const units = [...this.timer.querySelectorAll('[data-countdown-unit]')];
            const minimum = units.reduce((sum, unit) => sum + unit.getBoundingClientRect().width, 0);
            if (!minimum || !available) return;
            const desiredGap = parseFloat(style.getPropertyValue('--layout-flow-gap')) || 0;
            const fit = countdownGroupFit(available, minimum, desiredGap);
            this.group.style.setProperty('--countdown-content-gap', `${fit.gap}px`);
            this.toggleAttribute('data-countdown-stacked', fit.stacked);
            this.setAttribute('data-countdown-layout-ready', '');
          });
        };
        this.resizeObserver = new ResizeObserver(this.schedule);
        this.resizeObserver.observe(this.group);
        this.timer.querySelectorAll('[data-countdown-unit]').forEach(unit => this.resizeObserver.observe(unit));
        this.schedule();
      }
      disconnectedCallback() {
        this.resizeObserver?.disconnect();
        this.resizeObserver = null;
        cancelAnimationFrame(this.frame);
        this.frame = 0;
        this.group?.style.removeProperty('--countdown-content-gap');
        this.removeAttribute('data-countdown-layout-ready');
        this.removeAttribute('data-countdown-stacked');
      }
    }
    customElements.define('countdown-marquee-layout', CountdownMarqueeLayout);
  })();
{% endjavascript %}

