{% comment %}Ordered lifestyle images share the product carousel state.{% endcomment %}
{% liquid
  assign shop_the_look_section_width = 'page-width'
  assign shop_the_look_section_no_padding = false
  case section.settings.section_width
    when 'full_width'
      assign shop_the_look_section_width = 'full-width'
    when 'full_width_no_padding'
      assign shop_the_look_section_width = 'full-width'
      assign shop_the_look_section_no_padding = true
  endcase

  assign shop_the_look_media_position = section.settings.media_position | default: 'right'
  unless shop_the_look_media_position == 'left' or shop_the_look_media_position == 'right'
    assign shop_the_look_media_position = 'right'
  endunless

  assign shop_the_look_mobile_media_position = section.settings.mobile_media_position | default: 'first'
  unless shop_the_look_mobile_media_position == 'first' or shop_the_look_mobile_media_position == 'last'
    assign shop_the_look_mobile_media_position = 'first'
  endunless

  assign shop_the_look_gap_desktop = section.settings.gap_desktop | default: 50 | plus: 0
  if shop_the_look_gap_desktop < 0 or shop_the_look_gap_desktop > 100
    assign shop_the_look_gap_desktop = 50
  endif

  assign shop_the_look_gap_mobile = section.settings.gap_mobile | default: 16 | plus: 0
  if shop_the_look_gap_mobile < 0 or shop_the_look_gap_mobile > 100
    assign shop_the_look_gap_mobile = 16
  endif

  assign shop_the_look_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign shop_the_look_scheme = section.settings.color_scheme.id
  endif
  assign shop_the_look_scheme = shop_the_look_scheme | default: 'scheme-1' | handleize

  assign shop_the_look_padding_top = section.settings.padding_top | default: 0 | plus: 0
  assign shop_the_look_padding_bottom = section.settings.padding_bottom | default: 0 | plus: 0
  assign shop_the_look_padding_top_mobile = section.settings.padding_top_mobile | default: 0 | plus: 0
  assign shop_the_look_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 0 | plus: 0

%}

{% capture shop_the_look_style %}
  {% if shop_the_look_gap_desktop != 50 %}--shop-the-look-gap-desktop: {{ shop_the_look_gap_desktop }}px;{% endif %}
  {% if shop_the_look_gap_mobile != 16 %}--shop-the-look-gap-mobile: {{ shop_the_look_gap_mobile }}px;{% endif %}
  {% if shop_the_look_padding_top != 0 %}--shop-the-look-padding-top: {{ shop_the_look_padding_top }}px;{% endif %}
  {% if shop_the_look_padding_bottom != 0 %}--shop-the-look-padding-bottom: {{ shop_the_look_padding_bottom }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    {% if shop_the_look_padding_top_mobile != shop_the_look_padding_top %}--shop-the-look-padding-top-mobile: {{ shop_the_look_padding_top_mobile }}px;{% endif %}
    {% if shop_the_look_padding_bottom_mobile != shop_the_look_padding_bottom %}--shop-the-look-padding-bottom-mobile: {{ shop_the_look_padding_bottom_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign shop_the_look_style = shop_the_look_style | strip %}

<div class="section-spacing look-carousel section-color-scope {{ shop_the_look_scheme }} look-carousel--media-{{ shop_the_look_media_position }} look-carousel--mobile-media-{{ shop_the_look_mobile_media_position }}{% if shop_the_look_section_no_padding %} look-carousel--no-padding{% endif %}"
  style="{{ shop_the_look_style }}--look-product-width: {{ section.settings.product_width_desktop }}px;--look-product-width-mobile: {{ section.settings.product_width_mobile }}px;"
  data-shop-the-look-section data-look-carousel-banners>
  <div class="container {{ shop_the_look_section_width }} look-carousel__container">
    {% content_for 'block', type: 'header', id: 'header' %}
    <div class="look-carousel__layout">
      <div class="look-carousel__media">
        {% content_for 'block', type: '_look-images', id: 'images' %}
      </div>
      <div class="look-carousel__content section-content-scope">
        {% content_for 'block', type: '_look-banner-products', id: 'product-list' %}
      </div>
    </div>
  </div>
</div>
{% stylesheet %}
  .look-carousel {
    padding-top: var(--shop-the-look-padding-top, 0px);
    padding-bottom: var(--shop-the-look-padding-bottom, 0px);
    min-width: 0;
  }
  .look-carousel__container > .block-header { margin-inline: auto; }
  .look-carousel__layout { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--shop-the-look-gap-desktop, 50px); align-items: center; }
  .look-carousel__media, .look-carousel__content { min-width: 0; grid-row: 1; }
  .look-carousel__media { grid-column: 2; }
  .look-carousel__content { grid-column: 1; }
  .look-carousel--media-left .look-carousel__media { grid-column: 1; }
  .look-carousel--media-left .look-carousel__content { grid-column: 2; }
  .look-carousel--no-padding, .look-carousel--no-padding .look-carousel__container { padding-inline: 0; }
  .look-images { display: grid; min-width: 0; }
  .look-images > .image-block { grid-area: 1 / 1; width: 100%; max-width: none; padding: 0; }
  .look-images > .image-block:not(:first-child) { visibility: hidden; }
  .look-images[data-ready] > .image-block { opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 400ms ease, visibility 400ms; }
  .look-images[data-ready] > .image-block[data-active] { opacity: 1; visibility: visible; pointer-events: auto; }
  .look-carousel .shop-the-look-products__items { width: 100%; max-width: var(--look-product-width, 384px); margin-inline: auto; }
  .look-carousel .shop-the-look-products__carousel { position: static; }
  .look-carousel .shop-the-look-products__navigation--outside {
    width: auto;
    inset-inline: var(--look-outside-offset, 0px);
    top: 50%;
    transform: translateY(-50%);
  }
  .look-carousel .shop-the-look-products__navigation--outside .swiper-nav-button--prev {
    margin-inline: 0;
    translate: -50% 0;
  }
  .look-carousel .shop-the-look-products__navigation--outside .swiper-nav-button--next {
    margin-inline: 0;
    translate: 50% 0;
  }
  .look-carousel .shop-the-look-products__carousel:has(> .shop-the-look-products__navigation--inside) {
    position: relative;
    width: 100%;
    max-width: var(--look-product-width, 384px);
    margin-inline: auto;
  }
  .look-carousel .shop-the-look-products__navigation--inside { width: 100%; inset-inline: 0; }
  .look-carousel .shop-the-look-product__action { margin-top: 28px; align-self: center; }
  @media (max-width: 767.98px) {
    .look-carousel { padding-top: var(--shop-the-look-padding-top-mobile, var(--shop-the-look-padding-top, 0px)); padding-bottom: var(--shop-the-look-padding-bottom-mobile, var(--shop-the-look-padding-bottom, 0px)); }
    .look-carousel__layout { display: flex; flex-direction: column; row-gap: var(--shop-the-look-gap-mobile, 16px); }
    .look-carousel__media, .look-carousel__content { width: 100%; }
    .look-carousel--mobile-media-last .look-carousel__media { order: 2; }
    .look-carousel .shop-the-look-products__items { max-width: var(--look-product-width-mobile, 256px); }
    .look-carousel .shop-the-look-products__carousel:has(> .shop-the-look-products__navigation--inside) { max-width: var(--look-product-width-mobile, 256px); }
    .look-carousel .shop-the-look-product__action { margin-top: 24px; }
  }
  @media (prefers-reduced-motion: reduce) { .look-images[data-ready] > .image-block { transition: none; } }
{% endstylesheet %}
{% javascript %}
(() => {
  const instances = new WeakMap();
  const initialize = (root) => {
    if (instances.has(root)) return;
    const banners = root.querySelector('[data-look-images]');
    const products = root.querySelector('[data-shop-the-look-products]');
    if (!banners || !products) return;
    const controller = new AbortController();
    const getItems = () => Array.from(products.querySelectorAll('[data-shop-the-look-product]'));
    const getBanners = () => Array.from(banners.children).filter((item) => item.matches('.image-block'));
    const show = (index) => {
      const slides = getBanners();
      const activeIndex = Math.min(Math.max(index, 0), slides.length - 1);
      slides.forEach((slide, i) => {
        const active = i === activeIndex;
        slide.toggleAttribute('data-active', active);
        slide.setAttribute('aria-hidden', String(!active));
        slide.inert = !active;
        if (!active) slide.querySelectorAll('video').forEach((video) => video.pause());
      });
      banners.setAttribute('data-ready', '');
    };
    const refresh = () => show(Math.max(0, getItems().findIndex((item) => item.dataset.shopTheLookActive === 'true')));
    const observer = new MutationObserver(refresh);
    observer.observe(products, { subtree: true, childList: true, attributes: true, attributeFilter: ['data-shop-the-look-active'] });
    root.addEventListener('shopify:block:select', (event) => {
      const banner = event.target.closest?.('.shop-the-look-image');
      if (!banner || !banners.contains(banner)) return;
      const index = getBanners().indexOf(banner);
      const swiper = products.querySelector('[data-product-carousel]')?.swiper;
      if (swiper && !swiper.destroyed && index < getItems().length) swiper.slideTo(index, 0);
      show(index);
    }, { signal: controller.signal });
    // Expand only when the complete Figma offset fits. Otherwise button
    // centers stay exactly on the main edges, without partial expansion.
    const layout = root.querySelector('.look-carousel__layout');
    const view = root.ownerDocument.defaultView;
    const updateNavigation = () => {
      if (!layout) return;
      const bounds = layout.getBoundingClientRect();
      const navigation = root.querySelector('.shop-the-look-products__navigation--outside');
      const buttons = navigation ? Array.from(navigation.querySelectorAll('button')) : [];
      const halfButton = Math.max(0, ...buttons.map((button) => button.getBoundingClientRect().width / 2));
      const viewportWidth = root.ownerDocument.documentElement.clientWidth;
      const available = Math.min(bounds.left, viewportWidth - bounds.right);
      const offset = buttons.length && bounds.width > 0 && available >= bounds.width * 0.05625 + halfButton + 8
        ? '-5.625%' : '0px';
      if (layout.style.getPropertyValue('--look-outside-offset') !== offset) {
        layout.style.setProperty('--look-outside-offset', offset);
      }
    };
    const resizeObserver = typeof ResizeObserver === 'function' ? new ResizeObserver(updateNavigation) : null;
    if (layout) resizeObserver?.observe(layout);
    root.querySelectorAll('.shop-the-look-products__navigation--outside button').forEach((button) => resizeObserver?.observe(button));
    view?.addEventListener('resize', updateNavigation, { signal: controller.signal });
    updateNavigation();
    instances.set(root, { observer, controller, resizeObserver });
    refresh();
  };
  const roots = (scope) => [ ...(scope.matches?.('[data-look-carousel-banners]') ? [scope] : []), ...scope.querySelectorAll('[data-look-carousel-banners]') ];
  const load = (scope) => roots(scope).forEach(initialize);
  document.addEventListener('shopify:section:load', (event) => load(event.target));
  document.addEventListener('shopify:section:unload', (event) => roots(event.target).forEach((root) => {
    const state = instances.get(root);
    state?.observer.disconnect();
    state?.resizeObserver?.disconnect();
    state?.controller.abort();
    instances.delete(root);
  }));
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => load(document), { once: true });
  else load(document);
})();
{% endjavascript %}

