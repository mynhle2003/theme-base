{% liquid
  assign container_width = 'full-width full-width--no-padding'
  if section.settings.section_width == 'page_width'
    assign container_width = 'page-width'
  elsif section.settings.section_width == 'full_width'
    assign container_width = 'full-width'
  endif
  assign alignment = 'center'
  case section.settings.alignment
    when 'left'
      assign alignment = 'flex-start'
    when 'right'
      assign alignment = 'flex-end'
  endcase
  assign alignment_mobile = alignment
  if section.settings.customize_mobile_alignment
    assign alignment_mobile = 'center'
    case section.settings.alignment_mobile
      when 'left'
        assign alignment_mobile = 'flex-start'
      when 'right'
        assign alignment_mobile = 'flex-end'
    endcase
  endif
%}
<script type="module" src="{{ 'collection-marquee.js' | asset_url }}"></script>
<div class="section-spacing collection-marquees color-scheme section-color-scope {{ section.settings.color_scheme }}" style="--cm-padding-top:{{ section.settings.padding_top }}px;--cm-padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.customize_mobile_padding %}--cm-padding-top-mobile:{{ section.settings.padding_top_mobile }}px;--cm-padding-bottom-mobile:{{ section.settings.padding_bottom_mobile }}px;{% endif %}--cm-header-gap:{{ section.settings.header_gap }}px;--cm-header-gap-mobile:{{ section.settings.header_gap_mobile }}px;--cm-row-gap:{{ section.settings.row_gap }}px;--cm-row-gap-mobile:{{ section.settings.row_gap_mobile }}px;">
  <div class="container {{ container_width }} collection-marquees__container">
    <div class="align-content collection-marquees__header" style="--flex-align:{{ alignment }};--flex-align-mobile:{{ alignment_mobile }};">{% content_for 'block', type: 'header', id: 'header' %}</div>
    <div class="collection-marquees__rows">{% content_for 'blocks' %}</div>
  </div>
</div>
{% stylesheet %}
  .collection-marquees { padding-top: var(--cm-padding-top); padding-bottom: var(--cm-padding-bottom); background: var(--background-color); overflow: hidden; }
  .collection-marquees__container { min-width: 0; }
  .collection-marquees .container.full-width--no-padding { width: 100%; max-width: none; padding-inline: 0; }
  .collection-marquees__header { margin-bottom: var(--cm-header-gap); padding-inline: var(--page-margin-current); }
  .collection-marquees__rows { display: grid; gap: var(--cm-row-gap); min-width: 0; }
  .collection-marquees__rows:empty { display: none; }
  @media (min-width: 768px) and (max-width: 1149.98px) { .collection-marquees { padding-top: calc(var(--cm-padding-top) * .75); padding-bottom: calc(var(--cm-padding-bottom) * .75); } }
  @media (max-width: 767.98px) {
    .collection-marquees { padding-top: var(--cm-padding-top-mobile, calc(var(--cm-padding-top) * .5)); padding-bottom: var(--cm-padding-bottom-mobile, calc(var(--cm-padding-bottom) * .5)); }
    .collection-marquees__header { margin-bottom: var(--cm-header-gap-mobile); }
    .collection-marquees__rows { gap: var(--cm-row-gap-mobile); }
  }
{% endstylesheet %}

{% schema %}
