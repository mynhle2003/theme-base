    },
    {
      "type": "checkbox",
      "id": "full_width_content",
      "label": "Full-width content",
      "default": false
    },
    {
      "type": "header",
      "content": "Height"
    },
    {
      "type": "select",
      "id": "desktop_height",
      "label": "Desktop height",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt"
        },
        {
          "value": "extra_small",
          "label": "Extra small"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "extra_large",
          "label": "Extra large"
        },
        {
          "value": "full_screen",
          "label": "Full screen"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Mobile height",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt"
        },
        {
          "value": "extra_small",
          "label": "Extra small"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "extra_large",
          "label": "Extra large"
        },
        {
          "value": "full_screen",
          "label": "Full screen"
        }
      ],
      "default": "small"
    },
    {
      "type": "header",
      "content": "Slide autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay interval",
      "min": 3,
