{% liquid
  assign pagination_desktop = section.settings.show_pagination_on_desktop
  if pagination_desktop == nil
    assign pagination_desktop = section.settings.show_pagination
  endif
  assign pagination_mobile = section.settings.show_pagination_on_mobile
  if pagination_mobile == nil
    assign pagination_mobile = pagination_desktop
  endif
  assign pagination_any = false
  if pagination_desktop or pagination_mobile
    assign pagination_any = true
  endif
%}
{{ 'section-slideshow.css' | asset_url | stylesheet_tag }}
{% liquid
  assign slideshow_width = section.settings.width | default: 'full_bleed'
  unless slideshow_width == 'page' or slideshow_width == 'full' or slideshow_width == 'full_bleed'
    assign slideshow_width = 'full_bleed'
  endunless
  assign slideshow_show_next_slide_preview_on_desktop = false
  if slideshow_width == 'page' and section.settings.show_next_slide_preview_on_desktop
    assign slideshow_show_next_slide_preview_on_desktop = true
  endif
  assign slideshow_transition = section.settings.transition_style | default: 'slide'
  unless slideshow_transition == 'slide' or slideshow_transition == 'fade'
    assign slideshow_transition = 'slide'
  endunless
  assign slideshow_desktop_height = section.settings.desktop_height | default: 'medium'
  assign slideshow_mobile_height = section.settings.mobile_height | default: 'small'
  assign slideshow_autoplay_delay = section.settings.autoplay_delay | default: 6 | times: 1000
  assign slideshow_padding_top = section.settings.padding_top | default: 0 | plus: 0
  assign slideshow_padding_bottom = section.settings.padding_bottom | default: 0 | plus: 0
  assign slideshow_padding_top_mobile = section.settings.padding_top_mobile | default: slideshow_padding_top | plus: 0
  assign slideshow_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: slideshow_padding_bottom | plus: 0
  if slideshow_width == 'full_bleed'
    assign slideshow_padding_top = 0
    assign slideshow_padding_bottom = 0
    assign slideshow_padding_top_mobile = 0
    assign slideshow_padding_bottom_mobile = 0
  endif
  assign slideshow_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign slideshow_scheme = section.settings.color_scheme.id
  endif
  assign slideshow_scheme = slideshow_scheme | handleize
  assign slideshow_navigation_style = section.settings.navigation_style | default: 'primary'
  unless slideshow_navigation_style == 'primary' or slideshow_navigation_style == 'secondary'
    assign slideshow_navigation_style = 'primary'
  endunless
  assign slideshow_navigation_icon = section.settings.navigation_icon | default: 'arrow'
  unless slideshow_navigation_icon == 'chevron' or slideshow_navigation_icon == 'arrow' or slideshow_navigation_icon == 'long_arrow'
    assign slideshow_navigation_icon = 'arrow'
  endunless
  assign slideshow_navigation_behavior = section.settings.navigation_behavior | default: 'show_on_hover'
  unless slideshow_navigation_behavior == 'show_on_hover' or slideshow_navigation_behavior == 'always'
    assign slideshow_navigation_behavior = 'show_on_hover'
  endunless
%}

{% capture slideshow_style %}
  {% if slideshow_padding_top != 0 %}--slideshow-padding-top: {{ slideshow_padding_top }}px;{% endif %}
  {% if slideshow_padding_bottom != 0 %}--slideshow-padding-bottom: {{ slideshow_padding_bottom }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    {% if slideshow_padding_top_mobile != slideshow_padding_top %}--slideshow-padding-top-mobile: {{ slideshow_padding_top_mobile }}px;{% endif %}
    {% if slideshow_padding_bottom_mobile != slideshow_padding_bottom %}--slideshow-padding-bottom-mobile: {{ slideshow_padding_bottom_mobile }}px;{% endif %}
  {% endif %}
  {% if section.settings.background_color != blank %}--slideshow-background: {{ section.settings.background_color }};{% endif %}
  {% if section.settings.autoplay %}--slideshow-autoplay-duration: {{ slideshow_autoplay_delay }}ms;{% endif %}
{% endcapture %}

<link rel="stylesheet" href="{{ 'swiper-12.2.0-effect-fade.min.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'swiper-12.2.0-effect-fade.min.css' | asset_url | stylesheet_tag }}</noscript>
<script type="module" src="{{ 'slideshow.js' | asset_url }}"></script>

<div
  class="slideshow slideshow--width-{{ slideshow_width }} slideshow--desktop-{{ slideshow_desktop_height }} slideshow--mobile-{{ slideshow_mobile_height }} color-scheme section-color-scope {{ slideshow_scheme }}"
  data-slideshow
  {% render 'swiper-carousel-attributes', effect: slideshow_transition, desktop_preview: slideshow_show_next_slide_preview_on_desktop %}
  {% render 'swiper-carousel-attributes', autoplay_contract: 'owner', autoplay: section.settings.autoplay, autoplay_delay: slideshow_autoplay_delay, pause_on_hover: section.settings.pause_on_hover %}
  data-full-width-content="{{ section.settings.full_width_content }}"
  {% if slideshow_style != blank %}style="{{ slideshow_style | strip }}"{% endif %}
>
  <div class="slideshow__container{% if slideshow_width == 'page' %} container page-width{% endif %}">
    <div
      id="Slideshow-{{ section.id }}"
      class="slideshow__swiper swiper"
      aria-label="{{ section.settings.aria_label | default: 'Slideshow' | escape }}"
      data-slideshow-swiper
    >
      <div class="swiper-wrapper">
        {% content_for 'blocks' %}
      </div>

      {% if pagination_any %}
        <div
          class="swiper-pagination swiper-pagination--overlay slideshow__pagination slideshow__pagination--{{ section.settings.pagination_type }} swiper-pagination--desktop-{{ section.settings.pagination_position_desktop }} swiper-pagination--mobile-{{ section.settings.pagination_position_mobile }}"
          data-slideshow-pagination
          {% render 'pagination-visibility', desktop: pagination_desktop, mobile: pagination_mobile %}
          data-slideshow-control-scope
          data-pagination-type="{{ section.settings.pagination_type }}"
        ></div>
      {% endif %}

      {% if section.settings.show_navigation %}
        <div class="slideshow__navigation slideshow__navigation--{{ slideshow_navigation_behavior }}" data-slideshow-control-scope aria-label="Slideshow controls">
          <button class="btn btn-{{ slideshow_navigation_style }} btn--{{ slideshow_navigation_style }} btn--icon swiper-nav-button swiper-nav-button--prev slideshow__arrow" type="button" data-slideshow-previous aria-label="Previous slide">
            {% render 'carousel-navigation-icon', icon: slideshow_navigation_icon, direction: 'previous' %}
          </button>
          <button class="btn btn-{{ slideshow_navigation_style }} btn--{{ slideshow_navigation_style }} btn--icon swiper-nav-button swiper-nav-button--next slideshow__arrow" type="button" data-slideshow-next aria-label="Next slide">
            {% render 'carousel-navigation-icon', icon: slideshow_navigation_icon, direction: 'next' %}
          </button>
        </div>
      {% endif %}
    </div>
  </div>
</div>



{% schema %}
{
