{% content_for "block", type: "_header-top", id: "header-top" %}

{% stylesheet %}
  .header {
    position: relative;
    width: 100%;
    color: var(--body-color);
    background-color: var(--background-color);
    transition: background-color var(--motion-duration-standard) var(--motion-ease-standard);
  }

  .header.header--overlay {
    background-color: transparent;
  }

  .header--overlay:is(.header--is-scrolled, .header--submenu-open, .header--search-open, .header--cart-open) {
    background-color: var(--background-color);
  }

  .header--overlay:is(.header--is-scrolled, .header--submenu-open, .header--search-open, .header--cart-open) .header-top {
    background-color: var(--background-color);
  }

  .header--overlay:has(.header-top--transparent-scheme):not(:is(.header--is-scrolled, .header--submenu-open, .header--search-open, .header--cart-open)) .header-top {
    background-color: transparent;
  }

  .header--overlap-first-section {
    z-index: var(--z-drawer);
    margin-block-end: calc(var(--header-layout-height, 0px) * -1);
  }

  /* Home overlay is present in the server-rendered block. Keep its wrapper
     out of document flow before JS measures/reorganizes the header, rather
     than pulling MainContent upward after the first paint. */
  .section-header:has(.header-top[data-header-overlap-first-section]) {
    position: relative;
    height: 0;
    margin-block-end: 0;
    overflow: visible;
    z-index: var(--z-drawer, 200);
  }

  .section-header:has(.header-top[data-header-overlap-first-section][data-sticky-type]:not([data-sticky-type='none'])) {
    position: sticky;
    top: 0;
  }

  .header[data-sticky-type='always'],
  .header[data-sticky-type='scroll_up'] {
    position: sticky;
    top: 0;
    inset-inline: 0;
    z-index: var(--z-drawer, 200);
  }

  .header[data-sticky-type='scroll_up'] {
    transition:
      transform var(--motion-duration-standard) var(--motion-ease-standard),
      background-color var(--motion-duration-standard) var(--motion-ease-standard);
    will-change: transform;
  }

  .header[data-sticky-type='scroll_up'].header--is-hidden {
    transform: translateY(calc(-1 * var(--header-layout-height, 100%)));
  }

  /* Keep the fixed drawer viewport-relative through its entire overlay
     lifecycle, including the exit animation before [hidden] is restored,
     and across viewport resizes. */
  .header[data-sticky-type='scroll_up']:has([data-header-mobile-drawer]:not([hidden])) {
    transform: none;
    will-change: auto;
    transition-property: background-color;
  }

  .header[data-sticky-type='top_header_only'],
  .header[data-sticky-type='bottom_header_only'] {
    position: sticky;
    top: 0;
    z-index: var(--z-drawer, 200);
  }

  @media (prefers-reduced-motion: reduce) {
    .header,
    .header-top {
      transition-duration: 0.01ms;
    }
  }

  .header__container {
    min-width: 0;
  }

  .header .header-mega-menu__banner-media { aspect-ratio: 6 / 7; }
  .header .header-mega-menu__banner-image { height: 100%; object-fit: cover; }
  .header .header-top { --body-color: var(--heading-color); }
  .header-top .header__container.full-width {
    width: 100%;
    max-width: none;
    padding-inline: var(--page-margin-current);
  }
  /* Theme-specific header controls must not inherit global button heights. */
  .section-header .header-top { --header-control-min-height: 44px; }
  .section-header .header-top--separator-line {
    border-bottom: 0;
    box-shadow: inset 0 -0.5px 0 #ccc;
  }
  .section-header .header-top :is(.header__column, .header__blocks),
  .section-header .header-top .header__row :is(.header__column, .header__blocks) > :is(.header-search, .header-account, .header-cart, .header-menu-toggle, .header-localization),
  .section-header .header-top .header-menu__list > .header-menu__item > :is(.header-menu__link, .header-menu__summary),
  .section-header .header-top .header-menu__list > .header-menu__item > .header-menu__details > .header-menu__summary,
  .section-header .header-top .header-menu__placeholder,
  .section-header .header-top :is(.header__column, .header__blocks) > .header-localization > .header-localization__details > .header-localization__summary,
  .section-header .header-top .header-account__avatar {
    min-height: var(--header-control-min-height);
  }
  .header-top .header-localization__country { text-transform: uppercase; }
  .header-top .header-localization__icon { display: none; }
  .header-top .header-localization__flag { width: 16px; height: 12px; border-radius: 0; }
  @media (768px <= width < 992px) {
    .header-top .header__column .header-account { display: inline-flex; }
    .header-top[data-layout-ready='true'] .header__column--center { justify-content: center; }
  }
  @media (width < 768px) {
    .section-header .header-top { --header-control-min-height: 40px; }
  }

  /* Separate icon spacing from the Localization-to-icons spacing. */
  .section-header .header-top {
    --header-icon-action-gap: 6px;
    --header-action-group-gap: 24px;
    --header-action-control-padding: 10px;
  }
  .section-header .header-top .header-localization__country { gap: 8px; }
  .section-header .header-top .header__row .header__column--right > :is(.header-search, .header-account, .header-cart) {
    padding-inline: var(--header-action-control-padding);
    margin-inline: 0;
  }
  .section-header .header-top .header__row .header__column--right > .header-localization {
    padding-inline: 0;
    margin-inline: 0;
  }
  .section-header .header-top .header__row .header__column--right > :is(.header-search, .header-account, .header-cart) + :is(.header-search, .header-account, .header-cart) {
    margin-inline-start: var(--header-icon-action-gap);
  }
  .section-header .header-top .header__row .header__column--right > .header-localization + :is(.header-search, .header-account, .header-cart),
  .section-header .header-top .header__row .header__column--right > :is(.header-search, .header-account, .header-cart) + .header-localization {
    margin-inline-start: var(--header-action-group-gap);
  }
  @media (width < 768px) {
    .section-header .header-top {
      --header-icon-action-gap: 0px;
      --header-action-control-padding: 8px;
    }
    .section-header .header-top .header__row .header__column--left > .header-menu-toggle {
      padding-inline: 8px;
      margin-inline: 0;
    }
  }
{% endstylesheet %}

