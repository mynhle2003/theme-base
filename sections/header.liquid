{% liquid
  assign header_color_scheme = section.settings.color_scheme | default: settings.default_color_scheme
  assign header_color_scheme_id = header_color_scheme.id | default: header_color_scheme | default: 'scheme-1'
  assign desktop_layout = section.settings.desktop_layout | default: 'logo_center'
  assign mobile_layout = section.settings.mobile_layout | default: 'logo_center'
  assign desktop_layout_class = 'site-header--desktop-' | append: desktop_layout
  assign mobile_layout_class = 'site-header--mobile-' | append: mobile_layout
  assign header_class = 'site-header ' | append: desktop_layout_class | append: ' ' | append: mobile_layout_class | append: ' color-' | append: header_color_scheme_id
  assign desktop_navigation_id = 'DesktopNavigation-' | append: section.id
  assign mobile_navigation_id = 'MobileNavigation-' | append: section.id
  assign mobile_menu_id = 'MobileMenu-' | append: section.id
  assign mobile_menu_label = 'header.menu' | t
  assign navigation_label = 'navigation.label' | t
  assign localization_language_id = 'HeaderLanguage-' | append: section.id
  assign localization_country_id = 'HeaderCountry-' | append: section.id
  assign localization_panel_id = 'HeaderLocalization-' | append: section.id
  assign account_url = routes.storefront_login_url

  if customer
    assign account_url = routes.account_url
  endif
%}

<header
  id="Header-{{ section.id }}"
  class="{{ header_class | escape }} full-width{% if section.settings.container == 'full_width' %} site-header--full-width{% else %} site-header--contained{% endif %}{% if section.settings.enable_sticky_header %} site-header--sticky{% endif %}{% if section.settings.transparent_header %} site-header--transparent{% endif %}"
  data-site-header
  {% if section.settings.enable_sticky_header %}data-sticky-header{% endif %}
  style="--header-spacing-block: {{ section.settings.spacing_block }}px;"
>
  <div class="site-header__inner page-width">
    <div class="site-header__menu-area">
      {% if section.settings.menu != blank %}
        <details class="site-header__mobile-menu" data-header-disclosure data-header-mobile-menu scroll-lock>
          <summary
            class="site-header__menu-toggle"
            aria-controls="{{ mobile_menu_id }}"
            aria-expanded="false"
            data-header-disclosure-trigger
          >
            <span class="site-header__menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
            <span>{{ 'header.menu' | t }}</span>
          </summary>
          <div id="{{ mobile_menu_id }}" class="site-header__mobile-nav" data-header-disclosure-panel>
            {% render 'navigation', menu: section.settings.menu, id_prefix: mobile_navigation_id, class: 'navigation--mobile', label: mobile_menu_label %}
          </div>
        </details>

        <div class="site-header__desktop-nav">
          {% render 'navigation', menu: section.settings.menu, id_prefix: desktop_navigation_id, label: navigation_label %}
        </div>
      {% elsif request.design_mode %}
        <span class="site-header__menu-empty">{{ 'navigation.empty' | t }}</span>
      {% endif %}
    </div>

    <div class="site-header__brand">
      {% render 'site-logo', transparent: section.settings.transparent_header %}
    </div>

    <div class="site-header__actions">
      {% if section.settings.show_search %}
        <a class="site-header__action" href="{{ routes.search_url }}" data-dialog-open="SearchDrawer">
          <span class="site-header__action-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="11" cy="11" r="6.5"></circle>
              <path d="m16 16 4 4"></path>
            </svg>
          </span>
          <span class="site-header__action-label">{{ 'header.search' | t }}</span>
        </a>
      {% endif %}

      {% if section.settings.show_account and shop.customer_accounts_enabled %}
        <a class="site-header__action" href="{{ account_url }}" rel="nofollow">
          <span class="site-header__action-icon" aria-hidden="true">{{ 'icon-account.svg' | inline_asset_content }}</span>
          <span class="site-header__action-label">{% if customer %}{{ 'header.account' | t }}{% else %}{{ 'header.sign_in' | t }}{% endif %}</span>
        </a>
      {% endif %}

      {% if section.settings.show_cart %}
        <a
          class="site-header__action site-header__cart"
          href="{{ routes.cart_url }}"
          data-dialog-open="CartDrawer"
          data-cart-trigger
          data-cart-label="{{ 'header.cart' | t | escape }}"
          data-cart-count-template="{{ 'header.cart_count' | t: count: '__COUNT__' | escape }}"
          aria-label="{{ 'header.cart' | t | escape }}{% if cart.item_count > 0 %}, {{ 'header.cart_count' | t: count: cart.item_count | escape }}{% endif %}"
        >
          <span class="site-header__action-icon" aria-hidden="true">
            {{ 'icon-cart.svg' | inline_asset_content }}
            <span class="site-header__cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
          </span>
          <span class="site-header__action-label">{{ 'header.cart' | t }}</span>
        </a>
      {% endif %}

      {% if section.settings.show_localization %}
        {% if localization.available_languages.size > 1 or localization.available_countries.size > 1 %}
          <details class="site-header__localization" data-header-disclosure>
            <summary
              class="site-header__action"
              aria-controls="{{ localization_panel_id }}"
              aria-expanded="false"
              aria-label="{{ 'header.localization' | t | escape }}"
              data-header-disclosure-trigger
            >
              <span class="site-header__action-label">
                {{ localization.language.iso_code | upcase }}{% if localization.available_countries.size > 1 %} / {{ localization.country.iso_code }}{% endif %}
              </span>
            </summary>
            <div id="{{ localization_panel_id }}" class="site-header__localization-panel" data-header-disclosure-panel>
              {% form 'localization' %}
                {% if localization.available_languages.size > 1 %}
                  <label for="{{ localization_language_id }}">{{ 'header.language' | t }}</label>
                  <select id="{{ localization_language_id }}" name="language_code" data-localization-select>
                    {% for language in localization.available_languages %}
                      <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                        {{ language.endonym_name | capitalize | escape }}
                      </option>
                    {% endfor %}
                  </select>
                {% endif %}

                {% if localization.available_countries.size > 1 %}
                  <label for="{{ localization_country_id }}">{{ 'header.country' | t }}</label>
                  <select id="{{ localization_country_id }}" name="country_code" data-localization-select>
                    {% for country in localization.available_countries %}
                      <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                        {{ country.name | escape }} ({{ country.currency.iso_code }})
                      </option>
                    {% endfor %}
                  </select>
                {% endif %}

                <button class="site-header__localization-submit" type="submit">{{ 'header.apply' | t }}</button>
              {% endform %}
            </div>
          </details>
        {% endif %}
      {% endif %}
    </div>
  </div>
</header>

{% stylesheet %}
  .shopify-section:has(> .site-header--sticky),
  .shopify-section[data-sticky-header-host] {
    position: sticky;
    top: 0;
    z-index: var(--z-index-header);
  }

  .site-header {
    --header-bottom: 4.5rem;
    background: var(--gradient-background, var(--color-background));
    border-block-end: 1px solid transparent;
    color: var(--color-foreground);
    padding-block: var(--header-spacing-block);
    position: relative;
    transition: background-color var(--motion-duration) var(--motion-ease), border-color var(--motion-duration) var(--motion-ease), box-shadow var(--motion-duration) var(--motion-ease);
    z-index: var(--z-index-header);
  }

  .site-header--transparent { background: transparent; border-color: transparent; }
  .site-header--scrolled { background: var(--gradient-background, var(--color-background)); border-color: var(--color-border); box-shadow: 0 0.25rem 1rem rgb(0 0 0 / 8%); }
  .site-header--scrolled .site-logo--transparent .site-logo__image--default { display: block; }
  .site-header--scrolled .site-logo--transparent .site-logo__image--transparent { display: none; }
  .site-header--scrolled .site-logo--transparent .site-logo__text { display: inline; }

  .site-header__inner {
    align-items: center;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr auto 1fr;
    min-height: 4.5rem;
    padding-inline: var(--page-margin);
  }

  .site-header--full-width .site-header__inner {
    max-width: none;
  }

  .site-header--desktop-logo_left .site-header__inner { grid-template-columns: auto 1fr auto; }
  .site-header--desktop-logo_left .site-header__brand { grid-column: 1; grid-row: 1; }
  .site-header--desktop-logo_left .site-header__menu-area { grid-column: 2; grid-row: 1; }
  .site-header__menu-area { grid-column: 1; grid-row: 1; min-width: 0; }
  .site-header__brand { grid-column: 2; grid-row: 1; min-width: 0; }
  .site-header__actions { align-items: center; display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; grid-column: 3; grid-row: 1; justify-content: flex-end; min-width: 0; }
  .site-header__brand .site-logo { color: inherit; width: var(--logo-width); }
  .site-header__menu-empty { display: inline-block; font-size: 0.875rem; opacity: 0.7; }

  .site-header__desktop-nav .navigation__list { gap: 1.25rem; }
  .site-header__action,
  .site-header__menu-toggle {
    align-items: center;
    color: inherit;
    display: inline-flex;
    gap: 0.4rem;
    justify-content: center;
    min-height: 2.75rem;
    text-decoration: none;
  }

  .site-header__action:hover,
  .site-header__menu-toggle:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .site-header__action:focus-visible,
  .site-header__menu-toggle:focus-visible,
  .site-header__localization summary:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .site-header__action-icon { align-items: center; display: inline-flex; font-size: 1.35rem; line-height: 1; }
  .site-header__action-icon svg { height: 1.4rem; width: 1.4rem; }
  .site-header__cart { position: relative; }
  .site-header__cart .site-header__action-icon { position: relative; }
  .site-header__cart-count {
    align-items: center;
    background: var(--color-primary-button);
    border: 1px solid var(--color-primary-button-border);
    border-radius: var(--radius-pill);
    box-shadow: 0 0 0 2px var(--color-background);
    color: var(--color-primary-button-label);
    display: inline-flex;
    font-size: var(--font-body-xs);
    font-weight: var(--font-heading-weight, 700);
    height: 1.125rem;
    justify-content: center;
    inset-inline-end: -0.45rem;
    line-height: 1;
    min-width: 1.125rem;
    padding-inline: 0.25rem;
    pointer-events: none;
    position: absolute;
    top: -0.45rem;
    z-index: 1;
  }

  .site-header__mobile-menu { display: none; }
  .site-header__menu-toggle { cursor: pointer; list-style: none; }
  .site-header__menu-toggle::-webkit-details-marker { display: none; }
  .site-header__menu-icon { display: grid; gap: 0.2rem; width: 1.15rem; }
  .site-header__menu-icon span { background: currentColor; display: block; height: 1px; width: 100%; }

  .site-header__localization { position: relative; }
  .site-header__localization summary { cursor: pointer; list-style: none; }
  .site-header__localization summary::-webkit-details-marker { display: none; }
  .site-header__localization-panel { background: var(--color-background); border: 1px solid var(--color-border); box-shadow: var(--overlay-shadow, 0 0.5rem 1.5rem rgb(0 0 0 / 12%)); inset-inline-end: 0; min-width: 15rem; padding: 1rem; position: absolute; top: calc(100% + 0.5rem); z-index: var(--z-index-dropdown); }
  .site-header__localization-panel form { display: grid; gap: 0.5rem; }
  .site-header__localization-panel [data-localization-select] {
    background-color: var(--color-background);
    border-color: var(--color-border);
    color: var(--color-foreground);
  }
  .site-header__localization-panel [data-localization-select] option {
    background-color: var(--color-background);
    color: var(--color-foreground);
  }
  .site-header__localization-panel [data-localization-select]:focus-visible {
    border-color: var(--color-heading);
    outline-color: var(--color-heading);
  }
  .site-header__localization-submit { min-height: 2.75rem; }

  @media screen and (max-width: 767.98px) {
    .site-header { --header-bottom: 4rem; }
    .site-header__inner { grid-template-columns: auto minmax(0, 1fr) auto; min-height: 4rem; }
    .site-header--mobile-logo_left .site-header__brand { grid-column: 1; grid-row: 1; }
    .site-header--mobile-logo_left .site-header__menu-area { grid-column: 2; grid-row: 1; }
    .site-header--mobile-logo_center .site-header__menu-area { grid-column: 1; grid-row: 1; }
    .site-header--mobile-logo_center .site-header__brand { grid-column: 2; grid-row: 1; }
    .site-header__brand { max-width: min(var(--logo-width-mobile), 34vw); }
    .site-header__brand .site-logo { width: 100%; }
    .site-header__desktop-nav { display: none; }
    .site-header__mobile-menu { display: block; position: static; }
    .site-header__mobile-menu[open]::before {
      background: var(--overlay-backdrop, rgb(0 0 0 / 35%));
      content: '';
      inset: var(--header-bottom) 0 0;
      position: fixed;
      z-index: var(--z-index-dropdown);
    }
    .site-header__mobile-nav {
      background: var(--gradient-background, var(--color-background));
      border-inline-end: 1px solid var(--color-border);
      bottom: 0;
      color: var(--color-foreground);
      inline-size: min(24rem, calc(100vw - var(--page-margin)));
      inset-inline-start: 0;
      max-inline-size: 100%;
      overflow-y: auto;
      padding: 1.5rem var(--page-margin);
      position: fixed;
      top: var(--header-bottom);
      z-index: calc(var(--z-index-dropdown) + 1);
    }
    .site-header__mobile-nav .navigation__list { display: grid; gap: 0.75rem; }
    .site-header__mobile-nav .navigation__list--nested { border: 0; box-shadow: none; margin-block-start: 0.5rem; padding: 0 0 0 1rem; position: static; }
    .site-header__actions { flex-wrap: nowrap; gap: 0.25rem; }
    .site-header__action-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }
    .site-header__localization .site-header__action-label { position: static; width: auto; height: auto; clip: auto; clip-path: none; overflow: visible; white-space: normal; }
    .site-header__localization-panel { inset-inline-end: -0.5rem; }
  }

  @media screen and (min-width: 768px) {
    .site-header--desktop-logo_left .site-header__desktop-nav { justify-self: start; }
    .site-header__desktop-nav .navigation__item { position: relative; }
    .site-header__desktop-nav .navigation__list--nested {
      background: var(--gradient-background, var(--color-background));
      border: 1px solid var(--color-border);
      box-shadow: var(--overlay-shadow, 0 0.5rem 1.5rem rgb(0 0 0 / 12%));
      display: grid;
      gap: 0.75rem;
      inset-inline-start: 0;
      min-width: 13rem;
      padding: 1rem;
      position: absolute;
      top: calc(100% + 0.5rem);
      z-index: var(--z-index-dropdown);
    }
    .site-header__desktop-nav .navigation__list--nested .navigation__list--nested { inset-inline-start: calc(100% + 0.5rem); top: -1rem; }
  }

  @media screen and (max-width: 479.98px) {
    .site-header__actions {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    if (window.themeHeaderManager) return;

    const manager = {
      headers: new Map(),
      mobileViewport: window.matchMedia('(max-width: 767.98px)'),

      init(root) {
        const headers = [];
        if (root.matches?.('[data-site-header]')) headers.push(root);
        if (root.querySelectorAll) headers.push(...root.querySelectorAll('[data-site-header]'));
        headers.forEach((header) => this.register(header));
      },

      register(header) {
        if (this.headers.has(header)) return;
        const controller = new AbortController();
        const { signal } = controller;
        const disclosures = [...header.querySelectorAll('[data-header-disclosure]')];
        const sectionHost = header.closest('.shopify-section');
        const sticky = header.hasAttribute('data-sticky-header');

        const updatePosition = () => {
          if (sticky) header.classList.toggle('site-header--scrolled', window.scrollY > 0);
          const bottom = `${Math.max(0, Math.round(header.getBoundingClientRect().bottom))}px`;
          if (header.style.getPropertyValue('--header-bottom') !== bottom) {
            header.style.setProperty('--header-bottom', bottom);
          }
        };

        const closeNavigation = (root) => window.themeNavigationManager?.close?.(root);

        const updateDisclosure = (disclosure) => {
          const trigger = disclosure.querySelector(':scope > [data-header-disclosure-trigger]');
          trigger?.setAttribute('aria-expanded', String(disclosure.open));
          if (!disclosure.open) closeNavigation(disclosure);
        };

        const closeDisclosure = (disclosure, restoreFocus = false) => {
          if (!disclosure.open) return;
          const trigger = disclosure.querySelector(':scope > [data-header-disclosure-trigger]');
          disclosure.open = false;
          updateDisclosure(disclosure);
          if (restoreFocus) trigger?.focus();
        };

        const closeAll = (except = null, restoreFocus = false) => {
          this.headers.forEach((entry) => {
            entry.disclosures.forEach((disclosure) => {
              if (disclosure !== except) entry.closeDisclosure(disclosure, restoreFocus);
            });
          });
        };

        const handleToggle = (event) => {
          const disclosure = event.currentTarget;
          if (disclosure.open) {
            closeAll(disclosure, false);
            closeNavigation(header);
          }
          updateDisclosure(disclosure);
          updatePosition();
        };

        const handleKeydown = (event) => {
          if (event.defaultPrevented || event.key !== 'Escape') return;
          const disclosure = disclosures.find((item) => item.open);
          if (!disclosure) return;
          event.preventDefault();
          closeDisclosure(disclosure, true);
        };

        const handleClick = (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          if (target.closest('[data-dialog-open]')) {
            closeAll(null, false);
            closeNavigation(header);
            return;
          }

          if (target.closest('[data-header-mobile-menu] .navigation__link')) {
            const mobileMenu = target.closest('[data-header-mobile-menu]');
            if (mobileMenu) closeDisclosure(mobileMenu, false);
            return;
          }

          if (!target.closest('[data-navigation]')) closeNavigation(header);
        };

        const handleDocumentClick = (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const targetDisclosure = target.closest('[data-header-disclosure]');
          const opensDialog = target.closest('[data-dialog-open]');

          disclosures.forEach((disclosure) => {
            if (!disclosure.open) return;
            if (disclosure.contains(target) && target !== disclosure) return;
            const shouldRestoreFocus = target === disclosure || (!targetDisclosure && !opensDialog);
            closeDisclosure(disclosure, shouldRestoreFocus);
          });
        };

        const handleViewport = () => {
          if (!this.mobileViewport.matches) {
            disclosures.filter((item) => item.matches('[data-header-mobile-menu]')).forEach((item) => closeDisclosure(item, false));
          }
          updatePosition();
        };

        if (sticky && sectionHost) sectionHost.setAttribute('data-sticky-header-host', '');
        disclosures.forEach((disclosure) => {
          disclosure.open = false;
          disclosure.addEventListener('toggle', handleToggle, { signal });
          updateDisclosure(disclosure);
        });
        header.addEventListener('keydown', handleKeydown, { signal });
        header.addEventListener('click', handleClick, { signal });
        document.addEventListener('click', handleDocumentClick, { signal });
        window.addEventListener('scroll', updatePosition, { passive: true, signal });
        window.addEventListener('resize', updatePosition, { passive: true, signal });
        this.mobileViewport.addEventListener('change', handleViewport, { signal });

        const resizeObserver = typeof ResizeObserver === 'undefined' ? null : new ResizeObserver(updatePosition);
        resizeObserver?.observe(header);

        this.headers.set(header, {
          closeDisclosure,
          controller,
          disclosures,
          resizeObserver,
          sectionHost,
        });
        updatePosition();
      },

      destroy(root) {
        const headers = [];
        if (root.matches?.('[data-site-header]')) headers.push(root);
        if (root.querySelectorAll) headers.push(...root.querySelectorAll('[data-site-header]'));
        headers.forEach((header) => {
          const entry = this.headers.get(header);
          if (!entry) return;
          entry.controller.abort();
          entry.resizeObserver?.disconnect();
          entry.sectionHost?.removeAttribute('data-sticky-header-host');
          this.headers.delete(header);
        });
      },

      setup() {
        document.addEventListener('shopify:section:load', (event) => this.init(event.target));
        document.addEventListener('shopify:section:unload', (event) => this.destroy(event.target));
        this.init(document);
      },
    };

    window.themeHeaderManager = manager;
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => manager.setup(), { once: true });
    } else {
      manager.setup();
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "t:labels.desktop_layout",
      "options": [
        { "value": "logo_left", "label": "t:options.header_layout.logo_left" },
        { "value": "logo_center", "label": "t:options.header_layout.logo_center" }
      ],
      "default": "logo_center"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "t:labels.mobile_layout",
      "options": [
        { "value": "logo_left", "label": "t:options.header_layout.logo_left" },
        { "value": "logo_center", "label": "t:options.header_layout.logo_center" }
      ],
      "default": "logo_center"
    },
    {
      "type": "select",
      "id": "container",
      "label": "t:labels.container",
      "options": [
        { "value": "contained", "label": "t:options.header_container.contained" },
        { "value": "full_width", "label": "t:options.header_container.full_width" }
      ],
      "default": "contained"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "spacing_block",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "t:labels.header_spacing",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "label": "t:labels.sticky_header",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "transparent_header",
      "label": "t:labels.transparent_header",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:labels.show_search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "t:labels.show_account",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "t:labels.show_cart",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "t:labels.show_localization",
      "default": false
    }
  ],
  "class": "section-header",
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
