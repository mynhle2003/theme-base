{% content_for "block", type: "_header-top", id: "header-top" %}

{% stylesheet %}
  .header {
    position: relative;
    width: 100%;
    color: var(--body-color);
    background-color: var(--background-color);
    transition: background-color var(--motion-duration-standard) var(--motion-ease-standard);
  }

  .header--overlay:is(.header--is-scrolled, .header--submenu-open, .header--search-open, .header--cart-open) {
    background-color: var(--background-color);
  }

  .header--overlay:is(.header--is-scrolled, .header--submenu-open, .header--search-open, .header--cart-open) .header-top {
    background-color: var(--background-color);
  }

  .header--overlap-first-section {
    z-index: var(--z-drawer);
    margin-block-end: calc(var(--header-layout-height, 0px) * -1);
  }

  /* Home overlay is present in the server-rendered block. Keep its wrapper
     out of document flow before JS measures/reorganizes the header, rather
     than pulling MainContent upward after the first paint. */
  .section-header:has(.header-top[data-header-overlap-first-section]) {
    position: relative;
    height: 0;
    margin-block-end: 0;
    overflow: visible;
    z-index: var(--z-drawer, 200);
  }

  .section-header:has(.header-top[data-header-overlap-first-section][data-sticky-type]:not([data-sticky-type='none'])) {
    position: sticky;
    top: 0;
  }

  .header[data-sticky-type='always'],
  .header[data-sticky-type='scroll_up'] {
    position: sticky;
    top: 0;
    inset-inline: 0;
    z-index: var(--z-drawer, 200);
  }

  .header[data-sticky-type='scroll_up'] {
    transition:
      transform var(--motion-duration-standard) var(--motion-ease-standard),
      background-color var(--motion-duration-standard) var(--motion-ease-standard);
    will-change: transform;
  }

  .header[data-sticky-type='scroll_up'].header--is-hidden {
    transform: translateY(calc(-1 * var(--header-layout-height, 100%)));
  }

  /* Keep the fixed drawer viewport-relative through its entire overlay
     lifecycle, including the exit animation before [hidden] is restored,
     and across viewport resizes. */
  .header[data-sticky-type='scroll_up']:has([data-header-mobile-drawer]:not([hidden])) {
    transform: none;
    will-change: auto;
    transition-property: background-color;
  }

  .header[data-sticky-type='top_header_only'],
  .header[data-sticky-type='bottom_header_only'] {
    position: sticky;
    top: 0;
    z-index: var(--z-drawer, 200);
  }

  @media (prefers-reduced-motion: reduce) {
    .header,
    .header-top {
      transition-duration: 0.01ms;
    }
  }

  .header__container {
    min-width: 0;
  }
{% endstylesheet %}

