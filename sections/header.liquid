{% content_for "block", type: "_header-top", id: "header-top" %}

{% stylesheet %}
  .header {
    position: relative;
    width: 100%;
    color: var(--body-color);
    background-color: var(--background-color);
    transition: background-color var(--motion-duration-standard) var(--motion-ease-standard);
  }

  .header.header--overlay {
    background-color: rgb(0 0 0 / 20%);
    backdrop-filter: blur(2px);
  }

  .header--overlay:is(.header--is-scrolled, .header--submenu-open, .header--search-open, .header--cart-open) {
    background-color: var(--background-color);
  }

  .header--overlay:is(.header--is-scrolled, .header--submenu-open, .header--search-open, .header--cart-open) .header-top {
    background-color: var(--background-color);
  }

  .header--overlay:has(.header-top--transparent-scheme):not(:is(.header--is-scrolled, .header--submenu-open, .header--search-open, .header--cart-open)) .header-top {
    background-color: transparent;
  }

  @media (width < 992px) {
    .header.header--overlay { backdrop-filter: none; }
  }

  .header--overlap-first-section {
    z-index: var(--z-drawer);
    margin-block-end: calc(var(--header-layout-height, 0px) * -1);
  }

  /* Home overlay is present in the server-rendered block. Keep its wrapper
     out of document flow before JS measures/reorganizes the header, rather
     than pulling MainContent upward after the first paint. */
  .section-header:has(.header-top[data-header-overlap-first-section]) {
    position: relative;
    height: 0;
    margin-block-end: 0;
    overflow: visible;
    z-index: var(--z-drawer, 200);
  }

  .section-header:has(.header-top[data-header-overlap-first-section][data-sticky-type]:not([data-sticky-type='none'])) {
    position: sticky;
    top: 0;
  }

  .header[data-sticky-type='always'],
  .header[data-sticky-type='scroll_up'] {
    position: sticky;
    top: 0;
    inset-inline: 0;
    z-index: var(--z-drawer, 200);
  }

  .header[data-sticky-type='scroll_up'] {
    transition:
      transform var(--motion-duration-standard) var(--motion-ease-standard),
      background-color var(--motion-duration-standard) var(--motion-ease-standard);
    will-change: transform;
  }

  .header[data-sticky-type='scroll_up'].header--is-hidden {
    transform: translateY(calc(-1 * var(--header-layout-height, 100%)));
  }

  /* Keep the fixed drawer viewport-relative through its entire overlay
     lifecycle, including the exit animation before [hidden] is restored,
     and across viewport resizes. */
  .header[data-sticky-type='scroll_up']:has([data-header-mobile-drawer]:not([hidden])) {
    transform: none;
    will-change: auto;
    transition-property: background-color;
  }

  .header[data-sticky-type='top_header_only'],
  .header[data-sticky-type='bottom_header_only'] {
    position: sticky;
    top: 0;
    z-index: var(--z-drawer, 200);
  }

  @media (prefers-reduced-motion: reduce) {
    .header,
    .header-top {
      transition-duration: 0.01ms;
    }
  }

  .header__container {
    min-width: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "class": "section-header header section-color-scope",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "blocks": [
    {
      "type": "_header-top"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "page_width",
          "label": "t:options.section_width.page_width"
        },
        {
          "value": "full_width",
          "label": "t:options.section_width.full_width"
        }
      ],
      "default": "page_width"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "t:labels.icon_size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:general.sticky"
    },
    {
      "type": "select",
      "id": "sticky_type",
      "label": "t:labels.type",
      "options": [
        {
          "value": "always",
          "label": "t:options.sticky_type.always"
        },
        {
          "value": "scroll_up",
          "label": "t:options.sticky_type.scroll_up"
        },
        {
          "value": "top_header_only",
          "label": "t:options.sticky_type.top_header_only"
        },
        {
          "value": "bottom_header_only",
          "label": "t:options.sticky_type.bottom_header_only"
        },
        {
          "value": "none",
          "label": "t:options.sticky_type.none"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "header_overlay",
      "label": "t:labels.transparent_header_section",
      "info": "t:info.header_overlay",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "transparent_color_scheme",
      "label": "Transparent color scheme",
      "default": "scheme-1",
      "visible_if": "{{ section.settings.header_overlay }}"
    }
  ],
  "presets": [
    {
      "name": "t:general.header",
      "category": "t:general.header",
      "settings": {
        "section_width": "full_width",
        "icon_size": 24,
        "sticky_type": "always",
        "color_scheme": "scheme-1",
        "header_overlay": true,
        "transparent_color_scheme": "scheme-3"
      },
      "blocks": [
        {
          "type": "_header-top",
          "static": true,
          "settings": {
            "bottom_separator": "none",
            "gap": 32,
            "padding_top": 16,
            "padding_bottom": 16,
            "customize_mobile_padding": true,
            "padding_top_mobile": 12,
            "padding_bottom_mobile": 12,
            "actions_gap": 20,
            "customize_mobile_gap": true,
            "gap_mobile": 32,
            "actions_gap_mobile": 20
          },
          "id": "header-top",
          "blocks": [
            {
              "type": "_header-menu",
              "settings": {
                "menu": "mara-header",
                "gap": 32,
                "show_dropdown_icon": false,
                "dropdown_trigger": "hover",
                "font": "body",
                "font_size": "sm",
                "letter_spacing": "relaxed",
                "text_case": "uppercase",
                "text_color": "",
                "submenu_font": "body",
                "submenu_font_size": "md",
                "submenu_text_case": "original",
                "submenu_text_color": ""
              },
              "blocks": []
            },
            {
              "type": "_header-menu-toggle",
              "settings": {},
              "blocks": []
            },
            {
              "type": "_header-logo",
              "settings": {
                "position": "center",
                "position_mobile": "left"
              },
              "blocks": []
            },
            {
              "type": "_header-localization",
              "settings": {
                "dropdown_trigger": "click",
                "show_country_selector": true,
                "show_country_name": false,
                "show_country_flag": true,
                "show_language_selector": false,
                "font_size": "sm"
              },
              "blocks": []
            },
            {
              "type": "_header-search",
              "settings": {
                "type": "icon",
                "label": "Search",
                "font": "body",
                "font_size": "md",
                "letter_spacing": "relaxed"
              },
              "blocks": []
            },
            {
              "type": "_header-account",
              "settings": {
                "type": "icon",
                "label": "Account",
                "font": "body",
                "font_size": "md",
                "letter_spacing": "normal"
