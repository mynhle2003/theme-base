{% liquid
  assign announcement_alignment = section.settings.alignment | default: 'center'
  unless announcement_alignment == 'left' or announcement_alignment == 'center' or announcement_alignment == 'right'
    assign announcement_alignment = 'center'
  endunless
  assign announcement_alignment_mobile = section.settings.alignment_mobile | default: announcement_alignment
  unless announcement_alignment_mobile == 'left' or announcement_alignment_mobile == 'center' or announcement_alignment_mobile == 'right'
    assign announcement_alignment_mobile = announcement_alignment
  endunless
  assign announcement_gap = section.settings.gap | default: 16 | plus: 0
  assign announcement_padding_top = section.settings.padding_top | default: 8 | plus: 0
  assign announcement_padding_bottom = section.settings.padding_bottom | default: 8 | plus: 0
  assign announcement_color_scheme = section.settings.color_scheme | default: 'scheme-3'
  if section.settings.color_scheme.id != blank
    assign announcement_color_scheme = section.settings.color_scheme.id
  endif
  assign announcement_color_scheme = announcement_color_scheme | default: 'scheme-3' | handleize
  assign announcement_background_type = section.settings.background_type | default: 'none'
  assign announcement_overlay = false
  if section.settings.overlay and announcement_background_type == 'image'
    assign announcement_overlay = true
  endif
%}

{% capture announcement_style %}
  --announcement-static-alignment: {{ announcement_alignment }};
  {% if announcement_alignment_mobile != announcement_alignment %}--announcement-static-alignment-mobile: {{ announcement_alignment_mobile }};{% endif %}
  --announcement-bar-gap: {{ announcement_gap }}px;
  {% if announcement_padding_top != 0 %}--section-padding-top: {{ announcement_padding_top }}px;{% endif %}
  {% if announcement_padding_bottom != 0 %}--section-padding-bottom: {{ announcement_padding_bottom }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    {% if section.settings.padding_top_mobile != announcement_padding_top %}--section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;{% endif %}
    {% if section.settings.padding_bottom_mobile != announcement_padding_bottom %}--section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;{% endif %}
  {% endif %}
  {% if announcement_overlay and section.settings.overlay_color != blank %}--announcement-bar-overlay-color: {{ section.settings.overlay_color | escape }};{% endif %}
{% endcapture %}

<div
  class="section-spacing announcement-bar-static color-scheme section-color-scope body-text {{ announcement_color_scheme }}{% if section.settings.bottom_separator %} announcement-bar-static--bottom-separator{% endif %}"
  style="{{ announcement_style | strip }}"
>
  {% if announcement_background_type == 'image' and section.settings.background_image != blank %}
    <div class="announcement-bar__background" aria-hidden="true">
      {% render 'image', image: section.settings.background_image, mobile_image: section.settings.mobile_background_image, alt: '', widths: '480, 720, 960, 1200, 1600, 2400', sizes: '100vw', class: 'announcement-bar__background-image' %}
      {% if announcement_overlay %}<div class="announcement-bar__overlay"></div>{% endif %}
    </div>
  {% endif %}
  <div class="announcement-bar-static__layout container full-width">
    <div class="announcement-bar-static__social">
      {% content_for 'block', type: '_announcement-social-links', id: 'announcement-social' %}
    </div>
    <div class="announcement-bar-static__content">
      {% content_for 'blocks' %}
    </div>
    <div class="announcement-bar-static__localization">
      {% content_for 'block', type: '_header-localization', id: 'announcement-localization' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .announcement-bar-static { position: relative; width: 100%; color: var(--body-color); background: var(--background-color); }
  .announcement-bar-static--bottom-separator { border-bottom: 1px solid var(--border-color); }
  .announcement-bar-static__layout { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr); align-items: center; column-gap: var(--announcement-bar-gap, 16px); }
  .announcement-bar-static__social { min-width: 0; }
  .announcement-bar-static__localization { justify-self: end; min-width: 0; }
  .announcement-bar-static__content { --text-align-default: var(--announcement-static-alignment, center); display: grid; justify-items: var(--announcement-static-alignment, center); gap: var(--announcement-bar-gap, 16px); min-width: 0; text-align: var(--text-align-default); overflow-wrap: anywhere; }
  .announcement-bar-static .header-localization__details { --header-submenu-offset: var(--section-padding-bottom, 0px); }
  .announcement-bar-static .header-localization__panel { inset-inline-start: auto; inset-inline-end: 0; max-width: calc(100vw - 32px); }
  .announcement-bar-static .header-localization__flag,
  .announcement-bar-static .header-localization__icon { width: 16px; height: 16px; }
  .announcement-bar-static .header-localization__summary { gap: 4px; }
  .announcement-bar-static .header-localization__country { gap: 6px; }
  @media (max-width: 767.98px) {
    .announcement-bar-static__layout { grid-template-columns: minmax(0, 1fr); }
    .announcement-bar-static__social, .announcement-bar-static__localization { display: none; }
    .announcement-bar-static__content { --text-align-default: var(--announcement-static-alignment-mobile, var(--announcement-static-alignment, center)); justify-items: var(--text-align-default); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar static",
  "class": "section-announcement-bar-static",
  "tag": "div",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "limit": 1,
  "max_blocks": 6,
  "blocks": [
    {
      "type": "text"
    },
    {
      "type": "discount-code"
    },
    {
      "type": "announcement-countdown-timer"
    },
    {
      "type": "_announcement-social-links"
    },
    {
      "type": "_header-localization"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Bottom separator"
    },
    {
      "type": "checkbox",
      "id": "bottom_separator",
      "label": "Show bottom separator",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Position",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment_mobile",
      "label": "Position (mobile)",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Image",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile image (optional)",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "checkbox",
      "id": "overlay",
      "label": "Overlay",
      "default": false,
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#00000033",
      "visible_if": "{{ section.settings.background_type == 'image' and section.settings.overlay }}"
    },
    {
      "type": "header",
      "content": "Gap"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar static",
      "category": "t:general.header",
      "settings": {
        "background_type": "none",
        "overlay": false,
        "gap": 16,
        "color_scheme": "scheme-3",
        "bottom_separator": false,
        "padding_top": 10,
        "padding_bottom": 10,
        "customize_mobile_padding": true,
        "padding_top_mobile": 8,
        "padding_bottom_mobile": 8,
        "alignment": "center",
        "alignment_mobile": "center"
      },
      "blocks": [
        {
          "type": "_announcement-social-links",
          "id": "announcement-social",
          "static": true,
          "settings": {
            "gap": 12
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>Free shipping worldwide on orders over $150 USD</p>",
            "width": "fill",
            "text_size": "sm",
            "text_color": "#ffffff"
          }
        },
        {
          "type": "_header-localization",
          "id": "announcement-localization",
          "static": true,
          "settings": {
            "show_country_name": true,
            "show_currency_with_name": true,
            "font_size": "xs"
          }
        }
      ]
    }
  ]
}
{% endschema %}
