{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<div class="product-images">
  {% for image in product.images %}
    <div class="product-image" data-product-media data-media-id="{{ image.id }}">
      {% render 'image', image: image %}
    </div>
  {% endfor %}
</div>

<div class="product-info">
  <h1>{{ product.title }}</h1>
  {% render 'price', item: product, show_from: true, context: 'product_page' %}
  <p>{{ product.description }}</p>
</div>

<div class="product-form form__wrapper">
  {% form 'product', product %}
    {% assign current_variant = product.selected_or_first_available_variant %}
    <input type="hidden" name="id" value="{{ current_variant.id }}">

    {% render 'variant-picker', product: product %}

    <label class="form__field">
      <span>{{ 'products.product.quantity' | t }}</span>
      <input class="form__control" type="number" name="quantity" min="1" value="1">
    </label>

    <button class="product-form__submit" type="submit"{% unless current_variant.available %} disabled{% endunless %}>
      {{ 'products.product.add_to_cart' | t }}
    </button>
    {{ form | payment_button }}
  {% endform %}
</div>

{% stylesheet %}
  .product-images {
    display: grid;
    gap: var(--page-margin);
  }

  .product-image[hidden] {
    display: none;
  }

  .product-form {
    gap: 1rem;
  }

  .product-form form {
    display: grid;
    gap: 1rem;
  }

  .product-form__submit {
    background: var(--color-primary-button);
    border: 1px solid var(--color-primary-button-border);
    border-radius: var(--input-radius);
    color: var(--color-primary-button-label);
    cursor: pointer;
    font: inherit;
    min-height: var(--input-height);
    padding: 0.625rem 0.875rem;
  }

  .product-form__submit:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  .product-form__submit:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.product-form').forEach((productForm) => {
    if (productForm.dataset.priceInitialized === 'true') return;
    productForm.dataset.priceInitialized = 'true';

    const picker = productForm.querySelector('[data-variant-picker]');
    const priceBlock = productForm.parentElement?.previousElementSibling?.querySelector('[data-price]');
    if (!picker || !priceBlock) return;

    const formatMoney = (cents) => {
      if (window.Shopify?.formatMoney) return window.Shopify.formatMoney(cents);
      const currency = window.Shopify?.currency?.active;
      if (!currency) return String(cents);
      return new Intl.NumberFormat(document.documentElement.lang, { style: 'currency', currency }).format(cents / 100);
    };

    picker.addEventListener('variant:change', (event) => {
      const variant = event.detail.variant;
      const currentPrice = priceBlock.querySelector('[data-price-current]');
      const comparePrice = priceBlock.querySelector('[data-price-compare]');
      if (!variant || !currentPrice) return;

      currentPrice.textContent = formatMoney(variant.price);
      currentPrice.classList.toggle('price__current--sale', variant.compare_at_price > variant.price);

      if (comparePrice) {
        comparePrice.hidden = !(variant.compare_at_price > variant.price);
        comparePrice.textContent = formatMoney(variant.compare_at_price);
      }

      priceBlock.classList.toggle('price--sale', variant.compare_at_price > variant.price);
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
