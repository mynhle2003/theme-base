{% liquid
  assign scrolling_cards_section_width = section.settings.section_width | default: 'page_width'
  unless scrolling_cards_section_width == 'page_width' or scrolling_cards_section_width == 'full_width' or scrolling_cards_section_width == 'custom'
    assign scrolling_cards_section_width = 'page_width'
  endunless

  assign scrolling_cards_container_width = 'page-width'
  if scrolling_cards_section_width == 'full_width'
    assign scrolling_cards_container_width = 'full-width'
  endif

  assign scrolling_cards_custom_width = section.settings.custom_width | default: 1200 | plus: 0
  if scrolling_cards_custom_width < 640 or scrolling_cards_custom_width > 1800
    assign scrolling_cards_custom_width = 1200
  endif

  assign scrolling_cards_gap_desktop = section.settings.gap_desktop | default: 60 | plus: 0
  assign scrolling_cards_gap_mobile = section.settings.gap_mobile | default: 40 | plus: 0
  if scrolling_cards_gap_desktop < 0 or scrolling_cards_gap_desktop > 100
    assign scrolling_cards_gap_desktop = 60
  endif
  if scrolling_cards_gap_mobile < 0 or scrolling_cards_gap_mobile > 100
    assign scrolling_cards_gap_mobile = 40
  endif

  assign scrolling_cards_padding_top = section.settings.padding_top | default: 80 | plus: 0
  assign scrolling_cards_padding_bottom = section.settings.padding_bottom | default: 90 | plus: 0
  assign scrolling_cards_padding_top_mobile = section.settings.padding_top_mobile | default: 50 | plus: 0
  assign scrolling_cards_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 50 | plus: 0

  if scrolling_cards_padding_top < 0 or scrolling_cards_padding_top > 100
    assign scrolling_cards_padding_top = 80
  endif
  if scrolling_cards_padding_bottom < 0 or scrolling_cards_padding_bottom > 100
    assign scrolling_cards_padding_bottom = 90
  endif
  if scrolling_cards_padding_top_mobile < 0 or scrolling_cards_padding_top_mobile > 100
    assign scrolling_cards_padding_top_mobile = 50
  endif
  if scrolling_cards_padding_bottom_mobile < 0 or scrolling_cards_padding_bottom_mobile > 100
    assign scrolling_cards_padding_bottom_mobile = 50
  endif

  assign scrolling_cards_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign scrolling_cards_scheme = section.settings.color_scheme.id
  endif
  assign scrolling_cards_scheme = scrolling_cards_scheme | default: 'scheme-1' | handleize
%}

{% capture scrolling_cards_style %}
  --scrolling-cards-stack-gap: {{ section.settings.card_gap_desktop | default: 150 | at_least: 0 | at_most: 200 }}px;
  --scrolling-cards-stack-gap-mobile: {{ section.settings.card_gap_mobile | default: 120 | at_least: 0 | at_most: 200 }}px;
  --scrolling-cards-header-gap: {{ scrolling_cards_gap_desktop }}px;
  --scrolling-cards-header-gap-mobile: {{ scrolling_cards_gap_mobile }}px;
  --section-padding-top: {{ scrolling_cards_padding_top }}px;
  --section-padding-bottom: {{ scrolling_cards_padding_bottom }}px;
  {% if scrolling_cards_section_width == 'custom' %}--scrolling-cards-custom-width: {{ scrolling_cards_custom_width }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    --section-padding-top-mobile: {{ scrolling_cards_padding_top_mobile }}px;
    --section-padding-bottom-mobile: {{ scrolling_cards_padding_bottom_mobile }}px;
  {% endif %}
{% endcapture %}

<script type="module" src="{{ 'scrolling-cards.js' | asset_url }}"></script>

<div class="section-content-scope scrolling-cards-section scrolling-cards-section--{{ scrolling_cards_section_width }}">
  <div
    class="section-spacing scrolling-cards-section__spacing color-scheme section-color-scope {{ scrolling_cards_scheme }}"
    style="{{ scrolling_cards_style | strip }}"
  >
    <div class="container {{ scrolling_cards_container_width }} scrolling-cards-section__container">
      <div
        class="scrolling-cards align-content"
        data-scrolling-cards
        data-stack-effect="{{ section.settings.stack_effect | default: 'scale' }}"
        data-sticky-mobile="{{ section.settings.enable_sticky_mobile }}"
      >
        {% capture scrolling_cards_header_content %}{% content_for 'block', type: 'header', id: 'header' %}{% endcapture %}
        {% render 'section-content-slot', content: scrolling_cards_header_content, class: 'scrolling-cards__header' %}

        {% capture scrolling_cards_items_content %}{% content_for 'blocks' %}{% endcapture %}
        {% render 'section-content-slot', content: scrolling_cards_items_content, class: 'scrolling-cards__items' %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .scrolling-cards-section {
    width: 100%;
    min-width: 0;
  }

  .scrolling-cards-section--custom .scrolling-cards-section__container {
    max-width: var(--scrolling-cards-custom-width, 1200px);
  }

  .scrolling-cards-section__container {
    position: relative;
    z-index: 1;
  }

  .scrolling-cards {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    min-width: 0;
    gap: var(--scrolling-cards-header-gap);
  }

  .scrolling-cards__header {
    display: flex;
    justify-content: center;
    width: 100%;
    min-width: 0;
    text-align: center;
  }

  .scrolling-cards__header > .header-block {
    margin-inline: auto;
  }

  .scrolling-cards__items {
    display: flex;
    flex-direction: column;
    gap: var(--scrolling-cards-stack-gap, 150px);
    width: 100%;
    min-width: 0;
  }

  .scrolling-cards__items > .scrolling-card:not(:first-child) {
    --scrolling-card-offset-top: -1px;
  }

  @media (max-width: 767.98px) {
    .scrolling-cards {
      gap: var(--scrolling-cards-header-gap-mobile, var(--scrolling-cards-header-gap, 60px));
    }

    .scrolling-cards__items {
      gap: var(--scrolling-cards-stack-gap-mobile, 120px);
    }
  }
{% endstylesheet %}

