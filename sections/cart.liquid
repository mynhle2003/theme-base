{% liquid
  assign cart_form_id = 'CartForm-' | append: section.id
%}

<section class="cart-page page-width">
  <h1>{{ 'cart.title' | t }}</h1>

  <form id="{{ cart_form_id }}" class="cart-page__form" action="{{ routes.cart_url }}" method="post" data-cart-form>
    {% render 'cart-items', cart: cart, form_id: cart_form_id %}
    {% render 'cart-summary', cart: cart, form_id: cart_form_id %}
  </form>
</section>

{% stylesheet %}
  .cart-page { display: grid; gap: 2rem; }
  .cart-page h1 { margin: 0; }
  .cart-page__form { display: grid; gap: 2rem; }
  .cart-page .cart-summary { border-block-start: 1px solid var(--color-border); padding-block-start: 1.5rem; }
  @media screen and (min-width: 900px) {
    .cart-page__form { grid-template-columns: minmax(0, 1fr) minmax(16rem, 24rem); align-items: start; }
    .cart-page .cart-summary { border-block-start: 0; border-inline-start: 1px solid var(--color-border); padding-block-start: 0; padding-inline-start: 2rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
