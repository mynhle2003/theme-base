{% liquid
  assign rich_text_gap = section.settings.gap | default: 24
  assign rich_text_gap_mobile = section.settings.gap_mobile | default: rich_text_gap
  assign rich_text_alignment = 'start'
  case section.settings.alignment
    when 'center'
      assign rich_text_alignment = 'center'
    when 'right'
      assign rich_text_alignment = 'end'
  endcase

  assign rich_text_alignment_mobile = rich_text_alignment
  if section.settings.customize_mobile_alignment
    assign rich_text_alignment_mobile = 'start'
    case section.settings.alignment_mobile
      when 'center'
        assign rich_text_alignment_mobile = 'center'
      when 'right'
        assign rich_text_alignment_mobile = 'end'
    endcase
  endif

  assign padding_top = section.settings.padding_top | default: 0 | plus: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0 | plus: 0
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 0 | plus: 0
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 0 | plus: 0

  assign rich_text_container_width = 'page-width'
  case section.settings.section_width
    when 'full_width'
      assign rich_text_container_width = 'full-width'
  endcase

  assign rich_text_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign rich_text_scheme = section.settings.color_scheme.id
  endif
  assign rich_text_scheme = rich_text_scheme | default: 'scheme-1' | handleize
%}

{% capture rich_text_style %}
  {% if rich_text_alignment != 'start' %}--flex-align: {{ rich_text_alignment }};{% endif %}
  {% if section.settings.customize_mobile_alignment and rich_text_alignment_mobile != rich_text_alignment %}--flex-align-mobile: {{ rich_text_alignment_mobile }};{% endif %}
  {% if section.settings.background_color != blank %}--rich-text-background-color: {{ section.settings.background_color | escape }};{% endif %}
  {% if padding_top != 0 %}--rich-text-padding-top: {{ padding_top }}px;{% endif %}
  {% if padding_bottom != 0 %}--rich-text-padding-bottom: {{ padding_bottom }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    {% if padding_top_mobile != padding_top %}--rich-text-padding-top-mobile: {{ padding_top_mobile }}px;{% endif %}
    {% if padding_bottom_mobile != padding_bottom %}--rich-text-padding-bottom-mobile: {{ padding_bottom_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign rich_text_style = rich_text_style | strip %}

{% capture rich_text_content_style %}
  {% render 'layout-flow-style',
    direction: 'column',
    wrap: 'nowrap',
    align_items: 'var(--flex-align, flex-start)',
    align_items_mobile: 'var(--flex-align-mobile, var(--flex-align, flex-start))',
    gap: rich_text_gap,
    gap_mobile: rich_text_gap_mobile
  %}
{% endcapture %}
{% assign rich_text_content_style = rich_text_content_style | strip %}

<div
  class="section-spacing rich-text__spacing section-content-scope section-content-surface color-scheme section-color-scope {{ rich_text_scheme }}"
  {% if rich_text_style != blank %}style="{{ rich_text_style }}"{% endif %}
>
  {% if section.settings.background_image != blank %}
    <div class="rich-text__background" aria-hidden="true">
      {{ section.settings.background_image | image_url: width: 2000 | image_tag: class: 'background-media-paint' }}
    </div>
  {% endif %}

  <div class="container {{ rich_text_container_width }} rich-text__container">
    <div class="rich-text__content section-content-slot layout-flow layout-flow--responsive align-content" style="{{ rich_text_content_style }}">
      {% content_for "block", type: "eyebrow", id: "eyebrow" %}
      {% content_for "block", type: "heading", id: "heading" %}
      {% content_for "block", type: "text", id: "text" %}
      {% content_for "blocks" %}
    </div>
  </div>
</div>

{% stylesheet %}
  .rich-text__spacing {
    position: relative;
    overflow: hidden;
    width: 100%;
    padding-top: var(--rich-text-padding-top, 0px);
    padding-bottom: var(--rich-text-padding-bottom, 0px);
    background-color: var(--rich-text-background-color, var(--background-color));
  }

  .rich-text__background {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .rich-text__background img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rich-text__container {
    position: relative;
    z-index: 1;
  }

  .rich-text__content {
    min-width: 0;
    color: var(--body-color);
    overflow-wrap: anywhere;
  }

  .rich-text__content :where(ul, ol) {
    padding-inline-start: 1.5em;
  }

  .rich-text__content :where(img, video, iframe) {
    max-width: 100%;
  }

  .rich-text__content a:not(.btn, [class*='btn--']) {
    color: inherit;
  }

  @media (max-width: 767.98px) {
    .rich-text__spacing {
      padding-top: var(--rich-text-padding-top-mobile, var(--rich-text-padding-top, 0px));
      padding-bottom: var(--rich-text-padding-bottom-mobile, var(--rich-text-padding-bottom, 0px));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.rich_text",
  "class": "section-rich--text",
  "enabled_on": {
    "templates": [
      "*"
    ]
  },
  "blocks": [
    {
      "type": "eyebrow"
    },
    {
      "type": "heading"
    },
    {
      "type": "editorial-text"
    },
    {
      "type": "text"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "buttons"
    },
    {
      "type": "icon"
    },
    {
      "type": "marquee"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "page_width",
          "label": "t:options.section_width.page_width"
        },
        {
          "value": "full_width",
          "label": "t:options.section_width.full_width"
        }
      ],
      "default": "page_width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:labels.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:labels.mobile_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:labels.alignment",
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_alignment",
      "label": "t:labels.customize_mobile_alignment",
      "default": false
    },
    {
      "type": "text_alignment",
      "id": "alignment_mobile",
      "label": "t:labels.mobile_alignment",
      "default": "left",
      "visible_if": "{{ section.settings.customize_mobile_alignment }}"
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "background_color",
      "label": "t:labels.background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "t:general.rich_text",
      "settings": {
        "section_width": "page_width",
        "alignment": "center",
        "customize_mobile_alignment": true,
        "alignment_mobile": "center",
        "color_scheme": "scheme-2",
        "background_color": "#F6F0EC",
        "padding_top": 80,
        "padding_bottom": 80,
        "customize_mobile_padding": true,
        "padding_top_mobile": 56,
        "padding_bottom_mobile": 56,
        "gap": 16,
        "gap_mobile": 16
      },
      "blocks": [
        {
          "type": "eyebrow",
          "settings": {
            "text": "",
            "animation_delay": 100,
            "animation_type": "slide-right"
          },
          "static": true,
          "id": "eyebrow"
        },
        {
          "type": "heading",
          "settings": {
            "text": "<p>OVER 100 BRANDS OF DESIGNERS</p>",
            "heading_size": "display",
            "html_tag": "h2",
            "width": "custom",
            "custom_heading_size": 24,
            "max_width": 830,
            "customize_mobile_size": true,
            "width_mobile": "fill",
            "max_width_mobile": 480,
            "animation_type": "slide-bottom",
            "animation_delay": 100,
            "padding_top": 0,
            "padding_bottom": 4,
            "padding_left": 0,
            "padding_right": 0,
            "customize_mobile_padding": true,
            "padding_top_mobile": 0,
            "padding_bottom_mobile": 0,
            "padding_left_mobile": 0,
            "padding_right_mobile": 0,
            "text_color": "#3A3A3A"
          },
          "static": true,
          "id": "heading"
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>From flowy floral midi dresses to sleek evening gowns, every piece is designed to express your individuality and confidence. Our collection brings together global designers who blend creativity, comfort, and style — so you can look and feel your best wherever you go. Find your next favorite look and make every day.</p>",
            "text_size": "sm",
            "width": "custom",
            "max_width": 830,
            "text_color": "#6C6C6C",
            "padding_bottom": 16,
            "customize_mobile_padding": true,
            "padding_bottom_mobile": 8,
            "customize_mobile_size": true,
            "width_mobile": "fill",
            "animation_delay": 100,
            "animation_type": "slide-bottom"
          },
          "static": true,
          "id": "text"
        },
        {
          "type": "button",
          "settings": {
            "button_label": "DISCOVER MORE",
            "button_style": "primary",
            "show_icon": false,
            "width": "fit",
            "button_link": "shopify://pages/our-story-novaire",
            "animation_delay": 150,
            "animation_type": "slide-bottom"
          }
        }
      ]
    }
  ]
}
{% endschema %}
