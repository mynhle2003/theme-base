    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "t:custom_section.mobile_image_optional",
      "visible_if": "{{ section.settings.background == 'image' }}"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "t:custom_section.video",
      "visible_if": "{{ section.settings.background == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "t:custom_section.overlay",
      "default": true,
      "visible_if": "{{ section.settings.background != 'none' }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:custom_section.overlay_color",
      "alpha": true,
      "default": "#00000080",
      "visible_if": "{{ section.settings.background != 'none' and section.settings.show_overlay }}"
    },
    {
      "type": "select",
      "id": "parallax_effect",
      "label": "t:custom_section.parallax_effect",
      "options": [
        {
          "value": "none",
          "label": "t:custom_section.none"
        },
        {
          "value": "fixed",
          "label": "t:custom_section.fixed"
        },
        {
          "value": "vertical",
          "label": "t:custom_section.vertical"
        },
        {
          "value": "horizontal",
          "label": "t:custom_section.horizontal"
        },
        {
          "value": "zoom",
