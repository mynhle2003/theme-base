[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:labels.logo",
        "info": "t:info.logo"
      },
      {
        "type": "image_picker",
        "id": "logo_transparent",
        "label": "t:labels.logo_transparent",
        "info": "t:info.logo_transparent"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 400,
        "step": 5,
        "unit": "px",
        "label": "t:labels.logo_width",
        "default": 180
      },
      {
        "type": "range",
        "id": "logo_width_mobile",
        "min": 60,
        "max": 280,
        "step": 5,
        "unit": "px",
        "label": "t:labels.logo_width_mobile",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon",
        "info": "t:info.favicon"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "t:labels.background",
            "default": "#FFFFFF"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "t:labels.background_gradient"
          },
          {
            "type": "color",
            "id": "heading",
            "label": "t:labels.heading",
            "default": "#333333"
          },
          {
            "type": "color",
            "id": "text",
            "label": "t:labels.text",
            "default": "#333333"
          },
          {
            "type": "color",
            "id": "border",
            "label": "t:labels.border",
            "default": "#E5E5E5"
          },
          {
            "type": "color",
            "id": "primary_button",
            "label": "t:labels.primary_button",
            "default": "#333333"
          },
          {
            "type": "color",
            "id": "primary_button_label",
            "label": "t:labels.primary_button_label",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "primary_button_border",
            "label": "t:labels.primary_button_border",
            "default": "#333333"
          },
          {
            "type": "color",
            "id": "secondary_button",
            "label": "t:labels.secondary_button",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "t:labels.secondary_button_label",
            "default": "#333333"
          },
          {
            "type": "color",
            "id": "secondary_button_border",
            "label": "t:labels.secondary_button_border",
            "default": "#333333"
          },
          {
            "type": "color",
            "id": "shadow",
            "label": "t:labels.shadow",
            "default": "#000000"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "secondary_button_label",
          "icons": "heading",
          "primary_button": "primary_button",
          "on_primary_button": "primary_button_label",
          "primary_button_border": "primary_button_border",
          "secondary_button": "secondary_button",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button_border"
        }
      },
      {
        "type": "color_scheme",
        "id": "default_color_scheme",
        "default": "scheme-1",
        "label": "t:labels.default_color_scheme"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  }
]
