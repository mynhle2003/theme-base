[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:labels.logo",
        "info": "t:info.logo"
      },
      {
        "type": "image_picker",
        "id": "logo_transparent",
        "label": "t:labels.logo_transparent",
        "info": "t:info.logo_transparent"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 400,
        "step": 5,
        "unit": "px",
        "label": "t:labels.logo_width",
        "default": 180
      },
      {
        "type": "range",
        "id": "logo_width_mobile",
        "min": 60,
        "max": 280,
        "step": 5,
        "unit": "px",
        "label": "t:labels.logo_width_mobile",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon",
        "info": "t:info.favicon"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:labels.body_font"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "work_sans_n4",
        "label": "t:labels.heading_font"
      },
      {
        "type": "font_picker",
        "id": "type_accent_font",
        "default": "work_sans_n4",
        "label": "t:labels.accent_font"
      },
      {
        "type": "range",
        "id": "font_heading_base_size",
        "min": 28,
        "max": 72,
        "step": 1,
        "unit": "px",
        "default": 44,
        "label": "t:labels.heading_base_size"
      },
      {
        "type": "range",
        "id": "font_body_base_size",
        "min": 14,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 18,
        "label": "t:labels.body_base_size"
      },
      {
        "type": "select",
        "id": "font_body_line_height",
        "label": "t:labels.body_line_height",
        "options": [
          { "value": "normal", "label": "t:options.line_height.normal" },
          { "value": "relaxed", "label": "t:options.line_height.relaxed" },
          { "value": "loose", "label": "t:options.line_height.loose" }
        ],
        "default": "relaxed"
      },
      {
        "type": "select",
        "id": "font_heading_line_height",
        "label": "t:labels.heading_line_height",
        "options": [
          { "value": "tight", "label": "t:options.line_height.tight" },
          { "value": "normal", "label": "t:options.line_height.normal" },
          { "value": "relaxed", "label": "t:options.line_height.relaxed" }
        ],
        "default": "tight"
      },
      {
        "type": "select",
        "id": "font_heading_text_case",
        "label": "t:labels.heading_text_case",
        "options": [
          { "value": "original", "label": "t:options.text_case.original" },
          { "value": "uppercase", "label": "t:options.text_case.uppercase" },
          { "value": "capitalize", "label": "t:options.text_case.capitalize" }
        ],
        "default": "original"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
