{%- capture header_group_markup -%}
  {% sections 'header-group' %}
{%- endcapture -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Establish the viewport before evaluating responsive image hints. %}
    {% render 'meta-tags' %}

    {% comment %}The owning section supplies matching art-directed hints; discover
      its LCP source before fonts, styles and header/overlay markup are parsed.{% endcomment %}
    {% if content_for_layout contains '<!-- theme-lcp-preloads:start -->' %}
      {% assign lcp_preloads = content_for_layout | split: '<!-- theme-lcp-preloads:start -->' | last | split: '<!-- theme-lcp-preloads:end -->' | first %}
      {{ lcp_preloads }}
    {% endif %}
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% unless settings.motion_block_animations == false %}
      <script>
        // Prepare entrance effects before body content can reach its first paint.
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window && typeof Element.prototype.animate === 'function') {
          const boot = { expired: false };
          window[Symbol.for('theme.blockAnimationsBoot')] = boot;
          document.documentElement.classList.add('block-animations-enabled');
          boot.release = () => {
            boot.expired = true;
            document.documentElement.classList.remove('block-animations-enabled');
          };
          boot.timer = setTimeout(boot.release, 8000);
        }
      </script>
    {% endunless %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {% if settings.type_primary_font.family contains 'Kaisei Decol' and settings.type_primary_font.weight == 400 and settings.type_primary_font.style == 'normal' %}
        {{ 'kaisei-decol-latin-400.woff2' | asset_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
      {% else %}
        {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
      {% endif %}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    <link rel="stylesheet" href="{{ 'component-overlay.css' | asset_url }}" media="print" onload="this.media='all'">
    <noscript>{{ 'component-overlay.css' | asset_url | stylesheet_tag }}</noscript>
    <script src="{{ 'component-overlay.js' | asset_url }}" defer></script>
    {% comment %} Footer-only disclosure styles should not delay the first paint. {% endcomment %}
    <link rel="stylesheet" href="{{ 'accordion-details.css' | asset_url }}" media="print" onload="this.media='all'">
    <noscript>{{ 'accordion-details.css' | asset_url | stylesheet_tag }}</noscript>
    <link rel="stylesheet" href="{{ 'menu.css' | asset_url }}" media="print" onload="this.media='all'">
    <noscript>{{ 'menu.css' | asset_url | stylesheet_tag }}</noscript>
    {% render 'swiper-stylesheet' %}
    <script src="{{ 'header.js' | asset_url }}" defer></script>
    <script src="{{ 'theme-module-loader.js' | asset_url }}" defer></script>
    <script src="{{ 'accordion-details.js' | asset_url }}" defer></script>
    <script src="{{ 'product-card-variants.js' | asset_url }}" defer></script>
    <script src="{{ 'share.js' | asset_url }}" defer></script>
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>
    <script src="{{ 'scroll-to.js' | asset_url }}" defer></script>
    <script src="{{ 'hero.js' | asset_url }}" defer></script>
    <script src="{{ 'block-animations.js' | asset_url }}" defer onerror="window[Symbol.for('theme.blockAnimationsBoot')]?.release()"></script>
    {% if request.design_mode %}
      <script type="module" src="{{ 'timeline-list.js' | asset_url }}"></script>
    {% endif %}

    {{ content_for_header }}
  </head>

  {% assign default_color_scheme = settings.default_color_scheme %}
  {% if settings.default_color_scheme.id != blank %}
    {% assign default_color_scheme = settings.default_color_scheme.id %}
  {% endif %}
  <body class="{{ default_color_scheme | default: 'scheme-1' }} input-style--{{ settings.input_style | default: 'solid' }}">
    {{ header_group_markup }}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% comment %}Fixed overlays do not participate in page flow. Parse the
      meaningful page content before their hidden product/form markup.{% endcomment %}
    {% sections 'overlay-group' %}

    {% sections 'footer-group' %}
    {% render 'component-overlay-cursor' %}
    {% if request.page_type == 'product' %}{% section 'recently-viewed-card' %}{% endif %}
    <script src="{{ 'recently-viewed.js' | asset_url }}" defer></script>
    <script src="{{ 'search-suggestions.js' | asset_url }}" defer></script>
  </body>
</html>
